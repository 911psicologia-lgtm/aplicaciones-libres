<?xml version="1.0" encoding="utf-8"?>
<!--
  HAPPY Android · reproductor flotante (overlay)
  Un solo layout con dos estados: COMPACTO y EXPANDIDO.
  Diseño idéntico a la identidad HAPPY: oscuro, redondeado, acento coral.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_bg"
    android:padding="8dp">

    <!-- ═══ Barra superior · ZONA DE ARRASTRE (handle) ═══ -->
    <LinearLayout
        android:id="@+id/overlayHandle"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⠿ HAPPY · FLOTANTE"
            android:textColor="@color/happy_text_dim"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnReturnApp"
            android:layout_width="26dp"
            android:layout_height="24dp"
            android:background="@drawable/ctrl_btn_bg"
            android:text="↗"
            android:textColor="@color/happy_text"
            android:textSize="13sp"
            android:padding="0dp" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="26dp"
            android:layout_height="24dp"
            android:background="@drawable/ctrl_btn_bg"
            android:text="✕"
            android:textColor="@color/happy_text_dim"
            android:textSize="12sp"
            android:padding="0dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- ═══ COMPACTO ═══ -->
    <LinearLayout
        android:id="@+id/compactBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/compactArt"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:scaleType="centerCrop"
            android:contentDescription="Portada" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:id="@+id/compactTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/happy_text"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Sin reproducción" />

            <TextView
                android:id="@+id/compactArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/happy_text_dim"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="HAPPY" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnCompactPrev"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/ctrl_btn_bg"
                android:text="⏮"
                android:textColor="@color/happy_text"
                android:textSize="12sp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btnCompactPlay"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/play_btn_bg"
                android:text="▶"
                android:textColor="@color/happy_bg"
                android:textSize="14sp"
                android:padding="0dp"
                android:layout_marginStart="2dp" />

            <Button
                android:id="@+id/btnCompactNext"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/ctrl_btn_bg"
                android:text="⏭"
                android:textColor="@color/happy_text"
                android:textSize="12sp"
                android:padding="0dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ EXPANDIDO ═══ -->
    <LinearLayout
        android:id="@+id/expandedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/expandedArt"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            android:layout_marginTop="4dp"
            android:contentDescription="Portada ampliada" />

        <TextView
            android:id="@+id/expandedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/happy_text"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="8dp"
            android:text="Sin reproducción" />

        <TextView
            android:id="@+id/expandedArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/happy_text_dim"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="HAPPY" />

        <SeekBar
            android:id="@+id/expandedSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:progressTint="@color/happy_accent"
            android:thumbTint="@color/happy_accent"
            android:progressBackgroundTint="@color/happy_surface_2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeNow"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/happy_text_dim"
                android:textSize="10sp"
                android:text="0:00" />

            <TextView
                android:id="@+id/timeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/happy_text_dim"
                android:textSize="10sp"
                android:text="0:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <Button
                android:id="@+id/btnExpandedPrev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/ctrl_btn_bg"
                android:text="⏮"
                android:textColor="@color/happy_text"
                android:textSize="15sp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btnExpandedPlay"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/play_btn_bg"
                android:text="▶"
                android:textColor="@color/happy_bg"
                android:textSize="18sp"
                android:padding="0dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btnExpandedNext"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/ctrl_btn_bg"
                android:text="⏭"
                android:textColor="@color/happy_text"
                android:textSize="15sp"
                android:padding="0dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
