:root{
  --violet:#6d5dfc;
  --violet-deep:#5d47f5;
  --teal:#18c3d6;
  --navy:#0d1320;
  --paper:#F4F6FB;
  --line: rgba(244,246,251,0.14);
  --dim: rgba(244,246,251,0.58);
}
*{box-sizing:border-box; -webkit-tap-highlight-color: transparent;}
[hidden]{display:none!important;}
html,body{height:100%;}
body{
  margin:0;
  min-height:100vh;
  min-height:100dvh;
  background:var(--navy);
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  font-family:'Inter',sans-serif;
  overflow-x:hidden;
}

.screen{ display:none; width:100%; }
.screen.active{ display:flex; flex-direction:column; align-items:center; max-height:100dvh; overflow-y:auto; }

/* ================= MARCA ================= */
.brand-mark{ width:64px; height:64px; margin:0 auto 8px; }
.brand-mark.small{ width:48px; height:48px; }
.brand-mark img{ width:100%; height:100%; border-radius:18px; }



/* ================= SPLASH / IDENTIDAD ================= */
#screen-splash.active{ justify-content:center; overflow:hidden; }
.splash-wrap{
  width:100%; max-width:360px; min-height:100dvh;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  text-align:center; padding:32px;
  background:
    radial-gradient(90% 60% at 50% 20%, rgba(109,93,252,.22), transparent 62%),
    radial-gradient(70% 50% at 50% 78%, rgba(24,195,214,.14), transparent 64%);
}
.brand-mark.splash{ width:92px; height:92px; margin-bottom:18px; }
.brand-mark.splash img{
  border-radius:28px;
  box-shadow:0 18px 40px rgba(0,0,0,.35), 0 0 0 1px rgba(255,255,255,.12);
}
.splash-title{
  margin:0;
  font-family:'Nunito',sans-serif;
  font-size:34px;
  font-weight:800;
  color:var(--paper);
  letter-spacing:.01em;
}
.splash-copy{
  margin:8px 0 0;
  font-family:'IBM Plex Mono',monospace;
  font-size:12px;
  letter-spacing:.08em;
  color:var(--teal);
  text-transform:uppercase;
}

/* ================= ONBOARDING ================= */
.onboard-wrap, .resume-wrap{
  width:100%; max-width:380px; padding:32px 28px 40px; position:relative;
  display:flex; flex-direction:column; justify-content:center;
}
.onboard-step{ display:none; flex-direction:column; gap:14px; }
.onboard-step.active{ display:flex; }

.ob-eyebrow{
  font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:.12em;
  text-transform:uppercase; color:var(--teal); margin:0;
}
.ob-title{
  font-family:'Nunito',sans-serif; font-weight:800; font-size:24px; color:var(--paper);
  margin:0; line-height:1.25;
}
.ob-help{ font-size:13px; color:var(--dim); margin:0 0 8px; line-height:1.5; }
.about-trigger{
  align-self:flex-start;
  margin:0 0 2px;
  padding:8px 12px;
  border-radius:999px;
  border:1px solid rgba(24,195,214,.42);
  background:rgba(24,195,214,.08);
  color:var(--paper);
  font-family:'Nunito',sans-serif;
  font-size:12.5px;
  font-weight:800;
  cursor:pointer;
}
.about-trigger.is-pulsing{ animation:softPulse 1.6s ease-in-out infinite; }
@keyframes softPulse{
  0%,100%{ transform:scale(1); box-shadow:0 0 0 0 rgba(24,195,214,.22); }
  50%{ transform:scale(1.03); box-shadow:0 0 0 7px rgba(24,195,214,0); }
}
@media (prefers-reduced-motion: reduce){ .about-trigger.is-pulsing{ animation:none; } }

.ob-input{
  width:100%; background:rgba(255,255,255,.06); border:1px solid var(--line);
  border-radius:14px; padding:16px; font-size:16px; color:var(--paper);
  font-family:'Inter',sans-serif; outline:none;
}
.ob-input:focus{ border-color:var(--violet); }
.ob-input::placeholder{ color:var(--dim); }

.mark-all-btn{
  align-self:flex-start; font-family:'IBM Plex Mono',monospace; font-size:11px;
  letter-spacing:.04em; color:var(--violet); background:none; border:1px solid var(--violet);
  border-radius:14px; padding:7px 12px; cursor:pointer; margin-bottom:2px;
}
.mark-all-btn.all-marked{ background:var(--violet); color:#fff; }

.chip-grid{ display:flex; flex-wrap:wrap; gap:8px; margin:6px 0 4px; }
.chip{
  font-family:'Nunito',sans-serif; font-weight:700; font-size:12.5px; letter-spacing:.01em;
  padding:9px 14px; border-radius:18px; border:1px solid var(--line);
  background:rgba(255,255,255,.04); color:var(--dim); cursor:pointer;
  position:relative;
}
.chip.active{ background:var(--violet); border-color:var(--violet); color:#fff; }
.chip[data-order]::after{
  content:attr(data-order);
  position:absolute; top:-7px; right:-7px;
  min-width:18px; height:18px; padding:0 4px; box-sizing:border-box;
  display:flex; align-items:center; justify-content:center;
  font-size:11px; font-weight:800; line-height:1;
  color:var(--violet); background:#fff; border-radius:9px;
  box-shadow:0 1px 3px rgba(0,0,0,.3);
}

.pace-grid{ display:grid; grid-template-columns:1fr 1fr; gap:10px; margin:6px 0 4px; }
.pace-grid:has(.pace-btn:nth-child(3):last-child){ grid-template-columns:1fr 1fr 1fr; }
.pace-btn{
  font-family:'Nunito',sans-serif; font-weight:700; font-size:13px;
  padding:18px 10px; border-radius:14px; border:1px solid var(--line);
  background:rgba(255,255,255,.04); color:var(--paper); cursor:pointer;
}
.pace-btn.active{ background:var(--violet); border-color:var(--violet); color:#fff; }

.ob-buttons-row{ display:flex; gap:10px; margin-top:18px; }
.ob-next, .ob-start{
  flex:1; font-family:'Nunito',sans-serif; font-weight:800; font-size:15px;
  padding:16px; border-radius:14px; border:none; background:var(--violet);
  color:#fff; cursor:pointer;
}
.ob-next:disabled, .ob-start:disabled{ opacity:.35; cursor:not-allowed; }
.ob-back{
  font-family:'Inter',sans-serif; font-size:14px; padding:16px 18px;
  border-radius:14px; border:1px solid var(--line); background:none; color:var(--dim); cursor:pointer;
}
.ob-back-wide{
  width:100%; margin-top:12px; font-family:'Inter',sans-serif; font-size:14px;
  padding:15px; border-radius:14px; border:1px solid var(--line); background:none;
  color:var(--dim); cursor:pointer;
}

/* ================= RETOMAR ================= */
.resume-wrap{ text-align:left; }
#btn-resume{ width:100%; margin-top:22px; }

/* ================= EL CAJÓN ================= */
.phone{
  width:340px; height:660px; max-width:92vw; max-height:88dvh;
  border-radius:42px; padding:14px;
  background: linear-gradient(180deg, #161c2c, #0d1320);
  box-shadow: 0 30px 60px rgba(0,0,0,.55), inset 0 0 0 1px rgba(255,255,255,.04);
  position:relative;
}
.screen-inner{
  width:100%; height:100%; border-radius:30px; overflow:hidden; position:relative;
  display:flex; flex-direction:column;
  background: var(--bg1);
  background-image: radial-gradient(120% 80% at 50% -10%, var(--bg2), transparent 60%);
  transition: background-color .8s ease;
}
.notch{
  position:absolute; top:8px; left:50%; transform:translateX(-50%);
  width:90px; height:18px; border-radius:10px; background:#0d1320; z-index:5;
}

.screen-inner[data-theme="manana"]{ --bg1:#16213a; --bg2:#27406b; --accent:#18c3d6; }
.screen-inner[data-theme="tarde"]{ --bg1:#181530; --bg2:#392c70; --accent:#6d5dfc; }
.screen-inner[data-theme="noche"]{ --bg1:#0d0e1a; --bg2:#241a3d; --accent:#9b8cff; }

/* ---- íconos de esquina: tema / instalar / salir ---- */
.corner-icons{
  position:absolute;
  top:12px;
  right:12px;
  z-index:6;
  display:flex;
  align-items:center;
  gap:8px;
}
.icon-btn,
.topic-icon-btn{
  width:34px;
  height:34px;
  border-radius:50%;
  border:none;
  cursor:pointer;
  background:rgba(255,255,255,.08);
  display:flex;
  align-items:center;
  justify-content:center;
}
.icon-btn svg{ width:15px; height:15px; fill:var(--paper); opacity:.84; }
#install-btn{ display:none; } /* se muestra solo si el navegador permite instalar */
#install-btn.show{ display:flex; }

.topbar{ padding:34px 166px 0 22px; min-height:82px; display:flex; justify-content:space-between; align-items:flex-start; gap:10px;}
.greeting .eyebrow{
  font-family:'IBM Plex Mono',monospace; font-size:10px; letter-spacing:.1em;
  color:var(--dim); text-transform:uppercase; margin:0 0 3px;
}
.greeting .name{
  font-family:'Nunito',sans-serif; font-weight:600; font-size:14px; line-height:1.12;
  color:var(--paper); margin:0;
}
.topic-chip{
  font-family:'IBM Plex Mono',monospace; font-size:9.5px; letter-spacing:.04em;
  color:var(--accent); border:1px solid color-mix(in srgb, var(--accent) 45%, transparent);
  background:none; border-radius:20px; padding:5px 10px; white-space:nowrap; cursor:pointer;
  max-width:120px; overflow:hidden; text-overflow:ellipsis;
}
.topic-icon-btn{
  color:var(--paper);
  border:1px solid var(--line);
  font-size:17px;
  line-height:1;
  padding:0;
  max-width:none;
  overflow:visible;
  text-overflow:clip;
}
.topic-icon-btn:hover,
.icon-btn:hover,
.shuffle-btn:hover{ background:rgba(255,255,255,.14); }

.phrase-zone{
  flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
  text-align:center; padding:8px 26px 0; gap:9px; min-height:0; overflow:hidden;
}
.es{ font-family:'Inter',sans-serif; font-weight:500; font-size:21px; color:var(--paper); margin:0; line-height:1.3; }
.en{ font-family:'Nunito',sans-serif; font-style:italic; font-weight:700; font-size:18px; color:var(--accent); margin:0; line-height:1.3; }
.dash{ color:var(--dim); font-size:13px; margin:2px 0; }
.progress-dots{ display:flex; gap:4px; margin-top:10px; flex-wrap:wrap; justify-content:center; max-width:220px;}
.progress-dots span{ width:4px; height:4px; border-radius:50%; background:var(--line); flex:0 0 auto; }
.progress-dots span.active{ background:var(--accent); width:12px; border-radius:3px; }
.rep-indicator{
  font-family:'IBM Plex Mono',monospace; font-size:10px; color:var(--dim); margin:4px 0 0; min-height:14px;
}

.transport-wrap{ display:flex; flex-direction:column; align-items:center; padding:6px 0 8px; }
.ring{ width:100px; height:100px; border-radius:50%; display:flex; align-items:center; justify-content:center; position:relative; margin-bottom:14px; }
.ring.playing::before, .ring.playing::after{
  content:""; position:absolute; inset:0; border-radius:50%;
  border:1.5px solid var(--accent); opacity:.45; animation: pulse 3.2s ease-out infinite;
}
.ring.playing::after{ animation-delay:1.1s; }
@keyframes pulse{ 0%{ transform:scale(.72); opacity:.5; } 100%{ transform:scale(1.25); opacity:0; } }
.play-btn{
  width:60px; height:60px; border-radius:50%; background:var(--accent); border:none;
  display:flex; align-items:center; justify-content:center;
  box-shadow:0 8px 22px color-mix(in srgb, var(--accent) 55%, transparent);
  cursor:pointer; position:relative; z-index:2;
}
.play-btn svg{ width:22px; height:22px; fill:#0d1320; }
.play-btn:not(.is-playing) svg{ margin-left:3px; }

.transport-row{ display:flex; align-items:center; gap:34px; margin-bottom:18px; }
.skip-btn{ background:none; border:none; cursor:pointer; padding:8px; opacity:.85; }
.skip-btn svg{ width:20px; height:20px; fill:var(--paper); }

.control-row{
  display:flex; flex-wrap:wrap; align-items:center; justify-content:center;
  padding:0 14px 16px; gap:8px 10px; row-gap:10px;
}
.mode-toggle{ display:flex; background:rgba(255,255,255,.06); border-radius:20px; padding:3px; flex:0 0 auto; }
.mode-toggle button{
  border:none; background:none; font-family:'IBM Plex Mono',monospace; font-size:10px;
  letter-spacing:.04em; padding:6px 9px; border-radius:16px; cursor:pointer; color:var(--dim);
}
.mode-toggle button.active{ background:var(--accent); color:#0d1320; }

.lang-toggle{ display:flex; background:rgba(255,255,255,.06); border-radius:20px; padding:3px; flex:0 0 auto; }
.lang-toggle button{
  border:none; background:none; font-family:'IBM Plex Mono',monospace; font-size:10px;
  letter-spacing:.04em; padding:6px 9px; border-radius:16px; cursor:pointer; color:var(--dim);
}
.lang-toggle button.active{ background:var(--violet); color:#fff; }

.shuffle-btn{
  width:32px; height:32px; border-radius:50%; border:1px solid var(--line); background:rgba(255,255,255,.04);
  display:flex; align-items:center; justify-content:center; cursor:pointer; flex:0 0 auto;
}
.shuffle-btn svg{ width:15px; height:15px; fill:var(--dim); }
.shuffle-btn.active{ background:var(--accent); border-color:var(--accent); }
.shuffle-btn.active svg{ fill:#0d1320; }

.poly-btn{
  width:32px; height:32px; border-radius:50%; border:1px solid var(--line); background:rgba(255,255,255,.04);
  display:flex; align-items:center; justify-content:center; cursor:pointer; flex:0 0 auto;
  font-size:15px; line-height:1; padding:0;
}
.poly-btn.active{ background:var(--violet); border-color:var(--violet); }
#vocab-btn.active{ background:var(--teal); border-color:var(--teal); }
.vocab-ej{
  font-family:'Nunito',sans-serif; font-style:italic; font-size:14px; font-weight:600;
  color:var(--dim); margin:2px 0 4px; text-align:center; line-height:1.3;
}

.poly-zone{ display:flex; flex-direction:column; gap:3px; width:100%; margin:0 0 4px; }
.poly-line{
  display:flex; align-items:flex-start; gap:9px; padding:6px 9px; border-radius:12px;
  border:1px solid transparent; transition:background .2s, opacity .2s, border-color .2s; opacity:.6;
}
.poly-line .poly-tag{
  font-family:'IBM Plex Mono',monospace; font-size:10px; letter-spacing:.06em; color:var(--dim);
  width:22px; flex:0 0 auto; padding-top:3px;
}
.poly-line .poly-text{ font-family:'Nunito',sans-serif; font-weight:700; font-size:14.5px; color:var(--paper); line-height:1.22; }
.poly-line[data-lang="es"] .poly-tag{ color:var(--teal); }
.poly-line.active{
  opacity:1; background:#1c2342; border-color:var(--violet);
}
.poly-line.active .poly-text{ font-weight:800; font-style:italic; color:#a99fff; font-size:16px; }
.poly-line.active .poly-tag{ color:var(--violet); }

.poly-chain-row{ display:flex; align-items:center; justify-content:center; gap:8px; margin:4px 14px 10px; flex-wrap:wrap; }
.poly-chain-label{ font-family:'IBM Plex Mono',monospace; font-size:9.5px; letter-spacing:.06em; color:var(--dim); }
.poly-chain{ display:flex; gap:5px; }
.poly-chain button{
  font-family:'IBM Plex Mono',monospace; font-size:10px; padding:5px 9px; border-radius:14px;
  border:1px solid var(--line); background:rgba(255,255,255,.04); color:var(--dim); cursor:pointer;
}
.poly-chain button.active{ background:var(--violet); border-color:var(--violet); color:#fff; }
.poly-chain button.no-voice{ border-style:dashed; opacity:.7; }
.poly-chain button.no-voice::after{ content:" ·muda"; font-size:8px; opacity:.8; }


.speed{ display:flex; align-items:center; gap:6px; flex:0 0 auto; }
.speed input[type=range]{ -webkit-appearance:none; width:72px; height:3px; border-radius:2px; background:var(--line); outline:none; }
.speed input[type=range]::-webkit-slider-thumb{
  -webkit-appearance:none; width:13px; height:13px; border-radius:50%;
  background:var(--accent); cursor:pointer; border:2px solid #0d1320;
}
.speed .val{ font-family:'IBM Plex Mono',monospace; font-size:10px; color:var(--accent); min-width:26px; }

.session-status{
  font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--dim);
  margin-top:14px; text-align:center; min-height:16px;
}

/* ================= AJUSTES RÁPIDOS ================= */
.settings-panel{
  display:none;
  position:fixed;
  inset:0;
  z-index:40;
  align-items:center;
  justify-content:center;
  padding:18px;
  background:rgba(5,9,18,.72);
  backdrop-filter:blur(8px);
}
.settings-panel.show{ display:flex; }
.settings-card{
  width:min(360px, 92vw);
  border-radius:24px;
  padding:20px;
  background:linear-gradient(180deg, #151c2d, #0d1320);
  border:1px solid var(--line);
  box-shadow:0 24px 60px rgba(0,0,0,.55);
  color:var(--paper);
}
.settings-head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
  margin-bottom:16px;
}
.settings-eyebrow{
  margin:0 0 4px;
  font-family:'IBM Plex Mono',monospace;
  font-size:10px;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:var(--cyan);
}
.settings-head h2{
  margin:0;
  font-family:'Nunito',sans-serif;
  font-size:24px;
  line-height:1.05;
}
.settings-close{
  width:34px;
  height:34px;
  border-radius:50%;
  border:1px solid var(--line);
  background:rgba(255,255,255,.05);
  color:var(--paper);
  font-size:24px;
  line-height:1;
  cursor:pointer;
}
.settings-section{
  display:flex;
  flex-direction:column;
  gap:7px;
  margin:12px 0;
}
.settings-section label{
  font-family:'Inter',sans-serif;
  font-size:13px;
  color:var(--dim);
}
.settings-section select{
  width:100%;
  border-radius:14px;
  border:1px solid var(--line);
  background:rgba(255,255,255,.06);
  color:var(--paper);
  padding:13px 14px;
  font-family:'Inter',sans-serif;
  font-size:14px;
  outline:none;
}
.settings-section select option{ color:#111827; }
.settings-primary,
.settings-secondary,
.settings-danger{
  width:100%;
  border-radius:14px;
  padding:14px;
  margin-top:10px;
  font-family:'Nunito',sans-serif;
  font-weight:800;
  font-size:14px;
  cursor:pointer;
}
.settings-primary{
  border:none;
  background:var(--violet);
  color:#fff;
}
.settings-secondary{
  border:1px solid var(--line);
  background:rgba(255,255,255,.04);
  color:var(--paper);
}
.settings-danger{
  border:1px solid rgba(255,120,120,.34);
  background:rgba(255,80,80,.08);
  color:#ffc3c3;
}
.settings-note{
  min-height:16px;
  margin:12px 2px 0;
  font-family:'IBM Plex Mono',monospace;
  font-size:10.5px;
  line-height:1.35;
  color:var(--dim);
}
.voice-status{
  margin:12px 0 4px;
  border:1px solid var(--line);
  border-radius:14px;
  padding:10px 12px;
  background:rgba(255,255,255,.04);
  color:var(--dim);
  font-family:'IBM Plex Mono',monospace;
  font-size:10.5px;
  line-height:1.35;
}
.voice-status.ok{ color:#b9ffd9; border-color:rgba(90,220,140,.28); }
.voice-status.warn{ color:#ffe0a6; border-color:rgba(255,190,90,.32); }
.voice-status.error{ color:#ffc3c3; border-color:rgba(255,120,120,.34); }

/* ================= AVISO DE ACTUALIZACIÓN ================= */
.update-toast{
  display:none; position:fixed; bottom:18px; left:50%; transform:translateX(-50%);
  background:var(--violet-deep); color:#fff; font-family:'Nunito',sans-serif; font-weight:700;
  font-size:13px; padding:12px 12px 12px 18px; border-radius:30px; align-items:center; gap:12px;
  box-shadow:0 12px 30px rgba(0,0,0,.4); z-index:50;
}
.update-toast.show{ display:flex; }
.update-toast button{
  font-family:'Nunito',sans-serif; font-weight:800; font-size:12px; background:#fff;
  color:var(--violet-deep); border:none; border-radius:20px; padding:8px 14px; cursor:pointer;
}

/* ================= RESPONSIVE ================= */
@media (max-width:400px){
  .phone{ width:94vw; height:90dvh; }
  .topbar{ padding-right:158px; }
}
@media (max-width:360px){
  .corner-icons{ gap:6px; }
  .icon-btn,
  .topic-icon-btn{
    width:31px;
    height:31px;
  }
  .topbar{ padding-right:144px; }
}
@media (max-height:680px){
  .phone{ height:90dvh; }
  .ring{ width:78px; height:78px; margin-bottom:8px; }
  .play-btn{ width:50px; height:50px; }
  .transport-row{ margin-bottom:10px; }
}
@media (min-width:900px){
  .phone{ width:380px; height:720px; }
}

/* ================= DASHBOARD / INICIO RÁPIDO ================= */
.dashboard-wrap{
  width:100%; max-width:400px; padding:32px 28px 40px; position:relative;
  display:flex; flex-direction:column; justify-content:center; gap:12px;
}
.dash-stats{
  display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin:8px 0 10px;
}
.dash-stat{
  min-height:72px; border:1px solid var(--line); border-radius:18px;
  background:rgba(255,255,255,.045); display:flex; flex-direction:column;
  align-items:center; justify-content:center; gap:4px; text-align:center;
}
.dash-stat strong{ font-family:'Nunito',sans-serif; font-size:23px; color:var(--paper); line-height:1; }
.dash-stat span{ font-family:'IBM Plex Mono',monospace; font-size:9px; color:var(--dim); text-transform:uppercase; letter-spacing:.06em; }
.ob-start.soft{ background:rgba(109,93,252,.18); border:1px solid rgba(109,93,252,.5); color:var(--paper); }
.dashboard-actions{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.dashboard-actions button:first-child{ grid-column:1 / -1; }
.dashboard-actions button{
  border:1px solid var(--line); background:rgba(255,255,255,.045); color:var(--paper);
  border-radius:14px; padding:14px 10px; font-family:'Nunito',sans-serif; font-weight:800; cursor:pointer;
}
.dashboard-actions button:hover{ background:rgba(255,255,255,.08); }

/* ================= MARCAS DE APRENDIZAJE ================= */
.phrase-actions{
  display:flex; gap:8px; justify-content:center; align-items:center; margin-top:0; margin-bottom:6px;
}
.phrase-actions button{
  width:32px; height:32px; border-radius:50%; border:1px solid var(--line);
  background:rgba(255,255,255,.045); color:var(--paper); cursor:pointer;
  display:flex; align-items:center; justify-content:center; font-family:'Nunito',sans-serif; font-weight:800;
}
.phrase-actions button.active{
  background:var(--accent); border-color:var(--accent); color:#0d1320;
  box-shadow:0 8px 18px color-mix(in srgb, var(--accent) 35%, transparent);
}
.phrase-actions button:hover{ background:rgba(255,255,255,.12); }
.phrase-actions button.active:hover{ background:var(--accent); }



/* ================= ACERCA DE ================= */
.about-panel{
  display:none;
  position:fixed;
  inset:0;
  z-index:44;
  align-items:center;
  justify-content:center;
  padding:18px;
  background:rgba(5,9,18,.74);
  backdrop-filter:blur(8px);
}
.about-panel.show{ display:flex; }
.about-card{
  width:min(340px,92vw);
  position:relative;
  border-radius:24px;
  padding:22px;
  background:linear-gradient(180deg,#151c2d,#0d1320);
  border:1px solid var(--line);
  box-shadow:0 24px 60px rgba(0,0,0,.55);
  color:var(--paper);
  text-align:left;
}
.about-card .brand-mark{ margin:0 0 10px; }
.about-card h2{
  margin:4px 0 8px;
  font-family:'Nunito',sans-serif;
  font-size:25px;
  line-height:1.08;
}
.about-card p:not(.settings-eyebrow){
  margin:0 0 14px;
  color:var(--dim);
  font-size:14px;
  line-height:1.45;
}
.about-close{
  position:absolute;
  top:14px;
  right:14px;
  width:34px;
  height:34px;
  border-radius:50%;
  border:1px solid var(--line);
  background:rgba(255,255,255,.05);
  color:var(--paper);
  font-size:24px;
  line-height:1;
  cursor:pointer;
}

/* ================= RESUMEN DE SESIÓN ================= */
.summary-panel{
  display:none; position:fixed; inset:0; z-index:45; align-items:center; justify-content:center;
  padding:18px; background:rgba(5,9,18,.74); backdrop-filter:blur(8px);
}
.summary-panel.show{ display:flex; }
.summary-card{
  width:min(360px,92vw); border-radius:24px; padding:22px;
  background:linear-gradient(180deg,#151c2d,#0d1320); border:1px solid var(--line);
  box-shadow:0 24px 60px rgba(0,0,0,.55); color:var(--paper); text-align:left;
}
.summary-card h2{ margin:4px 0 8px; font-family:'Nunito',sans-serif; font-size:26px; line-height:1.1; }
.summary-copy{ color:var(--dim); margin:0 0 14px; font-size:14px; line-height:1.5; }
.summary-stats{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin:10px 0 12px; }
.summary-stats span{
  border:1px solid var(--line); border-radius:14px; padding:12px 8px; text-align:center;
  font-family:'IBM Plex Mono',monospace; font-size:10px; color:var(--dim); background:rgba(255,255,255,.04);
}
@media (max-width:360px){
  .dash-stats{ grid-template-columns:repeat(2,1fr); }
  .phrase-actions button{ width:30px; height:30px; }
}
.settings-card{ max-height:92dvh; overflow:auto; }


/* ================= CONFIRMACIÓN BREVE ================= */
.app-toast{
  position:fixed; left:50%; bottom:22px; transform:translate(-50%, 16px);
  z-index:80; min-width:180px; max-width:86vw;
  padding:11px 16px; border-radius:999px;
  background:rgba(244,246,251,.96); color:#0d1320;
  font-family:'Nunito',sans-serif; font-size:13px; font-weight:800; text-align:center;
  box-shadow:0 16px 38px rgba(0,0,0,.26);
  opacity:0; pointer-events:none; transition:opacity .18s ease, transform .18s ease;
}
.app-toast.show{ opacity:1; transform:translate(-50%, 0); }
@media (max-width:480px){ .app-toast{ bottom:14px; } }
