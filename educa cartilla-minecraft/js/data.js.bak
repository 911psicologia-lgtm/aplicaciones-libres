//   BIOMAS (5 originales + 1 para COMPLEJO)
// ═══════════════════════════════════════════
const BIOMES=[
  {id:'ingles',   n:'Océano del\nSaber',   ico:'🌊',cls:'bc-i',mns:['Vocabulario Visual','Diálogos','Fill in Blank','Reading Comprehension']},
  {id:'lenguaje', n:'Bosque de\nLetras',   ico:'🌲',cls:'bc-l',mns:['Textos Informativos','Escritura','Comprensión','Lenguaje Contextual']},
  {id:'matematicas',n:'Mina de\nDiamantes',ico:'⛏️',cls:'bc-m',mns:['Problemas y Medidas','Estadística','Fracciones','Geometría']},
  {id:'ciencias', n:'Selva\nViva',         ico:'🌿',cls:'bc-c',mns:['Reinos y Ecosistemas','Salud y Fuerzas','Movimientos','Máquinas Simples']},
  {id:'sociales', n:'Aldea del\nTiempo',   ico:'🏔️',cls:'bc-s',mns:['Prehistoria','Conquista y Colombia','Gobierno','Democracia']},
  {id:'inteligencia_emocional',n:'Valle de las\nEmociones',ico:'🌈',cls:'bc-e',mns:['Reconocer Emociones','Empatía y Comunicación','Resolución de Conflictos','Auto-regulación']}
];

// ── INSIGNIAS ──
const BADGES=[
  {id:'first', ico:'🥇',n:'Primer Bloque',d:'Completaste tu primera misión',c:p=>p.tm>=1},
  {id:'diam',  ico:'💎',n:'Diamante',d:'3 estrellas en cualquier misión',c:p=>(p.pm||0)>=1},
  {id:'fire',  ico:'🔥',n:'En Llamas',d:'3 días seguidos practicando',c:p=>(p.streak||0)>=3},
  {id:'mine',  ico:'⛏️',n:'Minero',d:'Ganaste 50 XP',c:p=>p.xp>=50},
  {id:'champ', ico:'🏆',n:'Campeón',d:'Ganaste 200 XP',c:p=>p.xp>=200},
  {id:'aim',   ico:'🎯',n:'Puntería',d:'10 correctas seguidas',c:p=>(p.mc||0)>=10},
  {id:'extra', ico:'⚡',n:'Extra Power',d:'Completaste un MODO EXTRA',c:p=>(p.ed||0)>=1},
  {id:'adv',   ico:'🌍',n:'Aventurero',d:'Completaste 10 misiones',c:p=>p.tm>=10},
  {id:'king',  ico:'👑',n:'Rey del SAI',d:'Completaste todos los 5 mundos',c:p=>(p.bc||0)>=5},
  {id:'mago',  ico:'🧙',n:'Mago del Saber',d:'Alcanzaste el nivel 3',c:p=>(p.level||1)>=3},
  {id:'sabio', ico:'📚',n:'Erudito',d:'3 estrellas en todas las misiones de un mundo',c:p=>{let ok=false;BIOMES.slice(0,5).forEach(b=>{let all3=true;for(let i=0;i<4;i++){if((p.prog[b.id+'_'+i]?.stars||0)<3)all3=false}if(all3)ok=true});return ok}},
  {id:'survivor',ico:'💀',n:'Sobreviviente',d:'Completa una misión con solo 1 vida',c:p=>(p.surv||0)>=1},
  {id:'medio_star',ico:'🌟',n:'Explorador Medio',d:'Completa todas las misiones de un mundo en nivel MEDIO',c:p=>{let ok=false;for(let b=0;b<5;b++){const bid=['ingles','lenguaje','matematicas','ciencias','sociales'][b];let all4=true;for(let i=0;i<4;i++){if(!P.prog[bid+'_medio_'+i]?.done)all4=false}if(all4)ok=true}return ok}},
  {id:'complejo_star',ico:'💎',n:'Maestro Complejo',d:'Completa todas las misiones de un mundo en nivel COMPLEJO',c:p=>{let ok=false;for(let b=0;b<5;b++){const bid=['ingles','lenguaje','matematicas','ciencias','sociales'][b];let all4=true;for(let i=0;i<4;i++){if(!P.prog[bid+'_complejo_'+i]?.done)all4=false}if(all4)ok=true}return ok}},
  {id:'refuerzo',ico:'🔄',n:'Refuerzo Maestro',d:'Completa un mundo de refuerzo sin errores',c:p=>(p.refM||0)>=1},
  {id:'ie_master',ico:'🌈',n:'Arcoíris Interior',d:'Completa el Valle de las Emociones',c:p=>{let ok=true;for(let i=0;i<4;i++){if(!P.prog['inteligencia_emocional_complejo_'+i]?.done)ok=false}return ok}},
  {id:'tri_level',ico:'🏆',n:'Tri-Campeón',d:'Completa un mundo en los 3 niveles de dificultad',c:p=>{let ok=false;for(let b=0;b<5;b++){const bid=['ingles','lenguaje','matematicas','ciencias','sociales'][b];let hasBas=true,hasMed=true,hasCom=true;for(let i=0;i<4;i++){if(!P.prog[bid+'_'+i]?.done)hasBas=false;if(!P.prog[bid+'_medio_'+i]?.done)hasMed=false;if(!P.prog[bid+'_complejo_'+i]?.done)hasCom=false}if(hasBas&&hasMed&&hasCom)ok=true}return ok}}
];

