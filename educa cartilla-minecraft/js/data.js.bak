// ═══════════════════════════════════════════
//   SAI QUEST — Datos, Preguntas e Ilustraciones
// ═══════════════════════════════════════════

// ── PREGUNTAS BÁSICAS (QD — NO MODIFICAR) ──
const QD={
ingles:[
  {q:"📸 Imagen: niño con cabello muy oscuro y rizado. ¿Qué tipo de cabello tiene?",o:["curly","straight","blonde"],a:0,tip:"Curly = rizado. Cabello en espiral y ondulado.",img:"curly_hair"},
  {q:"📸 Imagen: niña con cabello liso, lacio y de color amarillo dorado. ¿Qué tipo de cabello tiene?",o:["curly","straight","blonde"],a:2,tip:"Blonde = rubio. Color dorado/amarillo claro.",img:"blonde_hair"},
  {q:"📸 Imagen: niña con cabello marrón liso, sin ondas ni rizos. ¿Qué tipo de cabello tiene?",o:["curly","straight","blonde"],a:1,tip:"Straight = lacio. Sin ondas ni rizos.",img:"straight_brown"},
  {q:"📸 Señal: círculo rojo con una taza tachada. Texto: NO FOOD OR DRINK. ¿Dónde encontrarías este aviso?",o:["in a hospital","in a library","in a park"],a:1,tip:"En una biblioteca (library) no se permite comer ni beber.",img:"no_food_sign"},
  {q:"📸 Señal: cruz verde con la palabra EMERGENCY. ¿Dónde encontrarías este aviso?",o:["in a hospital","in a library","in a park"],a:0,tip:"Emergency (emergencia) es señal de hospitales o clínicas.",img:"emergency_sign"},
  {q:"📸 Señal: límite de estatura 'YOU MUST BE THIS TALL'. ¿Dónde encontrarías este aviso?",o:["in a hospital","in a library","in a park"],a:2,tip:"Esta señal se usa en parques con juegos o de diversiones.",img:"height_sign"},
  {q:"Alguien dice: 'Can you lend me a pen, please?' ¿Cuál es la respuesta correcta?",o:["Here you are!","Thank you!","You shouldn't eat fast food."],a:0,tip:"'Here you are' se dice cuando le das algo a alguien.",img:"dialogue_lend"},
  {q:"Alguien dice: 'I am too fat.' ¿Cuál es la respuesta más adecuada?",o:["Here you are!","Thank you!","You shouldn't eat fast food."],a:2,tip:"Cuando alguien dice que está gordo, el consejo es no comer comida rápida.",img:"dialogue_fat"},
  {q:"Alguien dice: 'You are so nice!' ¿Cuál es la respuesta correcta?",o:["Here you are!","Thank you!","You shouldn't eat fast food."],a:1,tip:"Cuando alguien te hace un cumplido, respondes 'Thank you!'",img:"dialogue_nice"},
  {q:"Harry ___ his grades very important. (Elige el verbo correcto)",o:["think","thinks","thinking"],a:1,tip:"Con 'he/she/it' el verbo lleva -S: thinks (tercera persona singular).",img:"grammar_harry"},
  {q:"Harry thinks his grades ___ very important.",o:["am","is","are"],a:1,tip:"'Grades' en concepto singular → usa IS.",img:"grammar_harry2"},
  {q:"He studies ___ the library.",o:["at","on","of"],a:0,tip:"Se dice 'at the library'. AT se usa para lugares específicos.",img:"library"},
  {q:"He studies when he goes ___ to eat.",o:["in","out","under"],a:1,tip:"'Goes out to eat' = sale a comer. OUT es la preposición correcta.",img:"eat_out"},
  {q:"His friends ___ fun of him.",o:["make","makes","making"],a:0,tip:"'Friends' es plural → el verbo no lleva -s: MAKE.",img:"friends_mock"},
  {q:"Harry ___ not care. He gets As all the time.",o:["can","do","does"],a:2,tip:"Con 'he/she/it' la negación usa DOES: Harry does not care.",img:"grammar_does"},
  {q:"📖 'SHE BRINGS LUNCH FROM HOME'. In the picture, the girl in yellow dress is:",o:["fat","thin","heavy"],a:1,tip:"La imagen muestra una niña delgada. Thin = delgado/a.",img:"lunch_girl"},
  {q:"📖 What fruit can you see in the picture of the lunch story?",o:["an apple","a banana","a watermelon"],a:0,tip:"En la imagen del almuerzo se ve una manzana (apple).",img:"apple_fruit"},
  {q:"📖 'Her mom is a good chef.' What does Melany's mother do?",o:["She is a teacher.","She is a doctor.","She is a chef."],a:2,tip:"El texto dice 'her mom is a good chef' = su mamá es chef.",img:"chef"},
  {q:"📖 What does Melanie sometimes prepare for school lunch?",o:["sandwiches","cooked meals","scrambled eggs"],a:0,tip:"El texto dice: 'Sometimes she makes a sandwich.'",img:"sandwich"},
  {q:"📖 Melanie's friends are jealous because:",o:["school lunch is free.","her lunch is delicious.","they fight a lot."],a:1,tip:"El texto dice 'It smells so good'. Son celosos de su almuerzo rico.",img:"jealous_friends"},
  {q:"Fill in the blank: 'She ___ to school every day.'",o:["go","goes","going"],a:1,tip:"Con 'she' (3ª persona singular) el verbo lleva -s: goes.",img:"school_go"},
  {q:"What does the word 'PUSH' mean in Spanish?",o:["Empujar","Jalar","Parar"],a:0,tip:"PUSH = empujar. PULL = jalar.",img:"push_pull"},
  {q:"'The book is ___ the table.' Choose the correct preposition.",o:["in","on","under"],a:1,tip:"ON = encima de. El libro está SOBRE la mesa = ON the table.",img:"book_on_table"},
  {q:"What is the plural of 'child'?",o:["childs","children","childrens"],a:1,tip:"'Children' es el plural irregular de 'child'. Es una excepción.",img:"children"},
  {q:"Which of these words describes a type of WEATHER?",o:["happy","rainy","hungry"],a:1,tip:"Rainy = lluvioso. Happy = feliz. Hungry = hambriento.",img:"weather"}
],
lenguaje:[
  {q:"Las noticias son textos informativos porque:",o:["narran historias de personajes fantásticos.","solo comparten información poética.","presentan hechos reales de manera objetiva.","indican los pasos para alcanzar un objetivo."],a:2,tip:"Los textos informativos presentan hechos reales y verificables.",img:"news"},
  {q:"El texto sobre textos informativos pretende principalmente:",o:["indicar por qué son importantes.","explicar cómo escribir uno.","contar una historia.","definir qué es un texto informativo y dar ejemplos."],a:3,tip:"El texto define y ejemplifica (noticias, cartas, afiches). Propósito explicativo.",img:"informative"},
  {q:"¿Cuál de estos textos pertenece al tipo INFORMATIVO?",o:["Un cuento sobre un perro que salva a su dueño","Una descripción de un paisaje tropical","Un cartel que explica la importancia de lavarse las manos","Una columna de opinión sobre el calentamiento global"],a:2,tip:"El cartel informativo da información verdadera y objetiva.",img:"text_types"},
  {q:"📸 Afiche: '¡LAVARTE LAS MANOS es tu superpoder!' ¿Qué acción promueve este afiche?",o:["Usar superpoderes para combatir el crimen.","Lavarse las manos para combatir los microbios.","Lavar la ropa para mantenerla limpia.","Visitar un sitio web."],a:1,tip:"El afiche anima a lavarse las manos para eliminar microbios.",img:"wash_hands_poster"},
  {q:"El afiche '¡Lávate las manos!' ¿Para quién está dirigido?",o:["Para las personas","Para los gérmenes y bacterias","Para los dibujos animados","Para los superhéroes"],a:0,tip:"El mensaje es para las personas: les aconseja lavarse las manos.",img:"audience"},
  {q:"Para escribir sobre 'El parque principal será renovado', ¿qué harías PRIMERO?",o:["Dibujar cómo te gustaría el parque.","Buscar información sobre los planes de renovación.","Escribir todo lo que recuerdas.","Leer otras noticias sobre parques."],a:1,tip:"Para texto informativo, primero se busca información real y verificable.",img:"research"},
  {q:"María necesita estudiar animales. ¿Cuál estrategia organiza mejor la información?",o:["Hacer un esquema con las características de los animales.","Contar una historia sobre un animal fantástico.","Dibujar un paisaje con animales.","Escribir un poema sobre los animales."],a:0,tip:"Un esquema organiza información visualmente y facilita la memoria.",img:"outline"},
  {q:"Al leer 'El Zorro y la Cigüeña', ¿a qué género pertenece?",o:["periodístico, porque informa hechos reales.","poético, porque usa rima y ritmo.","narrativo, porque cuenta una historia con personajes.","instructivo, porque explica cómo hacer algo."],a:2,tip:"Es narrativo: tiene personajes, acciones y desenlace.",img:"fox_crane_genre"},
  {q:"¿Qué tipo de texto literario es 'El Zorro y la Cigüeña'?",o:["Relato mitológico (dioses y héroes)","Leyenda (hechos reales y ficticios)","Cuento (narración breve de ficción)","Fábula (historia corta con animales y enseñanza)"],a:3,tip:"La fábula tiene animales como personajes y termina con una moraleja.",img:"fabula"},
  {q:"¿Cuál es la moraleja de la fábula 'El Zorro y la Cigüeña'?",o:["No debemos confiar en los demás.","Es importante compartir con los amigos.","No hagas a los demás lo que no quisieras que te hicieran.","La honestidad es la mejor política."],a:2,tip:"La moraleja dice: 'No hagas a los demás lo que no quieres que te hagan a ti.'",img:"moraleja"},
  {q:"📸 ¿Cuál imagen representa mejor la historia del Zorro y la Cigüeña?",o:["Zorro y cigüeña con platos planos y botellones altos","Cigüeña en árbol y zorro abajo","Animales corriendo en el bosque","Zorro y cigüeña nadando en río"],a:0,tip:"La historia: cena 1 en platos planos (del zorro), cena 2 en botellones altos (de la cigüeña).",img:"fox_crane_visual"},
  {q:"¿Dónde sucedió la historia de 'El Zorro y la Cigüeña'?",o:["En un río.","En la casa del zorro y en la casa de la cigüeña.","En una montaña.","En el polo norte."],a:1,tip:"La 1ª cena es en casa del zorro; la 2ª, en casa de la cigüeña.",img:"houses"},
  {q:"María quiere contarle a su clase sobre su visita al zoológico. ¿Primer paso?",o:["Dibujar un mapa del zoológico.","Buscar información en internet sobre zoológicos.","Escribir una historia ficticia sobre animales.","Hacer una lista de los animales que vio y lo que le gustó."],a:3,tip:"Antes de hablar o escribir, organiza la información: qué viste, qué te gustó.",img:"zoo_list"},
  {q:"📸 Aviso: 'SE VENDEN huevos frescos — LA DOCENA POR ___'. La imagen nos presenta una:",o:["fábula","publicidad","instrucción","orden"],a:1,tip:"Es un aviso publicitario (publicidad) que quiere vender huevos.",img:"eggs_ad"},
  {q:"En el aviso 'SE VENDEN huevos frescos', ¿qué dato va en el espacio en blanco?",o:["La cantidad de huevos que se venden.","Los tamaños de los huevos.","El precio de los huevos.","La ubicación del negocio."],a:2,tip:"El espacio está después de 'LA DOCENA POR', así que falta el PRECIO.",img:"price_blank"},
  {q:"'SE VENDEN huevos frescos' puede ser reemplazado por:",o:["Compre huevos frescos en este lugar","Los huevos frescos son baratos","¿Te gustan los huevos frescos?","Los huevos frescos se regalan aquí"],a:0,tip:"'Se venden' = están disponibles para comprar. La opción A lo expresa igual.",img:"rewrite"},
  {q:"En una exposición, ¿cuál es el comportamiento correcto para respetar turnos?",o:["Hablar más fuerte para que te escuchen.","Decir que tu idea es más importante.","Ignorar a los demás y seguir con tu idea.","Esperar tu turno para expresar tu opinión."],a:3,tip:"Respetar turnos = escuchar a los demás antes de hablar.",img:"turns"},
  {q:"📖 'Dulce es una gata encantadora y traviesa, de pelaje blanco...' El párrafo es de tipo:",o:["descriptivo","poético","dialógico","narrativo"],a:0,tip:"Describe características físicas y de comportamiento = texto descriptivo.",img:"cat_dulce"},
  {q:"¿Cuál opción reescribe mejor 'Dulce es una gata encantadora y traviesa'?",o:["Dulce es una gata tranquila y perezosa.","Dulce es una gata adorable y juguetona.","Dulce es una gata ruidosa y molesta.","Dulce es una gata silenciosa y tímida."],a:1,tip:"Encantadora ≈ adorable. Traviesa ≈ juguetona. Mismo significado.",img:"synonyms"},
  {q:"📸 Dulce: 'pelaje blanco como la nieve, orejas y cola grises'. ¿Cuál imagen la representa?",o:["Gato completamente negro","Gato gris oscuro tumbado","Gato blanco con puntos claros","Gato negro/siamés con ojos azules"],a:2,tip:"Blanco como la nieve con orejas grises = gato blanco (opción C).",img:"white_cat"},
  {q:"Un texto INSTRUCTIVO tiene como propósito principal:",o:["entretener al lector","informar sobre hechos reales","indicar los pasos para hacer algo","expresar sentimientos del autor"],a:2,tip:"Los textos instructivos (recetas, manuales) explican cómo hacer algo paso a paso.",img:"instructivo"},
  {q:"¿Qué es una MORALEJA?",o:["El título de la fábula","La enseñanza o lección al final de la historia","El nombre del personaje principal","El lugar donde ocurre la historia"],a:1,tip:"La moraleja es la enseñanza que deja la fábula al terminar.",img:"moraleja_def"},
  {q:"Un afiche publicitario debe tener principalmente:",o:["muchas páginas con detalles","rima y ritmo como un poema","un mensaje claro y breve","capítulos numerados"],a:2,tip:"Los afiches comunican en pocas palabras. Mensaje claro y visible.",img:"afiche"},
  {q:"En un texto DESCRIPTIVO, el autor principalmente:",o:["da instrucciones paso a paso","describe características de algo o alguien","narra una historia con inicio y final","da su opinión personal"],a:1,tip:"Describir = mencionar cómo es algo: forma, color, tamaño, comportamiento.",img:"descriptivo"},
  {q:"Los conectores 'porque', 'pero', 'y' sirven para:",o:["terminar una oración","unir y relacionar ideas en un texto","separar párrafos","iniciar un diálogo"],a:1,tip:"Los conectores unen ideas. 'Y' suma, 'pero' contrasta, 'porque' explica causa.",img:"conectores"}
],
matematicas:[
  {q:"📸 Sara ayuda a su mamá y recorre en bicicleta: 20m, luego 500cm, luego 650cm, luego 60m y finalmente 40m para volver a casa. ¿Cuántos metros recorrió en total?",o:["130 m","125 m","131,5 m","145,4 m"],a:2,tip:"Primero convierte a metros: 500cm=5m y 650cm=6,5m. Luego suma todo: 20+5+6,5+60+40 = 131,5m.",img:"distance"},
  {q:"📸 Observa la secuencia de cuadrados de colores en 4 posiciones. Cuenta los cuadrados en cada posición: ¿cuántos cuadrados nuevos se agregan de una posición a la siguiente?",o:["Se suman 6 cuadrados en cada posición.","Se restan 8 cuadrados en cada posición.","Se restan 6 cuadrados en cada posición.","Se suman 12 cuadrados en cada posición."],a:0,tip:"Pos 1=6, Pos 2=12, Pos 3=18, Pos 4=24. La diferencia siempre es +6 cuadrados.",img:"block_pattern"},
  {q:"Si la secuencia sigue el mismo patrón (suma 6 cada vez), ¿cuántos cuadrados habrá en la posición 7?",o:["36","42","48","54"],a:1,tip:"Pos 1=6, Pos 2=12... cada posición suma 6. Posición 7 = 6×7 = 42 cuadrados.",img:"pattern_calc"},
  {q:"📸 Luisa pone 20 bombones en la mesa: 7 de fresa, 3 de mango, 6 de mora y 4 de menta. ¿Qué fracción de los bombones NO son de mora?",o:["3/10","7/20","1/5","7/10"],a:3,tip:"Los que NO son mora: 20−6=14. Fracción = 14/20 = 7/10.",img:"candies"},
  {q:"📸 Observa la puerta abierta en la imagen. El profesor dibujó los ángulos en el tablero: recto=90°, agudo<90°, obtuso>90°. Ana dice que la puerta forma un ángulo menor a 90°. ¿Es correcta Ana?",o:["Sí, es un ángulo agudo.","No, es un ángulo obtuso.","Sí, es un ángulo llano.","No, es un ángulo recto."],a:1,tip:"La puerta está abierta más de 90°, por lo tanto es un ángulo OBTUSO. Ana se equivoca.",img:"door_angle"},
  {q:"📊 Camilo hizo una encuesta sobre el helado preferido de sus compañeros. Mira la tabla: Chocolate=11, Vainilla=5, Mora=7, Fresa=4, Maracuyá=2. ¿Cuál es el sabor más preferido?",o:["Mora","Fresa","Vainilla","Chocolate"],a:3,tip:"Chocolate tiene 11 votos, es el número más alto de la tabla.",img:"flavor_table"},
  {q:"📊 ¿Cuál gráfica de barras representa CORRECTAMENTE los datos de la tabla? (Chocolate=11, Vainilla=5, Mora=7, Fresa=4, Maracuyá=2)",o:["Gráfica A: Choc≈11, Vain≈8, Mora≈6","Gráfica B: Choc≈10, Vain≈4, Mora≈8","Gráfica C: Choc=11, Vain=5, Mora=7, Fresa=4, Maracuyá=2","Gráfica D: Choc≈5, Vain≈11, Mora=7"],a:2,tip:"Solo la Gráfica C tiene TODOS los valores correctos: Choc=11, Vain=5, Mora=7, Fresa=4, Maracuyá=2.",img:"bar_chart"},
  {q:"📸 Andrés y Camilo tienen un juego con figuras geométricas que tienen un valor cada una: octágono=4, cuadrado=5, triángulo=7, círculo=1. Camilo planta esta operación: (triángulo + círculo) − (cuadrado − octágono). ¿Qué figura obtiene?",o:["Cuadrado (valor 5)","Triángulo (valor 7)","Círculo (valor 1)","Octágono (valor 4)"],a:1,tip:"Paso 1: (7+1)=8. Paso 2: (5−4)=1. Paso 3: 8−1=7. El triángulo vale 7.",img:"shape_game"},
  {q:"📸 Observa la secuencia de años: 2003, 2006, 2009, 2012, 2015, ___, 2021, 2024. El Parque Chiribiquete fue declarado Patrimonio de la Humanidad en el año que falta. ¿Cuál es ese año?",o:["2018","2020","2009","2021"],a:0,tip:"Cada año suma 3: 2003→2006→2009→2012→2015→2018. La respuesta es 2018.",img:"year_sequence"},
  {q:"📸 Carlos pintó sobre una hoja con forma de pentágono y marcó con bolitas los VÉRTICES (las esquinas) de la hoja. ¿Cuál imagen muestra correctamente un pentágono con sus vértices marcados?",o:["Figura con 4 puntos (rombo)","Figura con 4 ángulos (rectángulo)","Pentágono de 5 lados SIN puntos","Pentágono de 5 lados con 5 puntos en las esquinas"],a:3,tip:"Un pentágono tiene 5 lados y 5 vértices. Solo la opción D muestra los 5 puntos.",img:"pentagon"},
  {q:"📸 Observa el bosque con animales. Hay 10 animales en total: 2 leones, 3 tigres, 3 ardillas, 1 ciervo y 1 conejo. ¿Qué fracción representan los leones del total?",o:["1/10","1/5","7/10","3/10"],a:1,tip:"2 leones de 10 animales = 2/10. Simplificando: 2÷2/10÷2 = 1/5.",img:"forest_animals"},
  {q:"Alguien dice: 'La fracción de leones y la fracción de tigres son iguales'. Observando la imagen del bosque (2 leones y 3 tigres de 10 animales), ¿es correcta esa afirmación?",o:["Sí, porque la cantidad de leones y tigres es la misma.","No, porque hay 2 leones (2/10) y 3 tigres (3/10), son diferentes.","Sí, porque hay dos leones y dos tigres.","No, porque hay más ardillas que leones y tigres."],a:1,tip:"Leones = 2/10 = 1/5. Tigres = 3/10. Como 1/5 ≠ 3/10, las fracciones NO son iguales.",img:"fractions_compare"},
  {q:"📊 Luisa observa aves cada día y registra los datos en un pictograma donde CADA DIBUJO de pájaro equivale a 3 aves. Lunes=3 dibujos, Martes=2, Miércoles=1, Jueves=4, Viernes=1. ¿Qué días observó la MISMA cantidad de aves?",o:["Lunes y miércoles","Martes y jueves","Viernes y lunes","Miércoles y viernes"],a:3,tip:"Miércoles: 1×3=3 aves. Viernes: 1×3=3 aves. Ambos días vio 3 aves.",img:"pictogram",birdRef:true},
  {q:"📊 Usando el mismo pictograma (cada dibujo = 3 aves), ¿cuántas aves observó Luisa EN TOTAL durante la semana?",o:["16","33","30","11"],a:1,tip:"Lunes: 3×3=9, Martes: 2×3=6, Miércoles: 1×3=3, Jueves: 4×3=12, Viernes: 1×3=3. Total: 9+6+3+12+3=33.",img:"pictogram_total",birdRef:true},
  {q:"📊 El pictograma muestra aves observadas por día (cada dibujo = 3 aves). ¿Cuál tabla tiene los valores CORRECTOS de aves reales?",o:["L=9, M=6, Mi=3, J=12, V=3","L=3, M=2, Mi=1, J=4, V=1","L=3, M=6, Mi=3, J=12, V=1","L=12, M=6, Mi=3, J=4, V=1"],a:0,tip:"Multiplica cada dibujo por 3: L(3×3=9), M(2×3=6), Mi(1×3=3), J(4×3=12), V(1×3=3).",img:"bird_table",birdRef:true},
  {q:"📸 Sara medía 93 cm hace 2 años. Este año el médico le dijo que creció 17 cm. ¿Cuánto mide Sara ahora?",o:["100 cm","120 cm","110 cm","130 cm"],a:2,tip:"Estatura actual = lo que medía + lo que creció = 93 + 17 = 110 cm.",img:"height_calc"},
  {q:"📸 Laura creó un logo dentro de un rectángulo de 9 cm de ancho por 7 cm de alto. Dentro hay un triángulo blanco recortado (base 3 cm, altura 6 cm) y un triángulo azul agregado (base 2 cm, altura 5 cm). ¿Cuál es el área de la región azul del logo?",o:["70 cm²","60 cm²","59 cm²","40 cm²"],a:2,tip:"Rectángulo: 9×7=63. Triángulo blanco (se resta): (3×6)/2=9. Triángulo azul (se suma): (2×5)/2=5. Azul = 63−9+5 = 59 cm².",img:"logo_area"},
  {q:"📸 Danna quiere cubrir una pared con cuadros de arte. La pared tiene una cuadrícula de 5 columnas por 8 filas. ¿Cuántos cuadros puede poner sin sobreponerlos?",o:["40","36","45","50"],a:0,tip:"5 columnas × 8 filas = 40 cuadros en total.",img:"wall_grid"},
  {q:"Martín, Carlos y Sara siembran café en tres terrenos iguales: Martín siembra 3/5, Carlos 9/20 y Sara 6/10 de su terreno. ¿Quién o quiénes sembraron MÁS café?",o:["Martín","Sara y Carlos","Carlos","Martín y Sara"],a:3,tip:"Convierte todas a vigésimos: Martín=12/20, Carlos=9/20, Sara=12/20. Martín y Sara empatan con más café.",img:"fractions_coffee"},
  {q:"📊 Según el pictograma de aves (cada dibujo = 3 aves), ¿cuál es el MEJOR día para salir a observar aves?",o:["Lunes","Jueves","Miércoles","Viernes"],a:1,tip:"Jueves tiene 4 dibujos × 3 = 12 aves. Es el día con más aves observadas.",img:"best_day",birdRef:true},
  {q:"¿Cuánto es 3/4 + 1/4?",o:["1 entero","2/4","4/8","1/2"],a:0,tip:"3/4 + 1/4 = 4/4 = 1 entero.",img:"fraction_add"},
  {q:"Un rectángulo tiene 6 cm de largo y 4 cm de ancho. ¿Cuál es su área?",o:["10 cm²","20 cm²","24 cm²","48 cm²"],a:2,tip:"Área = largo × ancho = 6 × 4 = 24 cm².",img:"rectangle_area"},
  {q:"¿Qué número sigue en la secuencia? 2, 5, 8, 11, ___",o:["12","14","13","15"],a:1,tip:"El patrón suma 3 cada vez: 11 + 3 = 14.",img:"sequence"},
  {q:"En una clase de 30 estudiantes, 1/3 usa gafas. ¿Cuántos estudiantes usan gafas?",o:["3","10","15","20"],a:1,tip:"1/3 de 30 = 30 ÷ 3 = 10 estudiantes.",img:"glasses"},
  {q:"¿Cuál ángulo es MAYOR que 90°?",o:["Ángulo agudo","Ángulo recto (90°)","Ángulo obtuso","Ninguno"],a:2,tip:"Obtuso > 90°. Agudo < 90°. Recto = exactamente 90°.",img:"angles"}
],
ciencias:[
  {q:"📸 Grupo 3: Helecho, Pino, Rosal, Musgo, Musgo. ¿A qué reino pertenece el Grupo 3?",o:["Reino Animalia (Animales)","Reino Fungi (Hongos)","Reino Plantae (Plantas)","Reino Protista (Protozoos)"],a:2,tip:"Helechos, pinos, rosales y musgos son plantas → Reino Plantae.",img:"plantae"},
  {q:"📸 Imagen 1=selva, 2=laguna, 3=desierto frío, 4=tiburón en mar. ¿Cuál clasificación es correcta?",o:["1:Selva · 2:Agua dulce · 3:Desierto frío · 4:Agua salada","1:Bosque · 2:Agua salada · 3:Desierto cálido · 4:Agua dulce","1:Selva · 2:Agua dulce · 3:Bosque · 4:Agua salada","1:Selva · 2:Agua salada · 3:Desierto frío · 4:Bosque"],a:0,tip:"Selva=terrestre húmedo, laguna=agua dulce, desierto frío=terrestre, mar=agua salada.",img:"ecosystems"},
  {q:"Calentaste hielo → se derritió → continuaste calentando → se evaporó. ¿Qué describe el efecto de la energía térmica?",o:["Hace que las moléculas se enfríen y compacten.","Permite que las moléculas se muevan más rápido, se fundan y se evaporen.","No afecta el estado del agua.","Solo afecta el estado sólido del agua."],a:1,tip:"La energía térmica aumenta el movimiento molecular: sólido → líquido → gas.",img:"water_states"},
  {q:"Fernanda dice: 'La energía térmica enfría las cosas'. ¿Es correcto?",o:["Sí, siempre enfría.","No, la energía térmica transfiere calor.","Sí, solo en invierno.","No, la energía térmica no existe."],a:1,tip:"La energía térmica se transfiere de un cuerpo caliente a uno frío.",img:"thermal"},
  {q:"¿Cuál es la función principal del pelo en los mamíferos?",o:["Producir alimento.","Proteger el cuerpo y regular la temperatura.","Ayudar a digerir.","Producir oxígeno."],a:1,tip:"El pelo protege la piel y ayuda a mantener la temperatura corporal.",img:"mammal_hair"},
  {q:"¿Qué efecto tiene una dieta rica en azúcares y grasas sobre la salud?",o:["Mejora la concentración.","Aumenta el riesgo de enfermedades como obesidad y diabetes.","Fortalece los músculos.","Mejora la vista."],a:1,tip:"El exceso de azúcar y grasa causa sobrepeso, diabetes y problemas cardíacos.",img:"diet"},
  {q:"Juan empuja una caja con fuerza pero no se mueve. ¿Qué fuerza se opone al movimiento?",o:["Gravedad","Fricción","Magnética","Elástica"],a:1,tip:"La fricción es la fuerza que se opone al movimiento entre dos superficies.",img:"friction"},
  {q:"¿Cuál es la unidad de medida de la fuerza en el Sistema Internacional?",o:["Kilogramo (kg)","Newton (N)","Metro (m)","Segundo (s)"],a:1,tip:"La fuerza se mide en Newtons (N) en honor a Isaac Newton.",img:"newton"},
  {q:"Un imán atrae objetos de qué material:",o:["Solo plástico","Solo madera","Metales como hierro y acero","Solo papel"],a:2,tip:"Los imanes atraen metales ferromagnéticos como hierro, cobalto y níquel.",img:"magnet"},
  {q:"Martín empuja la puerta y esta se abre. ¿Qué tipo de fuerza es?",o:["Fuerza de contacto","Fuerza a distancia","Fuerza gravitacional","Fuerza magnética"],a:0,tip:"Empujar requiere contacto físico → fuerza de contacto.",img:"push_door"},
  {q:"¿Qué tipo de movimiento describe una pelota que rueda por una rampa?",o:["Movimiento rectilíneo","Movimiento circular","Movimiento rectilíneo uniforme","Movimiento oscilatorio"],a:1,tip:"Al rodar, la pelota gira sobre su propio eje → movimiento circular.",img:"rolling_ball"},
  {q:"Un niño se balancea en un columpio. ¿Qué tipo de movimiento hace?",o:["Rectilíneo","Circular","Oscilatorio","Rectilíneo uniforme"],a:2,tip:"El columpio va y viene repetidamente → movimiento oscilatorio.",img:"swing"},
  {q:"¿Cuál objeto tiene movimiento rectilíneo?",o:["Una rueda girando","Un auto en carretera recta","Un péndulo","Una noria"],a:1,tip:"El auto avanza en línea recta → movimiento rectilíneo.",img:"rectilinear"},
  {q:"La Tierra gira sobre su propio eje. ¿Qué tipo de movimiento es?",o:["Rectilíneo","Oscilatorio","Circular (rotación)","Ondulatorio"],a:2,tip:"Girar sobre un eje es un movimiento circular de rotación.",img:"earth_rotation"},
  {q:"Un satellite orbita la Tierra. ¿Qué movimiento describe?",o:["Rectilíneo","Oscilatorio","Circular (traslación)","Parabólico"],a:2,tip:"Orbitar en círculo/óvala alrededor de un cuerpo es traslación circular.",img:"satellite"},
  {q:"¿Cuál es una máquina simple?",o:["Un automóvil","Una computadora","Una palanca","Un televisor"],a:2,tip:"Las máquinas simples son herramientas básicas: palanca, polea, plano inclinado, etc.",img:"lever"},
  {q:"¿Para qué sirve una polea?",o:["Medir la temperatura","Levantar objetos con menos esfuerzo","Mezclar sustancias","Contar el tiempo"],a:1,tip:"La polea cambia la dirección de la fuerza y facilita levantar cargas.",img:"pulley"},
  {q:"Un plano inclinado sirve para:",o:["Detener objetos","Subir o bajar objetos con menos fuerza","Medir distancias","Crear electricidad"],a:1,tip:"El plano inclinado reduce la fuerza necesaria para mover objetos.",img:"inclined_plane"},
  {q:"La rueda es una máquina simple porque:",o:["Es redonda","Reduce la fricción y facilita el movimiento","Produce energía","Mide la velocidad"],a:1,tip:"La rueda transforma el movimiento de deslizamiento en rodadura, reduciendo fricción.",img:"wheel"},
  {q:"¿Qué máquina simple usas cuando abres una botella con un abridor?",o:["Polea","Plano inclinado","Palanca","Tornillo"],a:2,tip:"El abridor es una palanca: punto de apoyo, fuerza y resistencia.",img:"bottle_opener"},
  {q:"¿Cuál es la principal fuente de energía del Sistema Solar?",o:["La Luna","El Sol","Los planetas","Las estrellas lejanas"],a:1,tip:"El Sol es la estrella central que proporciona luz y calor.",img:"sun"},
  {q:"Los seres vivos necesitan agua para:",o:["Solo beber cuando tienen sed.","Todas las funciones vitales: digestión, circulación, regulación.","Solo lavarse.","Solo las plantas la necesitan."],a:1,tip:"El agua es esencial para todos los procesos del cuerpo humano.",img:"water_life"},
  {q:"¿Qué gas necesitamos las personas para respirar?",o:["Nitrógeno","Oxígeno","Dióxido de carbono","Hidrógeno"],a:1,tip:"Respiramos oxígeno (O2) del aire y expulsamos dióxido de carbono (CO2).",img:"oxygen"},
  {q:"Un ecosistema está formado por:",o:["Solo animales","Solo plantas","Seres vivos y su entorno físico","Solo el clima"],a:2,tip:"Un ecosistema = biotopo (medio físico) + biocenosis (seres vivos).",img:"ecosystem_def"},
  {q:"¿Cuál es la cadena alimentaria correcta?",o:["Plantas → Conejo → Zorro","Zorro → Conejo → Plantas","Plantas → Zorro → Conejo","Conejo → Plantas → Zorro"],a:0,tip:"Las plantas son productores, el conejo las come, y el zorro come al conejo.",img:"food_chain"}
],
sociales:[
  {q:"¿En qué periodo aparecieron los primeros seres humanos?",o:["En la Edad Media","En la Prehistoria","En la Edad Moderna","En el siglo XX"],a:1,tip:"Los primeros humanos aparecieron en la Prehistoria, hace millones de años.",img:"prehistoria"},
  {q:"La pintura rupestre se realizaba sobre:",o:["Papel","Lienzo","Paredes de cuevas","Computadoras"],a:2,tip:"Las pinturas rupestres se hacían en las paredes y techos de las cuevas.",img:"cave_painting"},
  {q:"¿Cuál fue la principal invención de la Edad de Piedra?",o:["El teléfono","El fuego y las herramientas de piedra","El automóvil","Internet"],a:1,tip:"La piedra, el fuego y las herramientas de piedra fueron claves para sobrevivir.",img:"stone_tools"},
  {q:"Los primeros humanos eran:",o:["Agricultores y comerciantes","Nómadas: cazaban y recolectaban","Constructores de ciudades","Científicos"],a:1,tip:"Eran nómadas: se movían para buscar alimento y refugio.",img:"nomads"},
  {q:"¿Qué es un fósil?",o:["Una piedra decorativa","Resto o huella de un ser vivo del pasado","Un mineral raro","Un tipo de planta actual"],a:1,tip:"Los fósiles son restos conservados de seres vivos de épocas antiguas.",img:"fossil"},
  {q:"¿Qué pueblo indígena habitaba en el territorio de Colombia antes de la llegada de los españoles?",o:["Los incas","Los aztecas","Diversos pueblos como los muiscas, taironas y quimbayas","Los vikingos"],a:2,tip:"Colombia estaba habitada por muchos pueblos indígenas, cada uno con su cultura.",img:"indigenous"},
  {q:"¿Quiénes llegaron a América en 1492?",o:["Los portugueses","Cristóbal Colón y los españoles","Los ingleses","Los franceses"],a:1,tip:"Cristóbal Colón llegó a América el 12 de octubre de 1492.",img:"columbus"},
  {q:"La Conquista de América trajo consigo:",o:["Solo beneficios","Encuentro de dos mundos con cambios culturales, sociales y demográficos","Ningún cambio","Solo intercambio de alimentos"],a:1,tip:"La Conquista fue un encuentro complejo que transformó ambas civilizaciones.",img:"conquest"},
  {q:"¿Cuál es la capital de Colombia?",o:["Medellín","Bogotá","Cali","Cartagena"],a:1,tip:"Bogotá es la capital de Colombia, ubicada en la Cordillera Oriental.",img:"bogota"},
  {q:"Colombia se independizó en:",o:["1492","1810","1900","2000"],a:1,tip:"El 20 de julio de 1810 se firmó el Acta de Independencia en Bogotá.",img:"independence"},
  {q:"¿Quién es el jefe de Estado en Colombia?",o:["El alcalde","El presidente de la República","El gobernador","El rey"],a:1,tip:"El presidente es el jefe de Estado y de Gobierno de Colombia.",img:"president"},
  {q:"Las Ramas del Poder Público en Colombia son:",o:["Dos: Ejecutivo y Legislativo","Tres: Ejecutivo, Legislativo y Judicial","Cuatro: Ejecutivo, Legislativo, Judicial y Electoral","Solo una: el Gobierno"],a:1,tip:"Son 3 ramas: Ejecutivo (presidente), Legislativo (congreso) y Judicial (jueces).",img:"branches"},
  {q:"¿Qué hace la Rama Legislativa?",o:["Aplicar las leyes","Crear y aprobar las leyes","Elegir al presidente","Dirigir el ejército"],a:1,tip:"El Congreso (Legislativo) crea, debate y aprueba las leyes del país.",img:"legislative"},
  {q:"¿Qué es la Constitución de un país?",o:["Un partido político","La ley máxima que organiza el Estado y protege los derechos","Un edificio público","Un documento económico"],a:1,tip:"La Constitución es la ley fundamental que define la organización del Estado.",img:"constitution"},
  {q:"El sufragio significa:",o:["No poder votar","Votar en secreto y libremente","Ir a la escuela","Trabajar en el gobierno"],a:1,tip:"El sufragio es el derecho y deber de los ciudadanos a votar.",img:"vote"},
  {q:"¿Qué es la democracia?",o:["Gobierno de una sola persona","Sistema donde el pueblo participa en las decisiones","Gobierno militar","Sistema sin leyes"],a:1,tip:"La democracia es un sistema de gobierno donde el poder pertenece al pueblo.",img:"democracy"},
  {q:"En una democracia, los ciudadanos pueden:",o:["Hacer lo que quieran sin límites","Participar, votar, opinar y exigir sus derechos","No participar en nada","Solo obedecer órdenes"],a:1,tip:"Los ciudadanos pueden votar, opinar, protestar pacíficamente y exigir derechos.",img:"citizen_rights"},
  {q:"¿Qué es un debate democrático?",o:["Discutir a gritos","Intercambio respetuoso de ideas para tomar decisiones","Ganar siempre","No escuchar a otros"],a:1,tip:"Un debate democrático escucha todas las opiniones con respeto para decidir juntos.",img:"debate"},
  {q:"La participación ciudadana es importante porque:",o:["No tiene importancia","Permite mejorar la comunidad y defender derechos","Solo sirve para políticos","Es obligatoria siempre"],a:1,tip:"Participar ayuda a construir una sociedad más justa y mejora la convivencia.",img:"participation"},
  {q:"¿Qué valores son fundamentales en una democracia?",o:["Egoísmo y mentira","Respeto, tolerancia, responsabilidad y solidaridad","Violencia y fuerza","Indiferencia y silencio"],a:1,tip:"Los valores democráticos incluyen respeto, tolerancia, responsabilidad y solidaridad.",img:"values"},
  {q:"¿Cuántos departamentos tiene Colombia?",o:["20","32","50","15"],a:1,tip:"Colombia tiene 32 departamentos y Bogotá como capital distrito.",img:"departments"},
  {q:"Los Derechos de los Niños incluyen:",o:["Solo el derecho a jugar","Educación, salud, protección y juego","Solo educación","Ningún derecho especial"],a:1,tip:"La Convención sobre los Derechos del Niño protege educación, salud, juego y más.",img:"children_rights"},
  {q:"¿Qué es una norma?",o:["Un consejo cualquiera","Una regla que organiza la convivencia en sociedad","Una canción","Un deporte"],a:1,tip:"Las normas son reglas que ayudan a convivir en paz y respeto.",img:"norms"},
  {q:"¿Qué significa 'diversidad cultural'?",o:["Todos somos iguales en todo","Convivencia de diferentes culturas, tradiciones y costumbres","Solo existe una cultura válida","Separar a las personas por cultura"],a:1,tip:"La diversidad cultural reconoce y valora las diferentes formas de vida.",img:"diversity"},
  {q:"¿Qué es la paz?",o:["Ausencia total de problemas","Convivencia justa, en respeto y sin violencia","No hablar con nadie","Tener mucho dinero"],a:1,tip:"La paz es vivir juntos con justicia, respeto y sin violencia.",img:"peace"}
]
};

