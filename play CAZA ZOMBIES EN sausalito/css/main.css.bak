#game-board[data-world='oeste']{background:repeating-linear-gradient(0deg, rgba(0,0,0,.12) 1px,transparent 1px,transparent var(--cell-h)),repeating-linear-gradient(90deg,rgba(0,0,0,.12) 1px,transparent 1px,transparent var(--cell-w)),radial-gradient(circle at 75% 16%, rgba(255,214,107,.15), transparent 15%),linear-gradient(180deg,#c49a58 0%,#9a6f38 54%,#6e4a24 100%);border-color:rgba(255,255,255,.14);box-shadow:inset 0 0 40px rgba(0,0,0,.22),0 0 0 1px rgba(255,255,255,.04)}

#screen-game[data-world='metro']{background:linear-gradient(180deg,#07080d 0%,#10131a 100%)}
#game-board[data-world='metro']{background:repeating-linear-gradient(0deg, rgba(0,0,0,.12) 1px,transparent 1px,transparent var(--cell-h)),repeating-linear-gradient(90deg,rgba(0,0,0,.12) 1px,transparent 1px,transparent var(--cell-w)),radial-gradient(circle at 70% 15%, rgba(255,23,68,.16), transparent 16%),linear-gradient(180deg,#353b47 0%,#2a313b 54%,#151a22 100%);border-color:rgba(255,255,255,.14);box-shadow:inset 0 0 40px rgba(0,0,0,.22),0 0 0 1px rgba(255,255,255,.04)}


/* v2.5.4e — baja HUD y cuadrícula en móvil/tablet horizontal */
body.compact-seed-ui{--hud-top-gap:max(14px, env(safe-area-inset-top));--game-top-gap:10px;}
@media (max-width:1024px) and (orientation:landscape){
  body.compact-seed-ui{--hud-top-gap:max(24px, env(safe-area-inset-top));--game-top-gap:18px;}
}
@media (max-width:820px) and (orientation:landscape){
  body.compact-seed-ui{--hud-top-gap:max(30px, env(safe-area-inset-top));--game-top-gap:24px;}
}
@media (max-width:700px) and (orientation:landscape){
  body.compact-seed-ui{--hud-top-gap:max(34px, env(safe-area-inset-top));--game-top-gap:28px;}
}
