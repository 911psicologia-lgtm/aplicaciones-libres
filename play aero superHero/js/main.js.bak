      }));

      const avatarAssetManifest = (window.AERO_AVATAR_MANIFEST || []).map(entry => ({
        ...entry,
        role: entry.role || "playable_form"
      }));

      const villainExpansionManifest = (window.AERO_VILLAIN_MANIFEST || []).map(entry => ({
        ...entry,
        role: entry.role || "expansion_enemy",
        hp: entry.hp || (entry.id === "villain_1" ? 7 : 2)
      }));

      const powerupExpansionManifest = (window.AERO_POWERUP_MANIFEST || []).map(entry => ({
        ...entry,
        role: entry.role || "reward_pickup"
      }));

      const futureWorldsMasterManifest = (window.AERO_WORLDS_2_5_MASTER_MANIFEST || []).map(entry => ({
        ...entry,
        role: entry.role || entry.category || "future_asset",
        hp: entry.hp || 1
      }));

      const futureWorldsSummary = window.AERO_WORLDS_2_5_SUMMARY || {};

      function futureAssetImageKey(entry) {
        if (entry.category === "boss" || entry.category === "mini_boss" || entry.category === "boss_variant") return "image";
        return "image";
      }

      function futureWorldAsset(id) {
        return assets.futureWorldCatalog[id] || null;
      }

      function registerCatalogImage(catalog, entry, imageKey = "image") {
        const img = new Image();
        const record = { ...entry, img, ready: false };
        img.onload = () => { record.ready = true; };
        img.onerror = () => { record.ready = false; console.warn("No cargó asset", entry.id, entry[imageKey]); };
        img.src = entry[imageKey];
        catalog[entry.id] = record;
        return record;
      }

      bossAssetManifest.forEach(entry => registerCatalogImage(assets.bossCatalog, entry));
      [...enemyAssetManifest, ...world1EnemyAssetManifest, ...villainExpansionManifest].forEach(entry => registerCatalogImage(assets.enemyCatalog, entry));
      avatarAssetManifest.forEach(entry => registerCatalogImage(assets.avatarCatalog, entry));
      powerupExpansionManifest.forEach(entry => registerCatalogImage(assets.powerupCatalog, entry));
      futureWorldsMasterManifest.forEach(entry => registerCatalogImage(assets.futureWorldCatalog, entry, futureAssetImageKey(entry)));
      assets.catalogReady = true;

      function getBossAsset(id = "kharon_lancero_alado") {
        return assets.bossCatalog[id] || assets.futureWorldCatalog[id] || assets.bossCatalog.kharon_lancero_alado || null;
      }

      function enemyAssetIdForKind(enemy) {
        if (enemy.assetId) return enemy.assetId;
        if (enemy.kind === "shooter") return "goblin_trapper";
        if (enemy.kind === "spawner") return "gadget_minion";
        if (enemy.kind === "shielded") return "minotaur_1";
        if (enemy.kind === "trap") return "goblin_trapper";
        if (enemy.kind === "flyer_mini") return "bat_minion";
        if (enemy.kind === "flyer") return "harpy_1";
        if (enemy.kind === "walker") return "cerberus";
        return "serpent_minion";
      }

      function getEnemyAsset(enemy) {
        const id = enemyAssetIdForKind(enemy);
        return assets.enemyCatalog[id] || assets.bossCatalog[id] || assets.futureWorldCatalog[id] || null;
      }

      function getAvatarAsset(id) {
        return id && id !== "classic" ? (assets.avatarCatalog[id] || null) : null;
      }

      function getPowerupAsset(id = "reward_powerup_1") {
        return assets.powerupCatalog[id] || null;
      }

