      const physics = {
        moveAccel: 2600,
        maxSpeed: 360,
        groundFriction: 0.84,
        airFriction: 0.965,
        gravityUp: 1600,
        gravityDown: 2350,
        jumpSpeed: 690,
        doubleJumpSpeed: 635,
        extraJumps: 2,
        shortHopCut: 0.52,
        coyoteTime: 0.105,
        jumpBuffer: 0.12
      };

      const player = {
        x: 180,
        y: 0,
        vx: 0,
        vy: 0,
        width: 42,
        standHeight: 78,
        crouchHeight: 45,
        height: 78,
        isCrouching: false,
        dir: 1,
        grounded: false,
        coyote: 0,
        jumpBufferTimer: 0,
        airJumpsLeft: 2,
        invulnerable: 0,
        attackCooldown: 0,
        state: "idle",
        runT: 0,
        animTimer: 0,
        animFrame: 0,
        squash: 1,
        airJumpFlash: 0,
        hurtFlash: 0,
        attackFlash: 0,
        shieldTimer: 0,
        chargeTimer: 0,
        chargeFired: false,
        dashTimer: 0,
        dashCooldown: 0,
        dashDir: 1,
        overdriveTimer: 0,
        fireBoostTimer: 0,
        lastTrailTime: 0,
        flameCooldown: 0,
        lastGrounded: false,
        prevX: 180,
        prevY: 0,
        tubeCooldown: 0,
        phaseUpTimer: 0,
        specialWeaponTimer: 0,
        specialWeaponRestorePending: false,
        flightEntryNotified: false,
        bossTransformTimer: 0,
        bossTransformPulseTimer: 0,
        bossAutoAllyTriggered: false,
        allyTimer: 0,
        allyShootTimer: 0
      };

      function resize() {
        DPR = Math.min(window.devicePixelRatio || 1, DPR_LIMIT);
        const vv = window.visualViewport;
        W = Math.floor(vv ? vv.width : window.innerWidth);
        H = Math.floor(vv ? vv.height : window.innerHeight);
        canvas.width = Math.floor(W * DPR);
        canvas.height = Math.floor(H * DPR);
        canvas.style.width = W + "px";
        canvas.style.height = H + "px";
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

        const isTouchLandscape = ((navigator.maxTouchPoints || 0) > 0 || touchControl.enabled) && W > H;
        const floorBand = isTouchLandscape
          ? Math.min(88, Math.max(58, H * 0.135))
          : Math.min(128, Math.max(86, H * 0.18));
        world.floorY = Math.max(230, H - floorBand);

        if (!Number.isFinite(player.y) || player.y === 0 || player.y + player.height > H + 80) {
          player.y = world.floorY - player.height;
        }
      }

      function resetPlayer() {
        player.x = 180;
        player.y = world.floorY - player.height;
        player.vx = 0;
        player.vy = 0;
        player.dir = 1;
        player.height = player.standHeight;
        player.isCrouching = false;
        player.grounded = true;
        player.coyote = 0;
        player.jumpBufferTimer = 0;
        resetJumpCapacity();
        player.airJumpFlash = 0;
        player.hurtFlash = 0;
        player.animTimer = 0;
        player.animFrame = 0;
        player.invulnerable = 0;
        player.attackCooldown = 0;
        player.attackFlash = 0;
        player.shieldTimer = 0;
        player.chargeTimer = 0;
        player.chargeFired = false;
        player.dashTimer = 0;
        player.dashCooldown = 0;
        player.dashDir = 1;
        player.overdriveTimer = 0;
        player.fireBoostTimer = 0;
        player.flameCooldown = 0;
        player.tubeCooldown = 0;
        player.phaseUpTimer = 0;
        player.specialWeaponTimer = 0;
        player.specialWeaponRestorePending = false;
        player.bossTransformTimer = 0;
        player.bossTransformPulseTimer = 0;
        player.bossAutoAllyTriggered = false;
        player.allyTimer = 0;
        player.allyShootTimer = 0;
        player.lastTrailTime = 0;
        player.prevX = player.x;
        player.prevY = player.y;
        setWeaponModeById("spark", false);
      }

      function makeObstacle(spec) {
        return { active: true, ...spec };
      }

      function makeBlock(spec) {
        return { ...spec };
      }

      function makePlatform(spec) {
        return {
          baseX: spec.x,
          prevX: spec.x,
          ...spec
        };
      }

      function makeFallingPlatform(spec) {
        return {
          active: true,
          triggered: false,
          timer: 1.5,
          fallVy: 0,
          ...spec
        };
      }

      function makeFirePickup(spec) {
        return { type: "fire", r: 15, duration: 7, collected: false, assetId: null, rewardType: "fire", ...spec };
      }



      function makeRescueCage(spec) {
        return {
          x: spec.x,
          y: spec.y ?? 0,
          w: spec.w ?? 56,
          h: spec.h ?? 82,
          asset: spec.asset ?? 0,
          radius: spec.radius ?? 360,
          rewardType: spec.rewardType || "triplePower",
          rescued: false,
          prizeDropped: false,
          label: spec.label || "RESCATE"
        };
      }

      function rescueCageRect(cage) {
        return {
          x: cage.x,
          y: world.floorY + cage.y - cage.h,
          w: cage.w,
          h: cage.h
        };
      }

      function updateRescueCages(dt) {
        for (const cage of rescueCages) {
          if (cage.rescued || cage.prizeDropped) continue;
          const cx = cage.x + cage.w / 2;
          const aliveGuardians = enemies.some(enemy => {
            if (!enemy.active) return false;
            const er = enemyRect(enemy);
            const ex = er.x + er.w / 2;
            return Math.abs(ex - cx) <= cage.radius;
          });
          if (!aliveGuardians && player.x > cage.x - 220) {
            cage.rescued = true;
            cage.prizeDropped = true;
            const rect = rescueCageRect(cage);
            const px = cage.x + cage.w / 2;
            const py = rect.y - world.floorY - 24;
            firePickups.push(makeFirePickup({
              x: px + 34,
              y: py,
              r: 18,
              duration: 8.8,
              specialDuration: 10,
              rewardType: cage.rewardType,
              overdrive: 4.5,
              energy: 35,
              score: 200,
              revealed: true
            }));
            game.score += 180;
            spawnParticles(px, rect.y + cage.h * 0.45, "#e4c94f", 20);
            addFloatingText(px, rect.y - 14, "+RESCATE", "#fff0a8");
            setMessage("Rescate logrado · premio liberado", 1.2);
            playSfx("victory");
            updateHud();
          }
        }
      }

      function drawRescueCages() {
        for (const cage of rescueCages) {
          const r = rescueCageRect(cage);
          const x = r.x - world.camX;
          const y = r.y;
          if (x < -140 || x > W + 140) continue;

          const asset = decorativeHumanAssets[cage.asset % decorativeHumanAssets.length];
          ctx.save();

          const glow = ctx.createRadialGradient(x + r.w / 2, y + r.h / 2, 4, x + r.w / 2, y + r.h / 2, 60);
          glow.addColorStop(0, cage.rescued ? "rgba(228,201,79,.32)" : "rgba(216,90,90,.26)");
          glow.addColorStop(1, "rgba(109,88,216,0)");
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(x + r.w / 2, y + r.h / 2, 60, 0, Math.PI * 2);
          ctx.fill();

          if (asset && asset.ready) {
            const h = r.h * 0.92;
            const w = h * (asset.img.naturalWidth / Math.max(1, asset.img.naturalHeight));
            ctx.globalAlpha = cage.rescued ? 0.72 : 0.92;
            ctx.drawImage(asset.img, x + r.w / 2 - w / 2, y + r.h - h, w, h);
            ctx.globalAlpha = 1;
          }

          if (!cage.rescued) {
            ctx.strokeStyle = "rgba(20,25,35,.82)";
            ctx.lineWidth = 3;
            roundRect(ctx, x - 6, y - 4, r.w + 12, r.h + 8, 14);
            ctx.stroke();
            ctx.strokeStyle = "rgba(255,255,255,.42)";
            ctx.lineWidth = 2;
            for (let bx = x + 6; bx <= x + r.w - 4; bx += 14) {
              ctx.beginPath();
              ctx.moveTo(bx, y - 2);
              ctx.lineTo(bx, y + r.h + 2);
              ctx.stroke();
            }
            ctx.fillStyle = "#fff0a8";
            ctx.font = "900 10px system-ui, sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("GUARDIANES", x + r.w / 2, y - 10);
          } else {
            ctx.fillStyle = "#fff0a8";
            ctx.font = "900 12px system-ui, sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("LIBRE", x + r.w / 2, y - 10);
          }

          ctx.restore();
        }
      }


      function makeMudPit(spec) {
        return {
          x: spec.x,
          y: spec.y || 0,
          w: spec.w || 180,
          h: spec.h || 26,
          slow: spec.slow || 0.42,
          sink: spec.sink || 0.0,
          stamina: spec.stamina || 4,
          color: spec.color || "rgba(64,82,46,.78)",
          bubbles: Array.from({ length: spec.bubbles || 5 }, (_, i) => ({ phase: i * 0.9, ox: (i + 1) / ((spec.bubbles || 5) + 1) }))
        };
      }

      function mudPitRect(pit) {
        return { x: pit.x, y: world.floorY - pit.h + (pit.y || 0), w: pit.w, h: pit.h };
      }

      function makePendulum(spec) {
        return {
          x: spec.x,
          y: spec.y || -260,
          length: spec.length || 160,
          radius: spec.radius || 20,
          swing: spec.swing || 0.92,
          speed: spec.speed || 1.4,
          phase: spec.phase || 0,
          stamina: spec.stamina || 12,
          color: spec.color || "#e4c94f"
        };
      }

      function pendulumBob(p) {
        const ax = p.x;
        const ay = world.floorY + p.y;
        const angle = Math.sin(world.time * p.speed + p.phase) * p.swing;
        return {
          anchorX: ax,
          anchorY: ay,
          x: ax + Math.sin(angle) * p.length,
          y: ay + Math.cos(angle) * p.length,
          r: p.radius
        };
      }

      function drawMudPits() {
        for (const pit of mudPits) {
          const r = mudPitRect(pit);
          const x = r.x - world.camX;
          if (x > W + 80 || x + r.w < -80) continue;
          ctx.save();
          const g = ctx.createLinearGradient(0, r.y, 0, r.y + r.h);
          g.addColorStop(0, pit.color);
          g.addColorStop(1, "rgba(18,28,20,.95)");
          ctx.fillStyle = g;
          roundRect(ctx, x, r.y, r.w, r.h, 18);
          ctx.fill();
          ctx.strokeStyle = "rgba(143,255,184,.28)";
          ctx.lineWidth = 2;
          ctx.stroke();
          for (const b of pit.bubbles) {
            const bx = x + pit.w * b.ox;
            const by = r.y + 7 + Math.sin(world.time * 2.2 + b.phase) * 5;
            ctx.fillStyle = "rgba(188,255,170,.28)";
            ctx.beginPath();
            ctx.arc(bx, by, 4 + Math.sin(world.time * 3 + b.phase) * 1.8, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.restore();
        }
      }

      function drawPendulums() {
        for (const p of pendulums) {
          const b = pendulumBob(p);
          const ax = b.anchorX - world.camX;
          const bx = b.x - world.camX;
          if (bx < -140 || bx > W + 140) continue;
          ctx.save();
          ctx.strokeStyle = "rgba(20,25,35,.72)";
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.moveTo(ax, b.anchorY);
          ctx.lineTo(bx, b.y);
          ctx.stroke();
          const glow = ctx.createRadialGradient(bx, b.y, 3, bx, b.y, b.r * 3.5);
          glow.addColorStop(0, "rgba(255,255,255,.8)");
          glow.addColorStop(.4, "rgba(228,201,79,.55)");
          glow.addColorStop(1, "rgba(216,90,90,0)");
          ctx.fillStyle = glow;
          ctx.beginPath(); ctx.arc(bx, b.y, b.r * 3.4, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = p.color;
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 3;
          ctx.beginPath(); ctx.arc(bx, b.y, b.r, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
          ctx.restore();
        }
      }

      function updateMudAndPendulums(dt) {
        if (game.status !== "playing") return;
        const pr = playerRect();
        for (const pit of mudPits) {
          const r = mudPitRect(pit);
          if (rectsOverlap(pr, r)) {
            player.vx *= Math.pow(pit.slow, dt * 5);
            if (keys.jump || pressedOnce.jump || player.vy < -60) {
              player.vy -= 180 * dt;
            } else {
              player.vy += (pit.sink || 70) * dt;
            }
            if (Math.random() < 0.16) spawnParticles(player.x + player.width / 2, r.y + 8, "#8fff9f", 1);
            if (game.energy > 0) game.energy = Math.max(0, game.energy - (pit.stamina || 4) * dt);
            setMessage("Lodo pesado · salta o usa doble arriba", 0.35);
          }
        }
        for (const p of pendulums) {
          const b = pendulumBob(p);
          if (circleRectCollision(b.x, b.y, b.r + 4, pr)) {
            burnPlayer(b.x, p.stamina || 12);
            world.shake = Math.max(world.shake, 8);
            spawnParticles(b.x, b.y, p.color || "#e4c94f", 10);
            break;
          }
        }
      }

      function makeWarpTube(spec) {
        return {
          x: spec.x,
          y: spec.y ?? 0,
          w: spec.w ?? 70,
          h: spec.h ?? 98,
          toX: spec.toX ?? spec.x + 600,
          toY: spec.toY ?? 0,
          label: spec.label || "→",
          hint: spec.hint || "ENTRA",
          cooldown: 0
        };
      }

      function warpTubeRect(tube) {
        return {
          x: tube.x,
          y: world.floorY - tube.h + (tube.y || 0),
          w: tube.w,
          h: tube.h
        };
      }

      function makeFlame(spec, type) {
        return {
          type,
          active: type === "floor",
          timer: spec.life ?? 2.2,
          life: spec.life ?? 2.2,
          respawnTimer: spec.delay ?? 0,
          respawn: spec.respawn ?? 4,
          pulse: Math.random() * Math.PI * 2,
          ...spec
        };
      }

      function makeRisingStair(spec) {
        return {
          active: false,
          timer: 0,
          progress: 0,
          ...spec
        };
      }

      function makeUpperTimedPlatform(spec) {
        return {
          active: false,
          timer: 0,
          ...spec
        };
      }

      function makeEnemy(spec) {
        const hp = spec.hp ?? (spec.kind === "flyer" ? 1 : 2);
        const cooldown = spec.shootCooldown ?? 2.5;
        const spawnCooldown = spec.spawnCooldown ?? 4.0;
        return {
          kind: spec.kind || "walker",
          assetId: spec.assetId || null,
          x: spec.x,
          startX: spec.x,
          y: spec.y ?? 0,
          baseY: spec.y ?? 0,
          w: spec.w ?? 42,
          h: spec.h ?? 48,
          minX: spec.minX ?? spec.x - 80,
          maxX: spec.maxX ?? spec.x + 120,
          dir: spec.dir ?? 1,
          speed: spec.speed ?? 70,
          baseSpeed: spec.speed ?? 70,
          hp,
          maxHp: hp,
          active: true,
          hitFlash: 0,
          stunTimer: 0,
          shootCooldown: cooldown,
          shootTimer: spec.kind === "shooter" ? cooldown * 0.6 : 0,
          spawnCooldown,
          spawnTimer: spec.kind === "spawner" ? spawnCooldown * 0.65 : 0,
          countsForGoal: spec.countsForGoal ?? (spec.kind !== "flyer_mini"),
          spawned: !!spec.spawned,
          amp: spec.amp ?? 10
        };
      }

      function makeOrb(spec) {
        return { r: 14, collected: false, ...spec };
      }

      function makePickup(spec, type) {
        return {
          type,
          r: 13,
          amount: type === "energy" ? 25 : 0,
          duration: type === "shield" ? 5.5 : 0,
          collected: false,
          ...spec
        };
      }

      function makeFlowOrb(spec) {
        return {
          type: "flow",
          r: 16,
          duration: 5.0,
          collected: false,
          ...spec
        };
      }

      function makeBoss(spec) {
        const baseHp = spec.hp ?? 8;
        const bossHp = Math.ceil(baseHp * 6.2);
        return {
          name: spec.name || "Kharon, el Lancero Alado",
          assetId: spec.assetId || "kharon_lancero_alado",
          x: spec.x,
          startX: spec.x,
          y: spec.y ?? -176,
          baseY: spec.y ?? -176,
          w: spec.w ?? 126,
          h: spec.h ?? 88,
          minX: spec.minX ?? spec.x - 120,
          maxX: spec.maxX ?? spec.x + 180,
          dir: -1,
          hp: bossHp,
          maxHp: bossHp,
          patrolSpeed: spec.patrolSpeed ?? 72,
          chargeSpeed: spec.chargeSpeed ?? 520,
          patrolTime: spec.patrolTime ?? 2.8,
          chargeTime: spec.chargeTime ?? 0.85,
          restTime: spec.restTime ?? 1.55,
          prechargeTime: spec.prechargeTime ?? 0.62,
          lanceCooldown: spec.lanceCooldown ?? 1.8,
          lanceTimer: (spec.lanceCooldown ?? 1.8) * 0.55,
          warnedRest: false,
          state: "patrol",
          stateTimer: spec.patrolTime ?? 2.8,
          active: false,
          appeared: false,
          defeated: false,
          hitFlash: 0,
          vulnerable: false,
          chargeVy: 0,
          spawnHelpers: true,
          enraged: false,
          phaseTeleport: false,
          phaseSplit: false,
          phaseFinal: false,
          teleportTimer: spec.teleportTimer ?? 3.8,
          specialTimer: spec.specialTimer ?? 1.9,
          invulnTimer: 0,
          afterVanishState: "patrol",
          rageAura: 0,
          cloneAssetId: spec.cloneAssetId || spec.assetId || "kharon_lancero_alado",
          specialProfile: spec.specialProfile || "auto"
        };
      }



      function makeEscapeBoss(spec) {
        return {
          name: spec.name || "Guardián Errante",
          assetId: spec.assetId || spec.bossAssetId || "kharon_lancero_alado",
          triggerX: spec.triggerX ?? spec.x - 320,
          x: spec.x,
          y: spec.y ?? -180,
          startX: spec.x,
          startY: spec.y ?? -180,
          w: spec.w ?? 154,
          h: spec.h ?? 110,
          hp: spec.hp ?? 18,
          maxHp: spec.hp ?? 18,
          shootCooldown: spec.shootCooldown ?? 1.45,
          shootTimer: (spec.shootCooldown ?? 1.45) * 0.65,
          active: false,
          escaped: false,
          revealed: false,
          state: "idle",
          stateTimer: spec.engageTime ?? 8.0,
          engageTime: spec.engageTime ?? 8.0,
          escapeAtHp: spec.escapeAtHp ?? Math.max(5, Math.floor((spec.hp ?? 18) * 0.45)),
          escapeSpeed: spec.escapeSpeed ?? 340,
          dir: -1,
          hitFlash: 0
        };
      }

      function escapeBossRect(eb) {
        return {
          x: eb.x,
          y: world.floorY + eb.y - eb.h,
          w: eb.w,
          h: eb.h
        };
      }

      function hitEscapeBoss(eb, damageAmount = 1) {
        if (!eb || !eb.active || eb.escaped || eb.state === "escape") return false;
        const actualDamage = Math.max(0.15, damageAmount * 0.18);
        eb.hp -= actualDamage;
        eb.hitFlash = 0.2;
        world.shake = Math.max(world.shake, 4);
        addFloatingText(eb.x + eb.w / 2, world.floorY + eb.y - eb.h - 10, `-${actualDamage.toFixed(1)}`, "#ffb36b");
        playSfx("bossHit");
        if (eb.hp <= eb.escapeAtHp) {
          eb.state = "escape";
          eb.stateTimer = 2.2;
          setMessage(`${eb.name} escapa herido`, 1.0);
        }
        return true;
      }

      function fireEscapeBossProjectile(eb) {
        const er = escapeBossRect(eb);
        const px = player.x + player.width / 2;
        const ex = er.x + er.w / 2;
        const dir = px < ex ? -1 : 1;
        eb.dir = dir;
        enemyProjectiles.push({
          type: "escape_bolt",
          x: ex + dir * 32,
          y: er.y + er.h * 0.44,
          vx: dir * 310,
          r: 9,
          life: 3.4,
          active: true
        });
        spawnParticles(ex + dir * 18, er.y + er.h * 0.44, "#ff8a3d", 4);
      }

      function updateEscapeBosses(dt) {
        if (!escapeBosses.length) return;
        const pr = playerRect();

        for (const eb of escapeBosses) {
          if (eb.escaped) continue;

          eb.hitFlash = Math.max(0, eb.hitFlash - dt);

          if (!eb.active) {
            if (player.x >= eb.triggerX) {
              eb.active = true;
              eb.revealed = true;
              eb.state = "engage";
              eb.stateTimer = eb.engageTime;
              setMessage(`${eb.name} apareció`, 1.0);
              playSfx("bossAppear");
            }
            continue;
          }

          if (eb.state === "engage") {
            eb.stateTimer -= dt;
            const px = player.x + player.width / 2;
            const ex = eb.x + eb.w / 2;
            eb.dir = px < ex ? -1 : 1;
            eb.x += Math.sign(px - ex) * 64 * dt;
            eb.y = eb.startY + Math.sin(world.time * 2.4 + eb.startX * 0.01) * 22;
            eb.shootTimer -= dt;
            if (eb.shootTimer <= 0) {
              fireEscapeBossProjectile(eb);
              eb.shootTimer = eb.shootCooldown;
            }
            if (eb.stateTimer <= 0) {
              eb.state = "escape";
              eb.stateTimer = 2.4;
              setMessage(`${eb.name} huyó hacia las sombras`, 1.0);
            }
          } else if (eb.state === "escape") {
            eb.x += eb.escapeSpeed * dt;
            eb.y -= 96 * dt;
            if (eb.x - world.camX > W + 260 || eb.stateTimer <= 0) {
              eb.escaped = true;
              eb.active = false;
            }
            eb.stateTimer -= dt;
          }

          if (rectsOverlap(pr, escapeBossRect(eb))) {
            damagePlayer(eb.x + eb.w / 2);
          }
        }
      }

      function drawEscapeBosses() {
        for (const eb of escapeBosses) {
          if (!eb.active || eb.escaped) continue;
          const er = escapeBossRect(eb);
          const x = er.x - world.camX;
          const y = er.y;
          if (x < -260 || x > W + 260) continue;

          const blink = eb.hitFlash > 0 && Math.floor(world.time * 20) % 2 === 0;
          const asset = getBossAsset(eb.assetId);

          ctx.save();
          if (blink) ctx.globalAlpha = 0.66;

          const shadow = ctx.createRadialGradient(x + er.w / 2, y + er.h * 0.84, 10, x + er.w / 2, y + er.h * 0.84, er.w * 0.6);
          shadow.addColorStop(0, "rgba(20,20,25,.35)");
          shadow.addColorStop(1, "rgba(20,20,25,0)");
          ctx.fillStyle = shadow;
          ctx.beginPath();
          ctx.ellipse(x + er.w / 2, y + er.h * 0.94, er.w * 0.42, er.h * 0.12, 0, 0, Math.PI * 2);
          ctx.fill();

          if (asset && asset.ready) {
            ctx.save();
            ctx.translate(x + er.w / 2, y + er.h / 2);
            ctx.scale(eb.dir < 0 ? -1 : 1, 1);
            ctx.drawImage(asset.img, -er.w / 2, -er.h / 2, er.w, er.h);
            ctx.restore();
          } else {
            ctx.fillStyle = "#5d58a4";
            ctx.strokeStyle = "#111";
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.ellipse(x + er.w / 2, y + er.h * 0.58, er.w * 0.36, er.h * 0.26, 0, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
          }

          ctx.strokeStyle = "rgba(228,201,79,.86)";
          ctx.lineWidth = 3;
          ctx.strokeRect(x + 10, y + 10, (er.w - 20) * Math.max(0, eb.hp / eb.maxHp), 8);
          ctx.strokeRect(x + 10, y + 10, er.w - 20, 8);
          ctx.fillStyle = "#fff0a8";
          ctx.font = "700 12px system-ui, sans-serif";
          ctx.textAlign = "center";
          ctx.fillText(eb.name, x + er.w / 2, y - 8);
          ctx.restore();
        }
      }

      function loadLevel(levelIndex = 0) {
        const level = levels[levelIndex] || levels[0];
        game.currentLevel = levelIndex;
        game.levelName = level.name;
        game.goalOrbs = level.goalOrbs;
        game.goalEnemies = level.goalEnemies;
        game.bossDefeated = false;
        game.flightMode = false;
        game.flightZoneId = null;
        game.burrowMode = false;

        obstacles.length = 0;
        solidBlocks.length = 0;
        breakableBlocks.length = 0;
        movingPlatforms.length = 0;
        enemies.length = 0;
        orbs.length = 0;
        energyPickups.length = 0;
        shieldPickups.length = 0;
        flowOrbs.length = 0;
        firePickups.length = 0;
        floorFlames.length = 0;
        airFlames.length = 0;
        risingStairs.length = 0;
        upperTimedPlatforms.length = 0;
        fallingPlatforms.length = 0;
        warpTubes.length = 0;
        enemyProjectiles.length = 0;
        bossHelpers.length = 0;
        bossClones.length = 0;
        escapeBosses.length = 0;
        rescueCages.length = 0;
        mudPits.length = 0;
        pendulums.length = 0;
        particles.length = 0;
        aeroTrail.length = 0;
        floatingTexts.length = 0;
        sparks.length = 0;

        level.obstacles.forEach(item => obstacles.push(makeObstacle(item)));
        level.blocks.forEach(item => solidBlocks.push(makeBlock(item)));
        (level.breakableBlocks || []).forEach(item => breakableBlocks.push({ active: true, ...item }));
        level.platforms.forEach(item => movingPlatforms.push(makePlatform(item)));
        (level.fallingPlatforms || []).forEach(item => fallingPlatforms.push(makeFallingPlatform(item)));
        level.enemies.forEach(item => enemies.push(makeEnemy(item)));
        level.orbs.forEach(item => orbs.push(makeOrb(item)));
        level.energyPickups.forEach(item => energyPickups.push(makePickup(item, "energy")));
        level.shieldPickups.forEach(item => shieldPickups.push(makePickup(item, "shield")));
        (level.flowOrbs || []).forEach(item => flowOrbs.push(makeFlowOrb(item)));
        (level.firePickups || []).forEach(item => firePickups.push(makeFirePickup(item)));
        (level.floorFlames || []).forEach(item => floorFlames.push(makeFlame(item, "floor")));
        (level.airFlames || []).forEach(item => airFlames.push(makeFlame(item, "air")));
        (level.risingStairs || []).forEach(item => risingStairs.push(makeRisingStair(item)));
        (level.upperTimedPlatforms || []).forEach(item => upperTimedPlatforms.push(makeUpperTimedPlatform(item)));
        // Tubos deshabilitados por diseño: no se cargan warpTubes.
        warpTubes.length = 0;

        portal.x = level.portal.x;
        portal.y = level.portal.y;
        portal.w = level.portal.w;
        portal.h = level.portal.h;
        portal.active = false;
        storyScene.active = false;
        storyScene.timer = 0;

        boss = makeBoss(level.boss);
        (level.escapeBosses || []).forEach(item => escapeBosses.push(makeEscapeBoss(item)));
        (level.rescueCages || []).forEach(item => rescueCages.push(makeRescueCage(item)));
      }

      function resetLevel(levelIndex = game.currentLevel || 0) {
        loadLevel(levelIndex);
        resetPlayer();

        game.lives = game.maxLives;
        game.errors = 0;
        game.energy = game.maxEnergy;
        game.shields = 0;
        game.nextShieldScore = game.shieldScoreStep;
        game.nextPowerupScore = 650;
        game.orbs = 0;
        game.enemiesDefeated = 0;
        game.bossDefeated = false;
        game.score = 0;
        game.status = "playing";
        game.statusMessage = game.currentLevel === 0 ? `Aurora te espera, ${playerName}` : `${game.levelName}`;
        game.messageTimer = 1.5;
        runScoreRecorded = false;
        hideStartOverlay();
        if (endOverlay) endOverlay.classList.add("hidden");

        keys.left = keys.right = keys.down = keys.jump = keys.attack = keys.dash = keys.shield = false;
        clearTouchMovement();
        pressedOnce.jump = pressedOnce.attack = pressedOnce.dash = pressedOnce.shield = false;
        enemyProjectiles.length = 0;
        bossHelpers.length = 0;
        bossClones.length = 0;
        escapeBosses.length = 0;
        rescueCages.length = 0;
        particles.length = 0;
        aeroTrail.length = 0;
        floatingTexts.length = 0;
        world.shake = 0;

        applySelectedStartWeaponBonus();
        updateHud();
      }

      function handleDirectionTap(dir) {
        const now = performance.now() / 1000;
        if (dir < 0) {
          if (now - inputTap.leftTime <= inputTap.threshold) {
            player.dir = -1;
            pressedOnce.dash = true;
          }
          inputTap.leftTime = now;
        } else {
          if (now - inputTap.rightTime <= inputTap.threshold) {
            player.dir = 1;
            pressedOnce.dash = true;
          }
          inputTap.rightTime = now;
        }
      }


      function startDropThrough() {
        if (game.status !== "playing") return;
        if (!player.grounded && player.vy < 0) return;
        player.dropThroughTimer = 0.38;
        player.grounded = false;
        player.y += 34;
        player.vy = Math.max(player.vy, 320);
        setMessage("Baja rápido", 0.38);
        addFloatingText(player.x + player.width / 2, player.y - 8, "↓", "#a8f0ff");
      }

      function handleDownTap() {
        const now = performance.now() / 1000;
        if (now - inputTap.downTime <= 0.34) {
          startDropThrough();
          inputTap.downTime = -1;
        } else {
          inputTap.downTime = now;
        }
      }


      function findNearestOpenSpaceAbove() {
        const pr = playerRect();
        const cx = player.x + player.width / 2;
        const candidates = [];

        const pushCandidate = (r) => {
          if (r.h > 36) return;
          const horizontallyOver = cx >= r.x - 20 && cx <= r.x + r.w + 20;
          const aboveOrNear = r.y < pr.y + pr.h + 24;
          const notTooFar = pr.y - r.y < 240;
          if (horizontallyOver && aboveOrNear && notTooFar) {
            candidates.push(r);
          }
        };

        for (const block of activeSolidLikeBlocks()) pushCandidate(solidBlockRect(block));
        for (const platform of movingPlatforms) pushCandidate(movingPlatformRect(platform));
        for (const platform of fallingPlatforms) if (platform.active) pushCandidate(fallingPlatformRect(platform));
        for (const stair of risingStairs) stairRects(stair).forEach(pushCandidate);
        for (const platform of upperTimedPlatforms) if (platform.active) pushCandidate(upperTimedPlatformRect(platform));

        candidates.sort((a, b) => Math.abs(a.y - pr.y) - Math.abs(b.y - pr.y));
        return candidates[0] || null;
      }

      function startPhaseUp() {
        if (game.status !== "playing" || game.flightMode) return;
        const target = findNearestOpenSpaceAbove();
        player.phaseUpTimer = 0.62;
        player.dropThroughTimer = 0;
        player.grounded = false;
        player.coyote = 0;
        player.isCrouching = false;
        player.height = player.standHeight;

        if (target) {
          // Salto de rescate: atraviesa plataforma delgada y aparece cerca de la parte superior.
          player.y = Math.min(player.y - 24, target.y - player.height - 8);
          player.vy = -520;
        } else {
          player.y -= 34;
          player.vy = -820;
        }

        player.airJumpFlash = 0.24;
        world.shake = Math.max(world.shake, 5);
        spawnParticles(player.x + player.width / 2, player.y + player.height, "#a8f0ff", 16);
        addFloatingText(player.x + player.width / 2, player.y - 8, "↑ RESCATE", "#a8f0ff");
        setMessage("Doble arriba · Aero atraviesa y sube", 0.75);
        playSfx("orb");
      }

      function handleUpTap() {
        const now = performance.now() / 1000;
        if (now - inputTap.upTime <= 0.36) {
          startPhaseUp();
          inputTap.upTime = -1;
        } else {
          inputTap.upTime = now;
        }
      }

      function keyDown(e) {
        const tag = (e.target && e.target.tagName || "").toLowerCase();
        if (tag === "input" || tag === "textarea") return;
        const code = e.code;
        if (["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "Space", "KeyA", "KeyD", "KeyW", "KeyS", "KeyX", "KeyQ", "KeyE", "KeyR", "Digit1", "Digit2", "Digit3", "Digit4", "Digit5", "ShiftLeft", "ShiftRight"].includes(code)) {
          e.preventDefault();
        }
        if (code === "ArrowLeft" || code === "KeyA") {
          if (!keys.left) handleDirectionTap(-1);
          keys.left = true;
        }
        if (code === "ArrowRight" || code === "KeyD") {
          if (!keys.right) handleDirectionTap(1);
          keys.right = true;
        }
        if (code === "ArrowDown" || code === "KeyS") { if (!keys.down) handleDownTap(); keys.down = true; }
        if (code === "KeyR") resetLevel();
        if (game.status === "playing") {
          if (code === "Digit1") setAvatarForm("classic", true);
          if (code === "Digit2") setAvatarForm("superhero_2", true);
          if (code === "Digit3") setAvatarForm("superhero_3", true);
        }
        if (code === "KeyE") {
          if (!keys.shield) pressedOnce.shield = true;
          keys.shield = true;
        }
        if (code === "ShiftLeft" || code === "ShiftRight") {
          if (!keys.dash) pressedOnce.dash = true;
          keys.dash = true;
        }
        if (code === "ArrowUp" || code === "Space" || code === "KeyW") {
          if (!keys.jump) {
            handleUpTap();
            pressedOnce.jump = true;
          }
          keys.jump = true;
        }
        if (code === "KeyQ" && game.status === "playing") {
          cycleWeapon(1);
        }
        if (code === "KeyX") {
          if (!keys.attack) pressedOnce.attack = true;
          keys.attack = true;
        }
      }

      function keyUp(e) {
        const code = e.code;
        if (code === "ArrowLeft" || code === "KeyA") keys.left = false;
        if (code === "ArrowRight" || code === "KeyD") keys.right = false;
        if (code === "ArrowDown" || code === "KeyS") keys.down = false;
        if (code === "ShiftLeft" || code === "ShiftRight") keys.dash = false;
        if (code === "KeyE") keys.shield = false;
        if (code === "ArrowUp" || code === "Space" || code === "KeyW") keys.jump = false;
        if (code === "KeyX") keys.attack = false;
      }

      function bindTouchButtons() {
        const buttons = document.querySelectorAll(".controlBtn");

        const pressKey = (key) => {
          if (!key) return;

          if (key === "jump" && !keys.jump) pressedOnce.jump = true;
          if (key === "attack" && !keys.attack) pressedOnce.attack = true;
          if (key === "dash" && !keys.dash) pressedOnce.dash = true;
          if (key === "shield" && !keys.shield) pressedOnce.shield = true;

          keys[key] = true;
        };

        const releaseKey = (key) => {
          if (!key) return;
          keys[key] = false;
        };

        buttons.forEach(btn => {
          const key = btn.dataset.key;

          const on = (ev) => {
            ev.preventDefault();
            ev.stopPropagation();

            if (btn.setPointerCapture && ev.pointerId !== undefined) {
              try { btn.setPointerCapture(ev.pointerId); } catch (_) {}
            }

            pressKey(key);
            btn.classList.add("active");
          };

          const off = (ev) => {
            ev.preventDefault();
            ev.stopPropagation();

            releaseKey(key);
            btn.classList.remove("active");
          };

          btn.addEventListener("pointerdown", on, { passive: false });
          btn.addEventListener("pointerup", off, { passive: false });
          btn.addEventListener("pointercancel", off, { passive: false });
          btn.addEventListener("lostpointercapture", off, { passive: false });
          btn.addEventListener("mouseleave", off, { passive: false });
        });

        window.addEventListener("blur", () => {
          keys.left = keys.right = keys.down = keys.jump = keys.attack = keys.dash = keys.shield = false;
          clearTouchMovement();
          buttons.forEach(btn => btn.classList.remove("active"));
        });
      }

      function clamp(v, min, max) {
        return Math.max(min, Math.min(max, v));
      }

      function rectsOverlap(a, b) {
        return a.x < b.x + b.w &&
          a.x + a.w > b.x &&
          a.y < b.y + b.h &&
          a.y + a.h > b.y;
      }

      function circleRectCollision(cx, cy, r, rect) {
        const closestX = clamp(cx, rect.x, rect.x + rect.w);
        const closestY = clamp(cy, rect.y, rect.y + rect.h);
        const dx = cx - closestX;
        const dy = cy - closestY;
        return (dx * dx + dy * dy) <= r * r;
      }

      function playerRect() {
        return {
          x: player.x,
          y: player.y,
          w: player.width,
          h: player.height
        };
      }

      function solidBlockRect(block) {
        return {
          x: block.x,
          y: world.floorY + block.y,
          w: block.w,
          h: block.h
        };
      }

      function activeSolidLikeBlocks() {
        return [...solidBlocks, ...breakableBlocks.filter(block => block.active)];
      }

      function movingPlatformRect(platform) {
        return {
          x: platform.x,
          y: world.floorY + platform.y,
          w: platform.w,
          h: platform.h
        };
      }

      function fallingPlatformRect(platform) {
        return {
          x: platform.x,
          y: world.floorY + platform.y,
          w: platform.w,
          h: platform.h
        };
      }

      function stairRects(stair) {
        if (!stair.active && stair.progress <= 0) return [];
        const out = [];
        const lift = (1 - stair.progress) * 64;
        for (let i = 0; i < stair.steps; i++) {
          out.push({
            x: stair.x + i * stair.stepX,
            y: world.floorY - (i + 1) * stair.stepRise + lift,
            w: stair.stepW,
            h: stair.stepH
          });
        }
        return out;
      }

      function upperTimedPlatformRect(platform) {
        return { x: platform.x, y: world.floorY + platform.y, w: platform.w, h: platform.h };
      }

      function enemyRect(enemy) {
        return {
          x: enemy.x,
          y: world.floorY + enemy.y - enemy.h,
          w: enemy.w,
          h: enemy.h
        };
      }

      function enemyProjectileRect(projectile) {
        return {
          x: projectile.x - projectile.r,
          y: projectile.y - projectile.r,
          w: projectile.r * 2,
          h: projectile.r * 2
        };
      }

      function portalRect() {
        return {
          x: portal.x,
          y: world.floorY + portal.y - portal.h,
          w: portal.w,
          h: portal.h
        };
      }

      function bossRect() {
        if (!boss) return { x: -9999, y: -9999, w: 0, h: 0 };
        return {
          x: boss.x,
          y: world.floorY + boss.y - boss.h,
          w: boss.w,
          h: boss.h
        };
      }

      function resetJumpCapacity() {
        player.airJumpsLeft = player.overdriveTimer > 0 ? 2 : physics.extraJumps;
      }

      function resolveSolidBlockCollisions(prevX, prevY) {
        const prev = { x: prevX, y: prevY, w: player.width, h: player.height };
        let landed = false;

        for (const block of activeSolidLikeBlocks()) {
          const b = solidBlockRect(block);
          if (((player.dropThroughTimer || 0) > 0 || (player.phaseUpTimer || 0) > 0) && b.h <= 36) continue;
          let pr = playerRect();
          if (!rectsOverlap(pr, b)) continue;

          const prevBottom = prev.y + prev.h;
          const prevTop = prev.y;
          const prevRight = prev.x + prev.w;
          const prevLeft = prev.x;

          const fromAbove = prevBottom <= b.y + 8 && player.vy >= 0;
          const fromBelow = prevTop >= b.y + b.h - 8 && player.vy < 0;
          const fromLeft = prevRight <= b.x + 8 && player.vx > 0;
          const fromRight = prevLeft >= b.x + b.w - 8 && player.vx < 0;

          if (fromAbove) {
            player.y = b.y - player.height;
            player.vy = 0;
            player.grounded = true;
            resetJumpCapacity();
            landed = true;
          } else if (fromBelow) {
            player.y = b.y + b.h;
            player.vy = Math.max(0, player.vy);
          } else if (fromLeft) {
            player.x = b.x - player.width;
            player.vx = Math.min(0, player.vx);
          } else if (fromRight) {
            player.x = b.x + b.w;
            player.vx = Math.max(0, player.vx);
          } else {
            const overlapLeft = (player.x + player.width) - b.x;
            const overlapRight = (b.x + b.w) - player.x;
            const overlapTop = (player.y + player.height) - b.y;
            const overlapBottom = (b.y + b.h) - player.y;
            const minOverlap = Math.min(overlapLeft, overlapRight, overlapTop, overlapBottom);

            if (minOverlap === overlapTop) {
              player.y = b.y - player.height;
              player.vy = 0;
              player.grounded = true;
              resetJumpCapacity();
              landed = true;
            } else if (minOverlap === overlapBottom) {
              player.y = b.y + b.h;
              player.vy = Math.max(0, player.vy);
            } else if (minOverlap === overlapLeft) {
              player.x = b.x - player.width;
              player.vx = Math.min(0, player.vx);
            } else {
              player.x = b.x + b.w;
              player.vx = Math.max(0, player.vx);
            }
          }
        }

        return landed;
      }

      function resolveMovingPlatformCollisions(prevX, prevY) {
        const prev = { x: prevX, y: prevY, w: player.width, h: player.height };

        for (const platform of movingPlatforms) {
          if ((player.dropThroughTimer || 0) > 0 || (player.phaseUpTimer || 0) > 0) continue;
          const p = movingPlatformRect(platform);
          const pr = playerRect();
          if (!rectsOverlap(pr, p)) continue;

          const prevBottom = prev.y + prev.h;
          const fromAbove = prevBottom <= p.y + 9 && player.vy >= 0;

          if (fromAbove) {
            player.y = p.y - player.height;
            player.vy = 0;
            player.grounded = true;
            resetJumpCapacity();
            player.x += platform.x - platform.prevX;
          } else {
            const movingRight = platform.x >= platform.prevX;
            if (movingRight) {
              player.x = p.x + p.w;
              player.vx = Math.max(0, player.vx);
            } else {
              player.x = p.x - player.width;
              player.vx = Math.min(0, player.vx);
            }
          }
        }
      }

      function baseGoalsMet() {
        return game.orbs >= game.goalOrbs && game.enemiesDefeated >= game.goalEnemies;
      }

      function bossZoneReached() {
        if (!boss || game.bossDefeated) return false;
        const triggerDistance = Math.max(520, W * 0.55);
        return player.x >= boss.minX - triggerDistance;
      }

      function goalsMet() {
        // Para no bloquear el cierre del nivel si el jugador se saltó algún orbe/enemigo:
        // el portal se abre al derrotar al jefe.
        return game.bossDefeated;
      }

      
      function spawnBossHelpers() {
        if (!boss) return;
        const cx = boss.x + boss.w / 2;
        const cy = boss.y + boss.h * 0.42;
        bossHelpers.length = 0;
        bossHelpers.push(
          { id: "left", x: cx - 130, y: cy - 32, w: 76, h: 58, side: -1, angle: Math.PI, radiusX: 126, radiusY: 48, hp: 3, active: true, hitFlash: 0, respawnTimer: 0 },
          { id: "right", x: cx + 72, y: cy - 32, w: 76, h: 58, side: 1, angle: 0, radiusX: 126, radiusY: 48, hp: 3, active: true, hitFlash: 0, respawnTimer: 0 }
        );
      }

      function helperRect(helper) {
        return { x: helper.x, y: helper.y, w: helper.w, h: helper.h };
      }

      function hitBossHelper(helper, damage = 1) {
        if (!helper.active) return false;
        helper.hp -= damage;
        helper.hitFlash = 0.18;
        if (helper.hp <= 0) {
          helper.active = false;
          helper.respawnTimer = boss && !boss.defeated ? 4.2 : 999;
          helper.hp = 3;
          const cx = helper.x + helper.w / 2;
          const cy = helper.y + helper.h / 2;
          spawnParticles(cx, cy, "#d85a5a", 12);
          if (Math.random() < 0.35) dropEnergyOrb(cx, cy, 1);
          game.score += 40;
          addFloatingText(cx, cy, "-1", "#ff8a8a");
          setMessage("Esbirro derribado", 0.42);
          updateHud();
          return true;
        }
        return false;
      }

      function updateBossHelpers(dt) {
        if (!boss || !boss.active || boss.defeated || boss.spawnHelpers === false) {
          bossHelpers.length = 0;
          return;
        }
        if (!bossHelpers.length) spawnBossHelpers();

        const centerX = boss.x + boss.w / 2;
        const centerY = boss.y + boss.h * 0.42;
        for (const helper of bossHelpers) {
          helper.hitFlash = Math.max(0, helper.hitFlash - dt);
          if (!helper.active) {
            helper.respawnTimer -= dt;
            if (helper.respawnTimer <= 0) {
              helper.active = true;
              helper.hp = 3;
              helper.hitFlash = 0;
              helper.angle = helper.side < 0 ? Math.PI : 0;
            }
            continue;
          }
          helper.angle += dt * 1.55 * helper.side;
          helper.x = centerX + Math.cos(helper.angle) * helper.radiusX - helper.w / 2;
          helper.y = centerY + Math.sin(helper.angle * 1.15) * helper.radiusY - helper.h / 2;

          if (rectsOverlap(playerRect(), helperRect(helper))) {
            damagePlayer(helper.x + helper.w / 2);
          }
        }
      }

      function drawBossHelper(helper) {
        if (!helper.active) return;
        const x = helper.x - world.camX;
        const y = helper.y;
        if (x < -150 || x > W + 150) return;
        const blink = helper.hitFlash > 0 && Math.floor(world.time * 18) % 2 === 0;
        ctx.save();
        const glow = ctx.createRadialGradient(x + helper.w / 2, y + helper.h / 2, 4, x + helper.w / 2, y + helper.h / 2, 58);
        glow.addColorStop(0, "rgba(216,90,90,.35)");
        glow.addColorStop(1, "rgba(216,90,90,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(x + helper.w / 2, y + helper.h / 2, 58, 0, Math.PI * 2);
        ctx.fill();
        ctx.translate(x + helper.w / 2, y + helper.h * 0.95);
        ctx.scale(helper.side < 0 ? -1 : 1, 1);
        if (blink) ctx.globalAlpha = 0.46;
        const helperAsset = getBossAsset((boss && (boss.cloneAssetId || boss.assetId)) || "kharon_lancero_alado");
        if (helperAsset && helperAsset.ready) {
          ctx.drawImage(helperAsset.img, -helper.w * 0.82, -helper.h * 1.28, helper.w * 1.64, helper.h * 1.72);
        } else if (assets.bossWingedReady) {
          ctx.drawImage(assets.bossWinged, -helper.w * 0.82, -helper.h * 1.28, helper.w * 1.64, helper.h * 1.72);
        } else {
          ctx.fillStyle = "#3d2d58";
          ctx.beginPath();
          ctx.ellipse(0, -18, helper.w * 0.33, helper.h * 0.38, 0, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();

        if (debug) {
          ctx.save();
          ctx.strokeStyle = "rgba(214,90,90,.85)";
          ctx.lineWidth = 2;
          ctx.strokeRect(helper.x - world.camX, helper.y, helper.w, helper.h);
          ctx.restore();
        }
      }

      function revealBoss() {

        if (!boss || boss.appeared || game.bossDefeated) return;
        boss.active = true;
        boss.appeared = true;
        boss.state = "patrol";
        boss.stateTimer = boss.patrolTime;
        boss.vulnerable = false;
        if (boss.spawnHelpers !== false) spawnBossHelpers();
        setMessage(boss.name || "Guardián final", 1.4);
        playSfx("bossAppear");
      }

      function refreshPortalState() {
        const shouldRevealBoss = (baseGoalsMet() || bossZoneReached()) && !game.bossDefeated;
        if (shouldRevealBoss) {
          revealBoss();
        }
        if (boss && boss.active && !boss.defeated && boss.spawnHelpers !== false && bossHelpers.length === 0) {
          spawnBossHelpers();
        }
        portal.active = goalsMet();
      }

      function canStandUp() {
        const feetY = player.y + player.height;
        const standRect = {
          x: player.x,
          y: feetY - player.standHeight,
          w: player.width,
          h: player.standHeight
        };

        for (const block of activeSolidLikeBlocks()) {
          if (rectsOverlap(standRect, solidBlockRect(block))) return false;
        }
        for (const platform of movingPlatforms) {
          if (rectsOverlap(standRect, movingPlatformRect(platform))) return false;
        }
        for (const platform of fallingPlatforms) {
          if (platform.active && rectsOverlap(standRect, fallingPlatformRect(platform))) return false;
        }
        return true;
      }

      function applyCrouchState() {
        const wantsCrouch = keys.down && player.grounded && game.status === "playing";
        const feetY = player.y + player.height;

        if (wantsCrouch && !player.isCrouching) {
          player.height = player.crouchHeight;
          player.y = feetY - player.height;
          player.isCrouching = true;
        } else if (!wantsCrouch && player.isCrouching && canStandUp()) {
          player.height = player.standHeight;
          player.y = feetY - player.height;
          player.isCrouching = false;
        }
      }

      function setMessage(message, seconds = 1.4) {
        game.statusMessage = message;
        game.messageTimer = seconds;
        updateHud();
      }

      function registerError(sourceX, label = "Error") {
        if (game.status !== "playing") return;

        game.errors = Math.min(game.errorsPerLife, game.errors + 1);
        addFloatingText(player.x + player.width / 2, player.y - 12, `Error ${game.errors}/${game.errorsPerLife}`, "#d85a5a");

        if (game.errors >= game.errorsPerLife) {
          game.errors = 0;
          game.lives = Math.max(0, game.lives - 1);
          world.shake = Math.max(world.shake, 12);
          setMessage(game.lives > 0 ? `Pierdes 1 vida · quedan ${game.lives}` : "GAME OVER", game.lives > 0 ? 1.1 : 999);
        } else {
          setMessage(`${label} · ${game.errors}/${game.errorsPerLife}`, 0.75);
        }

        if (game.lives <= 0) {
          if (game.energy >= 25) {
            game.lives = 1;
            game.energy = Math.max(0, game.energy - 25);
            player.invulnerable = Math.max(player.invulnerable, 2.2);
            player.vy = -520;
            player.grounded = false;
            world.shake = Math.max(world.shake, 10);
            setMessage("La stamina evita la caída final", 1.0);
            addFloatingText(player.x + player.width / 2, player.y - 20, "RESISTE", "#fff0a8");
          } else {
            game.status = "lost";
            finishRun("lost");
          }
        }

        updateHud();
      }

      function damagePlayer(sourceX) {
        if (game.status !== "playing" || player.invulnerable > 0) return;

        if (player.shieldTimer > 0 || player.overdriveTimer > 0 || player.dashTimer > 0 || (player.bossTransformTimer || 0) > 0) {
          if ((player.bossTransformTimer || 0) > 0) {
            game.energy = Math.max(0, game.energy - 5);
            setMessage("Transformación bloquea el golpe", 0.55);
          } else {
            setMessage(player.overdriveTimer > 0 ? "Overdrive activo" : "Escudo bloqueó el error", 0.55);
          }
          playSfx("shield");
          updateHud();
          return;
        }

        player.invulnerable = 1.05;
        player.hurtFlash = 0.32;
        playSfx("damage");

        const playerCenter = player.x + player.width / 2;
        const pushDir = playerCenter < sourceX ? -1 : 1;
        player.vx = pushDir * 430;
        player.vy = -390;
        player.grounded = false;
        world.shake = Math.max(world.shake, 8);

        if (game.energy > 12) {
          const drain = Math.min(game.energy, 14);
          game.energy = Math.max(0, game.energy - drain);
          addFloatingText(player.x + player.width / 2, player.y - 12, `STA -${drain}`, "#ffb36b");
          setMessage("Stamina absorbió el golpe", 0.65);
          updateHud();
          return;
        }

        registerError(sourceX, "Golpe");
      }

      function collectOrb(orb) {
        if (orb.collected || game.status !== "playing") return;
        orb.collected = true;
        game.orbs += 1;
        game.score += 100;
        playSfx("orb");
        checkScoreRewards();

        refreshPortalState();

        if (goalsMet()) {
          setMessage("Portal activado", 1.2);
        } else {
          setMessage("+100 · Orbe recogido", 0.75);
        }

        updateHud();
      }

      function energyDamageProfile() {
        const pct = clamp(game.energy / game.maxEnergy, 0, 1);

        if (pct >= 0.70) {
          return {
            tier: "high",
            factor: 1,
            label: "alta",
            radius: 8,
            glow: 24,
            core: "#e4c94f",
            aura1: "rgba(228,201,79,.95)",
            aura2: "rgba(109,88,216,.72)"
          };
        }

        if (pct >= 0.30) {
          return {
            tier: "mid",
            factor: 0.6,
            label: "media",
            radius: 6.2,
            glow: 19,
            core: "#d8c66f",
            aura1: "rgba(216,198,111,.72)",
            aura2: "rgba(109,88,216,.42)"
          };
        }

        return {
          tier: "low",
          factor: 0.3,
          label: "crítica",
          radius: 4.8,
          glow: 14,
          core: "#f1e8a8",
          aura1: "rgba(241,232,168,.45)",
          aura2: "rgba(160,150,110,.22)"
        };
      }

      function projectileOrigin(dir) {
        return {
          x: player.x + player.width / 2 + dir * 28,
          y: player.y + 28
        };
      }

      function nearestTarget(x, y, range = 900) {
        let best = null;
        let bestD = range * range;

        for (const enemy of enemies) {
          if (!enemy.active) continue;
          const er = enemyRect(enemy);
          const cx = er.x + er.w / 2;
          const cy = er.y + er.h / 2;
          const d = (cx - x) ** 2 + (cy - y) ** 2;
          if (d < bestD) {
            bestD = d;
            best = { type: "enemy", ref: enemy, x: cx, y: cy };
          }
        }

        if (boss && boss.active && !boss.defeated) {
          const br = bossRect();
          const cx = br.x + br.w / 2;
          const cy = br.y + br.h / 2;
          const d = (cx - x) ** 2 + (cy - y) ** 2;
          if (d < bestD) best = { type: "boss", ref: boss, x: cx, y: cy };
        }

        return best;
      }



      function activateAllies(duration = 10, reason = "pickup") {
        player.allyTimer = Math.max(player.allyTimer || 0, duration);
        player.allyShootTimer = 0.04;
        const p1 = allyCompanionPosition ? allyCompanionPosition(0) : { x: player.x - 72, y: player.y + 20 };
        const p2 = allyCompanionPosition ? allyCompanionPosition(1) : { x: player.x + 72, y: player.y + 20 };
        spawnParticles(p1.x, p1.y, "#7bffbd", 34);
        spawnParticles(p2.x, p2.y, "#a8f0ff", 34);
        addFloatingText(p1.x, p1.y - 28, "S2 LLEGA", "#7bffbd");
        addFloatingText(p2.x, p2.y - 28, "S3 LLEGA", "#a8f0ff");
        setMessage(reason === "boss" ? "S2 y S3 entran al jefe · 10s" : "S2 y S3 aparecen y disparan junto a Aero · 10s", 1.25);
        playSfx("portal");
      }

      function allyCompanionSpecs() {
        return [
          { id: "superhero_2", short: "S2", color: "#7bffbd", side: -1, damage: 1.10 },
          { id: "superhero_3", short: "S3", color: "#a8f0ff", side: 1, damage: 1.05 }
        ];
      }

      function allyCompanionPosition(index = 0) {
        const spec = allyCompanionSpecs()[index] || allyCompanionSpecs()[0];
        const dir = player.dir || 1;
        const spread = game.flightMode ? 70 : 58;
        const side = spec.side;
        const hover = Math.sin(world.time * 4.8 + index * 2.1) * (game.flightMode ? 10 : 14);
        const lead = game.flightMode ? dir * 10 : 0;
        const rawX = player.x + player.width / 2 + side * spread + lead;
        const rawY = player.y + player.height * (game.flightMode ? 0.50 : 0.52) - (game.flightMode ? 8 : 24) + hover;
        const screenX = rawX - world.camX;
        const clampedScreenX = clamp(screenX, 72, W - 72);
        return {
          x: world.camX + clampedScreenX,
          y: clamp(rawY, 76, world.floorY - 18),
          dir
        };
      }

      function fireAllyCompanionShot(spec, index = 0) {
        if (game.status !== "playing" || (player.allyTimer || 0) <= 0) return;
        if (sparks.length >= sparkConfig.maxOnScreen + 34) return;

        const pos = allyCompanionPosition(index);
        const target = nearestTarget(pos.x, pos.y, 1100);
        let dir = player.dir || 1;
        let angle = 0;

        if (target) {
          const dx = target.x - pos.x;
          const dy = target.y - pos.y;
          dir = dx < 0 ? -1 : 1;
          angle = clamp(Math.atan2(dy, Math.max(1, Math.abs(dx))) * dir, -0.52, 0.52);
        }

        const shot = createSparkPayload(dir, true, {
          type: "laser",
          angle,
          speed: 1080,
          life: 1.22,
          r: 10,
          glow: 48,
          damageMultiplier: spec.damage,
          coreColor: "#ffffff",
          aura1: spec.color === "#7bffbd" ? "rgba(123,255,189,.95)" : "rgba(168,240,255,.95)",
          aura2: spec.color === "#7bffbd" ? "rgba(0,208,128,.68)" : "rgba(109,88,216,.62)",
          sparkle: true,
          pierce: true,
          homing: !!target,
          homingTurn: 4.4
        });
        shot.x = pos.x + dir * 26;
        shot.y = pos.y - (game.flightMode ? 2 : 8);
        shot.ally = spec.short;
        sparks.push(shot);

        spawnParticles(shot.x, shot.y, spec.color, 4);
      }

      function updateAllyCompanions(dt) {
        if ((player.allyTimer || 0) <= 0) return;
        player.allyShootTimer = Math.max(0, (player.allyShootTimer || 0) - dt);
        if (player.allyShootTimer <= 0) {
          allyCompanionSpecs().forEach((spec, index) => fireAllyCompanionShot(spec, index));
          player.allyShootTimer = player.overdriveTimer > 0 ? 0.16 : 0.22;
        }
        if (Math.floor((player.allyTimer || 0) * 10) % 20 === 0 && Math.random() < 0.10) {
          const pos = allyCompanionPosition(Math.random() < 0.5 ? 0 : 1);
          spawnParticles(pos.x, pos.y, "#7bffbd", 2);
        }
      }

      function drawMiniFlightAlly(spec, index, screenX, screenY) {
        ctx.save();
        const dir = player.dir || 1;
        const tilt = Math.sin(world.time * 4 + index) * 0.12;
        ctx.translate(screenX, screenY);
        ctx.rotate(tilt);
        ctx.scale(dir, 1);

        const glow = ctx.createRadialGradient(0, 0, 4, 0, 0, 48);
        glow.addColorStop(0, spec.color === "#7bffbd" ? "rgba(123,255,189,.50)" : "rgba(168,240,255,.48)");
        glow.addColorStop(1, "rgba(109,88,216,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(0, 0, 48, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = spec.color;
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(34, 0);
        ctx.lineTo(-28, -18);
        ctx.lineTo(-16, 0);
        ctx.lineTo(-28, 18);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#ffffff";
        ctx.beginPath();
        ctx.arc(8, -4, 7, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
      }

      function drawAllyAvatarFigure(spec, index, screenX, screenY) {
        const profile = avatarProfiles[spec.id] || avatarProfiles.classic;
        const asset = getAvatarAsset(spec.id);
        const facing = player.dir || 1;
        const scale = spec.id === "superhero_3" ? 0.82 : 0.84;
        const drawW = (profile.drawW || 78) * scale;
        const drawH = (profile.drawH || 96) * scale;

        ctx.save();
        const pulse = 1 + Math.sin(world.time * 5 + index) * 0.04;
        ctx.translate(screenX, screenY);
        ctx.scale(facing * pulse, pulse);

        const glow = ctx.createRadialGradient(0, -drawH * 0.45, 4, 0, -drawH * 0.45, 62);
        glow.addColorStop(0, spec.color === "#7bffbd" ? "rgba(123,255,189,.38)" : "rgba(168,240,255,.34)");
        glow.addColorStop(1, "rgba(109,88,216,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(0, -drawH * 0.45, 62, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "rgba(20,25,35,.22)";
        ctx.beginPath();
        ctx.ellipse(0, 3, drawW * 0.38, 8, 0, 0, Math.PI * 2);
        ctx.fill();

        if (asset && asset.ready) {
          ctx.drawImage(asset.img, -drawW / 2, -drawH, drawW, drawH);
        } else {
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 3;
          ctx.fillStyle = spec.color;
          ctx.beginPath();
          ctx.arc(0, -drawH * 0.74, 14, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();

          ctx.strokeStyle = "#111";
          ctx.lineWidth = 5;
          ctx.lineCap = "round";
          ctx.beginPath();
          ctx.moveTo(0, -drawH * 0.60);
          ctx.lineTo(0, -drawH * 0.26);
          ctx.moveTo(0, -drawH * 0.48);
          ctx.lineTo(-20, -drawH * 0.38);
          ctx.moveTo(0, -drawH * 0.48);
          ctx.lineTo(22, -drawH * 0.54);
          ctx.moveTo(0, -drawH * 0.26);
          ctx.lineTo(-14, -drawH * 0.02);
          ctx.moveTo(0, -drawH * 0.26);
          ctx.lineTo(16, -drawH * 0.02);
          ctx.stroke();
        }

        ctx.restore();
      }

      function drawAllyCompanions() {
        if ((player.allyTimer || 0) <= 0 || game.status !== "playing") return;
        const remaining = Math.ceil(player.allyTimer || 0);

        allyCompanionSpecs().forEach((spec, index) => {
          const pos = allyCompanionPosition(index);
          const sx = pos.x - world.camX;
          const sy = pos.y;
          if (sx < -120 || sx > W + 120) return;

          if (game.flightMode) {
            drawMiniFlightAlly(spec, index, sx, sy);
          } else {
            drawAllyAvatarFigure(spec, index, sx, sy + 34);
          }

          ctx.save();
          ctx.fillStyle = "rgba(20,25,35,.70)";
          roundRect(ctx, sx - 24, sy - 54, 48, 22, 10);
          ctx.fill();
          ctx.fillStyle = spec.color;
          ctx.font = "900 12px system-ui, sans-serif";
          ctx.textAlign = "center";
          ctx.fillText(`${spec.short} ${remaining}s`, sx, sy - 38);

          ctx.strokeStyle = spec.color;
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(sx + (player.dir || 1) * 18, sy - 18);
          ctx.lineTo(sx + (player.dir || 1) * (48 + Math.sin(world.time * 18 + index) * 8), sy - 18);
          ctx.stroke();
          ctx.restore();
        });
      }

      function createSparkPayload(dir, power = false, options = {}) {
        const profile = energyDamageProfile();
        const avatarProfile = activeAvatarProfile();
        const fire = player.fireBoostTimer > 0;
        const type = options.type || "spark";
        const angle = options.angle ?? 0;
        const speed = options.speed || sparkConfig.speed;
        const transformBoost = (player.bossTransformTimer || 0) > 0 ? 1.95 : 1;
        const damageMultiplier = (power ? 1.35 : 1) * (fire ? 2.15 : 1) * transformBoost * (avatarProfile.damageMultiplier || 1) * (options.damageMultiplier || 1);
        const fireBonusLife = fire ? 0.55 : 0;
        const fireBonusRadius = fire ? 9 : 0;
        const fireBonusGlow = fire ? 28 : 0;
        const avatarRadiusBonus = avatarProfile.radiusBonus || 0;
        const avatarLifeBonus = avatarProfile.lifeBonus || 0;
        const origin = projectileOrigin(dir);
        const vx = dir * Math.cos(angle) * speed * (power ? 1.18 : 1) * (fire ? 1.12 : 1);
        const vy = Math.sin(angle) * speed * (power ? 1.06 : 1);

        return {
          type,
          x: origin.x + dir * (power || fire ? 8 : 0),
          y: origin.y + (options.yOffset || 0),
          vx,
          vy,
          gravity: options.gravity || 0,
          life: options.life || ((power ? 1.25 : sparkConfig.life) + fireBonusLife + avatarLifeBonus),
          r: (options.r ?? (profile.radius + (power ? 6 : 0) + fireBonusRadius + avatarRadiusBonus)),
          glow: (options.glow ?? (profile.glow + (power ? 10 : 0) + fireBonusGlow + avatarRadiusBonus * 5)),
          damage: sparkConfig.baseDamage * profile.factor * damageMultiplier,
          energyTier: options.energyTier || (fire ? "fire" : profile.tier),
          coreColor: options.coreColor || (fire ? "#ffef9a" : (power ? "#ffffff" : profile.core)),
          aura1: options.aura1 || (fire ? "rgba(255,120,48,.95)" : (power ? "rgba(255,255,255,.95)" : profile.aura1)),
          aura2: options.aura2 || (fire ? "rgba(216,90,90,.72)" : (power ? profile.aura1 : profile.aura2)),
          power: power || fire || options.pierce || type === "laser",
          fire,
          homing: !!options.homing,
          homingTurn: options.homingTurn || 0,
          explosive: !!options.explosive,
          explosionRadius: options.explosionRadius || 0,
          sparkle: !!options.sparkle,
          age: 0,
          hits: new Set()
        };
      }

      function createLaserPayload(dir, angle = 0, power = false) {
        return createSparkPayload(dir, power, {
          type: "laser",
          angle,
          speed: power ? 1280 : 1120,
          life: power ? 0.72 : 0.55,
          r: power ? 7 : 5,
          glow: power ? 46 : 34,
          damageMultiplier: power ? 1.45 : 1.05,
          coreColor: power ? "#ffffff" : "#a8f0ff",
          aura1: "rgba(168,240,255,.95)",
          aura2: "rgba(109,88,216,.60)",
          sparkle: true,
          pierce: true
        });
      }

      function createGrenadePayload(dir) {
        return createSparkPayload(dir, false, {
          type: "grenade",
          angle: -0.45,
          speed: 540,
          gravity: 1220,
          life: 1.65,
          r: 10,
          glow: 32,
          damageMultiplier: 1.55,
          coreColor: "#2c263e",
          aura1: "rgba(228,201,79,.88)",
          aura2: "rgba(216,90,90,.42)",
          explosive: true,
          explosionRadius: 92
        });
      }

      function createRocketPayload(dir) {
        return createSparkPayload(dir, false, {
          type: "rocket",
          angle: -0.05,
          speed: 580,
          life: 2.25,
          r: 9,
          glow: 38,
          damageMultiplier: 1.7,
          coreColor: "#ffef9a",
          aura1: "rgba(255,120,48,.95)",
          aura2: "rgba(216,90,90,.70)",
          homing: true,
          homingTurn: 6.2,
          explosive: true,
          explosionRadius: 78
        });
      }

      function explodeProjectile(s) {
        if (!s || !s.explosive) return;
        const radius = s.explosionRadius || 80;
        spawnParticles(s.x, s.y, s.type === "rocket" ? "#ff9a3d" : "#e4c94f", s.type === "rocket" ? 34 : 26);
        spawnParticles(s.x, s.y, "#fff0a8", s.type === "rocket" ? 16 : 12);
        world.shake = Math.max(world.shake, s.type === "rocket" ? 14 : 10);
        addFloatingText(s.x, s.y - 12, 'BOOM', s.type === 'rocket' ? '#ff7a36' : '#e4c94f');

        for (const enemy of enemies) {
          if (!enemy.active) continue;
          const er = enemyRect(enemy);
          const cx = er.x + er.w / 2;
          const cy = er.y + er.h / 2;
          if ((cx - s.x) ** 2 + (cy - s.y) ** 2 <= radius * radius) {
            hitEnemy(enemy, Math.sign(s.vx) || 1, s.damage * 0.85);
          }
        }

        if (boss && boss.active && !boss.defeated) {
          const br = bossRect();
          const cx = br.x + br.w / 2;
          const cy = br.y + br.h / 2;
          if ((cx - s.x) ** 2 + (cy - s.y) ** 2 <= (radius + 30) * (radius + 30)) {
            hitBoss(s.damage * 0.75, s);
          }
        }
        playSfx("bossHit");
      }

      function formatHp(value) {
        return Number.isInteger(value) ? `${value}` : `${Math.max(0, value).toFixed(1)}`;
      }

      function dropEnergyOrb(worldX, screenY, chance = sparkConfig.energyDropChance) {
        if (Math.random() > chance) return;

        energyPickups.push({
          type: "energy",
          x: worldX,
          y: screenY - world.floorY,
          r: 10,
          amount: sparkConfig.energyDropAmount,
          collected: false,
          dropped: true,
          vx: Math.random() * 80 - 40,
          vy: -90 - Math.random() * 80
        });

        spawnParticles(worldX, screenY, "#d85a5a", 6);
      }

      function addFloatingText(x, y, text, color = "#ffffff") {
        floatingTexts.push({
          x,
          y,
          text,
          color,
          life: 0.8,
          maxLife: 0.8,
          vy: -46
        });
      }

      function updateFloatingTexts(dt) {
        for (let i = floatingTexts.length - 1; i >= 0; i--) {
          const ft = floatingTexts[i];
          ft.y += ft.vy * dt;
          ft.life -= dt;
          if (ft.life <= 0) floatingTexts.splice(i, 1);
        }
      }

      function drawFloatingTexts() {
        ctx.save();
        ctx.font = "900 15px system-ui, -apple-system, Segoe UI, sans-serif";
        ctx.textAlign = "center";
        ctx.lineWidth = 4;

        for (const ft of floatingTexts) {
          const alpha = clamp(ft.life / ft.maxLife, 0, 1);
          const sx = ft.x - world.camX;
          const sy = ft.y;
          ctx.globalAlpha = alpha;
          ctx.strokeStyle = "rgba(20,25,35,.82)";
          ctx.fillStyle = ft.color;
          ctx.strokeText(ft.text, sx, sy);
          ctx.fillText(ft.text, sx, sy);
        }

        ctx.restore();
      }

      function grantShieldPrize(reason = "Premio") {
        if (game.shields >= game.maxShields) return false;

        game.shields += 1;
        addFloatingText(player.x + player.width / 2, player.y - 18, "+🛡", "#6cdcff");
        setMessage(`${reason}: escudo disponible`, 1.0);
        playSfx("shieldOn");
        updateHud();
        return true;
      }

      function activateShield() {
        if (game.status !== "playing") return;
        if (player.shieldTimer > 0) {
          setMessage("Escudo ya activo", 0.6);
          return;
        }
        if (game.shields <= 0) {
          setMessage("Sin escudos guardados", 0.65);
          return;
        }

        game.shields -= 1;
        player.shieldTimer = Math.max(player.shieldTimer, 5.5);
        addFloatingText(player.x + player.width / 2, player.y - 18, "ESCUDO", "#6cdcff");
        setMessage("Escudo activado", 0.8);
        playSfx("shieldOn");
        updateHud();
      }

      function spawnProgressPowerupReward(reason = "Premio especial") {
        const spawnX = Math.min(levelEndX() - 720, player.x + 155);
        const spawnY = Math.min(-86, player.y - world.floorY - 28);
        firePickups.push(makeFirePickup({
          x: spawnX,
          y: spawnY,
          r: 18,
          duration: 8.5,
          assetId: "reward_powerup_1",
          rewardType: "combo",
          fromProgress: true
        }));
        addFloatingText(spawnX, world.floorY + spawnY - 22, "POWER-UP", "#e4c94f");
        setMessage(`${reason}: power-up emergente`, 1.0);
        playSfx("portal");
      }

      function checkScoreRewards() {
        while (game.score >= game.nextShieldScore) {
          grantShieldPrize("Premio por puntos");
          game.nextShieldScore += game.shieldScoreStep;
        }
        while (game.score >= game.nextPowerupScore) {
          spawnProgressPowerupReward("Avance logrado");
          game.nextPowerupScore += game.powerupScoreStep;
        }
      }

      function collectEnergyPickup(item) {
        if (item.collected || game.status !== "playing") return;
        item.collected = true;
        game.energy = Math.min(game.maxEnergy, game.energy + item.amount);
        game.score += 30;
        addFloatingText(item.x, world.floorY + item.y - 18, `+${item.amount} STA`, "#d85a5a");
        setMessage(`+${item.amount} stamina`, 0.8);
        playSfx("heal");
        checkScoreRewards();
        updateHud();
      }

      function collectShieldPickup(item) {
        if (item.collected || game.status !== "playing") return;
        item.collected = true;
        game.score += 40;
        addFloatingText(item.x, world.floorY + item.y - 18, "+ESCUDO", "#6cdcff");
        grantShieldPrize("Escudo ganado");
        checkScoreRewards();
        updateHud();
      }

      function collectFirePickup(item) {
        if (item.collected || game.status !== "playing") return;
        item.collected = true;

        const rewardType = item.rewardType || "fire";
        const specialWeaponMap = {
          triplePower: { weapon: "triple", label: "PODER TRIPLE", color: "#e4c94f", message: "Poder triple recogido: centro + diagonales" },
          laserPower: { weapon: "laser", label: "LÁSER", color: "#a8f0ff", message: "Láser unitario recogido" },
          grenadePower: { weapon: "grenade", label: "GRANADAS", color: "#ffb05a", message: "Granadas listas" },
          rocketPower: { weapon: "rocket", label: "COHETES", color: "#ff7a36", message: "Cohetes térmicos activados" },
          tripleNova: { weapon: "triple", label: "TRIPLE NOVA", color: "#fff0a8", message: "Triple Nova: disparo triple potenciado" },
          stormLaser: { weapon: "laser", label: "TORMENTA LÁSER", color: "#a8f0ff", message: "Tormenta láser chispeante" },
          bossTransform: { weapon: "laser", label: "TRANSFORMACIÓN", color: "#ff4bd8", message: "Transformación de Aero: arma brillante anti-jefe" },
          allyCall: { weapon: "laser", label: "ALIADOS", color: "#7bffbd", message: "Aliados S2 y S3 entran al combate" }
        };

        if (specialWeaponMap[rewardType]) {
          const prize = specialWeaponMap[rewardType];
          setWeaponModeById(prize.weapon, false);
          player.specialWeaponTimer = Math.max(player.specialWeaponTimer || 0, item.specialDuration ?? 10.0);
          player.specialWeaponRestorePending = true;
          player.overdriveTimer = Math.max(player.overdriveTimer, item.overdrive ?? 5.0);
          player.fireBoostTimer = Math.max(player.fireBoostTimer, item.duration ?? 8.5);
          if (rewardType === "bossTransform") {
            player.bossTransformTimer = Math.max(player.bossTransformTimer || 0, item.transformDuration ?? 10.0);
            if (boss && boss.active && !boss.defeated) {
              const wound = Math.min(boss.maxHp * 0.22, Math.max(8, boss.hp - 3));
              boss.hp = Math.max(3, boss.hp - wound);
              boss.hitFlash = 0.75;
              world.shake = Math.max(world.shake, 18);
              spawnParticles(boss.x + boss.w / 2, world.floorY + boss.y - boss.h / 2, prize.color, 44);
              addFloatingText(boss.x + boss.w / 2, world.floorY + boss.y - boss.h - 24, `-${wound.toFixed(1)} HERIDA`, prize.color);
            }
          }
          if (rewardType === "allyCall") {
            activateAllies(item.allyDuration ?? 10.0, "pickup");
          }
          game.energy = Math.min(game.maxEnergy, game.energy + (item.energy ?? 35));
          if ((item.shield ?? 0) > 0 && game.shields < game.maxShields) game.shields += item.shield;
          game.score += item.score ?? 180;
          spawnParticles(item.x, world.floorY + item.y, prize.color, 22);
          addFloatingText(item.x, world.floorY + item.y - 18, prize.label, prize.color);
          setMessage(`${prize.message} · ${Math.round(item.specialDuration ?? 10)}s`, 1.15);
          playSfx("portal");
          checkScoreRewards();
          updateHud();
          return;
        }

        const isCombo = rewardType === "combo" || item.assetId === "reward_powerup_1";
        player.fireBoostTimer = Math.max(player.fireBoostTimer, item.duration ?? 7);
        if (isCombo) {
          game.energy = Math.min(game.maxEnergy, game.energy + 30);
          if (game.shields < game.maxShields) game.shields += 1;
          game.score += 130;
          addFloatingText(item.x, world.floorY + item.y - 18, "+POWER", "#e4c94f");
          setMessage("Power-up ganado · fuego + stamina + escudo", 1.15);
        } else {
          game.score += 90;
          addFloatingText(item.x, world.floorY + item.y - 18, "FUEGO", "#ff9a3d");
          setMessage("Disparo de fuego aumentado", 1.0);
        }
        playSfx("portal");
        updateHud();
      }

      function burnPlayer(sourceX, amount = 10) {
        if (game.status !== "playing" || player.flameCooldown > 0) return;
        player.flameCooldown = 0.48;
        player.hurtFlash = 0.18;
        const adjustedAmount = Math.max(1, Math.round(amount * activeAvatarProfile().flameStaminaMultiplier));
        game.energy = Math.max(0, game.energy - adjustedAmount);
        addFloatingText(player.x + player.width / 2, player.y - 10, `-${adjustedAmount} STA`, "#ff7a36");
        setMessage("¡Quema! Pierdes stamina", 0.55);
        world.shake = Math.max(world.shake, 4);
        playSfx("damage");
        if (game.energy <= 0) {
          registerError(sourceX, "Quemadura");
        }
        updateHud();
      }

function collectFlowOrb(item) {
        if (item.collected || game.status !== "playing") return;
        item.collected = true;
        player.overdriveTimer = Math.max(player.overdriveTimer, item.duration);
        player.airJumpsLeft = 2;
        game.score += 120;
        setMessage("Orbe de Flujo · Overdrive", 1.0);
        playSfx("portal");
        updateHud();
      }

      function updateHud() {
        const pct = clamp(game.energy / game.maxEnergy, 0, 1);
        livesText.textContent = "♥".repeat(game.lives) + "·".repeat(game.maxLives - game.lives);
        errorsText.textContent = `${game.errors}/${game.errorsPerLife}`;
        energyFill.style.width = `${Math.round(pct * 100)}%`;
        energyText.textContent = `${Math.round(pct * 100)}%`;
        if (pct <= 0.25) {
          energyFill.style.background = "linear-gradient(90deg, #d85a5a, #f1e8a8)";
        } else {
          energyFill.style.background = "linear-gradient(90deg, #d85a5a, #e4c94f)";
        }
        orbsText.textContent = `${game.orbs}/${game.goalOrbs}`;
        enemiesText.textContent = `${game.enemiesDefeated}/${game.goalEnemies}`;
        shieldText.textContent = player.fireBoostTimer > 0 ? `🔥${player.fireBoostTimer.toFixed(1)}s` : (player.overdriveTimer > 0 ? `F${player.overdriveTimer.toFixed(1)}s` : (player.shieldTimer > 0 ? `${player.shieldTimer.toFixed(1)}s` : `${currentWeapon().icon} x${game.shields}`));
        if (!boss || (!boss.appeared && !game.bossDefeated)) bossText.textContent = "—";
        else if (game.bossDefeated) bossText.textContent = "OK";
        else bossText.textContent = `${formatHp(boss.hp)}/${boss.maxHp}`;
        scoreText.textContent = `${game.score}`;
        if (playerNameText) playerNameText.textContent = playerName;
        if (totalScoreText) totalScoreText.textContent = String(Math.round(totalScore));
        if (overlayTotalScore) overlayTotalScore.textContent = String(Math.round(totalScore));
        if (overlayAvatarName) overlayAvatarName.textContent = activeAvatarProfile().short || "Aero";
      }

      function hitEnemy(enemy, impactDir = 0, damageAmount = sparkConfig.baseDamage) {
        if (!enemy.active) return;

        enemy.hp -= damageAmount;
        enemy.hitFlash = 0.22;

        if (enemy.hp <= 0) {
          enemy.active = false;
          if (enemy.countsForGoal) game.enemiesDefeated += 1;
          game.score += enemy.countsForGoal ? 150 : 40;

          const cx = enemy.x + enemy.w / 2;
          const cy = world.floorY + enemy.y - enemy.h / 2;
          addFloatingText(cx, cy - 18, `-${damageAmount.toFixed(1)}`, "#d85a5a");
          spawnParticles(cx, cy, enemy.kind === "spawner" ? "#e4c94f" : "#6d58d8", enemy.kind === "spawner" ? 14 : 9);
          dropEnergyOrb(cx, cy);
          world.shake = Math.max(world.shake, enemy.kind === "spawner" ? 8 : 5);

          playSfx("enemy");
          checkScoreRewards();
          refreshPortalState();
          setMessage(baseGoalsMet() && !game.bossDefeated ? "El Guardián aparece" : "+150 · Sombra vencida", 1.0);
        } else {
          const dir = impactDir || ((enemy.x + enemy.w / 2) < (player.x + player.width / 2) ? -1 : 1);
          addFloatingText(enemy.x + enemy.w / 2, world.floorY + enemy.y - enemy.h - 12, `-${damageAmount.toFixed(1)}`, "#d85a5a");
          enemy.stunTimer = 0.3;
          enemy.x = clamp(enemy.x + dir * 15, enemy.minX, enemy.maxX - enemy.w);
          game.score += 25;
          playSfx("hit");
          setMessage(`+25 · Daño ${damageAmount.toFixed(1)}`, 0.55);
        }

        updateHud();
      }

      function hitBoss(damageAmount = sparkConfig.baseDamage, source = null) {
        if (!boss || !boss.active || boss.defeated) return false;

        if (boss.state === "vanish" || boss.state === "rage" || boss.invulnTimer > 0) {
          setMessage("No hay blanco claro", 0.42);
          playSfx("hit");
          return true;
        }

        boss.hitFlash = 0.22;

        if (boss.state === "charge" || boss.state === "precharge") {
          setMessage(boss.state === "precharge" ? "Espera · va a embestir" : "Rebota · embestida invulnerable", 0.7);
          playSfx("hit");
          return true;
        }

        const sourceType = source && source.type ? source.type : "spark";
        const simpleShot = sourceType === "spark" && !(source && (source.fire || source.power || source.explosive || source.homing));
        let resistance = simpleShot ? 0.10 : (sourceType === "laser" ? 0.42 : (source && source.explosive ? 0.62 : 0.34));
        if (boss.enraged) resistance *= 0.72;
        const damage = boss.state === "rest" ? damageAmount * resistance * 1.42 : damageAmount * resistance;
        boss.hp -= damage;
        addFloatingText(boss.x + boss.w / 2, world.floorY + boss.y - boss.h - 14, `-${damage.toFixed(1)}`, boss.state === "rest" ? "#e4c94f" : "#d85a5a");
        game.score += boss.state === "rest" ? 90 : 45;
        checkScoreRewards();
        playSfx("bossHit");

        if (boss.hp <= 0) {
          boss.active = false;
          boss.defeated = true;
          game.bossDefeated = true;
          bossHelpers.length = 0;
          bossClones.length = 0;
          game.score += 500;
          checkScoreRewards();

          const cx = boss.x + boss.w / 2;
          const cy = world.floorY + boss.y - boss.h / 2;
          spawnParticles(cx, cy, "#e4c94f", 22);
          dropEnergyOrb(cx - 28, cy, 1);
          dropEnergyOrb(cx, cy - 18, 1);
          dropEnergyOrb(cx + 28, cy, 1);
          grantShieldPrize("Jefe vencido");
          world.shake = Math.max(world.shake, 12);

          refreshPortalState();
          startWorld1EscapeCue();
          setMessage(game.currentLevel === 1 ? "Empuñadura localizada · Sombra huye" : (game.currentLevel === 2 ? "Canalizador localizado · Sombra huye" : (game.currentLevel === 3 ? "Estabilizador localizado · Sombra huye" : "Punta final localizada · Sombra huye")), 1.7);
          playSfx("bossDefeat");
        } else {
          setMessage(boss.state === "rest" ? `Golpe crítico · ${formatHp(boss.hp)}/${boss.maxHp}` : `${boss.name || "Jefe"} ${formatHp(boss.hp)}/${boss.maxHp}`, 0.7);
        }

        updateHud();
        return true;
      }

      function launchSpark() {
        if (game.status !== "playing") return;
        if (player.attackCooldown > 0) return;
        const weapon = currentWeapon();
        const dir = player.dir || 1;

        if (sparks.length >= sparkConfig.maxOnScreen) return;

        if (weapon.id === "spark") {
          sparks.push(createSparkPayload(dir, false, { angle: 0, damageMultiplier: 0.95 }));
        } else if (weapon.id === "triple") {
          sparks.push(createSparkPayload(dir, false, { angle: 0 }));
          sparks.push(createSparkPayload(dir, false, { angle: -0.34, yOffset: -5, damageMultiplier: 0.85 }));
          sparks.push(createSparkPayload(dir, false, { angle: 0.34, yOffset: 5, damageMultiplier: 0.85 }));
        } else if (weapon.id === "laser") {
          sparks.push(createLaserPayload(dir, 0, false));
        } else if (weapon.id === "grenade") {
          sparks.push(createGrenadePayload(dir));
        } else if (weapon.id === "rocket") {
          sparks.push(createRocketPayload(dir));
        }

        player.attackCooldown = (player.overdriveTimer > 0 ? weapon.cooldown * 0.55 : weapon.cooldown);
        player.attackFlash = 0.12;
        playSfx(weapon.id === "grenade" ? "hit" : "spark");
      }

      function launchPowerSpark() {
        if (game.status !== "playing") return;
        if (sparks.length >= sparkConfig.maxOnScreen + 8) return;

        const dir = player.dir || 1;
        const weapon = currentWeapon();

        if (weapon.id === "spark") {
          sparks.push(createSparkPayload(dir, true, { angle: 0, type: "laser", speed: 980, life: 0.8, sparkle: true }));
          sparks.push(createSparkPayload(dir, true, { angle: -0.18, yOffset: -4, damageMultiplier: 0.92 }));
          sparks.push(createSparkPayload(dir, true, { angle: 0.18, yOffset: 4, damageMultiplier: 0.92 }));
          setMessage("Pulso reforzado", 0.75);
        } else if (weapon.id === "laser") {
          sparks.push(createLaserPayload(dir, 0, true));
          sparks.push(createLaserPayload(dir, -0.25, true));
          sparks.push(createLaserPayload(dir, 0.25, true));
          setMessage("Triple láser chispeante", 0.75);
        } else if (weapon.id === "rocket") {
          sparks.push(createRocketPayload(dir));
          sparks.push(createRocketPayload(dir));
          setMessage("Cohetes térmicos", 0.75);
        } else if (weapon.id === "grenade") {
          sparks.push(createGrenadePayload(dir));
          setTimeout(() => sparks.push(createGrenadePayload(dir)), 90);
          setMessage("Doble granada", 0.75);
        } else {
          sparks.push(createSparkPayload(dir, true, { angle: 0, type: "laser", speed: 1150, life: 0.65, sparkle: true, pierce: true }));
          sparks.push(createSparkPayload(dir, true, { angle: -0.35, yOffset: -5, damageMultiplier: 0.95 }));
          sparks.push(createSparkPayload(dir, true, { angle: 0.35, yOffset: 5, damageMultiplier: 0.95 }));
          setMessage("Triple disparo potenciado", 0.75);
        }

        player.attackFlash = 0.22;
        world.shake = Math.max(world.shake, 4);
        playSfx("portal");
      }


      function spawnBreakableReward(block, bx, rect) {
        const y = rect.y - world.floorY - 26;
        if (block.reward === "fireBoost") {
          firePickups.push(makeFirePickup({ x: bx + 30, y, r: 16, duration: 8, revealed: true }));
          setMessage("Impulsador de fuego liberado", 0.8);
        } else if (block.reward === "shield") {
          shieldPickups.push(makePickup({ x: bx, y, r: 15, duration: 6.0, revealed: true }, "shield"));
          setMessage("Escudo oculto liberado", 0.8);
        } else if (block.reward === "energy") {
          energyPickups.push(makePickup({ x: bx, y, r: 14, amount: 35, revealed: true }, "energy"));
          setMessage("Stamina oculta liberada", 0.8);
        } else if (block.reward === "flow") {
          flowOrbs.push(makeFlowOrb({ x: bx, y, r: 16, duration: 5.2, revealed: true }));
          setMessage("Orbe de flujo liberado", 0.8);
        } else if (block.reward === "combo") {
          firePickups.push(makeFirePickup({ x: bx, y, r: 18, duration: 9, assetId: "reward_powerup_1", rewardType: "combo", revealed: true }));
          setMessage("Premio especial oculto", 0.9);
        }
      }

      function updateSparks(dt) {
        for (let i = sparks.length - 1; i >= 0; i--) {
          const s = sparks[i];

          s.age = (s.age || 0) + dt;

          if (s.homing) {
            const target = nearestTarget(s.x, s.y, 820);
            if (target) {
              const dx = target.x - s.x;
              const dy = target.y - s.y;
              const len = Math.max(1, Math.hypot(dx, dy));
              const desiredVx = (dx / len) * 670;
              const desiredVy = (dy / len) * 670;
              const turn = Math.min(1, (s.homingTurn || 5) * dt);
              s.vx += (desiredVx - s.vx) * turn;
              s.vy += (desiredVy - (s.vy || 0)) * turn;
            }
          }

          if (s.gravity) s.vy = (s.vy || 0) + s.gravity * dt;
          s.x += s.vx * dt;
          s.y += (s.vy || 0) * dt;
          s.life -= dt;

          if (s.sparkle && Math.random() < 0.38) {
            spawnParticles(s.x, s.y, s.type === "laser" ? "#a8f0ff" : "#e4c94f", 2);
          }

          if (s.life <= 0 || s.x < -160 || s.x > levelEndX() + 900 || s.y > H + 140 || s.y < -260) {
            if (s.explosive) explodeProjectile(s);
            sparks.splice(i, 1);
            continue;
          }

          let sparkUsed = false;

          for (const block of breakableBlocks) {
            if (!block.active) continue;
            const rect = solidBlockRect(block);
            if (circleRectCollision(s.x, s.y, s.r + 2, rect)) {
              block.active = false;
              if (!s.power || s.explosive) sparks.splice(i, 1);
              sparkUsed = !s.power || s.explosive;

              const bx = block.x + block.w / 2;
              const by = rect.y + block.h / 2;
              spawnParticles(bx, by, block.kind === "brick" ? "#b05a38" : "#9aa0aa", 14);
              const rewardLabel = block.reward === "fireBoost" ? "FUEGO" : (block.reward === "shield" ? "ESCUDO" : (block.reward === "energy" ? "STA" : (block.reward === "flow" ? "FLUJO" : (block.reward === "combo" ? "POWER" : "ROTO"))));
              const rewardColor = block.reward === "fireBoost" ? "#ff9a3d" : (block.reward === "shield" ? "#6cdcff" : (block.reward === "energy" ? "#d85a5a" : (block.reward === "flow" ? "#a8f0ff" : (block.reward === "combo" ? "#e4c94f" : "#cfd4df"))));
              addFloatingText(bx, by - 20, rewardLabel, rewardColor);
              spawnBreakableReward(block, bx, rect);
              world.shake = Math.max(world.shake, 6);
              playSfx("hit");
              if (s.explosive) explodeProjectile(s);
              break;
            }
          }

          if (sparkUsed) continue;

          for (const obstacle of obstacles) {
            if (!obstacle.active) continue;
            const rect = {
              x: obstacle.x,
              y: world.floorY - obstacle.h,
              w: obstacle.w,
              h: obstacle.h
            };
            if (circleRectCollision(s.x, s.y, s.r + 1, rect)) {
              if (!s.power || s.explosive) sparks.splice(i, 1);
              sparkUsed = !s.power || s.explosive;

              if (obstacle.breakable) {
                obstacle.active = false;
                game.score += obstacle.reward || 50;
                checkScoreRewards();
                const dropX = obstacle.x + obstacle.w / 2;
                const dropY = world.floorY - obstacle.h / 2;
                spawnParticles(dropX, dropY, "#6d58d8", 10);
                dropEnergyOrb(dropX, dropY);
                world.shake = Math.max(world.shake, 4);
                setMessage(`+${obstacle.reward || 50} · Cristal roto`, 0.72);
                updateHud();
              } else {
                setMessage(s.power ? "Rayo atraviesa" : "Impacto bloqueado", 0.5);
              }
              if (s.explosive) explodeProjectile(s);
              break;
            }
          }

          if (sparkUsed) continue;

          for (const enemy of enemies) {
            if (!enemy.active) continue;
            if (circleRectCollision(s.x, s.y, s.r + 2, enemyRect(enemy))) {
              if (!s.power || s.explosive) sparks.splice(i, 1);
              sparkUsed = !s.power || s.explosive;

              const sparkDir = Math.sign(s.vx) || 1;
              const alreadyHit = s.hits && s.hits.has(enemy);
              const frontalBlock = enemy.kind === "shielded" && sparkDir !== enemy.dir && !s.power && !s.explosive;

              if (alreadyHit) {
                sparkUsed = false;
              } else if (frontalBlock) {
                enemy.hitFlash = 0.12;
                setMessage("Escudo frontal bloquea", 0.65);
                playSfx("hit");
              } else {
                if (s.hits) s.hits.add(enemy);
                hitEnemy(enemy, sparkDir, s.damage);
                if (s.explosive) explodeProjectile(s);
              }

              break;
            }
          }

          if (sparkUsed) continue;

          for (const helper of bossHelpers) {
            if (!helper.active) continue;
            if (circleRectCollision(s.x, s.y, s.r + 2, helperRect(helper))) {
              if (!s.power || s.explosive) sparks.splice(i, 1);
              sparkUsed = !s.power || s.explosive;
              if (!s.hits || !s.hits.has(helper)) {
                if (s.hits) s.hits.add(helper);
                hitBossHelper(helper, Math.max(1, Math.round(s.damage)));
                if (s.explosive) explodeProjectile(s);
              }
              break;
            }
          }

          if (sparkUsed) continue;

          for (const clone of bossClones) {
            if (!clone.active) continue;
            const rect = { x: clone.x, y: world.floorY + clone.y - clone.h, w: clone.w, h: clone.h };
            if (circleRectCollision(s.x, s.y, s.r + 2, rect)) {
              if (!s.power || s.explosive) sparks.splice(i, 1);
              sparkUsed = !s.power || s.explosive;
              if (!s.hits || !s.hits.has(clone)) {
                if (s.hits) s.hits.add(clone);
                hitBossClone(clone, s.damage, s);
                if (s.explosive) explodeProjectile(s);
              }
              break;
            }
          }

          if (sparkUsed) continue;

          if (boss && boss.active && circleRectCollision(s.x, s.y, s.r + 2, bossRect())) {
            if (!s.power || s.explosive) sparks.splice(i, 1);
            if (!s.hits || !s.hits.has(boss)) {
              if (s.hits) s.hits.add(boss);
              hitBoss(s.damage, s);
              if (s.explosive) explodeProjectile(s);
            }
          }
        }
      }

      function doJump(speed, isAirJump) {
        if (player.isCrouching) return;
        player.vy = -speed;
        player.grounded = false;
        player.coyote = 0;
        player.jumpBufferTimer = 0;
        player.squash = isAirJump ? 1.14 : 1.09;

        if (isAirJump) {
          player.airJumpsLeft -= 1;
          player.airJumpFlash = 0.24;
        }
        playSfx(isAirJump ? "doubleJump" : "jump");
      }

      function updateMovingPlatforms(dt) {
        for (const platform of movingPlatforms) {
          platform.prevX = platform.x;
          platform.x = platform.baseX + Math.sin(world.time * platform.speed + platform.phase) * platform.range;
        }
      }

      function updateFallingPlatforms(dt) {
        for (const platform of fallingPlatforms) {
          if ((player.dropThroughTimer || 0) > 0 || (player.phaseUpTimer || 0) > 0) continue;
          if (!platform.active) continue;
          if (platform.triggered) {
            platform.timer -= dt;
            if (platform.timer <= 0) {
              platform.fallVy += 720 * dt;
              platform.y += platform.fallVy * dt;
              if (world.floorY + platform.y > H + 80) platform.active = false;
            }
          }
        }
      }

      function resolveFallingPlatformCollisions(prevX, prevY) {
        const prev = { x: prevX, y: prevY, w: player.width, h: player.height };

        for (const platform of fallingPlatforms) {
          if (!platform.active) continue;
          const p = fallingPlatformRect(platform);
          const pr = playerRect();
          if (!rectsOverlap(pr, p)) continue;

          const prevBottom = prev.y + prev.h;
          const fromAbove = prevBottom <= p.y + 9 && player.vy >= 0;

          if (fromAbove) {
            player.y = p.y - player.height;
            player.vy = 0;
            player.grounded = true;
            resetJumpCapacity();
            platform.triggered = true;
          }
        }
      }

      function fireEnemyProjectile(enemy) {
        const er = enemyRect(enemy);
        const px = player.x + player.width / 2;
        const ex = er.x + er.w / 2;
        const dir = px < ex ? -1 : 1;

        enemy.dir = dir;
        enemyProjectiles.push({
          x: ex + dir * 22,
          y: er.y + er.h * 0.42,
          vx: dir * 255,
          r: 7,
          life: 3.2,
          active: true
        });
      }

      function explodeEnemyProjectile(p) {
        const color = p.type === "boss_bomb" ? "#ff7a36" : (p.type === "boss_storm" ? "#fff245" : (p.type === "boss_toxic" ? "#00d0d0" : "#d85a5a"));
        spawnParticles(p.x, p.y, color, p.type === "boss_bomb" ? 24 : 16);
        spawnParticles(p.x, p.y, "#fff0a8", 8);
        world.shake = Math.max(world.shake, p.type === "boss_bomb" ? 13 : 8);
        addFloatingText(p.x, p.y - 10, p.type === "boss_bomb" ? "BOOM" : "¡PUM!", color);
      }

      function updateEnemyProjectiles(dt) {
        const pr = playerRect();

        for (let i = enemyProjectiles.length - 1; i >= 0; i--) {
          const p = enemyProjectiles[i];

          if (p.homing) {
            const tx = player.x + player.width / 2;
            const ty = player.y + player.height / 2;
            const dx = tx - p.x;
            const dy = ty - p.y;
            const len = Math.max(1, Math.hypot(dx, dy));
            const speed = Math.max(260, Math.hypot(p.vx || 0, p.vy || 0));
            const turn = Math.min(1, 2.8 * dt);
            p.vx += ((dx / len) * speed - p.vx) * turn;
            p.vy = (p.vy || 0) + ((dy / len) * speed - (p.vy || 0)) * turn;
          }

          if (p.gravity) p.vy = (p.vy || 0) + p.gravity * dt;

          p.x += (p.vx || 0) * dt;
          p.y += (p.vy || 0) * dt;
          p.life -= dt;

          const outOfWorld = p.life <= 0 || p.x < -180 || p.x > levelEndX() + 520 || p.y > H + 220 || p.y < -360;
          if (outOfWorld) {
            if (p.explosive) explodeEnemyProjectile(p);
            enemyProjectiles.splice(i, 1);
            continue;
          }

          if (p.explosive && p.y >= world.floorY - 8) {
            explodeEnemyProjectile(p);
            enemyProjectiles.splice(i, 1);
            const px = player.x + player.width / 2;
            const py = player.y + player.height / 2;
            if ((px - p.x) ** 2 + (py - p.y) ** 2 < 92 * 92) damagePlayer(p.x);
            continue;
          }

          if (circleRectCollision(p.x, p.y, p.r + 2, pr)) {
            enemyProjectiles.splice(i, 1);
            if (p.explosive) explodeEnemyProjectile(p);
            damagePlayer(p.x);
          }
        }
      }

      function updateEnemies(dt) {
        for (const enemy of enemies) {
          if (!enemy.active) continue;

          enemy.hitFlash = Math.max(0, enemy.hitFlash - dt);

          if (enemy.stunTimer > 0) {
            enemy.stunTimer = Math.max(0, enemy.stunTimer - dt);
            continue;
          }

          if (enemy.kind === "charger") {
            const dist = Math.abs((player.x + player.width / 2) - (enemy.x + enemy.w / 2));
            enemy.speed = dist < 220 ? Math.max(enemy.speed, 145) : (enemy.baseSpeed || enemy.speed);
          }

          if (enemy.kind === "tank") {
            enemy.speed = enemy.baseSpeed || enemy.speed;
          }

          if (enemy.kind === "shooter") {
            enemy.shootTimer -= dt;
            if (enemy.shootTimer <= 0) {
              fireEnemyProjectile(enemy);
              enemy.shootTimer = enemy.shootCooldown;
            }
          }

          if (enemy.kind === "spawner") {
            enemy.spawnTimer -= dt;
            if (enemy.spawnTimer <= 0) {
              const activeMinis = enemies.filter(e => e.active && e.kind === "flyer_mini").length;
              if (activeMinis < 4) {
                enemies.push(makeEnemy({
                  kind: "flyer_mini",
                  x: enemy.x + enemy.w / 2,
                  y: enemy.y - 24,
                  w: 30,
                  h: 28,
                  minX: enemy.x - 320,
                  maxX: enemy.x + 320,
                  dir: player.x < enemy.x ? -1 : 1,
                  speed: 108,
                  hp: 1,
                  amp: 6,
                  spawned: true,
                  countsForGoal: false
                }));
                spawnParticles(enemy.x + enemy.w / 2, world.floorY + enemy.y - enemy.h * 0.8, "#e4c94f", 7);
                playSfx("shieldOn");
              }
              enemy.spawnTimer = enemy.spawnCooldown;
            }
          }

          if (enemy.kind === "flyer_mini") {
            enemy.dir = (player.x + player.width / 2) < (enemy.x + enemy.w / 2) ? -1 : 1;
            enemy.y += clamp((player.y - world.floorY) - enemy.y, -80, 80) * dt * 0.55;
          }

          enemy.x += enemy.dir * enemy.speed * dt;

          if (enemy.kind === "flyer" || enemy.kind === "flyer_mini") {
            enemy.y = enemy.baseY + Math.sin(world.time * 4 + enemy.startX * 0.01) * (enemy.amp || 10);
          }

          if (enemy.x <= enemy.minX) {
            enemy.x = enemy.minX;
            enemy.dir = 1;
          } else if (enemy.x + enemy.w >= enemy.maxX) {
            enemy.x = enemy.maxX - enemy.w;
            enemy.dir = -1;
          }

          if (enemy.kind === "walker" || enemy.kind === "charger" || enemy.kind === "tank" || enemy.kind === "shielded" || enemy.kind === "shooter" || enemy.kind === "spawner") {
            const er = enemyRect(enemy);
            const sideProbe = {
              x: enemy.dir > 0 ? er.x + er.w : er.x - 4,
              y: er.y + 8,
              w: 4,
              h: er.h - 12
            };
            for (const block of solidBlocks) {
              if (rectsOverlap(sideProbe, solidBlockRect(block))) {
                enemy.dir *= -1;
                break;
              }
            }
          }
        }
      }


      function bossHpPct() {
        return boss && boss.maxHp ? clamp(boss.hp / boss.maxHp, 0, 1) : 1;
      }

      function currentBossProfile() {
        const id = boss ? (boss.assetId || "") : "";
        const lvl = game.currentLevel;
        if (id.includes("goliath") || lvl === 1) return { label: "Bombardeo", projectile: "bomb", color: "#ff7a36", cloneCount: 2 };
        if (id.includes("geode") || lvl === 2) return { label: "Cristales", projectile: "shard", color: "#a8f0ff", cloneCount: 3 };
        if (id.includes("kraken") || lvl === 3) return { label: "Lodo tóxico", projectile: "toxic", color: "#00d0d0", cloneCount: 3 };
        if (id.includes("eagle") || lvl === 4) return { label: "Tormenta", projectile: "storm", color: "#fff245", cloneCount: 4 };
        return { label: "Sombra", projectile: "shadow", color: "#d85a5a", cloneCount: 2 };
      }

      function teleportBossNearPlayer(reason = "teleport") {
        if (!boss) return;
        const side = player.dir >= 0 ? 1 : -1;
        const preferred = player.x + side * 360;
        const minX = boss.minX;
        const maxX = Math.max(boss.minX, boss.maxX - boss.w);
        boss.x = clamp(preferred, minX, maxX);
        boss.y = boss.baseY + (boss.enraged ? -28 : -12);
        boss.dir = (player.x + player.width / 2) < (boss.x + boss.w / 2) ? -1 : 1;
        boss.invulnTimer = 0.45;
        boss.hitFlash = 0.42;
        world.shake = Math.max(world.shake, boss.enraged ? 16 : 10);
        spawnParticles(boss.x + boss.w / 2, world.floorY + boss.y - boss.h / 2, currentBossProfile().color, boss.enraged ? 32 : 22);
        setMessage(reason === "rage" ? "¡Furia roja! El jefe reaparece" : "El jefe se teletransporta", 0.9);
        playSfx("bossAppear");
      }

      function startBossVanish(afterState = "patrol", duration = 0.72) {
        if (!boss || boss.state === "vanish" || boss.state === "charge" || boss.state === "precharge") return;
        boss.state = "vanish";
        boss.stateTimer = duration;
        boss.afterVanishState = afterState;
        boss.vulnerable = false;
        boss.invulnTimer = duration + 0.22;
        world.shake = Math.max(world.shake, 8);
        spawnParticles(boss.x + boss.w / 2, world.floorY + boss.y - boss.h / 2, "#6d58d8", 18);
        setMessage("El jefe desaparece", 0.6);
      }

      function makeBossClone(offsetX = 0, offsetY = 0, side = 1) {
        if (!boss) return null;
        const hp = Math.max(7, Math.round(boss.maxHp * 0.11));
        return {
          x: clamp(boss.x + offsetX, boss.minX, Math.max(boss.minX, boss.maxX - boss.w * 0.58)),
          y: boss.baseY + offsetY,
          baseY: boss.baseY + offsetY,
          w: boss.w * 0.55,
          h: boss.h * 0.58,
          dir: side,
          hp,
          maxHp: hp,
          speed: (boss.patrolSpeed || 60) * (boss.enraged ? 1.7 : 1.25),
          assetId: boss.cloneAssetId || boss.assetId,
          active: true,
          hitFlash: 0,
          shootTimer: 0.85 + Math.random() * 0.6,
          state: "hunt"
        };
      }

      function spawnBossClones() {
        if (!boss || boss.phaseSplit) return;
        boss.phaseSplit = true;
        const profile = currentBossProfile();
        bossClones.length = 0;
        const count = profile.cloneCount || 2;
        for (let i = 0; i < count; i++) {
          const side = i % 2 === 0 ? -1 : 1;
          const clone = makeBossClone(side * (170 + i * 62), -18 - i * 12, side);
          if (clone) bossClones.push(clone);
        }
        world.shake = Math.max(world.shake, 15);
        spawnParticles(boss.x + boss.w / 2, world.floorY + boss.y - boss.h / 2, profile.color, 34);
        setMessage("¡Se divide en sombras menores!", 1.15);
        playSfx("bossAppear");
      }

      function hitBossClone(clone, damageAmount = 1, source = null) {
        if (!clone || !clone.active) return false;
        const sourceType = source && source.type ? source.type : "spark";
        const simple = sourceType === "spark" && !(source && (source.power || source.fire || source.explosive || source.homing));
        const dmg = damageAmount * (simple ? 0.35 : 0.70);
        clone.hp -= dmg;
        clone.hitFlash = 0.2;
        addFloatingText(clone.x + clone.w / 2, world.floorY + clone.y - clone.h - 8, `-${dmg.toFixed(1)}`, "#ffb36b");
        playSfx("hit");
        if (clone.hp <= 0) {
          clone.active = false;
          const cx = clone.x + clone.w / 2;
          const cy = world.floorY + clone.y - clone.h / 2;
          spawnParticles(cx, cy, currentBossProfile().color, 18);
          if (Math.random() < 0.55) dropEnergyOrb(cx, cy, 1);
          game.score += 160;
          setMessage("Sombra menor vencida", 0.62);
          updateHud();
        }
        return true;
      }

      function fireBossCloneShot(clone) {
        if (!clone || !clone.active) return;
        const cr = { x: clone.x, y: world.floorY + clone.y - clone.h, w: clone.w, h: clone.h };
        const dir = (player.x + player.width / 2) < (clone.x + clone.w / 2) ? -1 : 1;
        clone.dir = dir;
        enemyProjectiles.push({
          type: "boss_orb",
          x: cr.x + cr.w / 2 + dir * 20,
          y: cr.y + cr.h * 0.42,
          vx: dir * 275,
          vy: Math.sin(world.time * 3 + clone.x) * 34,
          r: 8,
          life: 2.9,
          active: true
        });
      }

      function updateBossClones(dt) {
        for (const clone of bossClones) {
          if (!clone.active) continue;
          clone.hitFlash = Math.max(0, clone.hitFlash - dt);
          const px = player.x + player.width / 2;
          const cx = clone.x + clone.w / 2;
          const chase = Math.sign(px - cx) || clone.dir;
          clone.dir = chase;
          clone.x += chase * clone.speed * dt;
          clone.x = clamp(clone.x, boss ? boss.minX : 0, boss ? Math.max(boss.minX, boss.maxX - clone.w) : levelEndX());
          clone.y = clone.baseY + Math.sin(world.time * 4 + clone.x * 0.01) * 18;

          clone.shootTimer -= dt;
          if (clone.shootTimer <= 0) {
            fireBossCloneShot(clone);
            clone.shootTimer = boss && boss.enraged ? 1.0 : 1.45;
          }

          const rect = { x: clone.x, y: world.floorY + clone.y - clone.h, w: clone.w, h: clone.h };
          if (rectsOverlap(playerRect(), rect)) damagePlayer(clone.x + clone.w / 2);
        }
      }

      function drawBossClones() {
        for (const clone of bossClones) {
          if (!clone.active) continue;
          const x = clone.x - world.camX;
          const y = world.floorY + clone.y - clone.h;
          if (x < -180 || x > W + 180) continue;

          const blink = clone.hitFlash > 0 && Math.floor(world.time * 24) % 2 === 0;
          const asset = getBossAsset(clone.assetId);
          ctx.save();
          const cx = x + clone.w / 2;
          const cy = y + clone.h * 0.58;
          const glow = ctx.createRadialGradient(cx, cy, 6, cx, cy, 58);
          glow.addColorStop(0, "rgba(216,90,90,.26)");
          glow.addColorStop(1, "rgba(109,88,216,0)");
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(cx, cy, 58, 0, Math.PI * 2);
          ctx.fill();

          if (blink) ctx.globalAlpha = 0.55;
          ctx.translate(cx, y + clone.h);
          ctx.scale(clone.dir < 0 ? -1 : 1, 1);
          if (asset && asset.ready) {
            ctx.drawImage(asset.img, -clone.w * .72, -clone.h * 1.16, clone.w * 1.44, clone.h * 1.32);
          } else {
            ctx.fillStyle = "#5d58a4";
            ctx.strokeStyle = "#111";
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.ellipse(0, -clone.h * .45, clone.w * .34, clone.h * .38, 0, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
          }
          ctx.restore();

          ctx.save();
          ctx.fillStyle = "rgba(20,25,35,.72)";
          roundRect(ctx, x, y - 12, clone.w, 7, 5);
          ctx.fill();
          ctx.fillStyle = "#ff7a36";
          roundRect(ctx, x, y - 12, clone.w * Math.max(0, clone.hp / clone.maxHp), 7, 5);
          ctx.fill();
          ctx.restore();
        }
      }

      function fireBossSpecialVolley() {
        if (!boss || !boss.active || boss.defeated || boss.state === "vanish") return;
        const profile = currentBossProfile();
        const b = bossRect();
        const bx = b.x + b.w / 2;
        const by = b.y + b.h * 0.44;
        const dir = (player.x + player.width / 2) < bx ? -1 : 1;
        boss.dir = dir;

        if (profile.projectile === "bomb") {
          for (let i = 0; i < (boss.enraged ? 4 : 2); i++) {
            enemyProjectiles.push({
              type: "boss_bomb",
              x: bx + (i - 1.5) * 44,
              y: by - 50 - i * 8,
              vx: dir * (120 + i * 34),
              vy: -120 + i * 40,
              gravity: 760,
              r: 12,
              life: 2.8,
              explosive: true,
              active: true
            });
          }
          setMessage("¡Lluvia de bombas!", 0.7);
        } else if (profile.projectile === "storm") {
          for (let i = -1; i <= 1; i++) {
            enemyProjectiles.push({
              type: "boss_storm",
              x: bx + dir * 32,
              y: by + i * 30,
              vx: dir * 420,
              vy: i * 70,
              r: 10,
              life: 2.4,
              active: true
            });
          }
          setMessage("¡Tormenta triple!", 0.7);
        } else if (profile.projectile === "shard") {
          for (let i = -2; i <= 2; i++) {
            enemyProjectiles.push({
              type: "boss_shard",
              x: bx + dir * 32,
              y: by,
              vx: dir * (330 + Math.abs(i) * 20),
              vy: i * 82,
              r: 9,
              life: 2.55,
              active: true
            });
          }
          setMessage("¡Fragmentos de geoda!", 0.7);
        } else if (profile.projectile === "toxic") {
          for (let i = 0; i < (boss.enraged ? 5 : 3); i++) {
            enemyProjectiles.push({
              type: "boss_toxic",
              x: bx + dir * 30,
              y: by - 40 + i * 24,
              vx: dir * (250 + i * 18),
              vy: -70 + i * 45,
              gravity: 180,
              r: 11,
              life: 3.0,
              active: true
            });
          }
          setMessage("¡Lodo tóxico!", 0.7);
        } else {
          enemyProjectiles.push({
            type: "boss_orb",
            x: bx + dir * 34,
            y: by,
            vx: dir * 390,
            vy: 0,
            homing: boss.enraged,
            r: 11,
            life: 2.7,
            active: true
          });
          setMessage("¡Orbe de sombra!", 0.7);
        }
        world.shake = Math.max(world.shake, boss.enraged ? 12 : 7);
        playSfx("bossHit");
      }

      function triggerBossPhaseEvents() {
        if (!boss || !boss.active || boss.defeated) return;
        const pct = bossHpPct();
        if (pct <= 0.72 && !boss.phaseTeleport) {
          boss.phaseTeleport = true;
          startBossVanish("patrol", 0.82);
        }
        if (pct <= 0.55 && !boss.phaseSplit) {
          spawnBossClones();
        }
        if (pct <= 0.32 && !boss.enraged) {
          boss.enraged = true;
          boss.phaseFinal = true;
          boss.patrolSpeed *= 1.55;
          boss.chargeSpeed *= 1.25;
          boss.lanceCooldown = Math.max(0.62, boss.lanceCooldown * 0.58);
          boss.specialTimer = 0.35;
          boss.rageAura = 999;
          boss.state = "rage";
          boss.stateTimer = 1.2;
          boss.invulnTimer = 0.8;
          boss.vulnerable = false;
          world.shake = Math.max(world.shake, 20);
          spawnParticles(boss.x + boss.w / 2, world.floorY + boss.y - boss.h / 2, "#ff3434", 46);
          setMessage("¡FURIA ROJA! Poder especial al 100%", 1.3);
          playSfx("bossAppear");
        }
      }

      function fireBossLance() {
        if (!boss || !boss.active || boss.defeated) return;

        if (boss.enraged || game.currentLevel > 0 || Math.random() < 0.45) {
          fireBossSpecialVolley();
          return;
        }

        const b = bossRect();
        const px = player.x + player.width / 2;
        const bx = b.x + b.w / 2;
        const dir = px < bx ? -1 : 1;
        boss.dir = dir;

        enemyProjectiles.push({
          type: "boss_lance",
          x: bx + dir * 44,
          y: b.y + b.h * 0.46,
          vx: dir * 390,
          vy: 0,
          r: 10,
          life: 2.8,
          active: true
        });

        if (boss.enraged) {
          enemyProjectiles.push({
            type: "boss_orb",
            x: bx - dir * 22,
            y: b.y + b.h * 0.36,
            vx: -dir * 330,
            vy: -30,
            homing: true,
            r: 9,
            life: 2.4,
            active: true
          });
        }

        setMessage("¡Lanza!", 0.42);
        playSfx("bossHit");
      }

      function updateBoss(dt) {
        if (!boss || !boss.active || boss.defeated) return;

        boss.hitFlash = Math.max(0, boss.hitFlash - dt);
        boss.invulnTimer = Math.max(0, (boss.invulnTimer || 0) - dt);
        boss.stateTimer -= dt;
        boss.teleportTimer -= dt;
        boss.specialTimer -= dt;
        boss.rageAura = Math.max(0, (boss.rageAura || 0) - dt);

        triggerBossPhaseEvents();

        const pct = bossHpPct();
        const profile = currentBossProfile();

        if (boss.state === "vanish") {
          boss.vulnerable = false;
          boss.y -= 18 * dt;
          if (boss.stateTimer <= 0) {
            teleportBossNearPlayer(boss.enraged ? "rage" : "teleport");
            boss.state = boss.afterVanishState || "patrol";
            boss.stateTimer = boss.enraged ? 0.85 : Math.max(0.75, boss.patrolTime * 0.55);
            boss.vulnerable = false;
          }
          return;
        }

        if (boss.state === "rage") {
          boss.vulnerable = false;
          boss.y = boss.baseY + Math.sin(world.time * 18) * 7;
          world.shake = Math.max(world.shake, 12);
          if (boss.stateTimer <= 0) {
            teleportBossNearPlayer("rage");
            boss.state = "patrol";
            boss.stateTimer = Math.max(0.55, boss.patrolTime * 0.45);
            boss.vulnerable = true;
          }
          return;
        }

        if (boss.teleportTimer <= 0 && pct < 0.86 && boss.state !== "rest" && boss.state !== "charge" && boss.state !== "precharge") {
          boss.teleportTimer = boss.enraged ? 2.4 : 4.2;
          startBossVanish("patrol", boss.enraged ? 0.48 : 0.72);
          return;
        }

        if (boss.specialTimer <= 0 && boss.state !== "rest" && boss.state !== "charge" && boss.state !== "precharge") {
          fireBossSpecialVolley();
          boss.specialTimer = boss.enraged ? 1.05 : (pct < 0.55 ? 1.75 : 2.45);
        }

        if (boss.state === "patrol") {
          boss.vulnerable = true;
          boss.warnedRest = false;
          const bossBobAmp = game.currentLevel === 1 ? (boss.enraged ? 96 : 72) : (boss.enraged ? 24 : 16);
          boss.y = boss.baseY + Math.sin(world.time * (boss.enraged ? 5.6 : 3.3)) * bossBobAmp;

          const playerCenter = player.x + player.width / 2;
          const bossCenter = boss.x + boss.w / 2;
          const chaseRange = boss.enraged ? 920 : (pct < 0.72 ? 640 : 360);
          if (Math.abs(playerCenter - bossCenter) < chaseRange) {
            boss.dir = playerCenter < bossCenter ? -1 : 1;
            boss.x += boss.dir * boss.patrolSpeed * (boss.enraged ? 1.18 : 0.82) * dt;
          } else {
            boss.x += boss.dir * boss.patrolSpeed * dt;
          }

          if (boss.x <= boss.minX) {
            boss.x = boss.minX;
            boss.dir = 1;
          } else if (boss.x + boss.w >= boss.maxX) {
            boss.x = boss.maxX - boss.w;
            boss.dir = -1;
          }

          boss.lanceTimer -= dt;
          if (boss.lanceTimer <= 0) {
            boss.state = "aim";
            boss.stateTimer = boss.enraged ? 0.28 : 0.46;
            boss.vulnerable = true;
            boss.dir = (player.x + player.width / 2) < (boss.x + boss.w / 2) ? -1 : 1;
            setMessage(boss.enraged ? `¡${profile.label} al 100%!` : `${boss.name} prepara ${profile.label}`, 0.52);
          } else if (boss.stateTimer <= 0) {
            boss.state = "precharge";
            boss.stateTimer = boss.enraged ? boss.prechargeTime * 0.66 : boss.prechargeTime;
            boss.dir = (player.x + player.width / 2) < (boss.x + boss.w / 2) ? -1 : 1;
            boss.vulnerable = false;
            setMessage("¡Cuidado: embestida!", 0.62);
            playSfx("bossAppear");
          }
        } else if (boss.state === "aim") {
          boss.vulnerable = true;
          boss.y = boss.baseY + Math.sin(world.time * 6.5) * (boss.enraged ? 10 : 4);

          if (boss.stateTimer <= 0) {
            fireBossLance();
            boss.lanceTimer = boss.enraged ? boss.lanceCooldown * 0.55 : boss.lanceCooldown;
            boss.state = "patrol";
            boss.stateTimer = Math.max(0.48, boss.patrolTime * (boss.enraged ? 0.38 : 0.55));
            boss.vulnerable = true;
          }
        } else if (boss.state === "precharge") {
          boss.vulnerable = false;
          boss.y = boss.baseY + Math.sin(world.time * 18) * 3;

          if (boss.stateTimer <= 0) {
            boss.state = "charge";
            boss.stateTimer = boss.enraged ? boss.chargeTime * 1.08 : boss.chargeTime;
            boss.dir = (player.x + player.width / 2) < (boss.x + boss.w / 2) ? -1 : 1;
            boss.chargeVy = clamp(((player.y - world.floorY) - boss.y) * (boss.enraged ? 2.4 : 1.8), -320, 320);
            boss.vulnerable = false;
            world.shake = Math.max(world.shake, boss.enraged ? 12 : 6);
          }
        } else if (boss.state === "charge") {
          boss.vulnerable = false;
          boss.x += boss.dir * boss.chargeSpeed * (boss.enraged ? 1.12 : 1) * dt;
          boss.y += boss.chargeVy * dt;
          boss.y = clamp(boss.y, boss.baseY - (boss.enraged ? 70 : 34), -64);

          if (boss.x <= boss.minX) {
            boss.x = boss.minX;
            boss.stateTimer = 0;
          } else if (boss.x + boss.w >= boss.maxX) {
            boss.x = boss.maxX - boss.w;
            boss.stateTimer = 0;
          }

          if (boss.stateTimer <= 0) {
            boss.state = "rest";
            boss.stateTimer = boss.enraged ? Math.max(0.72, boss.restTime * 0.55) : boss.restTime;
            boss.vulnerable = true;
            boss.chargeVy = 0;
            boss.warnedRest = false;
          }
        } else if (boss.state === "rest") {
          boss.vulnerable = true;
          boss.y += (boss.baseY - boss.y) * Math.min(1, dt * 5);

          if (!boss.warnedRest) {
            boss.warnedRest = true;
            setMessage(boss.enraged ? "Vulnerable breve: usa poder especial" : "¡Vulnerable! Dispara ahora", 0.95);
            addFloatingText(boss.x + boss.w / 2, world.floorY + boss.y - boss.h - 20, boss.enraged ? "¡AHORA!" : "¡DISPARA!", "#e4c94f");
          }

          if (boss.stateTimer <= 0) {
            boss.state = "patrol";
            boss.stateTimer = boss.patrolTime * (boss.enraged ? 0.58 : 1);
            boss.lanceTimer = Math.min(boss.lanceTimer, boss.lanceCooldown * 0.75);
            boss.vulnerable = true;
            boss.warnedRest = false;
          }
        }
      }

      function tryDash() {
        if (game.status !== "playing") return;
        if (player.dashCooldown > 0 || player.dashTimer > 0) return;
        if (game.energy < 15 && player.overdriveTimer <= 0) return;

        const dir = player.dir || 1;
        if (player.overdriveTimer <= 0) game.energy = Math.max(0, game.energy - 15);

        player.dashDir = dir;
        player.dashTimer = 0.2;
        player.dashCooldown = 0.55;
        player.invulnerable = Math.max(player.invulnerable, 0.25);
        player.vx = dir * 800;
        player.vy *= 0.45;
        world.shake = Math.max(world.shake, 8);
        spawnParticles(player.x + player.width / 2, player.y + player.height / 2, "#36a678", 9);
        playSfx("spark");
        updateHud();
      }

      function activateUpperRoute(stair) {
        for (const platform of upperTimedPlatforms) {
          platform.active = true;
          platform.timer = platform.duration ?? 8;
        }
        stair.active = true;
        stair.timer = stair.duration ?? 8;
        setMessage("Gradas emergentes", 0.7);
      }

      function updateRisingSystems(dt) {
        const px = player.x + player.width / 2;
        for (const stair of risingStairs) {
          if (!stair.active && px >= stair.triggerX && px <= stair.triggerX + stair.triggerW && player.grounded) {
            activateUpperRoute(stair);
          }
          if (stair.active) {
            stair.timer -= dt;
            stair.progress = Math.min(1, stair.progress + dt * 2.8);
            if (stair.timer <= 0) {
              stair.active = false;
            }
          } else {
            stair.progress = Math.max(0, stair.progress - dt * 2.4);
          }
        }

        for (const platform of upperTimedPlatforms) {
          if (!platform.active) continue;
          platform.timer -= dt;
          if (platform.timer <= 0) {
            platform.active = false;
            spawnParticles(platform.x + platform.w / 2, world.floorY + platform.y, "#9aa0aa", 10);
          }
        }
      }


      function updateWarpTubes(dt) {
        player.tubeCooldown = Math.max(0, (player.tubeCooldown || 0) - dt);
        for (const tube of warpTubes) {
          tube.cooldown = Math.max(0, (tube.cooldown || 0) - dt);
        }
        if (game.status !== "playing" || player.tubeCooldown > 0) return;

        const pr = playerRect();
        const px = player.x + player.width / 2;
        for (const tube of warpTubes) {
          const tr = warpTubeRect(tube);
          const overTube = px >= tr.x - 8 && px <= tr.x + tr.w + 8 && pr.y + pr.h >= tr.y - 12;
          if (!overTube) continue;
          const wantsEntry = keys.down || player.isCrouching || touchMove.down;
          if (!wantsEntry || tube.cooldown > 0) continue;

          player.x = tube.toX;
          player.y = world.floorY - player.height + (tube.toY || 0);
          player.vx = 0;
          player.vy = -120;
          player.tubeCooldown = 0.65;
          tube.cooldown = 1.1;
          world.camX = Math.max(0, player.x - W * 0.35);
          spawnParticles(player.x + player.width / 2, player.y + player.height / 2, "#6d58d8", 18);
          addFloatingText(player.x + player.width / 2, player.y - 24, "TUBO", "#e4c94f");
          setMessage(`${tube.hint || "Tubo"} · salida`, 0.8);
          playSfx("orb");
          break;
        }
      }

      function updateFireSystems(dt) {
        for (const flame of airFlames) {
          if (flame.active) {
            flame.timer -= dt;
            if (flame.timer <= 0) {
              flame.active = false;
              flame.respawnTimer = flame.respawn;
            }
          } else {
            flame.respawnTimer -= dt;
            if (flame.respawnTimer <= 0) {
              flame.active = true;
              flame.timer = flame.life;
            }
          }
        }
      }

      function resolveExtraPlatformCollisions(prevX, prevY) {
        const prev = { x: prevX, y: prevY, w: player.width, h: player.height };
        const allRects = [];
        for (const stair of risingStairs) allRects.push(...stairRects(stair));
        for (const platform of upperTimedPlatforms) if (platform.active) allRects.push(upperTimedPlatformRect(platform));

        for (const p of allRects) {
          if ((player.dropThroughTimer || 0) > 0 || (player.phaseUpTimer || 0) > 0) continue;
          const pr = playerRect();
          if (!rectsOverlap(pr, p)) continue;
          const prevBottom = prev.y + prev.h;
          const fromAbove = prevBottom <= p.y + 10 && player.vy >= 0;
          if (fromAbove) {
            player.y = p.y - player.height;
            player.vy = 0;
            player.grounded = true;
            resetJumpCapacity();
          }
        }
      }

      function updateParticles(dt) {
        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.x += p.vx * dt;
          p.y += p.vy * dt;
          p.vy += 520 * dt;
          p.life -= dt;
          if (p.life <= 0) particles.splice(i, 1);
        }
      }

      function spawnParticles(x, y, color = "#e4c94f", count = 8) {
        for (let i = 0; i < count; i++) {
          particles.push({
            x,
            y,
            vx: Math.random() * 220 - 110,
            vy: -Math.random() * 240 - 40,
            size: 3 + Math.random() * 4,
            color,
            life: 0.42 + Math.random() * 0.25,
            maxLife: 0.65
          });
        }
      }

      function updateAeroTrail(dt) {
        if (player.overdriveTimer <= 0) return;
        player.lastTrailTime += dt;
        if (player.lastTrailTime >= 0.055) {
          player.lastTrailTime = 0;
          aeroTrail.push({ x: player.x, y: player.y, h: player.height, dir: player.dir, life: 0.32 });
        }
        for (let i = aeroTrail.length - 1; i >= 0; i--) {
          aeroTrail[i].life -= dt;
          if (aeroTrail[i].life <= 0) aeroTrail.splice(i, 1);
        }
      }


      function getActiveFlightZone() {
        const level = levels[game.currentLevel];
        if (!level || !Array.isArray(level.flightZones)) return null;
        return level.flightZones.find(zone => player.x >= zone.startX && player.x <= zone.endX) || null;
      }

      function updateFlightMode(dt) {
        const zone = getActiveFlightZone();
        if (!zone) {
          if (game.flightMode) {
            const wasBurrow = game.burrowMode;
            game.flightMode = false;
            game.flightZoneId = null;
            game.burrowMode = false;
            player.flightEntryNotified = false;
            player.vy = Math.min(player.vy, -180);
            setMessage(wasBurrow ? "Aero sale del subsuelo" : "Aero sale de la nave", 0.75);
          }
          return false;
        }

        if (!game.flightMode || game.flightZoneId !== zone.id) {
          game.flightMode = true;
          game.flightZoneId = zone.id;
          game.burrowMode = !!zone.burrow;
          player.flightEntryNotified = true;
          player.grounded = false;
          player.coyote = 0;
          player.airJumpsLeft = physics.extraJumps;
          player.isCrouching = false;
          player.height = player.standHeight;
          player.vx = Math.max(player.vx, 180);
          setWeaponModeById(zone.weapon || "laser", false);
          player.specialWeaponTimer = Math.max(player.specialWeaponTimer || 0, zone.specialDuration || 12);
          player.specialWeaponRestorePending = true;
          setMessage(zone.label || "Modo nave activado", 1.05);
          addFloatingText(player.x + player.width / 2, player.y - 24, zone.burrow ? "TOPO" : "NAVE", zone.burrow ? "#8fff9f" : "#a8f0ff");
          spawnParticles(player.x + player.width / 2, player.y + player.height / 2, "#a8f0ff", 24);
          playSfx("portal");
        }

        const inputX = (keys.right ? 1 : 0) - (keys.left ? 1 : 0);
        const inputY = (keys.down ? 1 : 0) - ((keys.jump || pressedOnce.jump) ? 1 : 0);
        pressedOnce.jump = false;

        const shipAccel = zone.accel || 2200;
        const maxShipSpeed = zone.maxSpeed || 510;
        const maxShipVy = zone.maxVy || 430;

        if (inputX !== 0) {
          player.vx += inputX * shipAccel * dt;
          player.dir = inputX > 0 ? 1 : -1;
        } else {
          player.vx += ((zone.autoSpeed || 220) - player.vx) * Math.min(1, dt * 1.8);
        }

        if (inputY !== 0) {
          player.vy += inputY * shipAccel * 0.82 * dt;
        } else {
          player.vy *= Math.pow(0.10, dt);
        }

        player.vx = clamp(player.vx, -maxShipSpeed * 0.55, maxShipSpeed);
        player.vy = clamp(player.vy, -maxShipVy, maxShipVy);

        const prevX = player.x;
        const prevY = player.y;
        player.prevX = prevX;
        player.prevY = prevY;

        player.x += player.vx * dt;
        player.y += player.vy * dt;

        const topY = Math.max(56, world.floorY + (zone.topY ?? -430));
        const bottomY = Math.min(world.floorY - player.height - 12, world.floorY + (zone.bottomY ?? -70));
        if (player.y < topY) {
          player.y = topY;
          player.vy = Math.max(0, player.vy * -0.15);
          world.shake = Math.max(world.shake, 2);
        }
        if (player.y > bottomY) {
          player.y = bottomY;
          player.vy = Math.min(0, player.vy * -0.15);
          world.shake = Math.max(world.shake, 2);
        }

        player.grounded = false;
        player.coyote = 0;
        player.state = "flight";
        player.runT += dt * 9;
        player.squash += (1 - player.squash) * Math.min(1, dt * 8);
        player.x = clamp(player.x, zone.startX + 28, zone.endX + 80);

        const targetCam = Math.max(0, player.x - W * 0.42);
        world.camX += (targetCam - world.camX) * Math.min(1, dt * 4.6);

        refreshPortalState();
        updateLevelCollisions();
        updateAllyCompanions(dt);
        updateSparks(dt);
        return true;
      }


      function drawWorld2MazeOverlay() {
        if (game.currentLevel !== 1) return;
        const start = 5050;
        const end = 8350;
        if (world.camX + W < start - 120 || world.camX > end + 120) return;

        const sx = Math.max(0, start - world.camX);
        const ex = Math.min(W, end - world.camX);
        if (ex <= sx) return;

        ctx.save();
        ctx.beginPath();
        ctx.rect(sx, 0, ex - sx, H);
        ctx.clip();

        // Laberinto mecánico decorativo: inspirado en maze/arcade, sin colisiones.
        ctx.globalAlpha = 0.34;
        const bg = ctx.createLinearGradient(0, 0, 0, H);
        bg.addColorStop(0, "rgba(4,8,16,.88)");
        bg.addColorStop(.55, "rgba(8,30,36,.76)");
        bg.addColorStop(1, "rgba(8,10,18,.92)");
        ctx.fillStyle = bg;
        ctx.fillRect(sx, 0, ex - sx, H);
        ctx.globalAlpha = 1;

        const gridShift = -((world.camX - start) * 0.4 % 96);
        ctx.strokeStyle = "rgba(0,255,120,.25)";
        ctx.lineWidth = 2;
        for (let x = sx + gridShift - 96; x < ex + 96; x += 96) {
          ctx.beginPath();
          ctx.moveTo(x, 60);
          ctx.lineTo(x + 50, 60);
          ctx.lineTo(x + 50, 108);
          ctx.lineTo(x + 96, 108);
          ctx.stroke();
        }
        for (let y = 120; y < H - 40; y += 72) {
          ctx.beginPath();
          ctx.moveTo(sx, y);
          ctx.lineTo(ex, y);
          ctx.stroke();
        }

        // Nodos tipo jardín/laberinto mecánico.
        for (let i = 0; i < 18; i++) {
          const wx = start + i * 190;
          const x = wx - world.camX;
          if (x < sx - 40 || x > ex + 40) continue;
          const y = 110 + ((i * 73) % Math.max(120, H - 240));
          ctx.fillStyle = i % 2 ? "rgba(0,208,208,.16)" : "rgba(228,201,79,.16)";
          ctx.beginPath();
          ctx.arc(x, y, 22 + (i % 3) * 7, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = "rgba(255,255,255,.16)";
          ctx.lineWidth = 2;
          ctx.stroke();
        }

        ctx.fillStyle = "rgba(20,25,35,.60)";
        roundRect(ctx, clamp(start - world.camX + 120, 120, W - 130) - 98, 72, 196, 32, 15);
        ctx.fill();
        ctx.fillStyle = "#fff0a8";
        ctx.font = "900 13px system-ui, sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("LABERINTO MECÁNICO", clamp(start - world.camX + 120, 120, W - 130), 94);

        ctx.restore();
      }

      function drawFlightZoneOverlay() {
        const level = levels[game.currentLevel];
        if (!level || !Array.isArray(level.flightZones)) return;
        const zone = getActiveFlightZone() || level.flightZones.find(z => world.camX + W > z.startX - 120 && world.camX < z.endX + 120);
        if (!zone) return;

        const sx = Math.max(0, zone.startX - world.camX);
        const ex = Math.min(W, zone.endX - world.camX);
        if (ex <= 0 || sx >= W) return;

        ctx.save();
        ctx.beginPath();
        ctx.rect(sx, 0, Math.max(0, ex - sx), H);
        ctx.clip();

        const isWorld3 = game.currentLevel === 2;
        const isBurrow = zone && zone.burrow;
        const isToxic = zone && /toxic|nebula/i.test(zone.id || "");
        const bg = ctx.createLinearGradient(0, 0, 0, H);
        bg.addColorStop(0, isBurrow ? "rgba(30,18,12,.86)" : (isToxic ? "rgba(20,26,8,.78)" : (isWorld3 ? "rgba(5,6,18,.84)" : "rgba(10,13,22,.72)")));
        bg.addColorStop(.55, isBurrow ? "rgba(72,45,22,.70)" : (isToxic ? "rgba(60,80,18,.70)" : (isWorld3 ? "rgba(18,16,48,.70)" : "rgba(14,34,42,.58)")));
        bg.addColorStop(1, "rgba(6,8,18,.86)");
        ctx.fillStyle = bg;
        ctx.fillRect(sx, 0, ex - sx, H);

        // Perspectiva tipo túnel 3D / shoot'em up.
        const cx = W * 0.54;
        const cy = H * 0.48;
        ctx.strokeStyle = isBurrow ? "rgba(228,201,79,.28)" : (isToxic ? "rgba(196,255,90,.28)" : (isWorld3 ? "rgba(0,255,90,.34)" : "rgba(168,240,255,.26)"));
        ctx.lineWidth = 2;
        for (let i = 0; i < 15; i++) {
          const t = i / 14;
          const ox = (t - 0.5) * W * 1.2;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + ox, H);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + ox, 0);
          ctx.stroke();
        }
        for (let i = 0; i < 12; i++) {
          const phase = ((world.time * 0.8 + i * 0.09) % 1);
          const scale = 0.15 + phase * 1.05;
          const w = W * 0.18 * scale;
          const h = H * 0.14 * scale;
          ctx.strokeStyle = isWorld3 ? `rgba(0,255,90,${0.08 + phase * 0.28})` : `rgba(168,240,255,${0.06 + phase * 0.22})`;
          ctx.strokeRect(cx - w, cy - h, w * 2, h * 2);
        }

        // Entrada y salida.
        const labelX = clamp(zone.startX - world.camX + 130, 120, W - 120);
        ctx.fillStyle = "rgba(20,25,35,.56)";
        roundRect(ctx, labelX - 92, 76, 184, 34, 16);
        ctx.fill();
        ctx.fillStyle = "#fff0a8";
        ctx.font = "900 13px system-ui, sans-serif";
        ctx.textAlign = "center";
        ctx.fillText(zone.short || "MODO NAVE", labelX, 98);

        ctx.restore();
      }


      function drawMoleForm() {
        const sx = player.x - world.camX;
        const sy = player.y;
        const cx = sx + player.width / 2;
        const cy = sy + player.height / 2;
        const dir = player.dir || 1;
        ctx.save();
        ctx.translate(cx, cy);
        ctx.scale(dir, 1);
        const dust = ctx.createRadialGradient(-28, 18, 3, -28, 18, 46);
        dust.addColorStop(0, "rgba(228,201,79,.55)");
        dust.addColorStop(1, "rgba(120,70,30,0)");
        ctx.fillStyle = dust;
        ctx.beginPath(); ctx.ellipse(-30, 18, 48, 20, 0, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = "#6d4524";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.ellipse(0, 0, 44, 28, 0, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();
        ctx.fillStyle = "#caa06a";
        ctx.beginPath(); ctx.ellipse(38, -2, 18, 14, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        ctx.fillStyle = "#111";
        ctx.beginPath(); ctx.arc(44, -7, 3, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = "#f7dca0";
        ctx.lineWidth = 5;
        for (let i = -1; i <= 1; i++) {
          ctx.beginPath(); ctx.moveTo(18, 18 + i * 6); ctx.lineTo(44, 30 + i * 8); ctx.stroke();
        }
        ctx.fillStyle = "#e4c94f";
        ctx.font = "900 12px system-ui";
        ctx.textAlign = "center";
        ctx.fillText("TOPO", 0, -36);
        ctx.restore();
      }

      function drawFlightShip() {
        if (game.burrowMode) { drawMoleForm(); return; }
        const sx = player.x - world.camX;
        const sy = player.y;
        const cx = sx + player.width / 2;
        const cy = sy + player.height / 2;
        const tilt = clamp(player.vy / 520, -0.35, 0.35);
        const dir = player.dir || 1;

        ctx.save();
        if (player.invulnerable > 0 && Math.floor(world.time * 16) % 2 === 0) ctx.globalAlpha = 0.55;
        ctx.translate(cx, cy);
        ctx.rotate(tilt * dir);
        ctx.scale(dir, 1);

        const flame = ctx.createRadialGradient(-48, 10, 3, -48, 10, 44);
        flame.addColorStop(0, "rgba(255,255,255,.95)");
        flame.addColorStop(.28, "rgba(255,180,70,.82)");
        flame.addColorStop(1, "rgba(216,90,90,0)");
        ctx.fillStyle = flame;
        ctx.beginPath();
        ctx.ellipse(-48, 10, 48, 17, 0, 0, Math.PI * 2);
        ctx.fill();

        const body = ctx.createLinearGradient(-46, -24, 54, 28);
        body.addColorStop(0, "rgba(168,240,255,.95)");
        body.addColorStop(.45, "rgba(109,88,216,.96)");
        body.addColorStop(1, "rgba(26,28,45,.98)");
        ctx.fillStyle = body;
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(58, 0);
        ctx.quadraticCurveTo(16, -34, -44, -22);
        ctx.lineTo(-56, 0);
        ctx.lineTo(-44, 24);
        ctx.quadraticCurveTo(16, 36, 58, 0);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "rgba(255,255,255,.74)";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.ellipse(10, -8, 18, 12, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#e4c94f";
        ctx.beginPath();
        ctx.arc(48, 0, 8 + Math.sin(world.time * 12) * 1.5, 0, Math.PI * 2);
        ctx.fill();

        if (player.shieldTimer > 0 || player.overdriveTimer > 0) {
          ctx.strokeStyle = player.shieldTimer > 0 ? "rgba(108,220,255,.72)" : "rgba(228,201,79,.72)";
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.ellipse(0, 0, 68, 40, 0, 0, Math.PI * 2);
          ctx.stroke();
        }

        ctx.restore();
        if (debug) drawHitbox();
      }


      function allyTargets() {
        const targets = [];
        if (boss && boss.active && !boss.defeated) {
          const br = bossRect();
          targets.push({ x: br.x + br.w / 2, y: br.y + br.h / 2, boss: true });
        }
        for (const enemy of enemies) {
          if (!enemy.active) continue;
          const er = enemyRect(enemy);
          targets.push({ x: er.x + er.w / 2, y: er.y + er.h / 2, enemy });
        }
        targets.sort((a, b) => ((a.x - player.x) ** 2 + (a.y - player.y) ** 2) - ((b.x - player.x) ** 2 + (b.y - player.y) ** 2));
        return targets[0] || null;
      }

      function updateAlliedHeroes(dt) {
        if ((player.allyTimer || 0) <= 0 || game.status !== "playing") return;
        player.allyShootTimer = Math.max(0, (player.allyShootTimer || 0) - dt);
        if (player.allyShootTimer > 0) return;
        player.allyShootTimer = 0.34;
        const target = allyTargets();
        const origins = [
          { x: player.x - 42, y: player.y + 18, c: "#7bffbd" },
          { x: player.x + player.width + 42, y: player.y + 28, c: "#a8f0ff" }
        ];
        for (const o of origins) {
          const dir = target ? Math.sign(target.x - o.x) || player.dir : player.dir;
          const s = createLaserPayload(dir, 0, true);
          s.x = o.x;
          s.y = o.y;
          if (target) {
            const dx = target.x - o.x;
            const dy = target.y - o.y;
            const len = Math.max(1, Math.hypot(dx, dy));
            s.vx = (dx / len) * 1180;
            s.vy = (dy / len) * 1180;
          }
          s.coreColor = o.c;
          s.aura1 = o.c === "#7bffbd" ? "rgba(123,255,189,.95)" : "rgba(168,240,255,.95)";
          s.damage *= 0.85;
          s.power = true;
          sparks.push(s);
          spawnParticles(o.x, o.y, o.c, 3);
        }
      }

      function drawAlliedHeroes() {
        if ((player.allyTimer || 0) <= 0 || game.status !== "playing") return;
        const heroes = [
          { x: player.x - 48, y: player.y + 8, label: "S2", c: "#7bffbd" },
          { x: player.x + player.width + 48, y: player.y + 18, label: "S3", c: "#a8f0ff" }
        ];
        ctx.save();
        for (const h of heroes) {
          const x = h.x - world.camX;
          if (x < -70 || x > W + 70) continue;
          const y = h.y + Math.sin(world.time * 5 + h.x * .03) * 4;
          const glow = ctx.createRadialGradient(x, y, 4, x, y, 38);
          glow.addColorStop(0, "rgba(255,255,255,.90)");
          glow.addColorStop(.4, h.c + "cc");
          glow.addColorStop(1, "rgba(109,88,216,0)");
          ctx.fillStyle = glow;
          ctx.beginPath(); ctx.arc(x, y, 38, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = h.c;
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 3;
          ctx.beginPath(); ctx.arc(x, y, 17, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
          ctx.fillStyle = "#111";
          ctx.font = "900 12px system-ui";
          ctx.textAlign = "center";
          ctx.fillText(h.label, x, y + 4);
        }
        ctx.restore();
      }


      function updateBossTransformEffect(dt) {
        if ((player.bossTransformTimer || 0) <= 0) return;
        player.bossTransformPulseTimer = Math.max(0, (player.bossTransformPulseTimer || 0) - dt);
        if (player.bossTransformPulseTimer <= 0) {
          player.bossTransformPulseTimer = 0.38;
          const px = player.x + player.width / 2;
          const py = player.y + player.height / 2;
          spawnParticles(px, py, "#ff4bd8", 6);

          if (boss && boss.active && !boss.defeated) {
            const br = bossRect();
            const bx = br.x + br.w / 2;
            const by = br.y + br.h / 2;
            const dist = Math.hypot(bx - px, by - py);
            if (dist < 1150) {
              const wound = Math.min(Math.max(1.4, boss.maxHp * 0.018), Math.max(0.6, boss.hp - 2));
              boss.hp = Math.max(2, boss.hp - wound);
              boss.hitFlash = Math.max(boss.hitFlash || 0, 0.28);
              spawnParticles(bx, by, "#ff4bd8", 8);
              addFloatingText(bx, by - 34, "ANTI-JEFE", "#ff4bd8");
              world.shake = Math.max(world.shake, 4);
              updateHud();
            }
          }
        }
      }

      function maybeAutoCallAlliesAtBoss() {
        if (game.status !== "playing" || player.bossAutoAllyTriggered || (player.allyTimer || 0) > 0) return;
        if (!boss || !boss.active || boss.defeated) return;
        const br = bossRect();
        const bx = br.x + br.w / 2;
        const px = player.x + player.width / 2;
        if (Math.abs(bx - px) < 820 || player.x > boss.minX - 440) {
          player.bossAutoAllyTriggered = true;
          activateAllies(10, "boss");
        }
      }

      function update(dt) {
        world.time += dt;
        updateStoryScene(dt);

        if (game.status === "menu" || game.status === "level_select") {
          world.shake = Math.max(0, world.shake - dt * 30);
          return;
        }

        if (game.status === "lost" || game.status === "won") {
          world.shake = Math.max(0, world.shake - dt * 30);
          updateParticles(dt);
          updateFloatingTexts(dt);
          updateAeroTrail(dt);
          return;
        }

        if (game.messageTimer > 0 && game.messageTimer < 900) {
          game.messageTimer -= dt;
          if (game.messageTimer <= 0 && game.status === "playing") {
            game.statusMessage = "";
            updateHud();
          }
        }

        player.invulnerable = Math.max(0, player.invulnerable - dt);
        player.hurtFlash = Math.max(0, player.hurtFlash - dt);
        player.attackCooldown = Math.max(0, player.attackCooldown - dt);
        player.attackFlash = Math.max(0, player.attackFlash - dt);
        player.dropThroughTimer = Math.max(0, (player.dropThroughTimer || 0) - dt);
        player.phaseUpTimer = Math.max(0, (player.phaseUpTimer || 0) - dt);
        player.shieldTimer = Math.max(0, player.shieldTimer - dt);
        player.overdriveTimer = Math.max(0, player.overdriveTimer - dt);
        player.fireBoostTimer = Math.max(0, player.fireBoostTimer - dt);
        player.specialWeaponTimer = Math.max(0, (player.specialWeaponTimer || 0) - dt);
        player.bossTransformTimer = Math.max(0, (player.bossTransformTimer || 0) - dt);
        player.allyTimer = Math.max(0, (player.allyTimer || 0) - dt);
        updateBossTransformEffect(dt);
        if ((player.specialWeaponRestorePending || false) && player.specialWeaponTimer <= 0 && currentWeapon().id !== 'spark') {
          setWeaponModeById('spark', false);
          player.specialWeaponRestorePending = false;
          addFloatingText(player.x + player.width / 2, player.y - 26, 'BASE', '#fff0a8');
          setMessage('Poder especial agotado · vuelve el pulso base', 0.9);
        }
        player.flameCooldown = Math.max(0, player.flameCooldown - dt);
        player.dashTimer = Math.max(0, player.dashTimer - dt);
        player.dashCooldown = Math.max(0, player.dashCooldown - dt);
        world.shake = Math.max(0, world.shake - dt * 30);
        if (game.currentLevel === 1 && player.x > 5400 && player.x < 7450 && player.y > world.floorY - 60 && Math.abs(player.vx) < 8 && !keys.left && !keys.right) {
          player.vy = Math.min(player.vy, -120);
        }
        if (player.shieldTimer > 0 || player.overdriveTimer > 0 || player.fireBoostTimer > 0 || Math.floor(world.time * 4) % 4 === 0) updateHud();

        const mobileAutoAttack = touchControl.enabled && touchControl.autoFire && game.status === "playing";
        const attackHeld = (keys.attack || mobileAutoAttack) && game.status === "playing";

        if (pressedOnce.attack || (mobileAutoAttack && player.chargeTimer <= 0 && !player.chargeFired)) {
          // Marca inicio de pulsación. En móvil, el disparo frecuente queda activo por defecto.
          player.chargeTimer = 0;
          player.chargeFired = false;
          pressedOnce.attack = false;
        }

        if (attackHeld) {
          player.chargeTimer += dt;

          // Disparo básico infinito y sostenido:
          // mientras esté activo X/⚡/auto-disparo, dispara cada vez que termina el cooldown.
          // No consulta stamina y no se bloquea con 0%.
          if (player.attackCooldown <= 0) {
            launchSpark();
          }

          // Mantiene el disparo cargado como premio por sostener, sin apagar el disparo básico.
          if (player.chargeTimer >= 0.8 && !player.chargeFired) {
            launchPowerSpark();
            player.chargeFired = true;
          }
        } else {
          player.chargeTimer = 0;
          player.chargeFired = false;
        }

        if (pressedOnce.dash) {
          tryDash();
          pressedOnce.dash = false;
        }

        if (pressedOnce.shield) {
          activateShield();
          pressedOnce.shield = false;
        }

        updateParticles(dt);
        updateFloatingTexts(dt);
        updateAeroTrail(dt);
        updateMovingPlatforms(dt);
        updateFallingPlatforms(dt);
        updateEnemies(dt);
        updateEnemyProjectiles(dt);
        updateBoss(dt);
        maybeAutoCallAlliesAtBoss();
        updateBossHelpers(dt);
        updateBossClones(dt);
        updateEscapeBosses(dt);
        updateRescueCages(dt);
        updateFireSystems(dt);
        updateRisingSystems(dt);
        applyCrouchState();

        if (updateFlightMode(dt)) return;

        const inputX = (keys.right ? 1 : 0) - (keys.left ? 1 : 0);
        if (inputX !== 0) {
          player.vx += inputX * physics.moveAccel * dt;
          player.dir = inputX > 0 ? 1 : -1;
        } else {
          player.vx *= player.grounded ? physics.groundFriction : physics.airFriction;
          if (Math.abs(player.vx) < 7) player.vx = 0;
        }

        const avatarProfile = activeAvatarProfile();
        const currentMaxSpeed = (player.isCrouching ? physics.maxSpeed * 0.48 : physics.maxSpeed) * (avatarProfile.speedFactor || 1);
        if (player.dashTimer > 0) {
          player.vx = player.dashDir * 800 * (avatarProfile.dashFactor || 1);
        } else {
          player.vx = clamp(player.vx, -currentMaxSpeed, currentMaxSpeed);
        }

        if (pressedOnce.jump) {
          player.jumpBufferTimer = physics.jumpBuffer;
          pressedOnce.jump = false;
        } else {
          player.jumpBufferTimer -= dt;
        }

        if (player.grounded) {
          player.coyote = physics.coyoteTime;
          player.airJumpsLeft = physics.extraJumps;
        } else {
          player.coyote -= dt;
        }

        if (player.jumpBufferTimer > 0) {
          const canGroundJump = player.coyote > 0 && !player.isCrouching;
          const canDoubleJump = !player.grounded && player.airJumpsLeft > 0 && !player.isCrouching;

          if (canGroundJump) {
            doJump(physics.jumpSpeed, false);
          } else if (canDoubleJump) {
            doJump(physics.doubleJumpSpeed, true);
          }
        }

        player.airJumpFlash = Math.max(0, player.airJumpFlash - dt);

        const g = player.vy < 0 ? physics.gravityUp : physics.gravityDown;
        player.vy += g * dt;

        if (!keys.jump && player.vy < 0) {
          player.vy += physics.gravityUp * physics.shortHopCut * dt;
        }

        const prevX = player.x;
        const prevY = player.y;
        player.prevX = prevX;
        player.prevY = prevY;

        player.x += player.vx * dt;
        player.y += player.vy * dt;

        const groundTop = world.floorY - player.height;
        player.lastGrounded = player.grounded;
        player.grounded = false;

        if (player.y >= groundTop) {
          player.y = groundTop;
          player.vy = 0;
          player.grounded = true;
          resetJumpCapacity();
        }

        resolveSolidBlockCollisions(prevX, prevY);
        resolveMovingPlatformCollisions(prevX, prevY);
        resolveFallingPlatformCollisions(prevX, prevY);
        resolveExtraPlatformCollisions(prevX, prevY);
        applyCrouchState();

        if (!player.lastGrounded && player.grounded) {
          player.squash = 0.88;
        }

        player.x = Math.max(40, player.x);

        const targetCam = Math.max(0, player.x - W * 0.35);
        world.camX += (targetCam - world.camX) * Math.min(1, dt * 5);

        player.runT += Math.abs(player.vx) * dt * 0.028;
        player.squash += (1 - player.squash) * Math.min(1, dt * 8);

        if (game.status !== "playing" && game.status !== "won") {
          player.vx *= player.grounded ? 0.82 : 0.98;
        }

        refreshPortalState();
        updateLevelCollisions();
        updateWarpTubes(dt);
        updateAllyCompanions(dt);
        updateSparks(dt);

        if (player.hurtFlash > 0) {
          player.state = "hurt";
        } else if (player.isCrouching && player.grounded) {
          player.state = "crouch";
        } else if (!player.grounded) {
          player.state = player.vy < -60 ? "jump_up" : (player.vy > 110 ? "fall" : "jump_air");
        } else if (Math.abs(player.vx) > 30) {
          player.state = "run";
        } else {
          player.state = "idle";
        }

        const animSpeed = player.state === "run" ? 12 : (player.state === "idle" ? 3 : 1);
        player.animTimer += dt * animSpeed;
        player.animFrame = Math.floor(player.animTimer);
      }


      function stompEnemy(enemy) {
        if (!enemy.active) return false;
        const damage = Math.max(0.34, (enemy.maxHp || enemy.hp || 3) / 3);
        const cx = enemy.x + enemy.w / 2;
        const cy = world.floorY + enemy.y - enemy.h / 2;
        hitEnemy(enemy, 0, damage);
        player.vy = Math.min(player.vy, -520);
        player.grounded = false;
        player.coyote = 0;
        resetJumpCapacity();
        player.airJumpsLeft = Math.max(player.airJumpsLeft, 1);
        player.squash = 1.12;
        player.invulnerable = Math.max(player.invulnerable, 0.16);
        spawnParticles(cx, cy, "#f2e66d", 8);
        addFloatingText(cx, cy - 26, "SALTO", "#f2e66d");
        setMessage("Salto certero · enemigo debilitado", 0.58);
        playSfx("jump");
        return true;
      }

      function canStompEnemy(enemy, pr, er) {
        const prevBottom = (player.prevY || player.y) + player.height;
        const currentBottom = player.y + player.height;
        const movingDown = player.vy >= -40;
        const enteredFromAbove = prevBottom <= er.y + Math.max(18, er.h * 0.32);
        const feetNearTop = currentBottom <= er.y + Math.max(30, er.h * 0.45);
        return movingDown && enteredFromAbove && feetNearTop;
      }


      function canStompBoss(pr, br) {
        if (!boss || !boss.active || boss.defeated) return false;
        const prevBottom = (player.prevY || player.y) + player.height;
        const currentBottom = player.y + player.height;
        return player.vy >= -40 && prevBottom <= br.y + Math.max(22, br.h * 0.28) && currentBottom <= br.y + Math.max(42, br.h * 0.48);
      }

      function stompBoss() {
        if (!boss || !boss.active || boss.defeated) return false;
        const br = bossRect();
        const damage = Math.max(4, boss.maxHp * 0.045);
        boss.hp = Math.max(1, boss.hp - damage);
        boss.hitFlash = 0.32;
        boss.invulnTimer = Math.max(boss.invulnTimer || 0, 0.12);
        player.vy = -620;
        player.grounded = false;
        player.coyote = 0;
        resetJumpCapacity();
        player.airJumpsLeft = Math.max(player.airJumpsLeft, 1);
        player.invulnerable = Math.max(player.invulnerable, 0.25);
        world.shake = Math.max(world.shake, 10);
        const cx = boss.x + boss.w / 2;
        const cy = br.y + 20;
        spawnParticles(cx, cy, "#fff0a8", 22);
        addFloatingText(cx, cy - 18, `SALTO -${damage.toFixed(1)}`, "#fff0a8");
        setMessage("Pisotón al jefe · poder reducido", 0.78);
        checkScoreRewards();
        updateHud();
        return true;
      }

      function updateLevelCollisions() {
        const pr = playerRect();

        for (const obstacle of obstacles) {
          if (!obstacle.active) continue;
          const rect = {
            x: obstacle.x,
            y: world.floorY - obstacle.h,
            w: obstacle.w,
            h: obstacle.h
          };
          if (rectsOverlap(pr, rect)) {
            if (player.dashTimer > 0 && obstacle.breakable) {
              obstacle.active = false;
              game.score += obstacle.reward || 50;
              const dropX = obstacle.x + obstacle.w / 2;
              const dropY = world.floorY - obstacle.h / 2;
              spawnParticles(dropX, dropY, "#6d58d8", 10);
              dropEnergyOrb(dropX, dropY);
              world.shake = Math.max(world.shake, 5);
              updateHud();
            } else {
              damagePlayer(obstacle.x + obstacle.w / 2);
              break;
            }
          }
        }

        for (const flame of floorFlames) {
          const rect = { x: flame.x, y: world.floorY - flame.h + (flame.y || 0), w: flame.w, h: flame.h };
          if (rectsOverlap(pr, rect)) {
            burnPlayer(flame.x + flame.w / 2, flame.stamina || 10);
            break;
          }
        }

        for (const flame of airFlames) {
          if (!flame.active) continue;
          const fx = flame.x;
          const fy = world.floorY + flame.y;
          if (circleRectCollision(fx, fy, flame.r + 4, pr)) {
            flame.active = false;
            flame.respawnTimer = flame.respawn;
            burnPlayer(fx, flame.stamina || 12);
            spawnParticles(fx, fy, "#ff7a36", 8);
            break;
          }
        }

        for (const orb of orbs) {
          if (orb.collected) continue;
          const ox = orb.x;
          const oy = world.floorY + orb.y;
          if (circleRectCollision(ox, oy, orb.r + 4, pr)) {
            collectOrb(orb);
          }
        }

        for (const item of energyPickups) {
          if (item.collected) continue;
          const ix = item.x;
          const iy = world.floorY + item.y;
          if (circleRectCollision(ix, iy, item.r + 4, pr)) {
            collectEnergyPickup(item);
          }
        }

        for (const item of shieldPickups) {
          if (item.collected) continue;
          const ix = item.x;
          const iy = world.floorY + item.y;
          if (circleRectCollision(ix, iy, item.r + 4, pr)) {
            collectShieldPickup(item);
          }
        }

        for (const item of flowOrbs) {
          if (item.collected) continue;
          const ix = item.x;
          const iy = world.floorY + item.y;
          if (circleRectCollision(ix, iy, item.r + 4, pr)) {
            collectFlowOrb(item);
          }
        }

        for (const item of firePickups) {
          if (item.collected) continue;
          const ix = item.x;
          const iy = world.floorY + item.y;
          if (circleRectCollision(ix, iy, item.r + 6, pr)) {
            collectFirePickup(item);
          }
        }

        for (const enemy of enemies) {
          if (!enemy.active) continue;
          const er = enemyRect(enemy);
          if (rectsOverlap(pr, er)) {
            if (canStompEnemy(enemy, pr, er)) {
              stompEnemy(enemy);
              continue;
            }
            const dashWeak = player.dashTimer > 0 && (enemy.kind === "walker" || enemy.kind === "flyer" || enemy.kind === "flyer_mini");
            if (dashWeak) {
              enemy.active = false;
              if (enemy.countsForGoal) game.enemiesDefeated += 1;
              game.score += enemy.countsForGoal ? 120 : 35;
              const dropX = enemy.x + enemy.w / 2;
              const dropY = world.floorY + enemy.y - enemy.h / 2;
              spawnParticles(dropX, dropY, "#36a678", 10);
              dropEnergyOrb(dropX, dropY);
              world.shake = Math.max(world.shake, 7);
              refreshPortalState();
              updateHud();
            } else {
              damagePlayer(enemy.x + enemy.w / 2);
              break;
            }
          }
        }

        if (boss && boss.active && rectsOverlap(pr, bossRect())) {
          if (canStompBoss(pr, bossRect())) {
            stompBoss();
          } else {
            damagePlayer(boss.x + boss.w / 2);
          }
        }

        if (game.status === "playing" && portal.active && rectsOverlap(pr, portalRect())) {
          game.status = "won";
          game.score += 300;
          playSfx("portal");
          world.shake = Math.max(world.shake, 10);
          setMessage("Pieza ganada · Sombra escapó", 999);
          updateHud();
          finishRun("won");
        }
      }


      function drawWorld1TunnelOverlay() {
        if (game.currentLevel !== 0) return;
        const dkStart = 5150;
        const dkEnd = 9300;
        if (world.camX + W < dkStart - 180 || world.camX > dkEnd + 220) return;

        ctx.save();
        const sx = Math.max(0, dkStart - world.camX);
        const ex = Math.min(W, dkEnd - world.camX);

        // Escena especial tipo arcade clásico, pero con identidad Aero.
        const alpha = clamp((Math.min(world.camX + W, dkEnd) - Math.max(world.camX, dkStart)) / Math.min(W, dkEnd - dkStart), 0, 1);
        ctx.globalAlpha = 0.50 * alpha;
        const bg = ctx.createLinearGradient(0, 0, 0, H);
        bg.addColorStop(0, "rgba(7,8,18,.96)");
        bg.addColorStop(.55, "rgba(18,16,36,.90)");
        bg.addColorStop(1, "rgba(7,8,18,.98)");
        ctx.fillStyle = bg;
        ctx.fillRect(sx, 0, Math.max(0, ex - sx), H);
        ctx.globalAlpha = 1;

        // Retícula de fondo y tuberías decorativas NO jugables.
        ctx.save();
        ctx.beginPath();
        ctx.rect(sx, 0, Math.max(0, ex - sx), H);
        ctx.clip();

        ctx.strokeStyle = "rgba(168,240,255,.10)";
        ctx.lineWidth = 1;
        for (let gx = dkStart - world.camX - ((world.camX - dkStart) % 80); gx < ex + 80; gx += 80) {
          ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, H); ctx.stroke();
        }
        for (let gy = 80; gy < H; gy += 80) {
          ctx.beginPath(); ctx.moveTo(sx, gy); ctx.lineTo(ex, gy); ctx.stroke();
        }

        const pipeY = world.floorY - 420;
        ctx.lineWidth = 10;
        ctx.strokeStyle = "rgba(0,128,80,.65)";
        ctx.beginPath();
        ctx.moveTo(5260 - world.camX, pipeY);
        ctx.lineTo(5480 - world.camX, pipeY);
        ctx.quadraticCurveTo(5560 - world.camX, pipeY, 5560 - world.camX, pipeY + 70);
        ctx.lineTo(5560 - world.camX, pipeY + 120);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(8920 - world.camX, pipeY + 40);
        ctx.lineTo(8720 - world.camX, pipeY + 40);
        ctx.quadraticCurveTo(8640 - world.camX, pipeY + 40, 8640 - world.camX, pipeY + 115);
        ctx.lineTo(8640 - world.camX, pipeY + 170);
        ctx.stroke();

        // Señales discretas. Menos saturación que las flechas gigantes.
        function sign(worldX, worldY, text) {
          const x = worldX - world.camX;
          const y = world.floorY + worldY;
          if (x < -100 || x > W + 100) return;
          ctx.fillStyle = "rgba(20,25,35,.55)";
          roundRect(ctx, x - 36, y - 14, 72, 26, 13);
          ctx.fill();
          ctx.fillStyle = "#fff0a8";
          ctx.font = "900 12px system-ui, sans-serif";
          ctx.textAlign = "center";
          ctx.fillText(text, x, y + 4);
        }
        sign(5360, -108, "ENTRA");
        sign(7040, -164, "SUBE");
        sign(5520, -246, "CRUZA");
        sign(6840, -330, "SUBE");
        sign(7600, -268, "BAJA");
        sign(8500, -132, "SALIDA");

        ctx.restore();
        ctx.restore();
      }

      function drawBackground() {
        const bgConfig = getLevelBackgroundConfig(game.currentLevel);
        if (bgConfig && drawManifestWorldBackground(bgConfig)) {
          return;
        }

        ctx.clearRect(0, 0, W, H);

        if (game.currentLevel === 1) {
          drawTechBackground();
          return;
        }
        if (game.currentLevel === 2) {
          drawWorld3Background();
          return;
        }
        if (game.currentLevel === 3) {
          drawSwampBackground();
          return;
        }
        if (game.currentLevel === 4) {
          drawToxicSkyBackground();
          return;
        }

        const sky = ctx.createLinearGradient(0, 0, 0, H);
        sky.addColorStop(0, "#6a708f");
        sky.addColorStop(0.28, "#8b7d97");
        sky.addColorStop(0.60, "#c4876e");
        sky.addColorStop(0.80, "#5a3c47");
        sky.addColorStop(1, "#2a2634");
        ctx.fillStyle = sky;
        ctx.fillRect(0, 0, W, H);

        drawAtmosphere();
        drawFarSkyline();
        drawMidSpireBand();
        drawNearParallaxBand();
        drawBurningSkyEffects();
        drawGroundDecor();

        ctx.fillStyle = "rgba(255,255,255,.26)";
        ctx.fillRect(0, world.floorY - 4, W, 4);

        ctx.strokeStyle = "rgba(30,35,45,.45)";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(0, world.floorY);
        ctx.lineTo(W, world.floorY);
        ctx.stroke();
      }


      function drawTechBackground() {
        const sky = ctx.createLinearGradient(0, 0, 0, H);
        sky.addColorStop(0, "#1b2234");
        sky.addColorStop(0.34, "#26364d");
        sky.addColorStop(0.68, "#364558");
        sky.addColorStop(1, "#171b27");
        ctx.fillStyle = sky;
        ctx.fillRect(0, 0, W, H);

        // Núcleo/cielo artificial
        const coreX = W * 0.62 - (world.camX * 0.035 % 160);
        const coreGlow = ctx.createRadialGradient(coreX, H * 0.48, 10, coreX, H * 0.48, Math.max(W, H) * 0.45);
        coreGlow.addColorStop(0, "rgba(108,220,255,.20)");
        coreGlow.addColorStop(0.42, "rgba(109,88,216,.10)");
        coreGlow.addColorStop(1, "rgba(109,88,216,0)");
        ctx.fillStyle = coreGlow;
        ctx.fillRect(0, 0, W, H);

        // Grilla tecnológica lejana
        ctx.save();
        ctx.globalAlpha = 0.18;
        ctx.strokeStyle = "#8bd8ff";
        ctx.lineWidth = 1;
        const grid = 64;
        const ox = -(world.camX * 0.12) % grid;
        for (let x = ox; x < W; x += grid) {
          ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
        }
        for (let y = 40; y < H; y += grid) {
          ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
        }
        ctx.restore();

        // Siluetas de estación, torres, hangares
        const bandY = world.floorY - 315;
        const farShift = -(world.camX * 0.22) % 520;
        for (let x0 = farShift - 520; x0 < W + 520; x0 += 520) {
          ctx.fillStyle = "rgba(10,16,30,.34)";
          for (let i = 0; i < 5; i++) {
            const x = x0 + i * 105 + 20;
            const h = 110 + ((i * 41) % 90);
            roundRect(ctx, x, bandY + 205 - h, 70, h, 4);
            ctx.fill();
            ctx.fillStyle = "rgba(108,220,255,.10)";
            ctx.fillRect(x + 12, bandY + 220 - h, 8, h - 24);
            ctx.fillStyle = "rgba(10,16,30,.34)";
          }
          ctx.fillStyle = "rgba(8,12,22,.42)";
          ctx.beginPath();
          ctx.moveTo(x0, world.floorY - 105);
          ctx.lineTo(x0 + 80, world.floorY - 170);
          ctx.lineTo(x0 + 160, world.floorY - 112);
          ctx.lineTo(x0 + 250, world.floorY - 198);
          ctx.lineTo(x0 + 340, world.floorY - 112);
          ctx.lineTo(x0 + 520, world.floorY - 165);
          ctx.lineTo(x0 + 520, world.floorY);
          ctx.lineTo(x0, world.floorY);
          ctx.closePath();
          ctx.fill();
        }

        // Tubos y cables cercanos
        const nearShift = -(world.camX * 0.55) % 360;
        for (let x0 = nearShift - 360; x0 < W + 360; x0 += 360) {
          ctx.strokeStyle = "rgba(108,220,255,.25)";
          ctx.lineWidth = 5;
          ctx.beginPath();
          ctx.moveTo(x0 + 20, world.floorY - 250);
          ctx.bezierCurveTo(x0 + 90, world.floorY - 310, x0 + 180, world.floorY - 155, x0 + 340, world.floorY - 230);
          ctx.stroke();

          ctx.fillStyle = "rgba(228,201,79,.24)";
          ctx.beginPath();
          ctx.arc(x0 + 92, world.floorY - 92, 8, 0, Math.PI * 2);
          ctx.arc(x0 + 236, world.floorY - 122, 6, 0, Math.PI * 2);
          ctx.fill();
        }

        // Piso industrial
        const floorGrad = ctx.createLinearGradient(0, world.floorY - 30, 0, H);
        floorGrad.addColorStop(0, "rgba(76,86,106,.96)");
        floorGrad.addColorStop(1, "rgba(18,22,31,.98)");
        ctx.fillStyle = floorGrad;
        ctx.fillRect(0, world.floorY, W, H - world.floorY);

        ctx.fillStyle = "rgba(108,220,255,.25)";
        ctx.fillRect(0, world.floorY - 5, W, 4);
        ctx.strokeStyle = "rgba(255,255,255,.16)";
        ctx.lineWidth = 1;
        for (let x = -(world.camX % 74); x < W; x += 74) {
          ctx.beginPath();
          ctx.moveTo(x, world.floorY);
          ctx.lineTo(x + 36, H);
          ctx.stroke();
        }
      }


      function drawWorld3Background() {
        const sky = ctx.createLinearGradient(0, 0, 0, H);
        sky.addColorStop(0, "#101827");
        sky.addColorStop(0.32, "#1f3551");
        sky.addColorStop(0.58, "#4d4b78");
        sky.addColorStop(0.82, "#271d3d");
        sky.addColorStop(1, "#11101d");
        ctx.fillStyle = sky;
        ctx.fillRect(0, 0, W, H);

        // aurora fría y geoda interna
        const aurora = ctx.createLinearGradient(0, H * 0.1, W, H * 0.65);
        aurora.addColorStop(0, "rgba(108,220,255,0)");
        aurora.addColorStop(0.30, "rgba(108,220,255,.16)");
        aurora.addColorStop(0.55, "rgba(232,84,255,.18)");
        aurora.addColorStop(0.85, "rgba(108,220,255,0)");
        ctx.fillStyle = aurora;
        ctx.fillRect(0, 0, W, H);

        // nieve/partículas
        ctx.save();
        ctx.fillStyle = "rgba(255,255,255,.42)";
        for (let i = 0; i < 70; i++) {
          const x = (i * 97 - world.camX * (0.08 + (i % 5) * 0.01) + world.time * 12) % (W + 60) - 30;
          const y = (i * 53 + Math.sin(world.time * 0.7 + i) * 18) % Math.max(1, H);
          const r = 1 + (i % 3) * 0.5;
          ctx.beginPath();
          ctx.arc(x, y, r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();

        // montañas de tundra lejanas
        const farShift = -(world.camX * 0.18) % 620;
        for (let x0 = farShift - 620; x0 < W + 620; x0 += 620) {
          ctx.fillStyle = "rgba(12,20,35,.38)";
          ctx.beginPath();
          ctx.moveTo(x0, world.floorY - 100);
          ctx.lineTo(x0 + 95, world.floorY - 240);
          ctx.lineTo(x0 + 165, world.floorY - 125);
          ctx.lineTo(x0 + 280, world.floorY - 300);
          ctx.lineTo(x0 + 390, world.floorY - 105);
          ctx.lineTo(x0 + 520, world.floorY - 230);
          ctx.lineTo(x0 + 620, world.floorY - 100);
          ctx.lineTo(x0 + 620, world.floorY);
          ctx.lineTo(x0, world.floorY);
          ctx.closePath();
          ctx.fill();

          ctx.fillStyle = "rgba(180,230,255,.16)";
          ctx.beginPath();
          ctx.moveTo(x0 + 95, world.floorY - 240);
          ctx.lineTo(x0 + 128, world.floorY - 173);
          ctx.lineTo(x0 + 68, world.floorY - 180);
          ctx.closePath();
          ctx.fill();
        }

        // cristales geoda cercanos
        const nearShift = -(world.camX * 0.45) % 420;
        for (let x0 = nearShift - 420; x0 < W + 420; x0 += 420) {
          for (let i = 0; i < 4; i++) {
            const x = x0 + 55 + i * 94;
            const h = 74 + ((i * 37) % 86);
            const y = world.floorY - h;
            const g = ctx.createLinearGradient(x, y, x + 40, world.floorY);
            g.addColorStop(0, "rgba(232,84,255,.34)");
            g.addColorStop(0.55, "rgba(108,220,255,.22)");
            g.addColorStop(1, "rgba(50,35,84,.40)");
            ctx.fillStyle = g;
            ctx.strokeStyle = "rgba(255,255,255,.17)";
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(x, world.floorY);
            ctx.lineTo(x + 18, y);
            ctx.lineTo(x + 38, world.floorY);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
          }
        }

        // piso helado/geoda
        const floor = ctx.createLinearGradient(0, world.floorY - 20, 0, H);
        floor.addColorStop(0, "rgba(178,220,232,.92)");
        floor.addColorStop(.25, "rgba(71,86,119,.96)");
        floor.addColorStop(1, "rgba(18,14,32,.98)");
        ctx.fillStyle = floor;
        ctx.fillRect(0, world.floorY, W, H - world.floorY);
        ctx.fillStyle = "rgba(160,240,255,.32)";
        ctx.fillRect(0, world.floorY - 5, W, 4);

        ctx.strokeStyle = "rgba(255,255,255,.14)";
        ctx.lineWidth = 1;
        for (let x = -(world.camX % 90); x < W; x += 90) {
          ctx.beginPath();
          ctx.moveTo(x, world.floorY);
          ctx.lineTo(x + 52, H);
          ctx.stroke();
        }
      }


      function drawSwampBackground() {
        const sky = ctx.createLinearGradient(0, 0, 0, H);
        sky.addColorStop(0, "#182b2c");
        sky.addColorStop(0.38, "#264538");
        sky.addColorStop(0.72, "#4d3d55");
        sky.addColorStop(1, "#15131d");
        ctx.fillStyle = sky;
        ctx.fillRect(0, 0, W, H);

        const fog = ctx.createRadialGradient(W * .48, world.floorY - 120, 30, W * .48, world.floorY - 120, Math.max(W, H) * .65);
        fog.addColorStop(0, "rgba(0,160,140,.18)");
        fog.addColorStop(.55, "rgba(157,0,255,.10)");
        fog.addColorStop(1, "rgba(0,0,0,0)");
        ctx.fillStyle = fog;
        ctx.fillRect(0, 0, W, H);

        const farShift = -(world.camX * 0.16) % 520;
        for (let x0 = farShift - 520; x0 < W + 520; x0 += 520) {
          ctx.fillStyle = "rgba(8,20,18,.42)";
          for (let i = 0; i < 6; i++) {
            const x = x0 + i * 86 + 20;
            const h = 85 + (i * 37) % 120;
            roundRect(ctx, x, world.floorY - h, 46, h, 20);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(x + 22, world.floorY - h + 12, 52 + (i % 3) * 18, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.strokeStyle = "rgba(0,128,128,.26)";
          ctx.lineWidth = 7;
          ctx.beginPath();
          ctx.moveTo(x0, world.floorY - 90);
          ctx.bezierCurveTo(x0 + 90, world.floorY - 180, x0 + 170, world.floorY - 20, x0 + 260, world.floorY - 130);
          ctx.bezierCurveTo(x0 + 350, world.floorY - 230, x0 + 430, world.floorY - 80, x0 + 520, world.floorY - 150);
          ctx.stroke();
        }

        const nearShift = -(world.camX * 0.45) % 360;
        for (let x0 = nearShift - 360; x0 < W + 360; x0 += 360) {
          ctx.fillStyle = "rgba(0,70,64,.30)";
          ctx.beginPath();
          ctx.ellipse(x0 + 80, world.floorY - 38, 130, 42, 0, 0, Math.PI * 2);
          ctx.ellipse(x0 + 250, world.floorY - 30, 110, 36, 0, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = "rgba(157,0,255,.24)";
          ctx.beginPath(); ctx.arc(x0 + 70, world.floorY - 82, 8, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = "rgba(0,208,208,.24)";
          ctx.beginPath(); ctx.arc(x0 + 225, world.floorY - 72, 7, 0, Math.PI * 2); ctx.fill();
        }

        const floor = ctx.createLinearGradient(0, world.floorY - 20, 0, H);
        floor.addColorStop(0, "rgba(25,70,60,.96)");
        floor.addColorStop(.38, "rgba(32,42,45,.98)");
        floor.addColorStop(1, "rgba(10,12,18,.99)");
        ctx.fillStyle = floor;
        ctx.fillRect(0, world.floorY, W, H - world.floorY);
        ctx.fillStyle = "rgba(0,208,208,.26)";
        ctx.fillRect(0, world.floorY - 4, W, 3);
      }

      function drawToxicSkyBackground() {
        const sky = ctx.createLinearGradient(0, 0, 0, H);
        sky.addColorStop(0, "#0f1015");
        sky.addColorStop(0.28, "#252523");
        sky.addColorStop(0.52, "#4d4b18");
        sky.addColorStop(0.78, "#2b263a");
        sky.addColorStop(1, "#101019");
        ctx.fillStyle = sky;
        ctx.fillRect(0, 0, W, H);

        const storm = ctx.createRadialGradient(W * .58, H * .34, 20, W * .58, H * .34, Math.max(W, H) * .62);
        storm.addColorStop(0, "rgba(255,245,0,.22)");
        storm.addColorStop(.38, "rgba(109,88,216,.16)");
        storm.addColorStop(1, "rgba(0,0,0,0)");
        ctx.fillStyle = storm;
        ctx.fillRect(0, 0, W, H);

        const cloudShift = -(world.camX * 0.20) % 520;
        for (let x0 = cloudShift - 520; x0 < W + 520; x0 += 520) {
          ctx.fillStyle = "rgba(12,12,14,.42)";
          for (let i = 0; i < 6; i++) {
            ctx.beginPath();
            ctx.ellipse(x0 + i * 92 + 30, 120 + (i % 3) * 42 + Math.sin(world.time + i) * 6, 92, 34, 0, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.strokeStyle = "rgba(255,245,0,.30)";
          ctx.lineWidth = 3;
          if ((Math.floor(world.time * 1.2 + x0) % 9) === 0) {
            ctx.beginPath();
            ctx.moveTo(x0 + 260, 90);
            ctx.lineTo(x0 + 236, 150);
            ctx.lineTo(x0 + 272, 150);
            ctx.lineTo(x0 + 244, 230);
            ctx.stroke();
          }
        }

        const cityShift = -(world.camX * 0.12) % 620;
        for (let x0 = cityShift - 620; x0 < W + 620; x0 += 620) {
          ctx.fillStyle = "rgba(6,8,12,.40)";
          for (let i = 0; i < 8; i++) {
            const x = x0 + i * 78;
            const h = 70 + (i * 31) % 150;
            roundRect(ctx, x, world.floorY - h, 50, h, 3);
            ctx.fill();
          }
        }

        const floor = ctx.createLinearGradient(0, world.floorY - 30, 0, H);
        floor.addColorStop(0, "rgba(70,72,62,.96)");
        floor.addColorStop(.35, "rgba(34,32,42,.98)");
        floor.addColorStop(1, "rgba(8,8,14,.99)");
        ctx.fillStyle = floor;
        ctx.fillRect(0, world.floorY, W, H - world.floorY);
        ctx.fillStyle = "rgba(255,245,0,.24)";
        ctx.fillRect(0, world.floorY - 4, W, 3);
      }

      function drawBurningSkyEffects() {
        const horizonGlow = ctx.createLinearGradient(0, world.floorY - 160, 0, world.floorY + 12);
        horizonGlow.addColorStop(0, "rgba(255,140,56,0)");
        horizonGlow.addColorStop(0.45, "rgba(255,126,48,.12)");
        horizonGlow.addColorStop(1, "rgba(255,86,36,.20)");
        ctx.fillStyle = horizonGlow;
        ctx.fillRect(0, world.floorY - 180, W, 200);

        drawRepeatingLayer(360, 0.18, (x0) => {
          for (let i = 0; i < 3; i++) {
            const x = x0 + 38 + i * 108;
            const plumeH = 80 + ((i * 37) % 50);
            const plumeW = 28 + i * 8;
            const smoke = ctx.createRadialGradient(x, world.floorY - plumeH * 0.4, 6, x, world.floorY - plumeH * 0.4, plumeW * 1.8);
            smoke.addColorStop(0, "rgba(70,72,88,.22)");
            smoke.addColorStop(0.55, "rgba(48,50,60,.18)");
            smoke.addColorStop(1, "rgba(48,50,60,0)");
            ctx.fillStyle = smoke;
            ctx.beginPath();
            ctx.ellipse(x, world.floorY - plumeH * 0.45, plumeW, plumeH * 0.62, 0, 0, Math.PI * 2);
            ctx.fill();
          }
        });

        drawRepeatingLayer(280, 0.22, (x0) => {
          for (let i = 0; i < 4; i++) {
            const fx = x0 + 22 + i * 62;
            const fy = world.floorY - 18 - (i % 2) * 6;
            const pulse = 1 + Math.sin(world.time * 7 + fx * 0.02) * 0.12;
            const glow = ctx.createRadialGradient(fx, fy, 2, fx, fy, 20 * pulse);
            glow.addColorStop(0, "rgba(255,235,180,.9)");
            glow.addColorStop(0.42, "rgba(255,142,54,.55)");
            glow.addColorStop(1, "rgba(255,90,38,0)");
            ctx.fillStyle = glow;
            ctx.beginPath();
            ctx.arc(fx, fy, 18 * pulse, 0, Math.PI * 2);
            ctx.fill();
          }
        });

        if ((world.time % 8.5) < 0.22) {
          ctx.save();
          ctx.strokeStyle = "rgba(248,248,255,.40)";
          ctx.lineWidth = 3;
          ctx.beginPath();
          const x = W * 0.74;
          ctx.moveTo(x, 40);
          ctx.lineTo(x - 18, 96);
          ctx.lineTo(x + 6, 96);
          ctx.lineTo(x - 28, 162);
          ctx.stroke();
          ctx.restore();
        }
      }

      function drawAtmosphere() {
        ctx.strokeStyle = "rgba(60,75,85,.08)";
        ctx.lineWidth = 1;
        const step = 36;
        const off = -world.camX * 0.12 % step;
        for (let x = off; x < W + step; x += step) {
          ctx.beginPath();
          ctx.moveTo(x, 0);
          ctx.lineTo(x, H);
          ctx.stroke();
        }
        for (let y = 0; y < H; y += step) {
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(W, y);
          ctx.stroke();
        }

        const hazeTop = ctx.createLinearGradient(0, 0, 0, H * 0.55);
        hazeTop.addColorStop(0, "rgba(255,255,255,.24)");
        hazeTop.addColorStop(1, "rgba(255,255,255,0)");
        ctx.fillStyle = hazeTop;
        ctx.fillRect(0, 0, W, H * 0.55);
      }

      function drawFarSkyline() {
        const speed = 0.12;
        const bandY = world.floorY - 240;
        const base = world.floorY - 112;

        drawRepeatingLayer(520, speed, (x0) => {
          const shapes = [
            {x: 0, w: 54, h: 118},
            {x: 62, w: 24, h: 166},
            {x: 94, w: 76, h: 138},
            {x: 186, w: 26, h: 154},
            {x: 220, w: 44, h: 108},
            {x: 274, w: 88, h: 128},
            {x: 374, w: 22, h: 172},
            {x: 406, w: 42, h: 120},
            {x: 458, w: 32, h: 148}
          ];

          ctx.save();
          ctx.fillStyle = "rgba(112,111,147,.23)";
          for (const s of shapes) {
            const x = x0 + s.x;
            const y = base - s.h;
            ctx.fillRect(x, y, s.w, s.h);
            ctx.beginPath();
            ctx.moveTo(x + s.w * 0.25, y);
            ctx.lineTo(x + s.w * 0.5, y - 16);
            ctx.lineTo(x + s.w * 0.75, y);
            ctx.closePath();
            ctx.fill();
          }
          ctx.restore();
        });

        const fog = ctx.createLinearGradient(0, bandY, 0, world.floorY);
        fog.addColorStop(0, "rgba(196,202,214,0)");
        fog.addColorStop(0.55, "rgba(210,214,224,.18)");
        fog.addColorStop(1, "rgba(224,227,235,.46)");
        ctx.fillStyle = fog;
        ctx.fillRect(0, bandY, W, world.floorY - bandY);
      }

      function drawMidSpireBand() {
        const speed = 0.26;
        const base = world.floorY - 70;

        drawRepeatingLayer(420, speed, (x0) => {
          ctx.save();
          ctx.fillStyle = "rgba(99,95,133,.17)";
          ctx.beginPath();
          ctx.moveTo(x0, base);
          ctx.lineTo(x0 + 24, base - 48);
          ctx.lineTo(x0 + 52, base - 102);
          ctx.lineTo(x0 + 76, base - 42);
          ctx.lineTo(x0 + 110, base - 88);
          ctx.lineTo(x0 + 144, base - 34);
          ctx.lineTo(x0 + 188, base - 126);
          ctx.lineTo(x0 + 226, base - 56);
          ctx.lineTo(x0 + 256, base - 80);
          ctx.lineTo(x0 + 302, base - 30);
          ctx.lineTo(x0 + 340, base - 96);
          ctx.lineTo(x0 + 388, base - 44);
          ctx.lineTo(x0 + 420, base);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        });

        drawRepeatingLayer(360, speed * 1.06, (x0) => {
          ctx.save();
          ctx.fillStyle = "rgba(126,118,164,.16)";
          for (let i = 0; i < 4; i++) {
            const x = x0 + i * 88 + 12;
            const h = 48 + (i % 2) * 18;
            ctx.fillRect(x, base - h, 18, h);
            ctx.beginPath();
            ctx.moveTo(x - 4, base - h + 10);
            ctx.lineTo(x + 9, base - h - 18);
            ctx.lineTo(x + 22, base - h + 10);
            ctx.closePath();
            ctx.fill();
          }
          ctx.restore();
        });
      }

      function drawNearParallaxBand() {
        const speed = 0.48;
        const base = world.floorY;

        drawRepeatingLayer(320, speed, (x0) => {
          ctx.save();
          ctx.fillStyle = "rgba(111,118,139,.12)";
          ctx.beginPath();
          ctx.moveTo(x0, base);
          ctx.lineTo(x0 + 18, base - 18);
          ctx.lineTo(x0 + 42, base - 10);
          ctx.lineTo(x0 + 68, base - 38);
          ctx.lineTo(x0 + 94, base - 16);
          ctx.lineTo(x0 + 124, base - 52);
          ctx.lineTo(x0 + 154, base - 22);
          ctx.lineTo(x0 + 184, base - 42);
          ctx.lineTo(x0 + 222, base - 12);
          ctx.lineTo(x0 + 248, base - 28);
          ctx.lineTo(x0 + 278, base - 8);
          ctx.lineTo(x0 + 320, base);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        });

        const fogBottom = ctx.createLinearGradient(0, world.floorY - 110, 0, H);
        fogBottom.addColorStop(0, "rgba(228,231,237,0)");
        fogBottom.addColorStop(0.55, "rgba(225,228,235,.18)");
        fogBottom.addColorStop(1, "rgba(236,239,244,.52)");
        ctx.fillStyle = fogBottom;
        ctx.fillRect(0, world.floorY - 110, W, H - world.floorY + 110);
      }

      function drawGroundDecor() {
        const groundGrad = ctx.createLinearGradient(0, world.floorY, 0, H);
        groundGrad.addColorStop(0, "rgba(78,82,98,.22)");
        groundGrad.addColorStop(1, "rgba(38,42,52,.34)");
        ctx.fillStyle = groundGrad;
        ctx.fillRect(0, world.floorY, W, H - world.floorY);

        for (let i = -1; i < W / 82 + 3; i++) {
          const x = (i * 82 - (world.camX * 0.9 % 82));
          ctx.strokeStyle = "rgba(18,22,30,.13)";
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(x, world.floorY);
          ctx.lineTo(x + 34, world.floorY + 30);
          ctx.stroke();
        }
      }

      function drawRepeatingLayer(tileW, speed, painter) {
        const offset = (world.camX * speed) % tileW;
        for (let i = -2; i < Math.ceil(W / tileW) + 2; i++) {
          painter(i * tileW - offset);
        }
      }


      function drawWarpTube(tube) {
        const r = warpTubeRect(tube);
        const x = r.x - world.camX;
        const y = r.y;
        if (x < -120 || x > W + 120) return;

        ctx.save();
        const isTech = game.currentLevel === 1;
        const isIce = game.currentLevel === 2;
        const g = ctx.createLinearGradient(x, y, x, y + r.h);
        if (isTech) {
          g.addColorStop(0, "rgba(108,220,255,.92)");
          g.addColorStop(.48, "rgba(42,58,88,.96)");
          g.addColorStop(1, "rgba(13,18,32,.98)");
        } else if (isIce) {
          g.addColorStop(0, "rgba(220,250,255,.94)");
          g.addColorStop(.48, "rgba(110,124,210,.92)");
          g.addColorStop(1, "rgba(50,34,92,.98)");
        } else {
          g.addColorStop(0, "rgba(228,201,79,.92)");
          g.addColorStop(.5, "rgba(88,70,160,.94)");
          g.addColorStop(1, "rgba(18,16,30,.98)");
        }
        ctx.fillStyle = g;
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 4;
        roundRect(ctx, x, y, r.w, r.h, 16);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "rgba(255,255,255,.28)";
        roundRect(ctx, x + 8, y + 8, r.w - 16, 9, 6);
        ctx.fill();

        ctx.fillStyle = "rgba(20,25,35,.72)";
        roundRect(ctx, x + 7, y - 28, r.w + 36, 24, 10);
        ctx.fill();
        ctx.fillStyle = "#fff";
        ctx.font = "bold 12px system-ui, sans-serif";
        ctx.textAlign = "left";
        ctx.fillText(`${tube.label || "→"} ${tube.hint || "ENTRA"}`, x + 14, y - 12);

        ctx.strokeStyle = isTech ? "rgba(108,220,255,.72)" : (isIce ? "rgba(220,250,255,.72)" : "rgba(228,201,79,.72)");
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(x + r.w / 2, y - 4);
        ctx.lineTo(x + r.w / 2, y - 22 + Math.sin(world.time * 6) * 4);
        ctx.stroke();

        ctx.restore();
      }

      function drawDecorativeHumans() {
        const groups = [
          { level: 0, x: 720, y: 0, asset: 0, scale: .42, alpha: .50 },
          { level: 0, x: 1380, y: 0, asset: 2, scale: .38, alpha: .48 },
          { level: 0, x: 3120, y: 0, asset: 3, scale: .36, alpha: .40 },
          { level: 1, x: 1160, y: 0, asset: 4, scale: .34, alpha: .32 },
          { level: 1, x: 2360, y: 0, asset: 2, scale: .32, alpha: .28 },
          { level: 1, x: 4200, y: 0, asset: 3, scale: .34, alpha: .30 },
          { level: 1, x: 6120, y: 0, asset: 0, scale: .38, alpha: .34 },
          { level: 2, x: 960, y: 0, asset: 1, scale: .34, alpha: .35 },
          { level: 2, x: 2860, y: 0, asset: 3, scale: .32, alpha: .28 },
          { level: 2, x: 5480, y: 0, asset: 4, scale: .34, alpha: .30 },
          { level: 2, x: 7140, y: 0, asset: 2, scale: .34, alpha: .32 },
          { level: 3, x: 1220, y: 0, asset: 0, scale: .34, alpha: .28 },
          { level: 3, x: 3680, y: 0, asset: 1, scale: .34, alpha: .30 },
          { level: 3, x: 6460, y: 0, asset: 4, scale: .34, alpha: .32 },
          { level: 4, x: 1540, y: 0, asset: 2, scale: .34, alpha: .28 },
          { level: 4, x: 4780, y: 0, asset: 3, scale: .34, alpha: .30 },
          { level: 4, x: 7820, y: 0, asset: 0, scale: .36, alpha: .34 }
        ];
        for (const g of groups) {
          if (g.level !== game.currentLevel) continue;
          const asset = decorativeHumanAssets[g.asset % decorativeHumanAssets.length];
          if (!asset || !asset.ready) continue;
          const x = g.x - world.camX;
          if (x < -120 || x > W + 120) continue;
          const h = 92 * g.scale * 2.2;
          const w = h * (asset.img.naturalWidth / Math.max(1, asset.img.naturalHeight));
          ctx.save();
          ctx.globalAlpha = g.alpha;
          ctx.filter = game.currentLevel === 0 ? "sepia(.2) saturate(.8)" : (game.currentLevel === 2 ? "saturate(.7) brightness(.9)" : "saturate(.7)");
          ctx.drawImage(asset.img, x, world.floorY - h - 5 + (g.y || 0), w, h);
          ctx.restore();
        }
      }


      function drawSceneTitlePill(title, sub, color = "#e4c94f") {
        if (!title) return;
        const w = Math.min(290, Math.max(150, title.length * 11 + 44));
        const x = 18;
        const y = 18;
        ctx.save();
        ctx.fillStyle = "rgba(20,22,32,.70)";
        roundRect(ctx, x, y, w, sub ? 56 : 36, 14);
        ctx.fill();
        ctx.strokeStyle = color;
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.fillStyle = "#fff";
        ctx.font = "900 16px system-ui, -apple-system, Segoe UI, sans-serif";
        ctx.textAlign = "left";
        ctx.fillText(title, x + 14, y + 22);
        if (sub) {
          ctx.fillStyle = "rgba(255,255,255,.78)";
          ctx.font = "700 11px system-ui, -apple-system, Segoe UI, sans-serif";
          ctx.fillText(sub, x + 14, y + 40);
        }
        ctx.restore();
      }

      function drawLadderDecor(x, y, h, w = 22, color = "rgba(156,240,255,.55)") {
        const sx = x - world.camX;
        if (sx < -50 || sx > W + 50) return;
        ctx.save();
        ctx.strokeStyle = color;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(sx, y);
        ctx.lineTo(sx, y + h);
        ctx.moveTo(sx + w, y);
        ctx.lineTo(sx + w, y + h);
        ctx.stroke();
        for (let ry = y + 10; ry < y + h; ry += 14) {
          ctx.beginPath();
          ctx.moveTo(sx + 3, ry);
          ctx.lineTo(sx + w - 3, ry);
          ctx.stroke();
        }
        ctx.restore();
      }

      function drawSlantedCatwalk(x, y, len = 240, drop = 38, color1 = "#f05cff", color2 = "#ffcf5a") {
        const sx = x - world.camX;
        if (sx > W + 280 || sx + len < -280) return;
        ctx.save();
        ctx.lineWidth = 12;
        ctx.strokeStyle = color1;
        ctx.beginPath();
        ctx.moveTo(sx, y);
        ctx.lineTo(sx + len, y - drop);
        ctx.stroke();
        ctx.lineWidth = 4;
        ctx.strokeStyle = color2;
        for (let t = 0; t <= 1; t += 0.08) {
          const px = sx + len * t;
          const py = y - drop * t;
          ctx.beginPath();
          ctx.moveTo(px - 9, py + 6);
          ctx.lineTo(px + 9, py - 6);
          ctx.stroke();
        }
        ctx.restore();
      }

      function drawNeonFrame(x, y, w, h, color = "rgba(108,220,255,.65)") {
        const sx = x - world.camX;
        if (sx > W + 220 || sx + w < -220) return;
        ctx.save();
        ctx.strokeStyle = color;
        ctx.lineWidth = 4;
        roundRect(ctx, sx, y, w, h, 16);
        ctx.stroke();
        ctx.globalAlpha = 0.35;
        roundRect(ctx, sx + 10, y + 10, w - 20, h - 20, 12);
        ctx.stroke();
        ctx.restore();
      }

      function drawWorld2SpecialScenes() {
        const px = player.x;
        if (px >= 1500 && px < 3200) drawSceneTitlePill("Mundo 2 · Hangar vertical", "plataformas, ascenso y nidos mecánicos", "#7ed7ff");
        else if (px >= 3200 && px < 5600) drawSceneTitlePill("Mundo 2 · Ascenso Donkey", "zigzag de pasarelas y presión de altura", "#ffcf5a");
        else if (px >= 5600 && px < 8200) drawSceneTitlePill("Mundo 2 · Ciudad de acero", "líneas de producción y guardianes", "#b8e1ff");
        else if (px >= 8200) drawSceneTitlePill("Mundo 2 · Plataforma del jefe", "bombas, secuaces y asalto final", "#ffb16f");

        // Hangar de entrada
        drawNeonFrame(1320, world.floorY - 250, 260, 200, "rgba(108,220,255,.55)");
        drawNeonFrame(1640, world.floorY - 300, 300, 240, "rgba(228,201,79,.45)");
        drawLadderDecor(1460, world.floorY - 230, 170);
        drawLadderDecor(1810, world.floorY - 280, 200);

        // Tramo Donkey Kong visual
        const baseX = 3320;
        drawSlantedCatwalk(baseX, world.floorY - 42, 290, -34, "rgba(240,92,255,.70)", "rgba(255,206,88,.75)");
        drawSlantedCatwalk(baseX + 110, world.floorY - 132, 300, 34, "rgba(240,92,255,.70)", "rgba(255,206,88,.75)");
        drawSlantedCatwalk(baseX + 10, world.floorY - 220, 310, -34, "rgba(240,92,255,.70)", "rgba(255,206,88,.75)");
        drawSlantedCatwalk(baseX + 120, world.floorY - 310, 320, 34, "rgba(240,92,255,.70)", "rgba(255,206,88,.75)");
        drawLadderDecor(baseX + 54, world.floorY - 136, 84, 18, "rgba(255,255,255,.48)");
        drawLadderDecor(baseX + 258, world.floorY - 226, 84, 18, "rgba(255,255,255,.48)");
        drawLadderDecor(baseX + 126, world.floorY - 314, 84, 18, "rgba(255,255,255,.48)");
        ctx.save();
        const sx = baseX + 430 - world.camX;
        if (sx > -120 && sx < W + 120) {
          ctx.fillStyle = "rgba(25,28,42,.76)";
          roundRect(ctx, sx, world.floorY - 388, 82, 82, 14);
          ctx.fill();
          ctx.strokeStyle = "rgba(255,206,88,.85)";
          ctx.lineWidth = 4;
          ctx.stroke();
          ctx.fillStyle = "rgba(255,206,88,.95)";
          ctx.font = "900 16px system-ui, sans-serif";
          ctx.fillText("BOSS", sx + 18, world.floorY - 340);
        }
        ctx.restore();

        // Ciudad de acero
        for (let i = 0; i < 4; i++) {
          const xx = 6120 + i * 220;
          const sx = xx - world.camX;
          if (sx < -120 || sx > W + 160) continue;
          ctx.save();
          const h = 150 + (i % 2) * 80;
          ctx.fillStyle = "rgba(14,18,28,.58)";
          roundRect(ctx, sx, world.floorY - h, 96, h, 12);
          ctx.fill();
          ctx.fillStyle = "rgba(108,220,255,.16)";
          for (let wy = world.floorY - h + 16; wy < world.floorY - 20; wy += 24) {
            ctx.fillRect(sx + 18, wy, 14, 8);
            ctx.fillRect(sx + 42, wy + 6, 12, 8);
            ctx.fillRect(sx + 64, wy, 10, 8);
          }
          ctx.restore();
        }

        // Plataforma del jefe
        drawNeonFrame(10020, world.floorY - 290, 420, 230, "rgba(255,146,96,.48)");
        drawLadderDecor(10110, world.floorY - 276, 200, 18, "rgba(255,206,88,.55)");
        drawLadderDecor(10330, world.floorY - 276, 200, 18, "rgba(255,206,88,.55)");
      }

      function drawWorld3SpecialScenes() {
        const px = player.x;
        if (px >= 1200 && px < 3600) drawSceneTitlePill("Mundo 3 · Caverna geoda", "cristales, cámaras y tránsito previo al vuelo", "#e97cff");
        else if (px >= 3600 && px < 9800) drawSceneTitlePill("Mundo 3 · Ruta de vuelo", "asalto aéreo prolongado con oleadas", "#8de4ff");
        else if (px >= 9800) drawSceneTitlePill("Mundo 3 · Muelle orbital", "regreso a tierra y combate final", "#fff07b");

        // bahía de lanzamiento
        drawNeonFrame(1360, world.floorY - 250, 420, 180, "rgba(232,84,255,.44)");
        for (let i = 0; i < 5; i++) drawLadderDecor(1420 + i * 76, world.floorY - 230, 140, 12, "rgba(108,220,255,.28)");

        // túnel de vuelo wireframe visual
        const tunnelStart = 3920;
        for (let i = 0; i < 9; i++) {
          const xx = tunnelStart + i * 340;
          const sx = xx - world.camX;
          if (sx < -420 || sx > W + 420) continue;
          ctx.save();
          ctx.strokeStyle = i % 2 ? "rgba(108,220,255,.23)" : "rgba(228,201,79,.20)";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(sx, 80);
          ctx.lineTo(sx + 120, 140);
          ctx.lineTo(sx + 120, H - 120);
          ctx.lineTo(sx, H - 60);
          ctx.closePath();
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(sx + 260, 110);
          ctx.lineTo(sx + 140, 160);
          ctx.lineTo(sx + 140, H - 140);
          ctx.lineTo(sx + 260, H - 90);
          ctx.closePath();
          ctx.stroke();
          ctx.restore();
        }

        // paisaje orbital y batalla lejana
        for (let i = 0; i < 12; i++) {
          const xx = 4360 + i * 280 - world.camX * 0.75;
          if (xx < -50 || xx > W + 50) continue;
          const yy = 110 + (i % 4) * 58 + Math.sin(world.time * 2 + i) * 8;
          ctx.save();
          ctx.globalAlpha = .55;
          ctx.fillStyle = i % 3 === 0 ? "rgba(255,220,120,.70)" : "rgba(108,220,255,.62)";
          ctx.beginPath();
          ctx.moveTo(xx, yy);
          ctx.lineTo(xx + 18, yy + 5);
          ctx.lineTo(xx, yy + 10);
          ctx.lineTo(xx + 4, yy + 5);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        }

        // muelle orbital final
        drawNeonFrame(10040, world.floorY - 264, 400, 210, "rgba(108,220,255,.44)");
        const sx = 10140 - world.camX;
        if (sx > -220 && sx < W + 220) {
          ctx.save();
          ctx.fillStyle = "rgba(255,255,255,.10)";
          for (let i = 0; i < 5; i++) ctx.fillRect(sx + i * 58, world.floorY - 252, 24, 164);
          ctx.restore();
        }
      }

      function drawWorld4SpecialScenes() {
        const px = player.x;
        if (px >= 1000 && px < 3400) drawSceneTitlePill("Mundo 4 · Pantano viviente", "raíces, niebla y anfibios mutantes", "#7bffbd");
        else if (px >= 3400 && px < 6400) drawSceneTitlePill("Mundo 4 · Ruinas sumergidas", "templos, hongos y guardianes", "#e97cff");
        else if (px >= 6400) drawSceneTitlePill("Mundo 4 · Altar del pantano", "charcas tóxicas y emboscada final", "#ffd66a");

        // árboles y hongos gigantes
        for (let i = 0; i < 7; i++) {
          const xx = 1040 + i * 250;
          const sx = xx - world.camX;
          if (sx < -100 || sx > W + 100) continue;
          ctx.save();
          ctx.strokeStyle = "rgba(32,24,32,.56)";
          ctx.lineWidth = 18;
          ctx.beginPath(); ctx.moveTo(sx, world.floorY); ctx.lineTo(sx + 10, world.floorY - 150 - (i % 2) * 40); ctx.stroke();
          ctx.fillStyle = i % 2 ? "rgba(143,255,184,.20)" : "rgba(166,94,255,.22)";
          ctx.beginPath(); ctx.ellipse(sx + 18, world.floorY - 182 - (i % 2) * 40, 48, 24, .2, 0, Math.PI * 2); ctx.fill();
          ctx.restore();
        }

        // ruinas anfibias
        for (let i = 0; i < 4; i++) {
          const xx = 3820 + i * 310;
          const sx = xx - world.camX;
          if (sx < -180 || sx > W + 180) continue;
          ctx.save();
          ctx.fillStyle = "rgba(22,26,28,.42)";
          roundRect(ctx, sx, world.floorY - 130, 120, 130, 14); ctx.fill();
          ctx.fillRect(sx + 18, world.floorY - 170, 26, 40);
          ctx.fillRect(sx + 76, world.floorY - 170, 26, 40);
          ctx.strokeStyle = "rgba(143,255,184,.22)";
          ctx.lineWidth = 3;
          ctx.beginPath(); ctx.arc(sx + 60, world.floorY - 72, 26, 0, Math.PI * 2); ctx.stroke();
          ctx.restore();
        }

        // santuario final
        drawNeonFrame(6940, world.floorY - 210, 320, 180, "rgba(143,255,184,.36)");
        const bx = 7060 - world.camX;
        if (bx > -120 && bx < W + 120) {
          ctx.save();
          ctx.fillStyle = "rgba(255,235,120,.18)";
          ctx.beginPath();
          ctx.moveTo(bx + 80, world.floorY - 210); ctx.lineTo(bx + 160, world.floorY - 270); ctx.lineTo(bx + 240, world.floorY - 210); ctx.closePath(); ctx.fill();
          ctx.restore();
        }
      }

      function drawWorld5SpecialScenes() {
        const px = player.x;
        if (px >= 1200 && px < 3600) drawSceneTitlePill("Mundo 5 · Atmósfera tóxica", "torres de humo y persecución aérea", "#ffe866");
        else if (px >= 3600 && px < 6900) drawSceneTitlePill("Mundo 5 · Corredor de tormenta", "rayos, reactores y nubes hostiles", "#9eff6d");
        else if (px >= 6900) drawSceneTitlePill("Mundo 5 · Fortaleza de gas", "núcleo químico y jefe volátil", "#ff9f6a");

        // torres reactor
        for (let i = 0; i < 5; i++) {
          const xx = 1320 + i * 260;
          const sx = xx - world.camX;
          if (sx < -120 || sx > W + 120) continue;
          ctx.save();
          ctx.fillStyle = "rgba(18,18,24,.54)";
          roundRect(ctx, sx, world.floorY - 180, 92, 180, 12); ctx.fill();
          const g = ctx.createRadialGradient(sx + 46, world.floorY - 136, 6, sx + 46, world.floorY - 136, 44);
          g.addColorStop(0, "rgba(255,245,120,.82)"); g.addColorStop(.5, "rgba(196,255,90,.36)"); g.addColorStop(1, "rgba(196,255,90,0)");
          ctx.fillStyle = g; ctx.beginPath(); ctx.arc(sx + 46, world.floorY - 136, 42, 0, Math.PI * 2); ctx.fill();
          ctx.restore();
        }

        // nube de tormenta tóxica
        for (let i = 0; i < 6; i++) {
          const xx = 3880 + i * 250 - world.camX * 0.48;
          if (xx < -120 || xx > W + 120) continue;
          const yy = 120 + (i % 3) * 36;
          ctx.save();
          const g = ctx.createRadialGradient(xx, yy, 8, xx, yy, 60);
          g.addColorStop(0, "rgba(255,250,160,.18)");
          g.addColorStop(.45, "rgba(144,255,92,.22)");
          g.addColorStop(1, "rgba(20,24,20,0)");
          ctx.fillStyle = g; ctx.beginPath(); ctx.arc(xx, yy, 58, 0, Math.PI * 2); ctx.fill();
          ctx.strokeStyle = "rgba(255,240,120,.26)";
          ctx.lineWidth = 3;
          ctx.beginPath(); ctx.moveTo(xx - 18, yy - 28); ctx.lineTo(xx + 6, yy + 4); ctx.lineTo(xx - 8, yy + 28); ctx.stroke();
          ctx.restore();
        }

        // fortaleza final
        drawNeonFrame(7440, world.floorY - 250, 420, 220, "rgba(196,255,90,.36)");
        const fx = 7600 - world.camX;
        if (fx > -200 && fx < W + 200) {
          ctx.save();
          ctx.fillStyle = "rgba(20,24,20,.50)";
          ctx.fillRect(fx, world.floorY - 280, 70, 280);
          ctx.fillRect(fx + 120, world.floorY - 320, 80, 320);
          ctx.fillRect(fx + 264, world.floorY - 250, 72, 250);
          ctx.fillStyle = "rgba(255,245,120,.14)";
          ctx.fillRect(fx + 18, world.floorY - 256, 16, 180);
          ctx.fillRect(fx + 146, world.floorY - 290, 18, 210);
          ctx.fillRect(fx + 288, world.floorY - 230, 16, 160);
          ctx.restore();
        }
      }

      function drawWorldSceneSetpieces() {
        if (game.currentLevel === 1) return drawWorld2SpecialScenes();
        if (game.currentLevel === 2) return drawWorld3SpecialScenes();
        if (game.currentLevel === 3) return drawWorld4SpecialScenes();
        if (game.currentLevel === 4) return drawWorld5SpecialScenes();
      }

      function drawLevelEntities() {
        drawDecorativeHumans();
        drawWorldSceneSetpieces();
        drawRescueCages();
        drawMudPits();
        drawPendulums();

        // Sin tubos activos.
        for (const block of solidBlocks) {
          drawSolidBlock(block);
        }

        for (const block of breakableBlocks) {
          if (block.active) drawBreakableBlock(block);
        }

        for (const platform of movingPlatforms) {
          drawMovingPlatform(platform);
        }

        for (const stair of risingStairs) drawRisingStair(stair);
        for (const platform of upperTimedPlatforms) if (platform.active) drawUpperTimedPlatform(platform);

        drawPortal();
        drawWorld1StoryCue();

        for (const orb of orbs) {
          if (!orb.collected) drawOrb(orb);
        }

        for (const item of energyPickups) {
          if (!item.collected) drawPickup(item);
        }

        for (const item of shieldPickups) {
          if (!item.collected) drawPickup(item);
        }

        for (const item of firePickups) {
          if (!item.collected) drawFirePickup(item);
        }

        for (const flame of floorFlames) drawFlame(flame);
        for (const flame of airFlames) if (flame.active) drawFlame(flame);

        drawEscapeBosses();
        drawBossClones();

        if (boss && boss.active) {
          drawBoss();
          for (const helper of bossHelpers) drawBossHelper(helper);
        }

        for (const obstacle of obstacles) {
          if (obstacle.active) drawCrystal(obstacle);
        }

        for (const enemy of enemies) {
          if (enemy.active) drawEnemy(enemy);
        }

        for (const projectile of enemyProjectiles) {
          drawEnemyProjectile(projectile);
        }

        for (const spark of sparks) {
          drawSpark(spark);
        }
      }

      function drawSmallFlameShape(cx, baseY, w, h, phase = 0) {
        const sway = Math.sin(world.time * 10 + phase) * w * 0.09;
        ctx.beginPath();
        ctx.moveTo(cx - w * 0.45, baseY);
        ctx.quadraticCurveTo(cx - w * 0.62 + sway, baseY - h * 0.42, cx - w * 0.18, baseY - h * 0.62);
        ctx.quadraticCurveTo(cx - w * 0.05 + sway, baseY - h * 1.05, cx + w * 0.10, baseY - h * 0.58);
        ctx.quadraticCurveTo(cx + w * 0.52 + sway, baseY - h * 0.42, cx + w * 0.45, baseY);
        ctx.closePath();
      }

      function drawFlame(flame) {
        const isAir = flame.type === "air";
        const x = flame.x - world.camX;
        const y = isAir ? world.floorY + flame.y : world.floorY - flame.h + (flame.y || 0);
        if (x < -120 || x > W + 120) return;
        const pulse = 1 + Math.sin(world.time * 9 + flame.pulse) * 0.16;

        ctx.save();

        if (game.currentLevel === 2) {
          if (isAir) {
            const cx = x;
            const cy = y;
            const r = flame.r * pulse;
            const glow = ctx.createRadialGradient(cx, cy, 2, cx, cy, r * 3.0);
            glow.addColorStop(0, "rgba(255,255,255,.96)");
            glow.addColorStop(0.38, "rgba(108,220,255,.72)");
            glow.addColorStop(0.75, "rgba(232,84,255,.32)");
            glow.addColorStop(1, "rgba(232,84,255,0)");
            ctx.fillStyle = glow;
            ctx.beginPath();
            ctx.arc(cx, cy, r * 2.2, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = "rgba(108,220,255,.92)";
            ctx.strokeStyle = "#111";
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            ctx.moveTo(cx, cy - r);
            ctx.lineTo(cx + r * .72, cy);
            ctx.lineTo(cx, cy + r);
            ctx.lineTo(cx - r * .72, cy);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
            ctx.restore();
            return;
          }

          const count = flame.count || Math.max(3, Math.round(flame.w / 24));
          const gap = flame.w / count;
          const baseY = y + flame.h;
          const hazardGlow = ctx.createLinearGradient(x, y - flame.h * 0.4, x, baseY + 8);
          hazardGlow.addColorStop(0, "rgba(108,220,255,0)");
          hazardGlow.addColorStop(0.45, "rgba(108,220,255,.42)");
          hazardGlow.addColorStop(1, "rgba(232,84,255,0)");
          ctx.fillStyle = hazardGlow;
          roundRect(ctx, x - 8, y - 10, flame.w + 16, flame.h + 18, 18);
          ctx.fill();

          for (let i = 0; i < count; i++) {
            const cx = x + gap * (i + 0.5);
            const h = flame.h * (0.88 + Math.sin(world.time * 5 + i * 1.7 + flame.pulse) * 0.12);
            const w = Math.min(20, gap * 0.66);
            const grad = ctx.createLinearGradient(cx, baseY - h, cx, baseY);
            grad.addColorStop(0, "rgba(255,255,255,.95)");
            grad.addColorStop(.48, "rgba(108,220,255,.78)");
            grad.addColorStop(1, "rgba(110,72,168,.82)");
            ctx.fillStyle = grad;
            ctx.strokeStyle = "#111";
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(cx, baseY - h);
            ctx.lineTo(cx + w / 2, baseY);
            ctx.lineTo(cx - w / 2, baseY);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
          }
          ctx.restore();
          return;
        }

        if (isAir) {
          const cx = x;
          const cy = y;
          const r = flame.r * pulse;
          const glow = ctx.createRadialGradient(cx, cy, 2, cx, cy, r * 2.4);
          glow.addColorStop(0, "rgba(255,238,160,.95)");
          glow.addColorStop(0.42, "rgba(255,116,48,.72)");
          glow.addColorStop(1, "rgba(216,90,90,0)");
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(cx, cy, r * 2.0, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = "#ff7a36";
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.arc(cx, cy, r, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
          ctx.fillStyle = "#fff0a8";
          ctx.beginPath();
          ctx.arc(cx, cy, r * 0.42, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
          return;
        }

        const count = flame.count || Math.max(3, Math.round(flame.w / 24));
        const gap = flame.w / count;
        const baseY = y + flame.h;
        const cxBase = x;

        const glow = ctx.createLinearGradient(x, y - flame.h * 0.35, x, baseY + 8);
        glow.addColorStop(0, "rgba(255,220,120,0)");
        glow.addColorStop(0.45, "rgba(255,110,42,.42)");
        glow.addColorStop(1, "rgba(216,90,90,0)");
        ctx.fillStyle = glow;
        roundRect(ctx, x - 8, y - 10, flame.w + 16, flame.h + 18, 18);
        ctx.fill();

        for (let i = 0; i < count; i++) {
          const cx = cxBase + gap * (i + 0.5);
          const fh = flame.h * (0.92 + Math.sin(world.time * 6 + i * 1.7 + flame.pulse) * 0.13);
          const fw = Math.min(22, gap * 0.72);

          ctx.fillStyle = "#ff6d35";
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 2;
          drawSmallFlameShape(cx, baseY, fw, fh, i);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = "#fff0a8";
          drawSmallFlameShape(cx, baseY - 1, fw * 0.46, fh * 0.58, i + 3);
          ctx.fill();
        }

        ctx.restore();
      }

      function drawFirePickup(item) {
        const x = item.x - world.camX;
        const y = world.floorY + item.y + Math.sin(world.time * 5 + item.x * 0.02) * 5;
        if (x < -90 || x > W + 90) return;
        ctx.save();

        const specialMap = {
          triplePower: { icon: "✦", color: "#e4c94f", glow: "rgba(228,201,79,.92)" },
          laserPower: { icon: "━", color: "#a8f0ff", glow: "rgba(168,240,255,.90)" },
          grenadePower: { icon: "●", color: "#ffb05a", glow: "rgba(255,176,90,.90)" },
          rocketPower: { icon: "⌁", color: "#ff7a36", glow: "rgba(255,122,54,.90)" },
          tripleNova: { icon: "✦3", color: "#fff0a8", glow: "rgba(255,240,168,.95)" },
          stormLaser: { icon: "⚡", color: "#a8f0ff", glow: "rgba(168,240,255,.95)" },
          bossTransform: { icon: "✹", color: "#ff4bd8", glow: "rgba(255,75,216,.95)" },
          allyCall: { icon: "👥", color: "#7bffbd", glow: "rgba(123,255,189,.95)" }
        };

        const special = specialMap[item.rewardType];
        const isCombo = item.rewardType === "combo" || item.assetId === "reward_powerup_1";
        const pulse = 1 + Math.sin(world.time * 7 + item.x * 0.03) * 0.12;
        const glow = ctx.createRadialGradient(x, y, 2, x, y, item.r * (special ? 6.0 : (isCombo ? 5.2 : 4)) * pulse);
        glow.addColorStop(0, "rgba(255,255,255,.98)");
        glow.addColorStop(0.35, special ? special.glow : (isCombo ? "rgba(228,201,79,.92)" : "rgba(255,138,44,.88)"));
        glow.addColorStop(1, special ? "rgba(109,88,216,0)" : (isCombo ? "rgba(109,88,216,0)" : "rgba(216,90,90,0)"));
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(x, y, item.r * (special ? 6.0 : (isCombo ? 5.2 : 4)) * pulse, 0, Math.PI * 2);
        ctx.fill();

        if (special) {
          ctx.save();
          ctx.translate(x, y);
          ctx.rotate(Math.sin(world.time * 2.2) * 0.12);
          ctx.fillStyle = special.color;
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.arc(0, 0, item.r * 1.35 * pulse, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();

          ctx.strokeStyle = "rgba(255,255,255,.92)";
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          for (let i = 0; i < 6; i++) {
            const a = i * Math.PI / 3 + world.time * 0.7;
            ctx.moveTo(Math.cos(a) * item.r * 1.8, Math.sin(a) * item.r * 1.8);
            ctx.lineTo(Math.cos(a) * item.r * 2.55, Math.sin(a) * item.r * 2.55);
          }
          ctx.stroke();

          ctx.fillStyle = "#151515";
          ctx.font = "900 15px system-ui, sans-serif";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillText(special.icon, 0, 1);
          ctx.restore();
          ctx.restore();
          return;
        }

        const asset = item.assetId ? getPowerupAsset(item.assetId) : null;
        if (asset && asset.ready) {
          const dw = (asset.recommendedWidth || 44) * (isCombo ? 1.18 : 1);
          const dh = (asset.recommendedHeight || 48) * (isCombo ? 1.18 : 1);
          ctx.drawImage(asset.img, x - dw / 2, y - dh / 2, dw, dh);
        } else {
          ctx.fillStyle = isCombo ? "#e4c94f" : "#ff7a36";
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.arc(x, y, item.r * pulse, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
          ctx.fillStyle = "#fff0a8";
          ctx.beginPath();
          ctx.arc(x + 3, y - 4, item.r * 0.45, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }

      function drawRisingStair(stair) {
        const rects = stairRects(stair);
        for (const p of rects) {
          const x = p.x - world.camX;
          if (x < -100 || x > W + 100) continue;
          ctx.save();
          ctx.fillStyle = stair.active ? "rgba(108,220,255,.80)" : "rgba(108,220,255,.32)";
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 3;
          roundRect(ctx, x, p.y, p.w, p.h, 8);
          ctx.fill();
          ctx.stroke();
          ctx.restore();
        }
      }

      function drawUpperTimedPlatform(platform) {
        const p = upperTimedPlatformRect(platform);
        const x = p.x - world.camX;
        if (x < -120 || x > W + 120) return;
        ctx.save();
        const alpha = platform.timer < 2 ? 0.38 + Math.sin(world.time * 18) * 0.22 : 0.82;
        ctx.globalAlpha = Math.max(0.2, alpha);
        ctx.fillStyle = "rgba(228,201,79,.82)";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 3;
        roundRect(ctx, x, p.y, p.w, p.h, 9);
        ctx.fill();
        ctx.stroke();
        ctx.globalAlpha = 1;
        ctx.fillStyle = "#111";
        ctx.font = "900 10px system-ui";
        ctx.textAlign = "center";
        ctx.fillText(`${Math.max(0, platform.timer).toFixed(1)}s`, x + p.w / 2, p.y - 7);
        ctx.restore();
      }

      function drawBreakableBlock(block) {
        const b = solidBlockRect(block);
        const x = b.x - world.camX;
        const y = b.y;
        if (x < -160 || x > W + 160) return;

        ctx.save();

        if (block.kind === "brick") {
          ctx.fillStyle = "rgba(160,82,50,.96)";
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 4;
          roundRect(ctx, x, y, b.w, b.h, 8);
          ctx.fill();
          ctx.stroke();
          ctx.strokeStyle = "rgba(20,25,35,.35)";
          ctx.lineWidth = 2;
          for (let yy = y + 16; yy < y + b.h; yy += 18) {
            ctx.beginPath(); ctx.moveTo(x + 4, yy); ctx.lineTo(x + b.w - 4, yy); ctx.stroke();
          }
          for (let xx = x + 18; xx < x + b.w; xx += 26) {
            ctx.beginPath(); ctx.moveTo(xx, y + 5); ctx.lineTo(xx, y + b.h - 5); ctx.stroke();
          }
          ctx.fillStyle = "#ffcf70";
          ctx.font = "900 16px system-ui";
          ctx.textAlign = "center";
          ctx.fillText(block.label || "", x + b.w / 2, y + b.h / 2 + 6);
          ctx.restore();
          return;
        }

        const glow = ctx.createRadialGradient(x + b.w / 2, y + b.h / 2, 4, x + b.w / 2, y + b.h / 2, Math.max(b.w, b.h));
        glow.addColorStop(0, "rgba(255,255,255,.22)");
        glow.addColorStop(0.6, "rgba(155,160,170,.24)");
        glow.addColorStop(1, "rgba(155,160,170,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.ellipse(x + b.w / 2, y + b.h / 2, b.w * 0.8, b.h * 0.78, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "rgba(177,183,191,.94)";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 4;
        roundRect(ctx, x, y, b.w, b.h, 12);
        ctx.fill();
        ctx.stroke();

        ctx.strokeStyle = "rgba(20,25,35,.28)";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(x + 12, y + 18);
        ctx.lineTo(x + b.w - 14, y + b.h - 18);
        ctx.moveTo(x + b.w - 18, y + 14);
        ctx.lineTo(x + 14, y + b.h - 20);
        ctx.stroke();

        ctx.fillStyle = "rgba(20,25,35,.72)";
        ctx.font = "900 14px system-ui";
        ctx.textAlign = "center";
        ctx.fillText(block.label || "?", x + b.w / 2, y + b.h / 2 + 5);

        if (debug) {
          ctx.strokeStyle = "rgba(160,160,160,.9)";
          ctx.lineWidth = 2;
          ctx.strokeRect(x, y, b.w, b.h);
        }

        ctx.restore();
      }

      function drawSolidBlock(block) {
        const b = solidBlockRect(block);
        const x = b.x - world.camX;
        const y = b.y;
        if (x < -160 || x > W + 160) return;

        ctx.save();

        if (block.kind === "dkPlatform" || block.kind === "dkLadder") {
          const isLadder = block.kind === "dkLadder";
          const grad = ctx.createLinearGradient(x, y, x, y + b.h);
          grad.addColorStop(0, isLadder ? "rgba(168,240,255,.96)" : "rgba(255,80,180,.94)");
          grad.addColorStop(.55, isLadder ? "rgba(30,70,90,.94)" : "rgba(80,35,120,.96)");
          grad.addColorStop(1, "rgba(15,18,28,.98)");
          ctx.fillStyle = grad;
          ctx.strokeStyle = "#07070d";
          ctx.lineWidth = 4;
          roundRect(ctx, x, y, b.w, b.h, isLadder ? 8 : 10);
          ctx.fill();
          ctx.stroke();

          ctx.strokeStyle = isLadder ? "rgba(255,255,255,.46)" : "rgba(168,240,255,.48)";
          ctx.lineWidth = 2;
          if (isLadder) {
            for (let xx = x + 14; xx < x + b.w; xx += 18) {
              ctx.beginPath();
              ctx.moveTo(xx, y + 3);
              ctx.lineTo(xx, y + b.h - 3);
              ctx.stroke();
            }
          } else {
            for (let xx = x + 12; xx < x + b.w; xx += 30) {
              ctx.beginPath();
              ctx.moveTo(xx, y + b.h - 4);
              ctx.lineTo(xx + 16, y + 4);
              ctx.stroke();
            }
          }

          if (block.label) {
            ctx.fillStyle = "rgba(20,25,35,.62)";
            roundRect(ctx, x + 8, y - 24, Math.min(96, 22 + block.label.length * 9), 22, 10);
            ctx.fill();
            ctx.fillStyle = "#fff0a8";
            ctx.font = "900 11px system-ui, sans-serif";
            ctx.textAlign = "left";
            ctx.fillText(block.label, x + 18, y - 9);
          }

          ctx.restore();
          return;
        }

        if (block.kind === "brickBeam") {
          ctx.fillStyle = "rgba(112,63,45,.96)";
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 4;
          roundRect(ctx, x, y, b.w, b.h, 8);
          ctx.fill();
          ctx.stroke();
          ctx.strokeStyle = "rgba(25,18,14,.35)";
          ctx.lineWidth = 2;
          for (let yy = y + 13; yy < y + b.h; yy += 14) {
            ctx.beginPath(); ctx.moveTo(x + 4, yy); ctx.lineTo(x + b.w - 4, yy); ctx.stroke();
          }
          for (let xx = x + 20; xx < x + b.w; xx += 28) {
            ctx.beginPath(); ctx.moveTo(xx, y + 4); ctx.lineTo(xx, y + b.h - 4); ctx.stroke();
          }
          ctx.fillStyle = "rgba(255,211,128,.22)";
          roundRect(ctx, x + 6, y + 5, b.w - 12, 6, 4);
          ctx.fill();
          if (debug) {
            ctx.strokeStyle = "rgba(228,201,79,.95)";
            ctx.lineWidth = 2;
            ctx.strokeRect(x, y, b.w, b.h);
          }
          ctx.restore();
          return;
        }

        if (game.currentLevel === 2) {
          const g = ctx.createLinearGradient(x, y, x + b.w, y + b.h);
          g.addColorStop(0, "rgba(220,250,255,.94)");
          g.addColorStop(.52, "rgba(142,168,220,.92)");
          g.addColorStop(1, "rgba(82,55,130,.96)");
          ctx.fillStyle = g;
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 4;
          roundRect(ctx, x, y, b.w, b.h, 12);
          ctx.fill();
          ctx.stroke();

          ctx.strokeStyle = "rgba(255,255,255,.28)";
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(x + 10, y + b.h - 12);
          ctx.lineTo(x + b.w * .38, y + 10);
          ctx.lineTo(x + b.w * .62, y + b.h - 12);
          ctx.lineTo(x + b.w - 12, y + 12);
          ctx.stroke();

          ctx.fillStyle = "rgba(108,220,255,.20)";
          roundRect(ctx, x + 8, y + 7, b.w - 16, 8, 6);
          ctx.fill();

          if (debug) {
            ctx.strokeStyle = "rgba(108,220,255,.95)";
            ctx.lineWidth = 2;
            ctx.strokeRect(x, y, b.w, b.h);
          }
          ctx.restore();
          return;
        }

        const glow = ctx.createRadialGradient(x + b.w / 2, y + b.h / 2, 4, x + b.w / 2, y + b.h / 2, Math.max(b.w, b.h) * 0.9);
        glow.addColorStop(0, "rgba(255,255,255,.34)");
        glow.addColorStop(0.52, "rgba(120,145,156,.22)");
        glow.addColorStop(1, "rgba(120,145,156,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.ellipse(x + b.w / 2, y + b.h / 2, b.w * 0.72, b.h * 0.72, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "rgba(225,235,239,.94)";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 4;
        roundRect(ctx, x, y, b.w, b.h, 12);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "rgba(109,88,216,.16)";
        ctx.fillRect(x + 8, y + 8, b.w - 16, b.h - 16);

        ctx.strokeStyle = "rgba(20,25,35,.16)";
        ctx.lineWidth = 1;
        for (let gx = x + 16; gx < x + b.w - 5; gx += 22) {
          ctx.beginPath();
          ctx.moveTo(gx, y + 8);
          ctx.lineTo(gx, y + b.h - 8);
          ctx.stroke();
        }
        for (let gy = y + 16; gy < y + b.h - 5; gy += 22) {
          ctx.beginPath();
          ctx.moveTo(x + 8, gy);
          ctx.lineTo(x + b.w - 8, gy);
          ctx.stroke();
        }

        ctx.fillStyle = "rgba(255,255,255,.62)";
        roundRect(ctx, x + 8, y + 7, b.w - 16, 8, 6);
        ctx.fill();

        if (debug) {
          ctx.strokeStyle = "rgba(54,166,120,.95)";
          ctx.lineWidth = 2;
          ctx.strokeRect(x, y, b.w, b.h);
        }

        ctx.restore();
      }

      function drawMovingPlatform(platform) {
        const p = movingPlatformRect(platform);
        const x = p.x - world.camX;
        const y = p.y;
        if (x < -180 || x > W + 180) return;

        ctx.save();
        ctx.fillStyle = "rgba(228,201,79,.28)";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 4;
        roundRect(ctx, x, y, p.w, p.h, 10);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "rgba(255,255,255,.58)";
        roundRect(ctx, x + 7, y + 5, p.w - 14, 5, 4);
        ctx.fill();

        ctx.strokeStyle = "rgba(109,88,216,.55)";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(x + 14, y + p.h + 7);
        ctx.lineTo(x + p.w - 14, y + p.h + 7);
        ctx.stroke();

        if (debug) {
          ctx.strokeStyle = "rgba(228,201,79,.95)";
          ctx.lineWidth = 2;
          ctx.strokeRect(x, y, p.w, p.h);
        }

        ctx.restore();
      }

      function drawEnemy(enemy) {
        const e = enemyRect(enemy);
        const x = e.x - world.camX;
        const y = e.y;
        if (x < -120 || x > W + 120) return;

        const blink = enemy.hitFlash > 0 && Math.floor(world.time * 22) % 2 === 0;
        const asset = getEnemyAsset(enemy);
        const bob = Math.sin(world.time * 7 + enemy.x * 0.02) * 2;
        const facing = enemy.dir < 0 ? -1 : 1;

        ctx.save();

        const glow = ctx.createRadialGradient(x + e.w / 2, y + e.h * 0.48, 4, x + e.w / 2, y + e.h * 0.48, 46);
        glow.addColorStop(0, enemy.kind === "shooter" ? "rgba(216,90,90,.24)" : "rgba(109,88,216,.22)");
        glow.addColorStop(1, "rgba(109,88,216,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(x + e.w / 2, y + e.h * 0.5, 46, 0, Math.PI * 2);
        ctx.fill();

        ctx.translate(x + e.w / 2, y + e.h + bob);
        ctx.scale(facing, 1);
        if (blink) ctx.globalAlpha = 0.45;

        if (asset && asset.ready) {
          const drawW = e.w * (enemy.kind === "spawner" ? 1.45 : (enemy.kind === "flyer" || enemy.kind === "flyer_mini" ? 1.65 : 1.32));
          const drawH = e.h * (enemy.kind === "spawner" ? 1.45 : (enemy.kind === "flyer" || enemy.kind === "flyer_mini" ? 1.70 : 1.34));
          ctx.drawImage(asset.img, -drawW / 2, -drawH, drawW, drawH);
        } else {
          ctx.fillStyle = enemy.kind === "flyer" ? "#34204d" : (enemy.kind === "shooter" ? "#3a2632" : (enemy.kind === "shielded" ? "#243744" : "#2c263e"));
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.ellipse(0, -e.h * 0.48, e.w * 0.45, e.h * 0.40, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
        }

        ctx.restore();

        if (enemy.kind === "shielded") {
          ctx.save();
          ctx.strokeStyle = "#6cdcff";
          ctx.lineWidth = 4;
          ctx.beginPath();
          const frontX = x + e.w / 2 + (enemy.dir > 0 ? 26 : -26);
          ctx.arc(frontX, y + e.h * 0.52, 18, -Math.PI / 2, Math.PI / 2, enemy.dir < 0);
          ctx.stroke();
          ctx.restore();
        }

        if (enemy.stunTimer > 0) {
          ctx.save();
          ctx.fillStyle = "rgba(228,201,79,.9)";
          ctx.font = "900 13px system-ui";
          ctx.textAlign = "center";
          ctx.fillText("!", x + e.w / 2, y - 8);
          ctx.restore();
        }

        for (let i = 0; i < enemy.maxHp; i++) {
          ctx.save();
          ctx.fillStyle = i < enemy.hp ? "#d85a5a" : "rgba(255,255,255,.25)";
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.arc(x + e.w / 2 - (enemy.maxHp - 1) * 7 + i * 14, y - 14, 4, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
          ctx.restore();
        }

        if (debug) {
          ctx.save();
          ctx.strokeStyle = "rgba(216,90,90,.95)";
          ctx.lineWidth = 2;
          ctx.strokeRect(x, y, e.w, e.h);
          ctx.restore();
        }
      }


      function startWorld1EscapeCue() {
        storyScene.active = true;
        storyScene.timer = 8.0;
        storyScene.shipX = portal.x + 178;
        storyScene.shipY = -286;
        storyScene.rewardX = portal.x + 26;
        storyScene.rewardY = -184;
      }

      function updateStoryScene(dt) {
        if (!storyScene.active) return;
        storyScene.timer = Math.max(0, storyScene.timer - dt);
        if (game.bossDefeated && storyScene.timer <= 0) {
          storyScene.timer = 0.01; // mantiene la nave como señal de cierre hasta entrar al portal
        }
      }

      function drawStoryImage(record, x, y, w, h, alpha = 1, flip = false) {
        if (!record || !record.ready) return false;
        ctx.save();
        ctx.globalAlpha = alpha;
        if (flip) {
          ctx.translate(x + w / 2, y + h / 2);
          ctx.scale(-1, 1);
          ctx.drawImage(record.img, -w / 2, -h / 2, w, h);
        } else {
          ctx.drawImage(record.img, x, y, w, h);
        }
        ctx.restore();
        return true;
      }

      function drawStoryImageByWidth(record, centerX, centerY, targetW, alpha = 1) {
        if (!record || !record.ready || !record.img) return false;
        const iw = record.img.naturalWidth || record.img.width || 1;
        const ih = record.img.naturalHeight || record.img.height || 1;
        const targetH = targetW * (ih / iw);
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.drawImage(record.img, centerX - targetW / 2, centerY - targetH / 2, targetW, targetH);
        ctx.restore();
        return { w: targetW, h: targetH };
      }

      function visibleShipWidth() {
        // La nave debe leerse como crucero: mayor que Aero, sin tapar toda la escena.
        return Math.min(360, Math.max(280, W * 0.24));
      }

      function drawVillainShipInWorld(worldId, centerX, centerY, alpha = 1) {
        const shipData = getShipImageForWorld(worldId, shipDamageStateFromBoss());
        const record = { ready: !!shipData.img, img: shipData.img };
        const targetW = visibleShipWidth();
        const drawn = drawStoryImageByWidth(record, centerX, centerY, targetW, alpha);
        if (!drawn) {
          drawFallbackShadowShip(centerX, centerY, targetW / 250);
          return { ship: shipData.ship, w: targetW, h: targetW * 0.45, fallback: true };
        }
        return { ship: shipData.ship, w: drawn.w, h: drawn.h, fallback: false };
      }

      function drawFallbackShadowShip(x, y, scale = 1) {
        // F35 · OVNI provisional grande: se usa cuando el PNG actual no corresponde
        // al crucero OVNI definitivo o mientras llega el nuevo asset 1024×720.
        ctx.save();
        ctx.translate(x, y);
        ctx.scale(scale, scale);

        // Estela / propulsión
        ctx.save();
        const trail = ctx.createLinearGradient(-190, 24, -50, 24);
        trail.addColorStop(0, "rgba(109,88,216,0)");
        trail.addColorStop(0.55, "rgba(109,88,216,.50)");
        trail.addColorStop(1, "rgba(160,120,255,.72)");
        ctx.fillStyle = trail;
        ctx.beginPath();
        ctx.ellipse(-125, 25, 92, 16, -0.05, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "rgba(228,201,79,.18)";
        ctx.beginPath();
        ctx.ellipse(-110, 42, 72, 10, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        // Cuerpo oscuro del platillo
        const hull = ctx.createLinearGradient(0, -46, 0, 56);
        hull.addColorStop(0, "#1f1a33");
        hull.addColorStop(.48, "#12101f");
        hull.addColorStop(1, "#05050b");
        ctx.fillStyle = hull;
        ctx.strokeStyle = "rgba(255,232,150,.42)";
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.moveTo(-178, 16);
        ctx.bezierCurveTo(-145, -34, -58, -62, 52, -56);
        ctx.bezierCurveTo(136, -52, 188, -20, 196, 12);
        ctx.bezierCurveTo(176, 52, 96, 70, -42, 62);
        ctx.bezierCurveTo(-128, 58, -178, 40, -178, 16);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // Borde inferior
        ctx.strokeStyle = "rgba(109,88,216,.72)";
        ctx.lineWidth = 5;
        ctx.beginPath();
        ctx.moveTo(-148, 44);
        ctx.bezierCurveTo(-55, 64, 82, 66, 160, 36);
        ctx.stroke();

        // Cúpula de cristal grande
        const dome = ctx.createRadialGradient(34, -34, 4, 34, -18, 82);
        dome.addColorStop(0, "rgba(255,255,255,.96)");
        dome.addColorStop(.18, "rgba(255,236,160,.86)");
        dome.addColorStop(.46, "rgba(156,122,255,.42)");
        dome.addColorStop(.78, "rgba(58,42,110,.34)");
        dome.addColorStop(1, "rgba(15,14,34,.16)");
        ctx.fillStyle = dome;
        ctx.strokeStyle = "rgba(255,242,176,.84)";
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.ellipse(36, -18, 62, 48, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        // Aurora visible dentro de la cúpula
        ctx.save();
        ctx.translate(15, -16);
        ctx.fillStyle = "rgba(255,244,180,.98)";
        ctx.beginPath();
        ctx.arc(0, -12, 8, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "rgba(250,225,118,.85)";
        ctx.beginPath();
        ctx.moveTo(0, -4);
        ctx.lineTo(-12, 24);
        ctx.lineTo(12, 24);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = "rgba(255,255,255,.78)";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(0, 2, 24, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();

        // Doctor Sombra visible dentro de la cúpula
        ctx.save();
        ctx.translate(62, -14);
        ctx.fillStyle = "rgba(10,8,18,.98)";
        ctx.beginPath();
        ctx.arc(0, -12, 9, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.moveTo(-12, -3);
        ctx.lineTo(12, -3);
        ctx.lineTo(16, 24);
        ctx.lineTo(-16, 24);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = "rgba(190,86,255,.80)";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(-8, -13);
        ctx.lineTo(-2, -10);
        ctx.moveTo(8, -13);
        ctx.lineTo(2, -10);
        ctx.stroke();
        ctx.restore();

        // Luces del casco
        const lights = [
          [-92, 18, "#6d58d8"],
          [-22, 22, "#e4c94f"],
          [104, 16, "#6d58d8"]
        ];
        for (const [lx, ly, color] of lights) {
          const g = ctx.createRadialGradient(lx, ly, 2, lx, ly, 22);
          g.addColorStop(0, "rgba(255,255,255,.95)");
          g.addColorStop(.32, color);
          g.addColorStop(1, "rgba(109,88,216,0)");
          ctx.fillStyle = g;
          ctx.beginPath();
          ctx.arc(lx, ly, 22, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.arc(lx, ly, 8, 0, Math.PI * 2);
          ctx.fill();
        }

        // Rayo de captura / luz hacia abajo
        const beam = ctx.createLinearGradient(44, 45, 44, 170);
        beam.addColorStop(0, "rgba(255,232,145,.38)");
        beam.addColorStop(.68, "rgba(255,232,145,.14)");
        beam.addColorStop(1, "rgba(255,232,145,0)");
        ctx.fillStyle = beam;
        ctx.beginPath();
        ctx.moveTo(18, 42);
        ctx.lineTo(72, 42);
        ctx.lineTo(112, 168);
        ctx.lineTo(-20, 168);
        ctx.closePath();
        ctx.fill();

        // Sombra inferior
        ctx.fillStyle = "rgba(0,0,0,.20)";
        ctx.beginPath();
        ctx.ellipse(12, 78, 150, 18, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
      }

      function shouldUseVectorOvni(shipData) {
        // El nuevo asset esperado es 1024×720. El paquete actual todavía trae 1024×512,
        // por eso forzamos el OVNI vectorial provisional hasta que el archivo real sea reemplazado.
        const img = shipData && shipData.img;
        if (!img) return true;
        const iw = img.naturalWidth || img.width || 0;
        const ih = img.naturalHeight || img.height || 0;
        return iw === 1024 && ih < 650;
      }

      function drawWorld1StoryCue() {
        if (!game.bossDefeated && !storyScene.active && !(boss && boss.active && boss.appeared)) return;
        const shipWorldX = storyScene.shipX || (portal.x + 178);
        const shipWorldY = storyScene.shipY || -286;
        const sx = shipWorldX - world.camX;
        const sy = world.floorY + shipWorldY + Math.sin(world.time * 1.8) * 6;
        if (sx < -260 || sx > W + 260) return;

        const alpha = game.status === "playing" ? 0.96 : 0.72;
        ctx.save();

        // Luz de Aurora dentro de la nave
        const glow = ctx.createRadialGradient(sx + 34, sy + 44, 4, sx + 34, sy + 44, 86);
        glow.addColorStop(0, "rgba(255,245,190,.82)");
        glow.addColorStop(0.38, "rgba(228,201,79,.30)");
        glow.addColorStop(1, "rgba(228,201,79,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(sx + 34, sy + 44, 86, 0, Math.PI * 2);
        ctx.fill();

        const shipDataForCue = getShipImageForWorld(currentWorldId(), shipDamageStateFromBoss());
        let shipDrawn;
        if (shouldUseVectorOvni(shipDataForCue)) {
          const targetW = visibleShipWidth();
          drawFallbackShadowShip(sx, sy + 28, targetW / 392);
          shipDrawn = { ship: shipDataForCue.ship, w: targetW, h: targetW * 0.45, fallback: true };
        } else {
          shipDrawn = drawVillainShipInWorld(currentWorldId(), sx, sy + 28, alpha);
        }

        // El OVNI provisional y el asset nuevo ya muestran a Aurora y Doctor Sombra visibles.

        // Estela de escape
        ctx.globalAlpha = 0.55 + Math.sin(world.time * 6) * 0.12;
        ctx.strokeStyle = "rgba(109,88,216,.70)";
        ctx.lineWidth = 6;
        ctx.beginPath();
        ctx.moveTo(sx - visibleShipWidth() * 0.48, sy + 30);
        ctx.bezierCurveTo(sx - 210, sy + 40, sx - 232, sy + 86, sx - 286, sy + 72);
        ctx.stroke();
        ctx.strokeStyle = "rgba(228,201,79,.48)";
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(sx - visibleShipWidth() * 0.43, sy + 44);
        ctx.bezierCurveTo(sx - 180, sy + 58, sx - 202, sy + 96, sx - 254, sy + 96);
        ctx.stroke();
        ctx.globalAlpha = 1;

        // Premio flotante al lado del portal: pieza 1/5
        if (!game.bossDefeated && !storyScene.active) {
          ctx.restore();
          return;
        }
        const currentReward = window.AERO_STORY_REWARDS && window.AERO_STORY_REWARDS[currentWorldId()];
        const rewardSrc = (currentReward && currentReward.reward) || "assets/story_core/lanza_aurora/rewards/reward_pieza_01.png";
        const rewardImg = getStoryImage(rewardSrc);
        const reward = { ready: !!rewardImg, img: rewardImg };
        const rx = (storyScene.rewardX || (portal.x + 26)) - world.camX;
        const ry = world.floorY + (storyScene.rewardY || -184) + Math.sin(world.time * 3.5) * 5;
        const pulse = 1 + Math.sin(world.time * 5.5) * 0.08;
        const rays = ctx.createRadialGradient(rx, ry, 4, rx, ry, 54 * pulse);
        rays.addColorStop(0, "rgba(255,255,255,.95)");
        rays.addColorStop(.34, "rgba(228,201,79,.58)");
        rays.addColorStop(1, "rgba(228,201,79,0)");
        ctx.fillStyle = rays;
        ctx.beginPath();
        ctx.arc(rx, ry, 54 * pulse, 0, Math.PI * 2);
        ctx.fill();
        ctx.save();
        ctx.translate(rx, ry);
        ctx.rotate(world.time * 0.6);
        ctx.strokeStyle = "rgba(255,231,130,.72)";
        ctx.lineWidth = 2;
        for (let i = 0; i < 12; i++) {
          const a = i * Math.PI / 6;
          ctx.beginPath();
          ctx.moveTo(Math.cos(a) * 34, Math.sin(a) * 34);
          ctx.lineTo(Math.cos(a) * 56, Math.sin(a) * 56);
          ctx.stroke();
        }
        ctx.restore();
        drawStoryImage(reward, rx - 28 * pulse, ry - 28 * pulse, 56 * pulse, 56 * pulse, 1);

        ctx.restore();
      }

      function drawPortal() {
        const r = portalRect();
        const x = r.x - world.camX;
        const y = r.y;
        if (x < -120 || x > W + 120) return;

        ctx.save();
        ctx.translate(x + r.w / 2, y + r.h / 2);

        const active = portal.active;
        const alpha = active ? 0.85 : 0.28;
        const pulse = active ? 1 + Math.sin(world.time * 5) * 0.06 : 1;

        ctx.globalAlpha = alpha;

        const glow = ctx.createRadialGradient(0, 0, 4, 0, 0, 66 * pulse);
        glow.addColorStop(0, active ? "rgba(228,201,79,.85)" : "rgba(155,160,175,.5)");
        glow.addColorStop(0.45, active ? "rgba(109,88,216,.62)" : "rgba(120,130,145,.25)");
        glow.addColorStop(1, "rgba(109,88,216,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.ellipse(0, 0, 44 * pulse, 64 * pulse, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.strokeStyle = active ? "#e4c94f" : "rgba(20,25,35,.55)";
        ctx.lineWidth = 5;
        ctx.beginPath();
        ctx.ellipse(0, 0, 23, 47, 0, 0, Math.PI * 2);
        ctx.stroke();

        ctx.strokeStyle = active ? "rgba(255,255,255,.8)" : "rgba(255,255,255,.35)";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.ellipse(0, 0, 13, 34, 0, 0, Math.PI * 2);
        ctx.stroke();

        if (!active) {
          ctx.globalAlpha = 0.72;
          ctx.fillStyle = "#111";
          ctx.font = "800 11px system-ui";
          ctx.textAlign = "center";
          ctx.fillText("LOCK", 0, 4);
        }

        ctx.restore();

        if (debug) {
          ctx.save();
          ctx.strokeStyle = active ? "rgba(54,166,120,.95)" : "rgba(120,120,120,.8)";
          ctx.lineWidth = 2;
          ctx.strokeRect(r.x - world.camX, r.y, r.w, r.h);
          ctx.restore();
        }
      }

      function drawHeartPath(ctx, x, y, r) {
        ctx.moveTo(x, y + r * 0.85);
        ctx.bezierCurveTo(x - r * 1.55, y - r * 0.05, x - r * 0.95, y - r * 1.15, x, y - r * 0.42);
        ctx.bezierCurveTo(x + r * 0.95, y - r * 1.15, x + r * 1.55, y - r * 0.05, x, y + r * 0.85);
        ctx.closePath();
      }

      function drawPickup(item) {
        const x = item.x - world.camX;
        const y = world.floorY + item.y + Math.sin(world.time * 4 + item.x * 0.02) * 5;
        if (x < -60 || x > W + 60) return;

        const isShield = item.type === "shield";
        const isFlow = item.type === "flow";
        const isStamina = item.type === "energy";
        const pulse = 1 + Math.sin(world.time * 8 + item.x * 0.03) * 0.12;
        const blink = 0.78 + Math.sin(world.time * 10 + item.x * 0.02) * 0.18;

        ctx.save();
        ctx.globalAlpha = blink;

        const glow = ctx.createRadialGradient(x, y, 2, x, y, item.r * 3.6 * pulse);
        glow.addColorStop(0, "rgba(255,255,255,.95)");
        glow.addColorStop(0.36, isShield ? "rgba(108,220,255,.76)" : (isFlow ? "rgba(228,201,79,.82)" : "rgba(216,90,90,.78)"));
        glow.addColorStop(1, isShield ? "rgba(108,220,255,0)" : (isFlow ? "rgba(228,201,79,0)" : "rgba(216,90,90,0)"));
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(x, y, item.r * 3.6 * pulse, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = isShield ? "#6cdcff" : (isFlow ? "#e4c94f" : "#d85a5a");
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 3;
        ctx.beginPath();

        if (isShield) {
          ctx.moveTo(x, y - item.r);
          ctx.lineTo(x + item.r * 0.9, y - item.r * 0.35);
          ctx.quadraticCurveTo(x + item.r * 0.65, y + item.r * 0.9, x, y + item.r * 1.15);
          ctx.quadraticCurveTo(x - item.r * 0.65, y + item.r * 0.9, x - item.r * 0.9, y - item.r * 0.35);
          ctx.closePath();
        } else if (isStamina) {
          drawHeartPath(ctx, x, y, item.r);
        } else {
          ctx.arc(x, y, item.r, 0, Math.PI * 2);
        }

        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "rgba(255,255,255,.82)";
        ctx.beginPath();
        ctx.arc(x - 4, y - 5, 3.5, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
      }

      function drawBossWarningLine(b, x, y) {
        if (!boss || (boss.state !== "precharge" && boss.state !== "aim")) return;

        const cx = x + b.w / 2;
        const cy = y + b.h * 0.52;
        const dir = boss.dir || 1;

        ctx.save();
        ctx.globalAlpha = boss.state === "precharge" ? 0.78 : 0.55;
        ctx.strokeStyle = boss.state === "precharge" ? "rgba(216,90,90,.95)" : "rgba(228,201,79,.82)";
        ctx.lineWidth = boss.state === "precharge" ? 6 : 4;
        ctx.setLineDash(boss.state === "precharge" ? [18, 10] : [10, 8]);

        ctx.beginPath();
        ctx.moveTo(cx + dir * 35, cy);
        ctx.lineTo(cx + dir * 260, cy + (boss.state === "precharge" ? 18 : 0));
        ctx.stroke();

        ctx.setLineDash([]);
        ctx.fillStyle = boss.state === "precharge" ? "rgba(216,90,90,.92)" : "rgba(228,201,79,.9)";
        ctx.beginPath();
        ctx.moveTo(cx + dir * 270, cy + (boss.state === "precharge" ? 18 : 0));
        ctx.lineTo(cx + dir * 242, cy - 12);
        ctx.lineTo(cx + dir * 242, cy + 24);
        ctx.closePath();
        ctx.fill();

        ctx.restore();
      }

      function drawBossTopBar() {
        if (!boss || !boss.active || boss.defeated) return;

        const wBar = Math.min(420, W - 52);
        const hBar = 18;
        const xBar = (W - wBar) / 2;
        const yBar = 86;
        const pct = clamp(boss.hp / boss.maxHp, 0, 1);

        ctx.save();
        ctx.fillStyle = "rgba(20,25,35,.72)";
        roundRect(ctx, xBar, yBar, wBar, hBar + 18, 12);
        ctx.fill();

        ctx.fillStyle = "rgba(255,255,255,.16)";
        roundRect(ctx, xBar + 12, yBar + 19, wBar - 24, hBar - 5, 8);
        ctx.fill();

        const fillColor = boss.state === "rest" ? "#e4c94f" : (boss.state === "precharge" || boss.state === "charge" ? "#d85a5a" : "#6cdcff");
        ctx.fillStyle = fillColor;
        roundRect(ctx, xBar + 12, yBar + 19, (wBar - 24) * pct, hBar - 5, 8);
        ctx.fill();

        ctx.fillStyle = "#fff";
        ctx.font = "900 12px system-ui";
        ctx.textAlign = "center";
        const label = boss.state === "rest" ? "VULNERABLE · DISPARA" : (boss.state === "precharge" ? "ALERTA · EMBESTIDA" : (boss.state === "aim" ? "APUNTA LA LANZA" : "KHARON · LANCERO ALADO"));
        ctx.fillText(`${label} · ${formatHp(boss.hp)}/${boss.maxHp}`, xBar + wBar / 2, yBar + 13);

        ctx.restore();
      }

      function drawBoss() {
        if (!boss) return;
        const b = bossRect();
        const x = b.x - world.camX;
        const y = b.y;
        if (x < -260 || x > W + 260) return;

        const blink = boss.hitFlash > 0 && Math.floor(world.time * 22) % 2 === 0;
        const vanish = boss.state === "vanish";
        const rage = boss.enraged || boss.state === "rage";
        const bob = Math.sin(world.time * (rage ? 7.5 : 4.5)) * (rage ? 9 : 5);
        const chargeTilt = boss.state === "charge" ? boss.dir * 0.14 : 0;
        const aimPulse = boss.state === "aim" ? 1 + Math.sin(world.time * 18) * 0.03 : 1;

        ctx.save();

        const cx = x + b.w / 2;
        const cy = y + b.h * 0.68 + bob;

        drawBossWarningLine(b, x, y);

        if (vanish) {
          ctx.globalAlpha = 0.32 + Math.sin(world.time * 22) * 0.12;
        }

        // sombra al piso
        ctx.fillStyle = "rgba(20,25,35,.18)";
        ctx.beginPath();
        ctx.ellipse(cx, y + b.h + 12, b.w * 0.32, 12, 0, 0, Math.PI * 2);
        ctx.fill();

        // aura de fase
        const auraRadius = rage ? 112 + Math.sin(world.time * 13) * 12 : 62;
        const glow = ctx.createRadialGradient(cx, cy, 8, cx, cy, auraRadius);
        glow.addColorStop(0, rage ? "rgba(255,40,40,.32)" : (boss.state === "rest" ? "rgba(228,201,79,.16)" : (boss.state === "aim" ? "rgba(216,90,90,.18)" : "rgba(108,220,255,.12)")));
        glow.addColorStop(0.55, rage ? "rgba(255,120,48,.16)" : "rgba(109,88,216,.04)");
        glow.addColorStop(1, "rgba(109,88,216,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(cx, cy, auraRadius, 0, Math.PI * 2);
        ctx.fill();

        if (rage) {
          ctx.strokeStyle = "rgba(255,52,52,.72)";
          ctx.lineWidth = 5;
          ctx.beginPath();
          ctx.arc(cx, cy, 82 + Math.sin(world.time * 10) * 8, 0, Math.PI * 2);
          ctx.stroke();
          ctx.strokeStyle = "rgba(255,239,154,.52)";
          ctx.lineWidth = 2;
          for (let i = 0; i < 6; i++) {
            const a = world.time * 2.2 + i * Math.PI / 3;
            ctx.beginPath();
            ctx.moveTo(cx + Math.cos(a) * 72, cy + Math.sin(a) * 72);
            ctx.lineTo(cx + Math.cos(a) * 122, cy + Math.sin(a) * 122);
            ctx.stroke();
          }
        }

        ctx.translate(cx, y + b.h + bob - 8);
        ctx.rotate(chargeTilt);
        ctx.scale(boss.dir < 0 ? -aimPulse : aimPulse, aimPulse);

        if (blink) ctx.globalAlpha = 0.5;
        if (rage) ctx.filter = "saturate(1.6) hue-rotate(-18deg) drop-shadow(0 0 8px rgba(255,40,40,.72))";

        const bossAsset = getBossAsset(boss.assetId);
        if (bossAsset && bossAsset.ready) {
          const dw = b.w * (rage ? 1.54 : 1.38);
          const dh = b.h * (rage ? 1.62 : 1.48);
          ctx.drawImage(bossAsset.img, -dw / 2, -dh + 10, dw, dh);
        } else if (assets.bossWingedReady) {
          const dw = b.w * (rage ? 1.54 : 1.38);
          const dh = b.h * (rage ? 1.62 : 1.48);
          ctx.drawImage(assets.bossWinged, -dw / 2, -dh + 10, dw, dh);
        } else {
          ctx.fillStyle = rage ? "#8e2432" : "#2b2238";
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 5;
          ctx.beginPath();
          ctx.ellipse(0, -42, b.w * 0.42, b.h * 0.46, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
        }

        ctx.filter = "none";

        if (boss.state === "aim") {
          ctx.strokeStyle = rage ? "rgba(255,239,154,.96)" : "rgba(216,90,90,.92)";
          ctx.lineWidth = rage ? 6 : 4;
          ctx.beginPath();
          ctx.moveTo(28, -36);
          ctx.lineTo(rage ? 108 : 84, -36);
          ctx.stroke();
        }

        if (boss.state === "rest") {
          ctx.globalAlpha = 0.92;
          ctx.strokeStyle = "#e4c94f";
          ctx.lineWidth = 5;
          ctx.beginPath();
          ctx.ellipse(0, -42, 62 + Math.sin(world.time * 10) * 6, 44 + Math.sin(world.time * 10) * 4, 0, 0, Math.PI * 2);
          ctx.stroke();
        }

        if (vanish) {
          ctx.strokeStyle = "rgba(168,240,255,.70)";
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.arc(0, -42, 58 + Math.sin(world.time * 30) * 18, 0, Math.PI * 2);
          ctx.stroke();
        }

        ctx.restore();

        if (debug) {
          ctx.save();
          ctx.strokeStyle = boss.state === "charge" ? "rgba(216,90,90,.95)" : "rgba(54,166,120,.95)";
          ctx.lineWidth = 2;
          ctx.strokeRect(b.x - world.camX, b.y, b.w, b.h);
          ctx.restore();
        }
      }

      function drawOrb(orb) {
        const x = orb.x - world.camX;
        const y = world.floorY + orb.y + Math.sin(world.time * 4 + orb.x * 0.02) * 6;
        if (x < -60 || x > W + 60) return;

        ctx.save();
        const pulse = 0.8 + Math.sin(world.time * 5 + orb.x) * 0.12;
        const glow = ctx.createRadialGradient(x, y, 2, x, y, orb.r * 3.2);
        glow.addColorStop(0, "rgba(255,255,255,.95)");
        glow.addColorStop(0.35, "rgba(228,201,79,.75)");
        glow.addColorStop(1, "rgba(109,88,216,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(x, y, orb.r * 3.2 * pulse, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "#e4c94f";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(x, y, orb.r, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "rgba(255,255,255,.86)";
        ctx.beginPath();
        ctx.arc(x - 4, y - 5, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      function drawEnemyProjectile(projectile) {
        const x = projectile.x - world.camX;
        const y = projectile.y;
        if (x < -100 || x > W + 100) return;

        ctx.save();

        if (projectile.type === "boss_bomb") {
          const glow = ctx.createRadialGradient(x, y, 3, x, y, 42);
          glow.addColorStop(0, "rgba(255,255,255,.95)");
          glow.addColorStop(.3, "rgba(255,122,54,.82)");
          glow.addColorStop(1, "rgba(216,90,90,0)");
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(x, y, 42, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = "#2c263e";
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.arc(x, y, projectile.r + 3, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
          ctx.strokeStyle = "#ffef9a";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(x - 2, y - projectile.r - 5);
          ctx.quadraticCurveTo(x + 10, y - projectile.r - 20, x + 20, y - projectile.r - 8);
          ctx.stroke();
          ctx.restore();
          return;
        }

        if (projectile.type === "boss_storm" || projectile.type === "boss_shard" || projectile.type === "boss_toxic" || projectile.type === "boss_orb") {
          const color = projectile.type === "boss_storm" ? "rgba(255,242,69,.92)" : (projectile.type === "boss_shard" ? "rgba(168,240,255,.90)" : (projectile.type === "boss_toxic" ? "rgba(0,208,208,.88)" : "rgba(216,90,90,.90)"));
          const glow = ctx.createRadialGradient(x, y, 2, x, y, 34);
          glow.addColorStop(0, "rgba(255,255,255,.95)");
          glow.addColorStop(0.38, color);
          glow.addColorStop(1, "rgba(109,88,216,0)");
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(x, y, 34, 0, Math.PI * 2);
          ctx.fill();

          if (projectile.type === "boss_shard") {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(world.time * 7);
            ctx.fillStyle = "#a8f0ff";
            ctx.strokeStyle = "#111";
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(0, -projectile.r - 5);
            ctx.lineTo(projectile.r + 5, 0);
            ctx.lineTo(0, projectile.r + 5);
            ctx.lineTo(-projectile.r - 5, 0);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
            ctx.restore();
          } else {
            ctx.fillStyle = projectile.type === "boss_storm" ? "#fff245" : (projectile.type === "boss_toxic" ? "#00d0d0" : "#d85a5a");
            ctx.strokeStyle = "#111";
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(x, y, projectile.r + (projectile.type === "boss_storm" ? 2 : 0), 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            if (projectile.type === "boss_storm") {
              ctx.strokeStyle = "rgba(255,255,255,.88)";
              ctx.lineWidth = 2;
              ctx.beginPath();
              ctx.moveTo(x - 14, y);
              ctx.lineTo(x + 14, y);
              ctx.moveTo(x, y - 14);
              ctx.lineTo(x, y + 14);
              ctx.stroke();
            }
          }
          ctx.restore();
          return;
        }

        if (projectile.type === "boss_lance") {
          const dir = Math.sign(projectile.vx) || 1;

          const glow = ctx.createRadialGradient(x, y, 2, x, y, 34);
          glow.addColorStop(0, "rgba(255,255,255,.95)");
          glow.addColorStop(0.35, "rgba(228,201,79,.78)");
          glow.addColorStop(1, "rgba(216,90,90,0)");
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(x, y, 34, 0, Math.PI * 2);
          ctx.fill();

          ctx.translate(x, y);
          ctx.scale(dir, 1);
          ctx.strokeStyle = "#111";
          ctx.fillStyle = "#d8c66f";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(24, 0);
          ctx.lineTo(4, -8);
          ctx.lineTo(6, -3);
          ctx.lineTo(-28, -3);
          ctx.lineTo(-28, 3);
          ctx.lineTo(6, 3);
          ctx.lineTo(4, 8);
          ctx.closePath();
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = "#d85a5a";
          ctx.beginPath();
          ctx.arc(-14, 0, 4, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
          return;
        }

        const glow = ctx.createRadialGradient(x, y, 2, x, y, 22);
        glow.addColorStop(0, "rgba(255,255,255,.95)");
        glow.addColorStop(0.38, "rgba(216,90,90,.88)");
        glow.addColorStop(1, "rgba(216,90,90,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(x, y, 22, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "#d85a5a";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(x, y, projectile.r, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        ctx.restore();
      }

      function drawSpark(spark) {
        const x = spark.x - world.camX;
        const y = spark.y;
        if (x < -80 || x > W + 80) return;

        const glowRadius = spark.glow || 24;
        const coreRadius = spark.r || 7;
        const aura1 = spark.aura1 || "rgba(228,201,79,.95)";
        const aura2 = spark.aura2 || "rgba(109,88,216,.72)";
        const coreColor = spark.coreColor || "#e4c94f";
        const lineAlpha = spark.energyTier === "low" ? 0.45 : 0.8;

        ctx.save();

        if (spark.type === "laser") {
          const len = spark.power ? 76 : 56;
          const angle = Math.atan2(spark.vy || 0, spark.vx || 1);
          ctx.translate(x, y);
          ctx.rotate(angle);
          const g = ctx.createLinearGradient(-len * 0.6, 0, len, 0);
          g.addColorStop(0, "rgba(168,240,255,0)");
          g.addColorStop(0.35, "rgba(168,240,255,.82)");
          g.addColorStop(0.65, "rgba(255,255,255,.98)");
          g.addColorStop(1, "rgba(109,88,216,0)");
          ctx.strokeStyle = g;
          ctx.lineWidth = spark.power ? 9 : 6;
          ctx.beginPath();
          ctx.moveTo(-len * 0.6, 0);
          ctx.lineTo(len, 0);
          ctx.stroke();

          ctx.strokeStyle = "rgba(255,255,255,.92)";
          ctx.lineWidth = spark.power ? 3 : 2;
          ctx.beginPath();
          ctx.moveTo(-len * 0.35, 0);
          ctx.lineTo(len * 0.72, 0);
          ctx.stroke();

          ctx.strokeStyle = "rgba(228,201,79,.85)";
          ctx.lineWidth = 2;
          for (let i = 0; i < 3; i++) {
            const px = -len * .2 + i * 22 + Math.sin(world.time * 18 + i) * 3;
            ctx.beginPath();
            ctx.moveTo(px, -8);
            ctx.lineTo(px + 8, 8);
            ctx.stroke();
          }
          ctx.restore();
          return;
        }

        if (spark.type === "grenade") {
          const glow = ctx.createRadialGradient(x, y, 2, x, y, glowRadius);
          glow.addColorStop(0, "rgba(255,255,255,.96)");
          glow.addColorStop(0.32, "rgba(228,201,79,.58)");
          glow.addColorStop(1, "rgba(216,90,90,0)");
          ctx.fillStyle = glow;
          ctx.beginPath(); ctx.arc(x, y, glowRadius, 0, Math.PI * 2); ctx.fill();
          ctx.translate(x, y);
          ctx.rotate(world.time * 8);
          ctx.fillStyle = "#2c263e";
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 3;
          roundRect(ctx, -9, -8, 18, 16, 6);
          ctx.fill(); ctx.stroke();
          ctx.fillStyle = "#e4c94f";
          ctx.fillRect(-3, -14, 6, 7);
          ctx.restore();
          return;
        }

        if (spark.type === "rocket") {
          const angle = Math.atan2(spark.vy || 0, spark.vx || 1);
          ctx.translate(x, y);
          ctx.rotate(angle);
          const flame = ctx.createRadialGradient(-22, 0, 2, -22, 0, 26);
          flame.addColorStop(0, "rgba(255,255,255,.95)");
          flame.addColorStop(.3, "rgba(255,180,70,.82)");
          flame.addColorStop(1, "rgba(216,90,90,0)");
          ctx.fillStyle = flame;
          ctx.beginPath();
          ctx.ellipse(-24, 0, 28, 11, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = "#3b344d";
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.moveTo(18, 0);
          ctx.lineTo(4, -8);
          ctx.lineTo(-16, -7);
          ctx.lineTo(-16, 7);
          ctx.lineTo(4, 8);
          ctx.closePath();
          ctx.fill(); ctx.stroke();
          ctx.fillStyle = "#ffef9a";
          ctx.beginPath(); ctx.arc(6, 0, 4, 0, Math.PI * 2); ctx.fill();
          ctx.restore();
          return;
        }

        const glow = ctx.createRadialGradient(x, y, 2, x, y, glowRadius);
        glow.addColorStop(0, "rgba(255,255,255,.98)");
        glow.addColorStop(0.28, aura1);
        glow.addColorStop(0.62, aura2);
        glow.addColorStop(1, "rgba(109,88,216,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(x, y, glowRadius, 0, Math.PI * 2);
        ctx.fill();

        ctx.strokeStyle = "#111";
        ctx.lineWidth = spark.energyTier === "low" ? 1.4 : 2;
        ctx.fillStyle = coreColor;
        ctx.beginPath();
        ctx.arc(x, y, coreRadius, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        if (spark.fire) {
          ctx.strokeStyle = "rgba(255,180,90,.92)";
          ctx.lineWidth = 7;
          ctx.beginPath();
          ctx.moveTo(x - 32, y);
          ctx.lineTo(x + 32, y);
          ctx.stroke();
        }

        if (spark.power) {
          ctx.strokeStyle = "rgba(255,255,255,.88)";
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.moveTo(x - 22, y);
          ctx.lineTo(x + 22, y);
          ctx.stroke();
        }

        ctx.strokeStyle = `rgba(255,255,255,${lineAlpha})`;
        ctx.lineWidth = spark.energyTier === "low" ? 1.4 : 2;
        ctx.beginPath();
        ctx.moveTo(x - coreRadius * 1.7, y);
        ctx.lineTo(x + coreRadius * 1.7, y);
        ctx.moveTo(x, y - coreRadius * 1.7);
        ctx.lineTo(x, y + coreRadius * 1.7);
        ctx.stroke();
        ctx.restore();
      }

      function drawCrystal(obstacle) {
        const x = obstacle.x - world.camX;
        const y = world.floorY - obstacle.h;
        if (x < -90 || x > W + 90) return;

        ctx.save();
        ctx.translate(x + obstacle.w / 2, y + obstacle.h);

        const breakable = !!obstacle.breakable;
        const glow = ctx.createRadialGradient(0, -obstacle.h * 0.55, 3, 0, -obstacle.h * 0.55, obstacle.h * 0.95);
        glow.addColorStop(0, "rgba(255,255,255,.75)");
        glow.addColorStop(0.35, breakable ? "rgba(109,88,216,.62)" : "rgba(216,90,90,.55)");
        glow.addColorStop(1, breakable ? "rgba(109,88,216,0)" : "rgba(216,90,90,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.ellipse(0, -obstacle.h * 0.45, obstacle.w * 1.1, obstacle.h * 0.72, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = breakable ? "#6d58d8" : "#d85a5a";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 4;
        ctx.lineJoin = "round";
        ctx.beginPath();
        ctx.moveTo(0, -obstacle.h);
        ctx.lineTo(obstacle.w * 0.48, -obstacle.h * 0.42);
        ctx.lineTo(obstacle.w * 0.24, 0);
        ctx.lineTo(-obstacle.w * 0.26, 0);
        ctx.lineTo(-obstacle.w * 0.48, -obstacle.h * 0.42);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.strokeStyle = breakable ? "rgba(228,201,79,.65)" : "rgba(255,255,255,.55)";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(-3, -obstacle.h * 0.82);
        ctx.lineTo(10, -obstacle.h * 0.42);
        ctx.stroke();

        ctx.restore();

        if (debug) {
          ctx.save();
          ctx.strokeStyle = "rgba(216,90,90,.95)";
          ctx.lineWidth = 2;
          ctx.strokeRect(obstacle.x - world.camX, world.floorY - obstacle.h, obstacle.w, obstacle.h);
          ctx.restore();
        }
      }

      function drawGameMessage() {
        if (!game.statusMessage || (game.status === "playing" && game.messageTimer <= 0)) return;

        const text = game.statusMessage;
        ctx.save();
        ctx.font = "800 14px system-ui, -apple-system, Segoe UI, sans-serif";
        const padX = 12;
        const boxW = Math.min(W - 50, ctx.measureText(text).width + padX * 2);
        const boxH = 34;
        const x = (W - boxW) / 2;
        const y = Math.max(68, H * 0.11);

        ctx.fillStyle = "rgba(20,25,35,.66)";
        roundRect(ctx, x, y, boxW, boxH, 12);
        ctx.fill();

        ctx.fillStyle = "#fff";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(text, W / 2, y + boxH / 2);
        ctx.restore();
      }


      function aeroAnimationFrames(state) {
        if (state === "run") return [2, 3, 4, 5];
        if (state === "idle") return [0, 1];
        if (state === "jump_up" || state === "jump_air") return [6];
        if (state === "fall") return [7];
        if (state === "crouch") return [8];
        if (state === "hurt") return [9];
        return [0];
      }

      function drawAeroImageAvatar(asset, profile) {
        const sx = player.x - world.camX;
        const sy = player.y;
        const facing = player.dir;
        const cx = sx + player.width / 2;
        const feetY = sy + player.height;

        ctx.save();
        if (player.invulnerable > 0 && Math.floor(world.time * 16) % 2 === 0) {
          ctx.globalAlpha = 0.48;
        }
        ctx.translate(cx, feetY);
        ctx.scale(facing, 1);

        const squashX = 1 + (1 - player.squash) * 0.25;
        const squashY = player.squash;
        const crouchVisual = player.isCrouching ? 0.62 : 1;
        ctx.scale(squashX, squashY * crouchVisual);

        drawAeroShadow(0, 0, player.grounded ? 1 : clamp(1 - (world.floorY - feetY) / 260, 0.3, 0.8));

        if (player.airJumpFlash > 0) {
          ctx.save();
          const pulse = player.airJumpFlash / 0.24;
          ctx.globalAlpha = pulse * 0.7;
          ctx.strokeStyle = "#e4c94f";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.ellipse(0, -42, 45 + (1 - pulse) * 32, 30 + (1 - pulse) * 20, -0.15, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }

        if (player.shieldTimer > 0) {
          ctx.save();
          const low = player.shieldTimer < 1 && Math.floor(world.time * 12) % 2 === 0;
          ctx.globalAlpha = low ? 0.32 : 0.58;
          ctx.strokeStyle = "#6cdcff";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.ellipse(0, -42, 42, 58, 0, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }

        if (player.fireBoostTimer > 0 || player.overdriveTimer > 0) {
          ctx.save();
          ctx.globalAlpha = 0.34 + Math.sin(world.time * 8) * 0.07;
          ctx.strokeStyle = player.fireBoostTimer > 0 ? "#ff9a3d" : "#e4c94f";
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.ellipse(0, -48, 50, 64, 0, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }

        const runBob = player.state === "run" ? Math.sin(player.runT * Math.PI * 2) * 3 : 0;
        const airTilt = !player.grounded ? clamp(player.vy / 900, -0.25, 0.25) : 0;
        const drawW = profile.drawW || asset.recommendedWidth || 76;
        const drawH = profile.drawH || asset.recommendedHeight || 96;
        ctx.save();
        ctx.rotate(airTilt);
        ctx.drawImage(asset.img, -drawW / 2, -drawH + runBob, drawW, drawH);
        ctx.restore();

        const orbX = profile.orbX ?? 30;
        const orbY = profile.orbY ?? -58;
        const glow = 0.65 + Math.sin(world.time * 8) * 0.2;
        ctx.save();
        ctx.globalAlpha = glow;
        const gradient = ctx.createRadialGradient(orbX, orbY, 2, orbX, orbY, 21);
        gradient.addColorStop(0, "#ffffff");
        gradient.addColorStop(0.35, player.fireBoostTimer > 0 ? "#ffef9a" : "#e4c94f");
        gradient.addColorStop(1, player.fireBoostTimer > 0 ? "rgba(255,100,40,0)" : "rgba(109,88,216,0)");
        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.arc(orbX, orbY, 21, 0, Math.PI * 2);
        ctx.fill();
        if (player.attackFlash > 0) {
          ctx.globalAlpha = player.attackFlash / 0.12;
          ctx.strokeStyle = "#e4c94f";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.arc(orbX, orbY, 15, 0, Math.PI * 2);
          ctx.stroke();
        }
        ctx.restore();

        ctx.restore();
        if (debug) drawHitbox();
      }

      function drawAero() {
        if (game.flightMode) { drawFlightShip(); return; }
        const avatarProfile = activeAvatarProfile();
        const avatarAsset = getAvatarAsset(avatarProfile.id);
        if (avatarAsset && avatarAsset.ready) {
          drawAeroImageAvatar(avatarAsset, avatarProfile);
          return;
        }

        const sx = player.x - world.camX;
        const sy = player.y;
        const scale = 1;
        const facing = player.dir;
        const cx = sx + player.width / 2;
        const feetY = sy + player.height;

        ctx.save();
        if (player.invulnerable > 0 && Math.floor(world.time * 16) % 2 === 0) {
          ctx.globalAlpha = 0.48;
        }
        ctx.translate(cx, feetY);
        ctx.scale(facing * scale, scale);

        const squashX = 1 + (1 - player.squash) * 0.25;
        const squashY = player.squash;
        const crouchVisual = player.isCrouching ? 0.62 : 1;
        ctx.scale(squashX, squashY * crouchVisual);

        drawAeroShadow(0, 0, player.grounded ? 1 : clamp(1 - (world.floorY - feetY) / 260, 0.3, 0.8));

        const run = player.state === "run" ? Math.sin(player.runT * Math.PI * 2) : 0;
        const run2 = player.state === "run" ? Math.cos(player.runT * Math.PI * 2) : 0;
        const airPose = !player.grounded ? clamp(player.vy / 700, -1, 1) : 0;
        const idleBob = player.state === "idle" ? Math.sin(world.time * 3) * 1.5 : 0;

        // Body anchors
        const hip = { x: 0, y: -28 + idleBob };
        const chest = { x: 2, y: -55 + idleBob };
        const head = { x: 4, y: -76 + idleBob };

        // Double jump pulse
        if (player.airJumpFlash > 0) {
          ctx.save();
          const pulse = player.airJumpFlash / 0.24;
          ctx.globalAlpha = pulse * 0.7;
          ctx.strokeStyle = "#e4c94f";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.ellipse(0, -42, 45 + (1 - pulse) * 32, 30 + (1 - pulse) * 20, -0.15, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }

        // Shield aura
        if (player.shieldTimer > 0) {
          ctx.save();
          const low = player.shieldTimer < 1 && Math.floor(world.time * 12) % 2 === 0;
          ctx.globalAlpha = low ? 0.32 : 0.58;
          ctx.strokeStyle = "#6cdcff";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.ellipse(0, -42, 42, 58, 0, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }

        // Cape, behind body
        ctx.save();
        const capeLift = !player.grounded ? -8 : run2 * 4;
        ctx.fillStyle = "rgba(85,71,167,.82)";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(chest.x - 5, chest.y + 2);
        ctx.bezierCurveTo(-32, -70 + capeLift, -58, -55 + capeLift, -72, -44 + capeLift);
        ctx.bezierCurveTo(-44, -37 + run * 5, -26, -25 + run2 * 2, hip.x - 6, hip.y - 6);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // Cape pattern
        ctx.strokeStyle = "rgba(232,205,82,.55)";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(-42, -56 + capeLift);
        ctx.lineTo(-24, -34 + run * 2);
        ctx.stroke();
        ctx.strokeStyle = "rgba(199,83,117,.48)";
        ctx.beginPath();
        ctx.moveTo(-52, -49 + capeLift);
        ctx.lineTo(-30, -30 + run * 2);
        ctx.stroke();
        ctx.restore();

        // Legs
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 7;
        ctx.lineCap = "round";
        ctx.lineJoin = "round";

        let leftKnee, leftFoot, rightKnee, rightFoot;
        if (player.grounded && player.state === "run") {
          leftKnee = { x: -12 + run * 10, y: -14 + Math.max(0, run2) * -5 };
          leftFoot = { x: -20 + run * 24, y: -1 + Math.max(0, -run2) * -8 };
          rightKnee = { x: 12 - run * 10, y: -14 + Math.max(0, -run2) * -5 };
          rightFoot = { x: 20 - run * 24, y: -1 + Math.max(0, run2) * -8 };
        } else if (!player.grounded) {
          leftKnee = { x: -18, y: -23 + airPose * 8 };
          leftFoot = { x: -33, y: -14 + airPose * 12 };
          rightKnee = { x: 16, y: -18 - airPose * 4 };
          rightFoot = { x: 36, y: -30 - airPose * 12 };
        } else {
          leftKnee = { x: -10, y: -13 };
          leftFoot = { x: -16, y: 0 };
          rightKnee = { x: 12, y: -13 };
          rightFoot = { x: 18, y: 0 };
        }

        line(hip.x - 5, hip.y, leftKnee.x, leftKnee.y, leftFoot.x, leftFoot.y);
        line(hip.x + 5, hip.y, rightKnee.x, rightKnee.y, rightFoot.x, rightFoot.y);

        // Torso
        ctx.fillStyle = "#f8f8f8";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 6;
        line(hip.x, hip.y, chest.x, chest.y);

        // Suit/chest cloth
        ctx.save();
        ctx.translate(0, 0);
        ctx.fillStyle = "#5547a7";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(chest.x - 8, chest.y + 2);
        ctx.lineTo(chest.x + 13, chest.y + 4);
        ctx.lineTo(hip.x + 8, hip.y + 7);
        ctx.lineTo(hip.x - 9, hip.y + 4);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.strokeStyle = "#e4c94f";
        ctx.lineWidth = 2;
        for (let i = 0; i < 4; i++) {
          ctx.beginPath();
          ctx.moveTo(chest.x - 4 + i * 4, chest.y + 8);
          ctx.lineTo(hip.x - 4 + i * 3, hip.y + 2);
          ctx.stroke();
        }
        ctx.restore();

        // Arms
        let backElbow, backHand, frontElbow, frontHand;
        if (player.grounded && player.state === "run") {
          backElbow = { x: -15 - run * 9, y: -48 + run2 * 4 };
          backHand = { x: -26 - run * 12, y: -38 + run2 * 5 };
          frontElbow = { x: 18 + run * 9, y: -50 - run2 * 4 };
          frontHand = { x: 33 + run * 12, y: -60 - run2 * 5 };
        } else if (!player.grounded) {
          backElbow = { x: -18, y: -50 };
          backHand = { x: -28, y: -46 };
          frontElbow = { x: 22, y: -64 };
          frontHand = { x: 36, y: -72 };
        } else {
          backElbow = { x: -14, y: -45 };
          backHand = { x: -24, y: -39 };
          frontElbow = { x: 16, y: -53 };
          frontHand = { x: 30, y: -57 };
        }

        line(chest.x - 3, chest.y + 4, backElbow.x, backElbow.y, backHand.x, backHand.y);
        line(chest.x + 4, chest.y + 3, frontElbow.x, frontElbow.y, frontHand.x, frontHand.y);

        // Energy orb
        const glow = 0.65 + Math.sin(world.time * 8) * 0.2;
        ctx.save();
        ctx.globalAlpha = glow;
        const gradient = ctx.createRadialGradient(frontHand.x + 5, frontHand.y - 4, 2, frontHand.x + 5, frontHand.y - 4, 19);
        gradient.addColorStop(0, "#ffffff");
        gradient.addColorStop(0.35, "#e4c94f");
        gradient.addColorStop(1, "rgba(109,88,216,0)");
        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.arc(frontHand.x + 5, frontHand.y - 4, 19, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        if (player.attackFlash > 0) {
          ctx.save();
          ctx.globalAlpha = player.attackFlash / 0.12;
          ctx.strokeStyle = "#e4c94f";
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.arc(frontHand.x + 5, frontHand.y - 4, 14, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }

        ctx.fillStyle = "#e4c94f";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(frontHand.x + 5, frontHand.y - 4, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        // Head
        ctx.fillStyle = "#fff";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 5;
        ctx.beginPath();
        ctx.arc(head.x, head.y, 16, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        // Face
        ctx.fillStyle = "#111";
        ctx.beginPath();
        ctx.arc(head.x - 5, head.y - 2, 2.3, 0, Math.PI * 2);
        ctx.arc(head.x + 6, head.y - 2, 2.3, 0, Math.PI * 2);
        ctx.fill();
        ctx.lineWidth = 2.4;
        ctx.beginPath();
        ctx.arc(head.x + 1, head.y + 2, 7, 0.15 * Math.PI, 0.85 * Math.PI);
        ctx.stroke();

        ctx.restore();

        if (debug) drawHitbox();
      }

      function drawAeroShadow(x, y, alpha) {
        ctx.save();
        ctx.globalAlpha = 0.25 * alpha;
        ctx.fillStyle = "#8ce9ff";
        ctx.beginPath();
        ctx.ellipse(x, 5, 35, 8, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      function line(...pts) {
        ctx.beginPath();
        ctx.moveTo(pts[0], pts[1]);
        for (let i = 2; i < pts.length; i += 2) {
          ctx.lineTo(pts[i], pts[i + 1]);
        }
        ctx.stroke();
      }

      function drawHitbox() {
        const sx = player.x - world.camX;
        const sy = player.y;
        ctx.save();
        ctx.strokeStyle = "rgba(216,90,90,.95)";
        ctx.fillStyle = "rgba(216,90,90,.12)";
        ctx.lineWidth = 2;
        roundRect(ctx, sx, sy, player.width, player.height, 18);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "rgba(0,0,0,.72)";
        ctx.font = "12px system-ui, sans-serif";
        ctx.fillText("hitbox cuerpo+cabeza", sx - 24, sy - 8);
        ctx.restore();
      }

      function roundRect(ctx, x, y, w, h, r) {
        const rr = Math.min(r, w / 2, h / 2);
        ctx.beginPath();
        ctx.moveTo(x + rr, y);
        ctx.arcTo(x + w, y, x + w, y + h, rr);
        ctx.arcTo(x + w, y + h, x, y + h, rr);
        ctx.arcTo(x, y + h, x, y, rr);
        ctx.arcTo(x, y, x + w, y, rr);
        ctx.closePath();
      }

      function drawMenu() {
        drawBackground();

        ctx.save();
        ctx.fillStyle = "rgba(20,25,35,.62)";
        ctx.fillRect(0, 0, W, H);

        const titleY = Math.max(90, H * 0.28);
        ctx.textAlign = "center";
        ctx.fillStyle = "#ffffff";
        ctx.font = "900 48px system-ui, -apple-system, Segoe UI, sans-serif";
        ctx.fillText("AERO", W / 2, titleY);

        ctx.font = "700 16px system-ui, -apple-system, Segoe UI, sans-serif";
        ctx.fillStyle = "rgba(255,255,255,.82)";
        ctx.fillText("Escribe tu nombre y toca Iniciar juego", W / 2, titleY + 34);

        const bw = Math.min(320, W - 48);
        const bh = 64;
        const bx = (W - bw) / 2;
        const by = titleY + 76;

        const pulse = 1 + Math.sin(world.time * 4) * 0.025;
        ctx.save();
        ctx.translate(W / 2, by + bh / 2);
        ctx.scale(pulse, pulse);
        ctx.translate(-W / 2, -(by + bh / 2));
        ctx.fillStyle = "rgba(228,201,79,.96)";
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 4;
        roundRect(ctx, bx, by, bw, bh, 20);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#151515";
        ctx.font = "900 20px system-ui, -apple-system, Segoe UI, sans-serif";
        ctx.fillText("INICIAR MISIÓN", W / 2, by + bh / 2 + 7);
        ctx.restore();

        ctx.font = "700 12px system-ui, -apple-system, Segoe UI, sans-serif";
        ctx.fillStyle = "rgba(255,255,255,.70)";
        ctx.fillText("Click, toque o Enter/Espacio", W / 2, by + bh + 32);

        ctx.restore();
      }

      function levelCardRect(index) {
        const cardW = Math.min(360, W - 46);
        const cardH = levels.length > 3 ? 66 : 84;
        const gap = levels.length > 3 ? 10 : 18;
        const totalH = levels.length * cardH + (levels.length - 1) * gap;
        const startY = Math.max(162, H / 2 - totalH / 2 + 46);
        return {
          x: W / 2 - cardW / 2,
          y: startY + index * (cardH + gap),
          w: cardW,
          h: cardH
        };
      }

      function drawLevelSelect() {
        drawBackground();

        ctx.save();
        ctx.fillStyle = "rgba(20,25,35,.60)";
        ctx.fillRect(0, 0, W, H);

        ctx.textAlign = "center";
        ctx.fillStyle = "#fff";
        ctx.font = "900 32px system-ui, -apple-system, Segoe UI, sans-serif";
        ctx.fillText("Selecciona nivel", W / 2, 72);

        const chips = loadoutChipRects();
        ctx.font = "700 12px system-ui, -apple-system, Segoe UI, sans-serif";
        ctx.fillStyle = "rgba(255,255,255,.82)";
        ctx.fillText("Carga de inicio", W / 2, 98);
        chips.forEach(chip => {
          const active = chip.id === selectedStartWeaponId;
          ctx.fillStyle = active ? "rgba(228,201,79,.97)" : "rgba(255,255,255,.94)";
          ctx.strokeStyle = "#111";
          ctx.lineWidth = active ? 4 : 3;
          roundRect(ctx, chip.x, chip.y, chip.w, chip.h, 14);
          ctx.fill();
          ctx.stroke();
          ctx.fillStyle = "#151515";
          ctx.font = "900 14px system-ui, -apple-system, Segoe UI, sans-serif";
          ctx.fillText(`${weaponIconById(chip.id)} ${weaponLabelById(chip.id)}`, chip.x + chip.w / 2, chip.y + 15);
          ctx.font = "700 11px system-ui, -apple-system, Segoe UI, sans-serif";
          const countText = chip.id === "spark" ? "base" : `x${getStartWeaponCharge(chip.id)}`;
          ctx.fillText(countText, chip.x + chip.w / 2, chip.y + 28);
        });

        levels.forEach((level, index) => {
          const r = levelCardRect(index);
          ctx.fillStyle = index === game.currentLevel ? "rgba(228,201,79,.96)" : "rgba(255,255,255,.90)";
          ctx.strokeStyle = "#111";
          ctx.lineWidth = 4;
          roundRect(ctx, r.x, r.y, r.w, r.h, 18);
          ctx.fill();
          ctx.stroke();

          ctx.textAlign = "left";
          ctx.fillStyle = "#151515";
          ctx.font = levels.length > 3 ? "900 15px system-ui, -apple-system, Segoe UI, sans-serif" : "900 18px system-ui, -apple-system, Segoe UI, sans-serif";
          ctx.fillText(`${index + 1}. ${level.name}`, r.x + 22, r.y + (levels.length > 3 ? 26 : 32));

          ctx.font = "700 12px system-ui, -apple-system, Segoe UI, sans-serif";
          ctx.fillStyle = "rgba(20,25,35,.72)";
          const bossNames = ["Kharon", "Goliath", "Titán Geoda", "Axolotl Kraken", "Águila Tormenta"];
          ctx.fillText(`${level.goalOrbs} orbes · ${level.goalEnemies} enemigos · ${bossNames[index] || "Jefe"}`, r.x + 22, r.y + (levels.length > 3 ? 48 : 56));
        });

        ctx.textAlign = "center";
        ctx.fillStyle = "rgba(255,255,255,.72)";
        ctx.font = "700 12px system-ui, -apple-system, Segoe UI, sans-serif";
        ctx.fillText("Toca una tarjeta. Arriba eliges carga inicial · 1 / 2 / 3 / 4 / 5 para mundos", W / 2, H - 34);

        ctx.restore();
      }

      function loadoutChipRects() {
        const unlocked = startWeaponUnlocks.filter(id => id === "spark" || getStartWeaponCharge(id) > 0);
        const chipW = 84;
        const chipH = 34;
        const gap = 10;
        const totalW = unlocked.length * chipW + Math.max(0, unlocked.length - 1) * gap;
        const startX = W / 2 - totalW / 2;
        const y = 104;
        return unlocked.map((id, index) => ({ id, x: startX + index * (chipW + gap), y, w: chipW, h: chipH }));
      }

      function startLevelSelect() {
        if (game.status !== "menu") return;
        savePlayerName(playerNameInput ? playerNameInput.value : playerName);
        hideStartOverlay();
        if (endOverlay) endOverlay.classList.add("hidden");
        enableSound();
        game.status = "level_select";
        game.statusMessage = "Selecciona mundo";
        game.messageTimer = 0;
        updatePlayerUi();
        playSfx("orb");
      }

      function chooseLevel(index) {
        if (game.status !== "level_select") return;
        const safeIndex = clamp(index, 0, levels.length - 1);
        resetLevel(safeIndex);
        playSfx("start");
      }

      function handleMenuPointer(clientX, clientY) {
        if (game.status === "menu") {
          startLevelSelect();
          return;
        }

        if (game.status === "level_select") {
          for (const chip of loadoutChipRects()) {
            if (clientX >= chip.x && clientX <= chip.x + chip.w && clientY >= chip.y && clientY <= chip.y + chip.h) {
              setSelectedStartWeapon(chip.id, true);
              return;
            }
          }
          for (let i = 0; i < levels.length; i++) {
            const r = levelCardRect(i);
            if (clientX >= r.x && clientX <= r.x + r.w && clientY >= r.y && clientY <= r.y + r.h) {
              chooseLevel(i);
              return;
            }
          }
        }
      }


      function drawBossTransformAura() {
        if ((player.bossTransformTimer || 0) <= 0 || game.status !== "playing") return;
        const sx = player.x - world.camX + player.width / 2;
        const sy = player.y + player.height / 2;
        ctx.save();
        const pulse = 1 + Math.sin(world.time * 12) * 0.12;
        const glow = ctx.createRadialGradient(sx, sy, 6, sx, sy, 98 * pulse);
        glow.addColorStop(0, "rgba(255,255,255,.72)");
        glow.addColorStop(0.30, "rgba(255,75,216,.42)");
        glow.addColorStop(1, "rgba(255,75,216,0)");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(sx, sy, 98 * pulse, 0, Math.PI * 2);
        ctx.fill();

        ctx.strokeStyle = "rgba(255,75,216,.90)";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.ellipse(sx, sy, 58 * pulse, 76 * pulse, 0, 0, Math.PI * 2);
        ctx.stroke();

        ctx.fillStyle = "rgba(20,25,35,.70)";
        roundRect(ctx, sx - 54, sy - 102, 108, 24, 12);
        ctx.fill();
        ctx.fillStyle = "#ffbdf0";
        ctx.font = "900 12px system-ui, sans-serif";
        ctx.textAlign = "center";
        ctx.fillText(`TRANS ${Math.ceil(player.bossTransformTimer)}s`, sx, sy - 85);
        ctx.restore();
      }

      function draw() {
        if (game.status === "menu") {
          drawMenu();
          return;
        }

        if (game.status === "level_select") {
          drawLevelSelect();
          return;
        }

        drawBackground();
        drawWorld1TunnelOverlay();
        drawWorld2MazeOverlay();
        drawFlightZoneOverlay();
        drawLevelEntities();
        drawAero();
        drawBossTransformAura();
        drawAllyCompanions();
        drawFloatingTexts();
        drawBossTopBar();
        drawGameMessage();

        if (debug) {
          debugBox.style.display = "block";
          debugBox.textContent =
            `AERO DEBUG\n` +
            `state: ${player.state}\n` +
            `x: ${player.x.toFixed(1)}  y: ${player.y.toFixed(1)}\n` +
            `vx: ${player.vx.toFixed(1)} vy: ${player.vy.toFixed(1)}\n` +
            `grounded: ${player.grounded}\n` +
            `airJumpsLeft: ${player.airJumpsLeft}\n` +
            `invulnerable: ${player.invulnerable.toFixed(2)} atkCd: ${player.attackCooldown.toFixed(2)}\n` +
            `lives: ${game.lives}/${game.maxLives} errors: ${game.errors}/${game.errorsPerLife} stamina: ${game.energy}/${game.maxEnergy} shieldStock: ${game.shields}\n` +
            `orbs: ${game.orbs}/${game.goalOrbs} score: ${game.score}\n` +
            `sparks: ${sparks.length} enemyShots: ${enemyProjectiles.length} blocks: ${solidBlocks.length} platforms: ${movingPlatforms.length}\n` +
            `enemies: ${game.enemiesDefeated}/${game.goalEnemies} boss: ${boss ? boss.state + ":" + boss.hp : "none"} portal: ${portal.active}\n` +
            `status: ${game.status}\n` +
            `floorY: ${world.floorY.toFixed(0)} camX: ${world.camX.toFixed(1)}`;
        } else {
          debugBox.style.display = "none";
        }
      }

      let last = performance.now();
      function loop(now) {
        let dt = (now - last) / 1000;
        last = now;
        dt = Math.min(dt, 1 / 30);
        update(dt);
        draw();
        requestAnimationFrame(loop);
      }


      const audio = {
        ctx: null,
        enabled: false,
        bgmTimer: null,
        step: 0
      };

      function ensureAudio() {
        if (!audio.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (!AudioContext) return null;
          audio.ctx = new AudioContext();
        }
        if (audio.ctx.state === "suspended") audio.ctx.resume();
        return audio.ctx;
      }

      function tone(freq, duration, type = "square", gain = 0.035, slideTo = null) {
        if (!audio.enabled) return;
        const actx = ensureAudio();
        if (!actx) return;

        const osc = actx.createOscillator();
        const vol = actx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, actx.currentTime);
        if (slideTo) osc.frequency.exponentialRampToValueAtTime(Math.max(20, slideTo), actx.currentTime + duration);
        vol.gain.setValueAtTime(gain, actx.currentTime);
        vol.gain.exponentialRampToValueAtTime(0.0001, actx.currentTime + duration);
        osc.connect(vol).connect(actx.destination);
        osc.start();
        osc.stop(actx.currentTime + duration);
      }

      function playSfx(name) {
        if (!audio.enabled) return;
        if (name === "start") {
          tone(220, 0.10, "triangle", 0.04, 440);
          setTimeout(() => tone(440, 0.14, "triangle", 0.035, 880), 95);
        }
        else if (name === "victory") {
          tone(330, 0.12, "triangle", 0.04, 660);
          setTimeout(() => tone(520, 0.14, "triangle", 0.038, 900), 115);
          setTimeout(() => tone(740, 0.18, "triangle", 0.035, 980), 250);
        }
        else if (name === "gameOver") {
          tone(180, 0.18, "sawtooth", 0.045, 90);
          setTimeout(() => tone(110, 0.22, "square", 0.035, 65), 160);
        }
        else if (name === "jump") tone(160, 0.12, "triangle", 0.04, 520);
        else if (name === "doubleJump") tone(220, 0.12, "triangle", 0.038, 720);
        else if (name === "spark") tone(620, 0.08, "sawtooth", 0.03, 180);
        else if (name === "damage") {
          tone(90, 0.12, "square", 0.055, 55);
          setTimeout(() => tone(70, 0.08, "square", 0.04, 45), 70);
        }
        else if (name === "orb") tone(540, 0.1, "triangle", 0.03, 980);
        else if (name === "heal") tone(400, 0.15, "sine", 0.04, 800);
        else if (name === "shieldOn") {
          tone(300, 0.1, "sawtooth", 0.03, 600);
          setTimeout(() => tone(600, 0.2, "sine", 0.02, 600), 90);
        }
        else if (name === "shield") tone(620, 0.06, "sine", 0.02, 620);
        else if (name === "bossAppear") tone(100, 0.4, "sawtooth", 0.06, 50);
        else if (name === "bossHit") tone(150, 0.15, "square", 0.05, 100);
        else if (name === "bossDefeat") {
          tone(180, 0.12, "square", 0.05, 80);
          setTimeout(() => tone(440, 0.16, "triangle", 0.04, 880), 130);
        }
        else if (name === "hit") tone(300, 0.07, "square", 0.028, 160);
        else if (name === "enemy") {
          tone(360, 0.08, "square", 0.035, 160);
          setTimeout(() => tone(620, 0.1, "triangle", 0.03, 920), 80);
        }
        else if (name === "portal") {
          tone(260, 0.13, "triangle", 0.035, 520);
          setTimeout(() => tone(520, 0.13, "triangle", 0.032, 880), 120);
        }
      }

      function startBgm() {
        if (audio.bgmTimer) clearInterval(audio.bgmTimer);
        const notes = [196, 247, 294, 247, 330, 294, 247, 220];
        audio.bgmTimer = setInterval(() => {
          if (!audio.enabled || game.status !== "playing") return;
          const note = notes[audio.step % notes.length];
          audio.step += 1;
          tone(note, 0.09, "square", 0.012, note * 1.01);
        }, 360);
      }

      function stopBgm() {
        if (audio.bgmTimer) clearInterval(audio.bgmTimer);
        audio.bgmTimer = null;
      }

      function toggleSound() {
        audio.enabled = !audio.enabled;
        if (audio.enabled) {
          enableSound();
          if (btnSound) { btnSound.classList.add("soundOn"); btnSound.textContent = "Sonido ✓"; }
          playSfx("orb");
        } else {
          if (btnSound) { btnSound.classList.remove("soundOn"); btnSound.textContent = "Sonido"; }
          stopBgm();
        }
      }

      if (btnDebug) btnDebug.addEventListener("click", () => {
        debug = !debug;
        btnDebug.textContent = debug ? "Ocultar" : "Hitbox";
      });

      if (btnSound) btnSound.addEventListener("click", toggleSound);
      if (btnReset) btnReset.addEventListener("click", () => resetLevel(game.currentLevel || 0));
      if (startGameBtn) startGameBtn.addEventListener("click", startLevelSelect);
      if (restartGameBtn) restartGameBtn.addEventListener("click", () => {
        if (endOverlay) endOverlay.classList.add("hidden");
        enableSound();
        resetLevel(nextLevelIndex || 0);
        playSfx("start");
      });
      if (backToStartBtn) backToStartBtn.addEventListener("click", showStartOverlay);
      if (playerNameInput) {
        playerNameInput.value = playerName;
        playerNameInput.addEventListener("input", () => updatePlayerUi());
        playerNameInput.addEventListener("keydown", (e) => {
          if (e.code === "Enter") { e.preventDefault(); startLevelSelect(); }
        });
      }

      window.addEventListener("keydown", (e) => {
        const tag = (e.target && e.target.tagName || "").toLowerCase();
        if (tag === "input" || tag === "textarea") return;
        if (game.status === "menu" && (e.code === "Enter" || e.code === "Space")) {
          e.preventDefault();
          startLevelSelect();
        }

        if (game.status === "level_select") {
          if (e.code === "KeyQ" || e.code === "ArrowLeft") {
            const chips = loadoutChipRects();
            const ids = chips.map(c => c.id);
            const idx = Math.max(0, ids.indexOf(selectedStartWeaponId));
            setSelectedStartWeapon(ids[(idx - 1 + ids.length) % ids.length], true);
          }
          if (e.code === "KeyE" || e.code === "ArrowRight") {
            const chips = loadoutChipRects();
            const ids = chips.map(c => c.id);
            const idx = Math.max(0, ids.indexOf(selectedStartWeaponId));
            setSelectedStartWeapon(ids[(idx + 1) % ids.length], true);
          }
          if (e.code === "Digit1") chooseLevel(0);
          if (e.code === "Digit2") chooseLevel(1);
          if (e.code === "Digit3") chooseLevel(2);
          if (e.code === "Digit4") chooseLevel(3);
          if (e.code === "Digit5") chooseLevel(4);
          if (e.code === "Enter" || e.code === "Space") chooseLevel(game.currentLevel || 0);
        }
      }, { passive: false });

      canvas.addEventListener("pointerdown", (ev) => {
        handleMenuPointer(ev.clientX, ev.clientY);
      }, { passive: true });

      window.addEventListener("keydown", keyDown, { passive: false });
      window.addEventListener("keyup", keyUp, { passive: false });
      window.addEventListener("resize", resize);

      bindTouchButtons();
      bindGestureControls();
      bindThumbPads();
      initStoryImages();
      resize();
      loadLevel(0);
      resetPlayer();
      updateHud();
      updatePlayerUi();
      showStartOverlay();
      requestAnimationFrame(loop);
    })();
