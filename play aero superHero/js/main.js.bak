      expandCampaignF55();


      function ensureAllyCallPickupsF56() {
        levels.forEach((level, index) => {
          if (!level || !Array.isArray(level.firePickups)) return;
          const hasAlly = level.firePickups.some(item => item.rewardType === "allyCall");
          if (hasAlly) return;
          const px = level.portal ? level.portal.x : (6800 + index * 900);
          level.firePickups.push({
            x: Math.max(900, px - 1150),
            y: index === 2 ? -230 : -190,
            r: 22,
            duration: 10,
            rewardType: "allyCall",
            specialDuration: 10,
            allyDuration: 10,
            overdrive: 5,
            energy: 50,
            score: 300
          });
        });
      }

