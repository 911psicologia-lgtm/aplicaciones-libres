      const AVATAR_STORAGE_KEY = "aero_selected_avatar_v1";
      let selectedAvatarId = localStorage.getItem(AVATAR_STORAGE_KEY) || "classic";
      if (!avatarProfiles[selectedAvatarId]) selectedAvatarId = "classic";

      function activeAvatarProfile() {
        return avatarProfiles[selectedAvatarId] || avatarProfiles.classic;
      }

      function setAvatarForm(id, announce = true) {
        if (!avatarProfiles[id]) id = "classic";
        selectedAvatarId = id;
        try { localStorage.setItem(AVATAR_STORAGE_KEY, id); } catch (_) {}
        avatarButtons.forEach(btn => btn.classList.toggle("active", btn.dataset.avatar === id));
        updatePlayerUi();
        if (announce && game.status === "playing") {
          const profile = activeAvatarProfile();
          setMessage(profile.message, 1.0);
          addFloatingText(player.x + player.width / 2, player.y - 18, profile.short, "#e4c94f");
        }
      }

      function cycleAvatarForm() {
        const ids = Object.keys(avatarProfiles);
        const current = ids.indexOf(selectedAvatarId);
        const next = ids[(current + 1 + ids.length) % ids.length];
        setAvatarForm(next, true);
      }

      function sanitizePlayerName(value) {
        const cleaned = String(value || "").trim().replace(/\s+/g, " ").slice(0, 18);
        return cleaned || "Piloto Aero";
      }

      function savePlayerName(value) {
        playerName = sanitizePlayerName(value);
        try { localStorage.setItem(PLAYER_NAME_KEY, playerName); } catch (_) {}
        updatePlayerUi();
      }

      function saveTotalScore() {
        try { localStorage.setItem(TOTAL_SCORE_KEY, String(Math.max(0, Math.round(totalScore)))); } catch (_) {}
      }


      function parseStoredJson(key, fallback) {
        try {
          const raw = localStorage.getItem(key);
          if (!raw) return fallback;
          const parsed = JSON.parse(raw);
          return parsed === null || parsed === undefined ? fallback : parsed;
        } catch (_) {
          return fallback;
        }
      }

      function weaponLabelById(id) {
        const map = { spark: "Pulso", triple: "Triple", laser: "Láser", grenade: "Granadas", rocket: "Cohetes" };
        return map[id] || id || "Pulso";
      }

      function weaponIconById(id) {
        const map = { spark: "•", triple: "✦", laser: "━", grenade: "●", rocket: "⌁" };
        return map[id] || "•";
      }

      function getStartWeaponCharge(id) {
        if (id === "spark") return Infinity;
        return Math.max(0, Number(startWeaponCharges[id] || 0) || 0);
      }

      function normalizeStartWeaponState() {
        startWeaponUnlocks = Array.isArray(startWeaponUnlocks) ? startWeaponUnlocks : ["spark"];
        startWeaponUnlocks = Array.from(new Set(["spark", ...startWeaponUnlocks.filter(Boolean)]));
        startWeaponCharges = startWeaponCharges && typeof startWeaponCharges === "object" ? startWeaponCharges : {};
        if (!startWeaponUnlocks.includes(selectedStartWeaponId)) selectedStartWeaponId = "spark";
        if (selectedStartWeaponId !== "spark" && getStartWeaponCharge(selectedStartWeaponId) <= 0) selectedStartWeaponId = "spark";
      }

      function loadStartWeaponState() {
        const unlocks = parseStoredJson(START_WEAPON_UNLOCKS_KEY, ["spark"]);
        const charges = parseStoredJson(START_WEAPON_CHARGES_KEY, {});
        startWeaponUnlocks = Array.isArray(unlocks) ? unlocks : ["spark"];
        startWeaponCharges = charges && typeof charges === "object" ? charges : {};
        selectedStartWeaponId = localStorage.getItem(START_WEAPON_SELECTED_KEY) || "spark";
        normalizeStartWeaponState();
      }

      function saveStartWeaponState() {
        normalizeStartWeaponState();
        try { localStorage.setItem(START_WEAPON_UNLOCKS_KEY, JSON.stringify(startWeaponUnlocks)); } catch (_) {}
        try { localStorage.setItem(START_WEAPON_CHARGES_KEY, JSON.stringify(startWeaponCharges)); } catch (_) {}
        try { localStorage.setItem(START_WEAPON_SELECTED_KEY, selectedStartWeaponId); } catch (_) {}
      }

      function setSelectedStartWeapon(id, announce = false) {
        loadStartWeaponState();
        if (id !== "spark" && !startWeaponUnlocks.includes(id)) return false;
        if (id !== "spark" && getStartWeaponCharge(id) <= 0) return false;
        selectedStartWeaponId = id || "spark";
        saveStartWeaponState();
        if (announce) {
          const countText = selectedStartWeaponId === "spark" ? "base" : `x${getStartWeaponCharge(selectedStartWeaponId)}`;
          setMessage(`Inicio: ${weaponIconById(selectedStartWeaponId)} ${weaponLabelById(selectedStartWeaponId)} · ${countText}`, 0.9);
          playSfx("orb");
        }
        return true;
      }

      function unlockStartWeapon(id, amount = 1, source = "") {
        loadStartWeaponState();
        if (!id || id === "spark") return;
        if (!startWeaponUnlocks.includes(id)) startWeaponUnlocks.push(id);
        startWeaponCharges[id] = getStartWeaponCharge(id) + Math.max(1, amount || 1);
        lastGrantedStartReward = { id, amount: Math.max(1, amount || 1), source };
        saveStartWeaponState();
      }

      function getWorldStartReward(levelIndex = game.currentLevel || 0) {
        const rewards = [
          { id: "triple", amount: 2, title: "Carga Triple" },
          { id: "grenade", amount: 2, title: "Caja de Granadas" },
          { id: "laser", amount: 2, title: "Batería Láser" },
          { id: "rocket", amount: 2, title: "Rack de Cohetes" },
          { id: "triple", amount: 3, title: "Arsenal Aurora" }
        ];
        return rewards[levelIndex] || rewards[0];
      }

      function grantWorldCompletionStartReward(levelIndex = game.currentLevel || 0) {
        const reward = getWorldStartReward(levelIndex);
        if (!reward) return null;
        unlockStartWeapon(reward.id, reward.amount || 1, `Mundo ${levelIndex + 1}`);
        return reward;
      }

      function applySelectedStartWeaponBonus() {
        loadStartWeaponState();
        setWeaponModeById("spark", false);
        player.specialWeaponTimer = 0;
        player.specialWeaponRestorePending = false;
        if (!selectedStartWeaponId || selectedStartWeaponId === "spark") return;
        const charges = getStartWeaponCharge(selectedStartWeaponId);
        if (charges <= 0) {
          selectedStartWeaponId = "spark";
          saveStartWeaponState();
          return;
        }
        startWeaponCharges[selectedStartWeaponId] = Math.max(0, charges - 1);
        saveStartWeaponState();
        setWeaponModeById(selectedStartWeaponId, false);
        player.specialWeaponTimer = 13.0;
        player.specialWeaponRestorePending = true;
        player.overdriveTimer = Math.max(player.overdriveTimer, 4.5);
        player.fireBoostTimer = Math.max(player.fireBoostTimer, 6.5);
        addFloatingText(player.x + player.width / 2, player.y - 22, `INICIO ${weaponLabelById(selectedStartWeaponId).toUpperCase()}`, "#fff0a8");
        setMessage(`Carga de inicio: ${weaponLabelById(selectedStartWeaponId)} · 13s`, 1.1);
      }

      loadStartWeaponState();

      function updatePlayerUi() {
        const profile = activeAvatarProfile();
        if (playerNameText) playerNameText.textContent = playerName;
        if (totalScoreText) totalScoreText.textContent = String(Math.round(totalScore));
        if (overlayTotalScore) overlayTotalScore.textContent = String(Math.round(totalScore));
        if (overlayAvatarName) overlayAvatarName.textContent = profile.short || profile.label || "Aero";
        if (playerNameInput && document.activeElement !== playerNameInput) playerNameInput.value = playerName;
      }

      function hideStartOverlay() {
        if (startOverlay) startOverlay.classList.add("hidden");
      }

      function showStartOverlay() {
        if (endOverlay) endOverlay.classList.add("hidden");
        setWorldRewardSummary(false);
        if (startOverlay) startOverlay.classList.remove("hidden");
        game.status = "menu";
        updatePlayerUi();
        setTimeout(() => { if (playerNameInput) playerNameInput.focus(); }, 40);
      }

      function enableSound() {
        audio.enabled = true;
        const actx = ensureAudio();
        if (actx && actx.state === "suspended") actx.resume();
        startBgm();
      }

      function startMission(levelIndex = 0) {
        savePlayerName(playerNameInput ? playerNameInput.value : playerName);
        hideStartOverlay();
        if (endOverlay) endOverlay.classList.add("hidden");
        enableSound();
        resetLevel(levelIndex);
        playSfx("start");
      }


      function setImgSrc(el, src) {
        if (!el) return;
        if (src) {
          el.src = src;
          el.classList.remove("hidden");
        } else {
          el.removeAttribute("src");
          el.classList.add("hidden");
        }
      }

      function setWorldRewardSummary(won) {
        const reward = (window.AERO_STORY_REWARDS && window.AERO_STORY_REWARDS[currentWorldId()]) || null;
        if (!won || !reward) {
          if (storyRewardPanel) storyRewardPanel.classList.add("hidden");
          if (escapeMiniPanel) escapeMiniPanel.classList.add("hidden");
          if (endSceneStrip) endSceneStrip.classList.add("hidden");
          setImgSrc(endRewardPiece, "");
          setImgSrc(endLanzaProgress, "");
          setImgSrc(endEscapeShip, "");
          if (endCutsceneCtx && endCutsceneCanvas) endCutsceneCtx.clearRect(0, 0, endCutsceneCanvas.width, endCutsceneCanvas.height);
          return;
        }

        if (storyRewardPanel) storyRewardPanel.classList.remove("hidden");
        if (escapeMiniPanel) escapeMiniPanel.classList.remove("hidden");
        if (endRewardTitle) endRewardTitle.textContent = reward.title || "Pieza obtenida";
        if (endRewardSubtitle) endRewardSubtitle.textContent = reward.subtitle || "Lanza Aurora";
        if (endEscapeText) endEscapeText.textContent = reward.escapeText || "Doctor Sombra escapó con Aurora";

        setImgSrc(endRewardPiece, reward.reward || reward.piece);
        setImgSrc(endLanzaProgress, reward.assembled);
        const shipForSummary = getShipManifest(reward.world || currentWorldId());
        setImgSrc(endEscapeShip, (shipForSummary && shipForSummary.mini) || reward.shipMini);
        const cutsceneDrawn = drawEndCutscene(reward.world || currentWorldId());
        if (endSceneStrip) endSceneStrip.classList.toggle("hidden", !cutsceneDrawn);
      }

      function showEndOverlay(outcome) {
        if (!endOverlay) return;
        const won = outcome === "won";
        const worldNum = (game.currentLevel || 0) + 1;
        const reward = window.AERO_STORY_REWARDS && window.AERO_STORY_REWARDS[currentWorldId()];
        nextLevelIndex = won ? Math.min(levels.length - 1, (game.currentLevel || 0) + 1) : (game.currentLevel || 0);

        endKicker.textContent = won ? "Mundo completado" : "Fin";
        endTitle.textContent = won ? `Mundo ${worldNum}` : "Intento fallido";
        const carryText = won && lastGrantedStartReward
          ? ` Premio adicional: ${weaponLabelById(lastGrantedStartReward.id)} x${lastGrantedStartReward.amount} para el siguiente mundo.`
          : "";
        endMessage.textContent = won
          ? `Pieza ${reward ? reward.pieceNumber : worldNum}/5 obtenida. Aurora sigue en fuga.${carryText}`
          : "Aero cayó. Conservas tus puntos.";
        if (restartGameBtn) restartGameBtn.textContent = won && nextLevelIndex !== game.currentLevel ? `Mundo ${nextLevelIndex + 1}` : "Reintentar";
        if (endPlayerName) endPlayerName.textContent = playerName;
        endRunScore.textContent = String(Math.round(game.score));
        endTotalScore.textContent = String(Math.round(totalScore));
        setWorldRewardSummary(won);
        endOverlay.classList.remove("hidden");
      }

      function finishRun(outcome) {
        if (runScoreRecorded) return;
        runScoreRecorded = true;
        if (outcome === "won") {
          const weaponReward = grantWorldCompletionStartReward(game.currentLevel || 0);
          if (weaponReward) {
            game.score += 140 + (weaponReward.amount || 1) * 40;
            game.shields = Math.min(game.maxShields, game.shields + 1);
          }
        } else {
          lastGrantedStartReward = null;
        }
        totalScore += Math.max(0, Math.round(game.score));
        saveTotalScore();
        updatePlayerUi();
        stopBgm();
        playSfx(outcome === "won" ? "victory" : "gameOver");
        setTimeout(() => showEndOverlay(outcome), 260);
      }

      avatarButtons.forEach(btn => {
        btn.addEventListener("click", (ev) => {
          ev.stopPropagation();
          setAvatarForm(btn.dataset.avatar, true);
        });
      });
      if (avatarPanel) {
        avatarPanel.addEventListener("click", (ev) => {
          ev.preventDefault();
          cycleAvatarForm();
        });
      }
      setAvatarForm(selectedAvatarId, false);

      const keys = {
        left: false,
        right: false,
        down: false,
        jump: false,
        attack: false,
        dash: false,
        shield: false
      };

      const pressedOnce = {
        jump: false,
        attack: false,
        dash: false,
        shield: false
      };

      const inputTap = {
        leftTime: -1,
        rightTime: -1,
        threshold: 0.28
      };

      const touchControl = {
        enabled: (window.matchMedia && window.matchMedia("(pointer: coarse)").matches) || (navigator.maxTouchPoints || 0) > 0,
        autoFire: true,
        pointerId: null,
        startX: 0,
        startY: 0,
        lastX: 0,
        lastY: 0,
        lastTapTime: -1,
        lastTapX: 0,
        lastTapY: 0,
        horizontalDir: 0,
        upTriggered: false,
        downActive: false,
        deadZone: 18,
        jumpTimer: null,
        hintTimer: 0,
        leftPadPointerId: null,
        rightPadPointerId: null,
        leftPadStartX: 0,
        leftPadStartY: 0,
        rightPadStartX: 0,
        rightPadStartY: 0,
        rightPadDir: 0
      };

      function setTouchMode(active = true) {
        touchControl.enabled = true;
        document.body.classList.add("touch-mode");
        updateTouchFireButton();
      }

      function updateTouchFireButton() {
        if (!touchFireToggle) return;
        touchFireToggle.textContent = touchControl.autoFire ? "⚡ Auto ON" : "⚡ Auto OFF";
        touchFireToggle.classList.toggle("off", !touchControl.autoFire);
        touchFireToggle.classList.toggle("active", touchControl.autoFire);
      }

      function pulseTouchJump() {
        handleUpTap();
        if (!keys.jump) pressedOnce.jump = true;
        keys.jump = true;
        if (touchControl.jumpTimer) clearTimeout(touchControl.jumpTimer);
        touchControl.jumpTimer = setTimeout(() => {
          keys.jump = false;
          touchControl.jumpTimer = null;
        }, 145);
      }

      function clearTouchMovement() {
        keys.left = false;
        keys.right = false;
        keys.down = false;
        touchControl.horizontalDir = 0;
        touchControl.downActive = false;
        touchControl.upTriggered = false;
      }

      function applyTouchDrag(clientX, clientY) {
        const dx = clientX - touchControl.startX;
        const dy = clientY - touchControl.startY;
        const absX = Math.abs(dx);
        const absY = Math.abs(dy);
        const horizontalThreshold = Math.max(touchControl.deadZone, Math.min(52, W * 0.045));
        const verticalThreshold = Math.max(30, Math.min(62, H * 0.12));

        let dir = 0;
        if (absX > horizontalThreshold && absX > absY * 0.55) dir = dx > 0 ? 1 : -1;
        if (dir !== touchControl.horizontalDir) {
          if (dir < 0) handleDirectionTap(-1);
          if (dir > 0) handleDirectionTap(1);
          touchControl.horizontalDir = dir;
        }
        keys.left = dir < 0;
        keys.right = dir > 0;
        if (dir !== 0) player.dir = dir;

        const wantsDown = dy > verticalThreshold && absY > absX * 0.65;
        keys.down = wantsDown;
        touchControl.downActive = wantsDown;

        if (dy < -verticalThreshold && absY > absX * 0.55 && !touchControl.upTriggered) {
          pulseTouchJump();
          touchControl.upTriggered = true;
        }
        if (dy > -verticalThreshold * 0.36) touchControl.upTriggered = false;
      }

      function bindGestureControls() {
        if (touchControl.enabled) setTouchMode(true);
        updateTouchFireButton();

        if (touchFireToggle) {
          touchFireToggle.addEventListener("pointerdown", (ev) => {
            ev.preventDefault();
            ev.stopPropagation();
            setTouchMode(true);
            touchControl.autoFire = !touchControl.autoFire;
            if (!touchControl.autoFire) {
              player.chargeTimer = 0;
              player.chargeFired = false;
            }
            updateTouchFireButton();
          }, { passive: false });
        }

        canvas.addEventListener("pointerdown", (ev) => {
          if (ev.pointerType !== "touch") return;
          ev.preventDefault();
          setTouchMode(true);
          touchControl.pointerId = ev.pointerId;
          touchControl.startX = touchControl.lastX = ev.clientX;
          touchControl.startY = touchControl.lastY = ev.clientY;
          touchControl.upTriggered = false;
          touchControl.downActive = false;
          if (canvas.setPointerCapture) {
            try { canvas.setPointerCapture(ev.pointerId); } catch (_) {}
          }

          const now = performance.now();
          const dtTap = now - touchControl.lastTapTime;
          const distTap = Math.hypot(ev.clientX - touchControl.lastTapX, ev.clientY - touchControl.lastTapY);
          if (dtTap > 0 && dtTap < 330 && distTap < 54) {
            pulseTouchJump();
            touchControl.lastTapTime = -1;
          } else {
            touchControl.lastTapTime = now;
            touchControl.lastTapX = ev.clientX;
            touchControl.lastTapY = ev.clientY;
          }
        }, { passive: false });

        canvas.addEventListener("pointermove", (ev) => {
          if (ev.pointerType !== "touch" || ev.pointerId !== touchControl.pointerId) return;
          ev.preventDefault();
          touchControl.lastX = ev.clientX;
          touchControl.lastY = ev.clientY;
          applyTouchDrag(ev.clientX, ev.clientY);
        }, { passive: false });

        const endTouch = (ev) => {
          if (ev.pointerType !== "touch" || ev.pointerId !== touchControl.pointerId) return;
          ev.preventDefault();
          clearTouchMovement();
          touchControl.pointerId = null;
          if (canvas.releasePointerCapture) {
            try { canvas.releasePointerCapture(ev.pointerId); } catch (_) {}
          }
        };
        canvas.addEventListener("pointerup", endTouch, { passive: false });
        canvas.addEventListener("pointercancel", endTouch, { passive: false });
        canvas.addEventListener("lostpointercapture", endTouch, { passive: false });
      }

      function setPadKnob(knob, dx, dy) {
        if (!knob) return;
        const max = 24;
        const len = Math.max(1, Math.hypot(dx, dy));
        const k = Math.min(max, len) / len;
        knob.style.transform = `translate(${dx * k}px, ${dy * k}px)`;
      }

      function resetPadKnob(knob) {
        if (knob) knob.style.transform = "translate(0,0)";
      }

      function bindThumbPads() {
        const releaseLeft = () => {
          touchControl.leftPadPointerId = null;
          keys.down = false;
          resetPadKnob(leftPadKnob);
          if (leftPad) leftPad.classList.remove("active");
        };

        const releaseRight = () => {
          touchControl.rightPadPointerId = null;
          keys.right = false;
          keys.left = false;
          keys.dash = false;
          touchControl.rightPadDir = 0;
          resetPadKnob(rightPadKnob);
          if (rightPad) rightPad.classList.remove("active");
        };

        if (leftPad) {
          leftPad.addEventListener("pointerdown", (ev) => {
            if (ev.pointerType !== "touch" && ev.pointerType !== "pen") return;
            ev.preventDefault();
            ev.stopPropagation();
            setTouchMode(true);
            touchControl.leftPadPointerId = ev.pointerId;
            touchControl.leftPadStartX = ev.clientX;
            touchControl.leftPadStartY = ev.clientY;
            touchControl.upTriggered = false;
            if (leftPad.setPointerCapture) {
              try { leftPad.setPointerCapture(ev.pointerId); } catch (_) {}
            }
            leftPad.classList.add("active");
          }, { passive: false });

          leftPad.addEventListener("pointermove", (ev) => {
            if (ev.pointerId !== touchControl.leftPadPointerId) return;
            ev.preventDefault();
            ev.stopPropagation();
            const dx = ev.clientX - touchControl.leftPadStartX;
            const dy = ev.clientY - touchControl.leftPadStartY;
            setPadKnob(leftPadKnob, dx, dy);

            const verticalThreshold = Math.max(18, Math.min(42, H * 0.08));
            if (dy < -verticalThreshold && !touchControl.upTriggered) {
              pulseTouchJump();
              touchControl.upTriggered = true;
            }
            if (dy > -verticalThreshold * 0.25) touchControl.upTriggered = false;

            keys.down = dy > verticalThreshold;
          }, { passive: false });

          ["pointerup", "pointercancel", "lostpointercapture"].forEach(type => {
            leftPad.addEventListener(type, (ev) => {
              if (ev.pointerId !== touchControl.leftPadPointerId) return;
              ev.preventDefault();
              ev.stopPropagation();
              releaseLeft();
            }, { passive: false });
          });
        }

        if (rightPad) {
          rightPad.addEventListener("pointerdown", (ev) => {
            if (ev.pointerType !== "touch" && ev.pointerType !== "pen") return;
            ev.preventDefault();
            ev.stopPropagation();
            setTouchMode(true);
            touchControl.rightPadPointerId = ev.pointerId;
            touchControl.rightPadStartX = ev.clientX;
            touchControl.rightPadStartY = ev.clientY;
            touchControl.rightPadDir = 1;
            keys.right = true;
            keys.left = false;
            keys.dash = true;
            pressedOnce.dash = true;
            if (!keys.attack) pressedOnce.attack = true;
            keys.attack = true;
            player.dir = 1;
            if (rightPad.setPointerCapture) {
              try { rightPad.setPointerCapture(ev.pointerId); } catch (_) {}
            }
            rightPad.classList.add("active");
            setPadKnob(rightPadKnob, 18, 0);
          }, { passive: false });

          rightPad.addEventListener("pointermove", (ev) => {
            if (ev.pointerId !== touchControl.rightPadPointerId) return;
            ev.preventDefault();
            ev.stopPropagation();
            const dx = ev.clientX - touchControl.rightPadStartX;
            const dy = ev.clientY - touchControl.rightPadStartY;
            setPadKnob(rightPadKnob, dx || 18, dy);

            const horizontalThreshold = Math.max(18, Math.min(48, W * 0.045));
            let dir = 1;
            if (Math.abs(dx) > horizontalThreshold) dir = dx < 0 ? -1 : 1;
            touchControl.rightPadDir = dir;
            keys.right = dir > 0;
            keys.left = dir < 0;
            keys.dash = true;
            keys.attack = true;
            player.dir = dir;

            if (dy < -Math.max(24, H * 0.07) && !touchControl.upTriggered) {
              pulseTouchJump();
              touchControl.upTriggered = true;
            }
            if (dy > -Math.max(10, H * 0.03)) touchControl.upTriggered = false;
          }, { passive: false });

          ["pointerup", "pointercancel", "lostpointercapture"].forEach(type => {
            rightPad.addEventListener(type, (ev) => {
              if (ev.pointerId !== touchControl.rightPadPointerId) return;
              ev.preventDefault();
              ev.stopPropagation();
              keys.attack = false;
              releaseRight();
            }, { passive: false });
          });
        }

        window.addEventListener("blur", () => {
          releaseLeft();
          releaseRight();
          resetPadKnob(leftPadKnob);
          resetPadKnob(rightPadKnob);
        });
      }




      const world = {
        floorY: 0,
        camX: 0,
        time: 0,
        shake: 0
      };

      const game = {
        currentLevel: 0,
        levelName: "Mundo 1 · El Umbral de las Sombras",
        maxLives: 3,
        lives: 3,
        errors: 0,
        errorsPerLife: 10,
        maxEnergy: 100,
        energy: 100,
        shields: 0,
        maxShields: 3,
        nextShieldScore: 300,
        shieldScoreStep: 300,
        nextPowerupScore: 650,
        powerupScoreStep: 850,
        orbs: 0,
        goalOrbs: 5,
        enemiesDefeated: 0,
        goalEnemies: 6,
        bossDefeated: false,
        score: 0,
        status: "menu",
        statusMessage: "",
        messageTimer: 0,
        flightMode: false,
        flightZoneId: null,
        burrowMode: false
      };

      const obstacles = [];
      const solidBlocks = [];
      const breakableBlocks = [];
      const movingPlatforms = [];
      const enemies = [];
      const sparks = [];
      const orbs = [];
      const energyPickups = [];
      const shieldPickups = [];
      const flowOrbs = [];
      const firePickups = [];
      const floorFlames = [];
      const airFlames = [];
      const risingStairs = [];
      const upperTimedPlatforms = [];
      const fallingPlatforms = [];
      const warpTubes = [];
      const enemyProjectiles = [];
      const bossHelpers = [];
      const bossClones = [];
      const escapeBosses = [];
      const rescueCages = [];
      const mudPits = [];
      const pendulums = [];
      const particles = [];
      const aeroTrail = [];
      const floatingTexts = [];

      const portal = { x: 2215, y: -122, w: 56, h: 104, active: false };
      let boss = null;

      const storyScene = {
        active: false,
        timer: 0,
        shipX: 0,
        shipY: 0,
        rewardX: 0,
        rewardY: 0
      };

      const storyImages = {};

      function loadStoryImage(id, src) {
        if (!src || storyImages[id]) return storyImages[id] || null;
        const img = new Image();
        const record = { id, src, img, ready: false };
        img.onload = () => { record.ready = true; };
        img.onerror = () => { record.ready = false; console.warn("No cargó story asset", id, src); };
        img.src = src;
        storyImages[id] = record;
        return record;
      }

      const STORY_MANIFEST_PATHS = {
        ships: "assets/story_core/manifests/story_ships_manifest.json",
        cutscenes: "assets/story_core/manifests/story_cutscenes_manifest.json",
        parts: "assets/story_core/manifests/ship_parts_manifest.json"
      };

      const storyAssetStore = {
        ready: false,
        loading: false,
        error: null,
        manifests: {
          ships: [],
          cutscenes: [],
          parts: []
        },
        images: new Map(),
        failed: []
      };

      function normalizeAssetPath(path) {
        if (!path || typeof path !== "string") return "";
        if (/^(https?:|data:|blob:)/i.test(path)) return path;
        return path.replace(/^\.?\//, "");
      }

      async function fetchManifest(path, fallback) {
        const normalized = normalizeAssetPath(path);
        try {
          if (location.protocol === "file:") throw new Error("file protocol fallback");
          const res = await fetch(normalized, { cache: "no-store" });
          if (!res.ok) throw new Error(`${res.status} ${normalized}`);
          return await res.json();
        } catch (err) {
          console.warn("Manifest fallback", normalized, err.message);
          return fallback || [];
        }
      }

      function collectAssetPaths(value, out = new Set()) {
        if (!value) return out;
        if (typeof value === "string") {
          const p = normalizeAssetPath(value);
          if (/\.(png|jpg|jpeg|webp|gif)$/i.test(p)) out.add(p);
          return out;
        }
        if (Array.isArray(value)) {
          value.forEach(item => collectAssetPaths(item, out));
          return out;
        }
        if (typeof value === "object") {
          Object.values(value).forEach(item => collectAssetPaths(item, out));
        }
        return out;
      }

      function loadStoryImageAsset(src) {
        const normalized = normalizeAssetPath(src);
        if (!normalized) return Promise.resolve(null);
        if (storyAssetStore.images.has(normalized)) {
          const cached = storyAssetStore.images.get(normalized);
          return cached.promise || Promise.resolve(cached);
        }

        const img = new Image();
        const record = { src: normalized, img, ready: false, failed: false };
        const promise = new Promise(resolve => {
          img.onload = () => {
            record.ready = true;
            record.failed = false;
            resolve(record);
          };
          img.onerror = () => {
            record.ready = false;
            record.failed = true;
            storyAssetStore.failed.push(normalized);
            console.warn("No cargó story image", normalized);
            resolve(record);
          };
        });
        record.promise = promise;
        storyAssetStore.images.set(normalized, record);
        img.src = normalized;
        return promise;
      }

      async function preloadStoryAssets() {
        if (storyAssetStore.loading || storyAssetStore.ready) return storyAssetStore;
        storyAssetStore.loading = true;

        const fallbackShips = window.AERO_STORY_SHIPS_MANIFEST || [];
        const fallbackCutscenes = window.AERO_STORY_CUTSCENES_MANIFEST || [];
        const fallbackParts = window.AERO_STORY_SHIP_PARTS_MANIFEST || [];

        const [shipsManifest, cutscenesManifest, partsManifest] = await Promise.all([
          fetchManifest(STORY_MANIFEST_PATHS.ships, fallbackShips),
          fetchManifest(STORY_MANIFEST_PATHS.cutscenes, fallbackCutscenes),
          fetchManifest(STORY_MANIFEST_PATHS.parts, fallbackParts)
        ]);

        storyAssetStore.manifests.ships = Array.isArray(shipsManifest) ? shipsManifest : [];
        storyAssetStore.manifests.cutscenes = Array.isArray(cutscenesManifest) ? cutscenesManifest : [];
        storyAssetStore.manifests.parts = Array.isArray(partsManifest) ? partsManifest : [];

        const paths = new Set();
        collectAssetPaths(storyAssetStore.manifests.ships, paths);
        collectAssetPaths(storyAssetStore.manifests.cutscenes, paths);
        collectAssetPaths(storyAssetStore.manifests.parts, paths);

        await Promise.all([...paths].map(loadStoryImageAsset));

        storyAssetStore.ready = true;
        storyAssetStore.loading = false;
        console.info(`Story assets listos: ${storyAssetStore.images.size} imágenes, fallidas: ${storyAssetStore.failed.length}`);
        drawEndCutscene(currentWorldId());
        return storyAssetStore;
      }

      function currentWorldId() {
        return `world_${(game.currentLevel || 0) + 1}`;
      }

      function getStoryImage(src) {
        const normalized = normalizeAssetPath(src);
        if (!normalized) return null;
        const record = storyAssetStore.images.get(normalized);
        return record && record.ready ? record.img : null;
      }

      function getShipManifest(worldId = currentWorldId()) {
        return storyAssetStore.manifests.ships.find(item => item.world === worldId) || null;
      }

      function getCutsceneManifest(worldId = currentWorldId()) {
        return storyAssetStore.manifests.cutscenes.find(item => item.world === worldId) || null;
      }

      function shipImagePathByState(ship, state = "full") {
        if (!ship) return "";
        if (state === "critical") return ship.critical || ship.damaged_stage_2 || ship.damaged_stage_1 || ship.damaged || ship.image;
        if (state === "damaged2") return ship.damaged_stage_2 || ship.damaged || ship.image;
        if (state === "damaged1") return ship.damaged_stage_1 || ship.damaged || ship.image;
        if (state === "damaged") return ship.damaged || ship.damaged_stage_1 || ship.image;
        if (state === "mini") return ship.mini || ship.image;
        return ship.image;
      }

      function shipDamageStateFromBoss() {
        if (!boss) return "full";
        if (game.bossDefeated || boss.defeated || boss.hp <= 0) return "damaged";
        const ratio = boss.maxHp ? boss.hp / boss.maxHp : 1;
        if (ratio <= 0.18) return "critical";
        if (ratio <= 0.42) return "damaged2";
        if (ratio <= 0.70) return "damaged1";
        return "full";
      }

      function getShipImageForWorld(worldId = currentWorldId(), state = shipDamageStateFromBoss()) {
        const ship = getShipManifest(worldId);
        const src = shipImagePathByState(ship, state);
        return { ship, src, img: getStoryImage(src) };
      }

      function drawImageCoverToCanvas(ctx2, img, w, h) {
        if (!ctx2 || !img) return;
        const iw = img.naturalWidth || img.width;
        const ih = img.naturalHeight || img.height;
        if (!iw || !ih) return;
        const scale = Math.max(w / iw, h / ih);
        const dw = iw * scale;
        const dh = ih * scale;
        ctx2.drawImage(img, (w - dw) / 2, (h - dh) / 2, dw, dh);
      }

      function drawEndCutscene(worldId = currentWorldId()) {
        if (!endCutsceneCanvas || !endCutsceneCtx) return false;
        const cutscene = getCutsceneManifest(worldId);
        if (!cutscene || !cutscene.layers) return false;

        const cw = endCutsceneCanvas.width;
        const ch = endCutsceneCanvas.height;
        endCutsceneCtx.clearRect(0, 0, cw, ch);

        const layers = cutscene.layers;
        const orderedPaths = [
          layers.background,
          layers.trail,
          layers.energy,
          layers.lightning,
          layers.ship,
          layers.aurora
        ].filter(Boolean);

        let drew = false;
        for (const src of orderedPaths) {
          const img = getStoryImage(src);
          if (!img) continue;
          drawImageCoverToCanvas(endCutsceneCtx, img, cw, ch);
          drew = true;
        }
        return drew;
      }

      function initStoryImages() {
        preloadStoryAssets().then(() => {
          drawEndCutscene(currentWorldId());
        });
      }


      function levelEndX() {
        return Math.max(portal.x + 520, boss ? boss.maxX + 520 : 2700);
      }

      const sparkConfig = {
        speed: 760,
        cooldown: 0.18,
        maxOnScreen: 22,
        life: 0.95,
        baseDamage: 1,
        energyDropChance: 0.30,
        energyDropAmount: 20
      };

      const weaponModes = [
        { id: "spark", label: "Pulso", icon: "•", cooldown: 0.22 },
        { id: "triple", label: "Triple", icon: "✦", cooldown: 0.20 },
        { id: "laser", label: "Láser", icon: "━", cooldown: 0.26 },
        { id: "grenade", label: "Granadas", icon: "●", cooldown: 0.52 },
        { id: "rocket", label: "Cohetes térmicos", icon: "⌁", cooldown: 0.62 }
      ];
      let currentWeaponIndex = 0;

      function currentWeapon() {
        return weaponModes[currentWeaponIndex] || weaponModes[0];
      }

      function setWeaponModeById(id, announce = true) {
        const idx = weaponModes.findIndex(w => w.id === id);
        if (idx < 0) return false;
        currentWeaponIndex = idx;
        if (announce) {
          const weapon = currentWeapon();
          setMessage(`Poder equipado: ${weapon.icon} ${weapon.label}`, 1.0);
          addFloatingText(player.x + player.width / 2, player.y - 28, weapon.label.toUpperCase(), "#e4c94f");
          playSfx("portal");
        }
        updateHud();
        return true;
      }

      function cycleWeapon(delta = 1) {
        currentWeaponIndex = (currentWeaponIndex + delta + weaponModes.length) % weaponModes.length;
        const weapon = currentWeapon();
        setMessage(`Poder: ${weapon.icon} ${weapon.label}`, 0.9);
        addFloatingText(player.x + player.width / 2, player.y - 28, weapon.label.toUpperCase(), "#e4c94f");
        playSfx("orb");
        updateHud();
      }

