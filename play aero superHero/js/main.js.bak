      const worldBackgroundManifests = window.AERO_WORLD_BACKGROUNDS_2_5 || {};
      const backgroundLayerCache = new Map();
      const levelBackgroundRoutes = {
        1: {
          worldId: "world_2",
          segments: [
            { start: 0, end: 980, zoneId: "zone_01" },
            { start: 980, end: 1820, zoneId: "zone_02" },
