      };

      function getLevelBackgroundConfig(levelIndex = game.currentLevel) {
        return levelBackgroundRoutes[levelIndex] || null;
      }

      function getBackgroundZoneManifest(worldId, zoneId) {
        const list = worldBackgroundManifests[worldId] || [];
        return list.find(item => item.zoneId === zoneId) || null;
      }

      function getActiveBackgroundZone(config, positionX = player.x) {
        if (!config || !Array.isArray(config.segments)) return null;
        return config.segments.find(seg => positionX >= seg.start && positionX < seg.end) || config.segments[config.segments.length - 1] || null;
      }

      function ensureBackgroundLayer(src) {
        if (!src) return null;
        if (backgroundLayerCache.has(src)) return backgroundLayerCache.get(src);
        const img = new Image();
        const record = { img, ready: false, error: false, src };
        img.onload = () => record.ready = true;
        img.onerror = () => record.error = true;
        img.src = src;
        backgroundLayerCache.set(src, record);
        return record;
      }

      function drawBackgroundLayerRecord(record, parallax = 0.1, alpha = 1, yBias = 0, scaleBoost = 1.02) {
        if (!record || !record.ready || !record.img) return false;
        const img = record.img;
        const baseScale = Math.max(W / img.width, H / img.height) * scaleBoost;
        const drawW = img.width * baseScale;
        const drawH = img.height * baseScale;
        const minY = H - drawH + yBias;
        const overflow = Math.max(0, drawW - W);
        const drift = overflow > 0 ? ((world.camX * parallax) % overflow) : 0;
        let drawX = -drift;
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.drawImage(img, drawX, minY, drawW, drawH);
        while (drawX + drawW < W) {
          drawX += drawW;
          ctx.drawImage(img, drawX, minY, drawW, drawH);
        }
        if (drawX > 0) {
          ctx.drawImage(img, drawX - drawW, minY, drawW, drawH);
        }
        ctx.restore();
        return true;
      }

      function drawManifestWorldBackground(config) {
        const activeSegment = getActiveBackgroundZone(config, player.x);
        if (!activeSegment) return false;
        const manifest = getBackgroundZoneManifest(config.worldId, activeSegment.zoneId);
        if (!manifest || !manifest.files) return false;

        const far = ensureBackgroundLayer(manifest.files.bg_far);
        const mid = ensureBackgroundLayer(manifest.files.bg_mid);
        const near = ensureBackgroundLayer(manifest.files.bg_near);
        const fx = ensureBackgroundLayer(manifest.files.bg_foreground_fx);
        const ground = ensureBackgroundLayer(manifest.files.ground_overlay);
        const smoke = ensureBackgroundLayer(manifest.files.smoke_layer || manifest.files.fog_layer || manifest.files.ambient_overlay);
        const glow = ensureBackgroundLayer(manifest.files.light_glow_layer);

        let drawn = false;
        ctx.clearRect(0, 0, W, H);
        drawn = drawBackgroundLayerRecord(far, 0.04, 1, -10, 1.04) || drawn;
        drawn = drawBackgroundLayerRecord(mid, 0.10, 1, 0, 1.04) || drawn;
        if (smoke) drawn = drawBackgroundLayerRecord(smoke, 0.07, 0.72, 0, 1.05) || drawn;
        drawn = drawBackgroundLayerRecord(near, 0.20, 1, 8, 1.05) || drawn;
        if (glow) drawn = drawBackgroundLayerRecord(glow, 0.03, 0.85, 0, 1.03) || drawn;
        if (fx) drawn = drawBackgroundLayerRecord(fx, 0.28, 0.95, 0, 1.05) || drawn;
        if (ground) drawn = drawBackgroundLayerRecord(ground, 0.35, 1, 0, 1.05) || drawn;

        if (!drawn) return false;

        // sutil línea de piso para integrarlo con la jugabilidad
        ctx.fillStyle = config.worldId === 'world_2' ? 'rgba(160,211,238,.28)' : 'rgba(210,238,255,.28)';
        ctx.fillRect(0, world.floorY - 3, W, 3);

        return true;
      }

